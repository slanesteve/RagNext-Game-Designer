/* ═══════════════════════════════════════════════════════════════════════════
   RagNext Player — GameStyles.uss
   Dark fantasy theme: deep blacks, deep blue-grey accents, amber highlights
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Design Tokens ────────────────────────────────────────────────────────── */
:root {
    --color-bg-deep:        rgb(13, 14, 18);
    --color-bg-card:        rgba(22, 24, 30, 0.65);
    --color-bg-panel:       rgba(22, 24, 30, 0.85);
    --color-border:         rgba(0, 168, 204, 0.3);
    --color-accent-blue:    rgb(0, 168, 204);
    --color-accent-amber:   #FFB84A;
    --color-text-primary:   #EAEAEA;
    --color-text-secondary: rgb(90, 95, 110);
    --color-text-hotlink:   rgb(0, 168, 204);
    --color-character-dot:  #FF6B9D;
    --color-object-dot:     rgb(0, 168, 204);
    --radius-card:          8px;
    --radius-btn:           6px;
    --font-size-body:       14px;
    --font-size-header:     18px;
    --font-size-section:          11px;
}

/* ── Root Layout ──────────────────────────────────────────────────────────── */
.root-container {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: var(--color-bg-deep);
    color: var(--color-text-primary);
    border-width: 1px;
    border-color: rgba(0, 168, 204, 0.3);
    border-radius: 8px;
    overflow: hidden;
}

/* ── Top Bar ──────────────────────────────────────────────────────────────── */
.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 18px;
    background-color: rgba(22, 24, 30, 0.85);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 168, 204, 0.3);
}

.room-title {
    font-size: 20px;
    color: var(--color-accent-blue);
    -unity-font-style: bold;
    letter-spacing: 1px;
    cursor: link;
}

.room-portrait {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    border-width: 1.5px;
    border-color: var(--color-accent-blue);
    background-color: rgba(22, 24, 30, 0.65);
    -unity-background-scale-mode: scale-and-crop;
    flex-shrink: 0;
    margin-right: 8px;
    cursor: link;
}

.room-portrait:hover {
    border-color: var(--color-accent-amber);
}

.room-title:hover {
    color: var(--color-accent-amber);
}

.game-info {
    font-size: 11px;
    color: var(--color-text-secondary);
    -unity-font-style: italic;
}

/* ── Content Area ─────────────────────────────────────────────────────────── */
.content-area {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0px;
    padding: 10px;
    overflow: hidden;
    margin-bottom: 4px; /* Clear bottom split handle */
}

/* Stylized splitter drag lines/handles for content-splitter */
#content-splitter > .unity-two-pane-split-view__drag-line {
    background-color: rgba(0, 168, 204, 0.2);
    width: 1px;
}
#content-splitter > .unity-two-pane-split-view__handle {
    background-color: rgba(0, 168, 204, 0.4);
}

/* Hide when collapsed */
.splitter--collapsed > .unity-two-pane-split-view__drag-line,
.splitter--collapsed > .unity-two-pane-split-view__handle {
    display: none;
    width: 0px;
    opacity: 0;
}

/* ── Left Column ──────────────────────────────────────────────────────────── */
.left-column {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0px;
    row-gap: 10px;
    min-height: 0px;
    margin-right: 0px;
}

/* Scene Art Card */
.scene-card {
    background-color: var(--color-bg-card);
    border-radius: 8px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(0, 168, 204, 0.3);
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 100px;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    margin-bottom: 3px; /* Clear horizontal split handle */
}

.scene-image {
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.scene-placeholder {
    font-size: 64px;
    color: rgba(0, 168, 204, 0.2);
    -unity-text-align: middle-center;
}

/* Narrative Panel */
.narrative-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0px;
    min-height: 0px;
    background-color: var(--color-bg-card);
    border-radius: 8px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(0, 168, 204, 0.3);
    transition-property: opacity;
    transition-duration: 0.3s;
    margin-top: 3px; /* Clear horizontal split handle */
}

.narrative-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0px;
    min-height: 0px;
    padding: 12px;
}

.narrative-room-header {
    font-size: 16px;
    color: var(--color-accent-blue);
    -unity-font-style: bold;
    margin-bottom: 6px;
    margin-top: 12px;
    letter-spacing: 1px;
}

.narrative-paragraph {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
    align-items: flex-start;
}

.narrative-text {
    font-size: 14px;
    color: #EAEAEA;
    white-space: normal;
    line-height: 1.6;
}

.narrative-status {
    font-size: 14px;
    color: #D0D0D8;
    white-space: normal;
    margin: 3px 0;
}

.narrative-hotlink {
    font-size: 14px;
    color: var(--color-accent-blue);
    -unity-font-style: bold;
    text-decoration: underline;
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
    cursor: link;
}

.narrative-hotlink:hover {
    color: #80CAFF;
}

.narrative-separator {
    height: 1px;
    background-color: rgba(0, 168, 204, 0.2);
    margin: 10px 0;
}

.narrative-spacer {
    height: 4px;
}

/* ── Right Column ─────────────────────────────────────────────────────────── */
.right-column {
    flex-direction: column;
    row-gap: 10px;
    min-width: 0px;
    overflow: hidden;
    margin-left: 0px;
    padding-left: 2px;
    margin-right: 0px;
    border-left-width: 1px;
    border-left-color: rgba(0, 168, 204, 0.3);
}

.right-column > * {
    flex-shrink: 0;
}

/* Section headers */
.section-header {
    font-size: 11px;
    color: var(--color-text-secondary);
    -unity-font-style: bold;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 6px;
    padding: 6px 12px;
    background-image: linear-gradient(to right, rgba(0, 168, 204, 0.15), rgba(13, 14, 18, 0));
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 168, 204, 0.3);
}

/* Card base */
.compass-card, .entity-card {
    background-color: var(--color-bg-card);
    border-radius: 8px;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 168, 204, 0.2);
    border-top-width: 1.5px;
    border-top-color: rgba(0, 168, 204, 0.45);
    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.5);
    padding: 10px;
}

/* ── Exits Compass ────────────────────────────────────────────────────────── */
.compass-rose {
    background-color: transparent;
    border-width: 0;
    width: 120px;
    height: 120px;
    align-self: center;
    align-items: center;
    justify-content: center;
    padding: 8px;
    margin-bottom: 12px;
}

.compass-row {
    flex-direction: row;
    column-gap: 4px;
    margin: 2px 0;
}

.compass-rose-btn {
    width: 30px;
    height: 30px;
    border-radius: 4px;
    background-color: transparent;
    border-width: 0px;
    font-size: 14px;
    -unity-font-style: bold;
    padding: 0;
    -unity-text-align: middle-center;
}

.compass-center {
    width: 30px;
    height: 30px;
    align-items: center;
    justify-content: center;
}

.compass-center-dot {
    font-size: 14px;
    color: var(--color-accent-blue);
    -unity-font-style: bold;
}

.compass-auxiliary {
    flex-direction: row;
    flex-wrap: wrap;
    column-gap: 6px;
    row-gap: 6px;
    justify-content: center;
    margin-top: 4px;
}

.compass-aux-btn {
    background-color: transparent;
    border-radius: 6px;
    border-width: 0px;
    font-size: 11px;
    padding: 6px 12px;
    -unity-font-style: bold;
}

/* Dimmed / Inactive exits */
.compass-btn--inactive {
    opacity: 0.25;
    border-width: 0;
    color: var(--color-text-secondary);
    background-color: transparent;
}

/* Generic active state for directional paths */
.compass-btn--active {
    opacity: 1.0;
    border-color: rgba(0, 168, 204, 0.8);
}

/* Active Exits (Cardinal directions / Electric Cyan glow) */
.compass-rose-btn.compass-btn--active {
    border-width: 1px;
    border-color: rgba(0, 168, 204, 0.8);
    color: var(--color-accent-blue);
    background-color: rgba(22, 24, 30, 0.65);
    opacity: 1.0;
}

.compass-rose-btn.compass-btn--active:hover {
    border-color: var(--color-accent-blue);
    color: var(--color-accent-blue);
    background-color: rgba(0, 168, 204, 0.1);
}

/* Active Vertical portals (Electric Cyan glow) */
.compass-aux-btn.compass-btn--active {
    border-width: 1px;
    border-color: rgba(0, 168, 204, 0.8);
    color: var(--color-accent-blue);
    background-color: rgba(22, 24, 30, 0.65);
    opacity: 1.0;
}

.compass-aux-btn.compass-btn--active:hover {
    border-color: var(--color-accent-blue);
    color: var(--color-accent-blue);
    background-color: rgba(0, 168, 204, 0.1);
}

/* Active Spatial portals (pink glow) */
.compass-aux-btn.compass-btn--active {
    border-width: 1.5px;
    border-color: #FF6B9D;
    color: #FF6B9D;
    background-color: #1E1E28;
    opacity: 1.0;
}

.compass-aux-btn.compass-btn--active:hover {
    background-color: #FF6B9D;
    color: #0D0D0F;
}

/* ── Entity Lists ─────────────────────────────────────────────────────────── */
.entity-list {
    flex-direction: column;
    row-gap: 3px;
}

.entity-row {
    flex-direction: row;
    align-items: center;
    background-color: transparent;
    border-radius: 8px;
    padding: 6px 8px;
    min-height: 52px;
    height: auto;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.entity-row:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.entity-thumbnail {
    width: 40px;
    height: 40px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(0, 188, 212, 0.3);
    margin-right: 10px;
    background-size: cover;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.4);
}


.entity-dot--object {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: #4AABFF;
    margin-right: 8px;
    flex-shrink: 0;
}

.entity-dot--character {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: #FF6B9D;
    margin-right: 8px;
    flex-shrink: 0;
}

.entity-name {
    flex-grow: 1;
    font-size: 13px;
    color: #E0E0E8;
}

.entity-action-btn {
    background-color: transparent;
    border-width: 0;
    color: #888899;
    font-size: 16px;
    padding: 0 4px;
}

.entity-action-btn:hover {
    color: #FFB84A;
}

/* ── Bottom Bar ───────────────────────────────────────────────────────────── */
.bottom-bar {
    flex-direction: row;
    align-items: center;
    background-color: #101014;
    border-top-width: 1px;
    border-top-color: #2A2A38;
    padding: 8px 14px;
    min-height: 115px; /* Sized to fit inventory scroll and info */
    column-gap: 14px;
    margin-top: 4px; /* Clear vertical split handle */
}

.player-portrait {
    height: 90%;
    aspect-ratio: 1;
    border-radius: 100px;
    border-width: 2px;
    border-color: #FFB84A;
    background-color: #1E1E28;
    -unity-background-scale-mode: scale-and-crop;
    flex-shrink: 0;
    cursor: link;
}

.player-portrait:hover {
    border-color: #4AABFF;
}


.player-info {
    flex-direction: column;
    justify-content: center;
    row-gap: 2px;
    min-width: 90px;
}

.player-name {
    font-size: 14px;
    color: #E0E0E8;
    -unity-font-style: bold;
}

.player-gender {
    font-size: 11px;
    color: #888899;
}

.inventory-card {
    flex-grow: 1;
    background-color: rgba(20, 20, 24, 0.88);
    border-radius: 12px;
    border-width: 1.5px;
    border-color: #2A2A38;
    padding: 6px 10px;
    overflow: hidden;
}

.inventory-scroll {
    flex-direction: row;
    flex-grow: 1;
}

.inventory-list {
    flex-direction: row;
    align-items: center;
    column-gap: 8px;
    padding: 4px 0;
}

/* Horizontal pill-style badges for inventory items */
.inventory-list .entity-row {
    flex-direction: row;
    align-items: center;
    background-color: #1E1E28;
    border-radius: 20px;
    border-width: 1px;
    border-color: #3A3A4A;
    padding: 5px 14px;
    flex-shrink: 0;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}

.inventory-list .entity-row:hover {
    background-color: #2E2E3E;
    border-color: #FFB84A; /* Amber glow on hover */
}

/* Hide action button in inventory pills since tapping the entire pill interacts */
.inventory-list .entity-row .entity-action-btn {
    display: none;
}

.inventory-list .entity-row .entity-name {
    font-size: 12px;
    -unity-font-style: bold;
    color: #E0E0E8;
}

/* ── Interaction Popup Menu ────────────────────────────────────────────────── */
.interaction-menu {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    background-color: rgba(24, 24, 28, 0.92);
    border-radius: 12px;
    border-width: 1.5px;
    border-color: #4AABFF;
    padding: 16px;
    min-width: 260px;
    max-width: 380px;
    flex-direction: column;
    row-gap: 6px;
    z-index: 100;
}

.interaction-menu-title {
    font-size: 15px;
    color: #4AABFF;
    -unity-font-style: bold;
    margin-bottom: 8px;
    -unity-text-align: upper-center;
}

.interaction-menu-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 8px;
    row-gap: 8px;
    margin: 8px 0;
}

.interaction-menu-btn {
    background-color: #1E1E28;
    border-radius: 6px;
    border-width: 1px;
    border-color: #2A2A38;
    color: #E0E0E8;
    font-size: 13px;
    padding: 8px 12px;
    -unity-text-align: middle-left;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.interaction-menu-btn:hover {
    background-color: #2A2A38;
    border-color: #4AABFF;
}

.interaction-menu-cancel {
    background-color: transparent;
    border-width: 0;
    color: #888899;
    font-size: 12px;
    margin-top: 6px;
    -unity-text-align: upper-center;
}

.interaction-menu-cancel:hover {
    color: #E0E0E8;
}

/* ── Settings Controls & Settings Panel ──────────────────────────────────── */
.settings-btn {
    background-color: #1E1E28;
    border-radius: 6px;
    border-width: 1px;
    border-color: #2A2A38;
    color: #E0E0E8;
    font-size: 11px;
    padding: 4px 10px;
    -unity-font-style: bold;
}

.settings-btn:hover {
    background-color: #2A2A38;
    border-color: #4AABFF;
    color: #4AABFF;
}

.settings-btn:active {
    background-color: #1A1A20;
    color: #FFB84A;
}

.settings-menu {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    background-color: rgba(24, 24, 28, 0.92);
    border-radius: 12px;
    border-width: 1.5px;
    border-color: #4AABFF;
    padding: 20px;
    min-width: 280px;
    max-width: 360px;
    flex-direction: column;
    row-gap: 12px;
    z-index: 200;
}

.settings-menu-title {
    font-size: 16px;
    color: #4AABFF;
    -unity-font-style: bold;
    margin-bottom: 8px;
    -unity-text-align: upper-center;
}

.settings-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    column-gap: 10px;
}

.settings-label {
    font-size: 13px;
    color: #E0E0E8;
    flex-grow: 1;
}

.settings-toggle-btn {
    background-color: #1E1E28;
    border-radius: 6px;
    border-width: 1px;
    border-color: #2A2A38;
    color: #E0E0E8;
    font-size: 12px;
    padding: 6px 12px;
    min-width: 110px;
}

.settings-toggle-btn:hover {
    border-color: #4AABFF;
    background-color: #22222E;
}

.settings-slider {
    flex-grow: 1;
    min-width: 120px;
}

.settings-separator {
    height: 1px;
    background-color: #2A2A38;
    margin: 4px 0;
}

.quit-btn {
    background-color: #4C1C24;
    border-radius: 6px;
    border-width: 1px;
    border-color: #FF4A4A;
    color: #FFC0C0;
    font-size: 13px;
    padding: 8px 12px;
    -unity-font-style: bold;
}

.quit-btn:hover {
    background-color: #FF4A4A;
    color: #0D0D0F;
}

.settings-menu-cancel {
    background-color: transparent;
    border-width: 0;
    color: #888899;
    font-size: 12px;
    -unity-text-align: upper-center;
    margin-top: 4px;
}

.settings-menu-cancel:hover {
    color: #E0E0E8;
}

.slot-btn {
    background-color: #1E1E28;
    border-radius: 4px;
    border-width: 1px;
    border-color: #2A2A38;
    color: #E0E0E8;
    font-size: 11px;
    padding: 4px 8px;
    min-width: 55px;
}

.slot-btn:hover {
    border-color: #4AABFF;
    color: #4AABFF;
}

.slot-btn:disabled {
    color: #444450;
    border-color: #222228;
    background-color: #121216;
}

/* ── Splitter Styles (TwoPaneSplitView) ────────────────────────────────────── */
.unity-two-pane-split-view__drag-line {
    background-color: #2A2A38;
}

.unity-two-pane-split-view__drag-line--hovered {
    background-color: #4AABFF;
}

.unity-two-pane-split-view__handle {
    background-color: #1E1E28;
    border-color: #2A2A38;
}

.unity-two-pane-split-view__handle:hover {
    background-color: #4AABFF;
}

/* ── Game Over & Player Input Modal Styling ───────────────────────────────── */
.game-over-message,
.prompt-input-message {
    font-size: 13px;
    color: #888899;
    white-space: normal;
    margin: 4px 0 8px 0;
    -unity-text-align: middle-center;
}

.prompt-choice-btn {
    background-color: #1E1E28;
    border-radius: 6px;
    border-width: 1px;
    border-color: #2A2A38;
    color: #E0E0E8;
    font-size: 12px;
    padding: 8px 12px;
    margin-bottom: 4px;
    -unity-text-align: middle-left;
}

.prompt-choice-btn:hover {
    background-color: #2A2A38;
    border-color: #FFB84A;
    color: #FFB84A;
}

#prompt-text-field {
    margin: 8px 0;
}

#prompt-text-field .unity-text-field__input {
    background-color: #121217;
    color: #FFFFFF;
    border-color: #2A2A38;
    border-width: 1px;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
    selection-color: #00A8CC;
}

#prompt-text-field .unity-text-field__input:focus {
    border-color: #00A8CC;
}

/* ── Nested Container Items Styling ────────────────────────────────────────── */
.entity-row--nested {
    padding-left: 20px;
    background-color: #121217;
    border-radius: 4px;
    margin-left: 10px;
    margin-bottom: 2px;
}

.entity-nested-arrow {
    font-size: 14px;
    color: #FFB84A;
    margin-right: 4px;
    -unity-font-style: bold;
}

.entity-name--nested {
    font-size: 11px;
    color: #A0A0B0;
    -unity-font-style: italic;
}

/* ── Splash Screen ────────────────────────────────────────────────────────── */
.splash-screen {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: #0B0914;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    transition-property: opacity;
    transition-duration: 0.8s;
}

.splash-badge {
    width: 100px;
    height: 100px;
    border-radius: 50px;
    background-color: #6F1AD4;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
}

.splash-badge-text {
    font-size: 40px;
    color: white;
    -unity-font-style: bold;
}

.splash-title {
    font-size: 32px;
    color: white;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 6px;
}

.splash-subtitle {
    font-size: 10px;
    color: #888899;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

/* ── UI OVERHAUL ADDITIONS ────────────────────────────────────────────────── */
.sidebar-toggle-btn {
    position: absolute;
    right: 0px;
    top: 50%;
    translate: 50% -50%;
    width: 16px;
    height: 48px;
    background-color: rgba(22, 24, 30, 0.95);
    border-width: 1px;
    border-color: rgba(0, 168, 204, 0.4);
    border-radius: 4px;
    color: rgb(0, 168, 204);
    align-items: center;
    justify-content: center;
    padding: 0;
    font-size: 10px;
    z-index: 100;
}

.sidebar-toggle-btn:hover {
    background-color: rgb(0, 168, 204);
    color: rgb(13, 14, 18);
    border-color: rgb(0, 168, 204);
}

#compass-card-hud {
    display: none;
    position: absolute;
    right: 15px;
    top: 15px;
    background-color: rgba(22, 24, 30, 0.65);
    border-radius: 8px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(0, 168, 204);
    padding: 10px;
    z-index: 50;
}

.hud-mode-active #compass-card-hud {
    display: none;
}

.hud-mode-active #navigation-panel {
    display: flex;
}

.media-vignette {
    position: absolute;
    width: 100%;
    height: 100%;
    pointer-events: none;
    background-image: radial-gradient(circle, rgba(13, 14, 18, 0) 60%, rgba(13, 14, 18, 0.85) 100%);
    z-index: 5;
}

.sidebar--collapsed {
    width: 0px !important;
    border-left-width: 0px !important;
    border-left-color: transparent !important;
}

/* Custom Splitter Handles & Dragging Zones */
.drag-splitter {
    background-color: transparent;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.drag-splitter--vertical {
    width: 8px; /* Larger clickable hitbox area */
    cursor: resize-horizontal;
    height: 100%;
}

.drag-splitter--horizontal {
    height: 8px; /* Larger clickable hitbox area */
    cursor: resize-vertical;
    width: 100%;
}

.drag-splitter-line {
    background-color: rgba(90, 95, 110, 0.4);
}

.drag-splitter--vertical > .drag-splitter-line {
    width: 2px;
    height: 100%;
}

.drag-splitter--horizontal > .drag-splitter-line {
    height: 2px;
    width: 100%;
}

/* Floating HUD Overlay Sidebar Deck */
#right-sidebar-container.sidebar--hud-overlay {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    position: absolute;
    right: 16px;
    top: 64px;
    bottom: 24px;
    width: 300px;
    background-color: rgba(22, 24, 30, 0.65);
    border-top-width: 1px;
    border-top-color: rgba(0, 168, 204, 0.4);
    border-left-width: 0px;
    border-right-width: 0px;
    border-bottom-width: 0px;
    border-radius: 8px;
    height: auto;
    padding: 12px;
}

/* Ensure no inherited style sheets can force a dark fill on items */
.sidebar--hud-overlay .entity-row, 
.sidebar--hud-overlay .legend-box {
    background-color: transparent !important;
    background-image: none !important;
}

/* Force physical separation between the stacked modules */
#right-sidebar-container.sidebar--hud-overlay #navigation-panel {
    position: relative; /* Hard override to ensure layout flow */
    margin-bottom: 16px; /* Explicit gap so the legend cannot merge into it */
    flex-shrink: 0;
}

#right-sidebar-container.sidebar--hud-overlay #room-legend {
    position: relative; /* Hard override to ensure layout flow */
    flex-grow: 1;
}

.sidebar--hud-overlay .entity-card,
.sidebar--hud-overlay .compass-card {
    background-color: transparent;
    border-width: 0;
    box-shadow: none;
}

/* Unified Room Legend Separator */
.legend-separator {
    height: 1px;
    background-color: rgba(0, 168, 204, 0.2);
    margin: 8px 4px;
}

/* Push the text boundaries and scrollbar left to completely clear the HUD width */
.text-container--hud-active {
    padding-right: 308px;
    transition-property: padding-right;
    transition-duration: 0.2s;
}

/* ── Glassmorphic & Overlay HUD Revamp Styles ────────────────────────────────── */
.glass-card {
    background-color: rgba(13, 14, 18, 0.78);
    border-width: 1px;
    border-color: rgba(0, 188, 212, 0.25);
    border-radius: 12px;
}

.room-action-thumbnail-wrapper {
    cursor: link;
    background-color: rgba(13, 14, 18, 0.78);
    transition: scale 0.15s ease-in-out, border-color 0.15s ease-in-out;
}

.room-action-thumbnail-wrapper:hover {
    scale: 1.05;
    border-color: #FFB84A;
}

.room-action-thumbnail {
    -unity-background-scale-mode: scale-and-crop;
    border-radius: 35px;
    overflow: hidden;
}

/* Pulsing neon border animation for room actions indicator */
.room-action-thumbnail--pulse {
    border-color: #00bcd4;
    transition: border-color 0.3s ease-in-out;
}

/* Compass collapsible dial styling */
.compass-dial-overlay {
    background-color: rgba(13, 14, 18, 0.9);
    border-color: rgba(0, 188, 212, 0.35);
    transition: opacity 0.2s ease-in-out, scale 0.2s ease-in-out;
}

/* Tab button formatting */
.active-tab-btn {
    color: #00bcd4 !important;
    background-color: rgba(0, 188, 212, 0.15) !important;
    border-color: #00bcd4 !important;
}

/* History Log Revamped Overlay Class */
.history-log-menu {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    background-color: rgba(13, 14, 18, 0.95);
    border-radius: 12px;
    border-width: 1.5px;
    border-color: #00bcd4;
    padding: 24px;
    width: 780px;
    height: 80%;
    max-width: 780px;
    max-height: 80%;
    flex-direction: column;
    z-index: 200;
}

/* Glassy Help Menu Popup Style */
.help-menu {
    border-color: #00bcd4;
    width: 380px;
    max-width: 380px;
    height: 440px;
    max-height: 440px;
    background-color: rgba(13, 14, 18, 0.96);
}



