<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
  <ui:Style src="project://database/Assets/UI/GameStyles.uss?fileID=7433451118617782107&amp;guid=0cf91808b5cc2af43bbc800baeb214b6&amp;type=3#GameStyles" />
  <ui:VisualElement name="root" class="root-container">

    <!-- ══ TOP BAR ═══════════════════════════════════════════════════════════ -->
    <ui:VisualElement name="top-bar" class="top-bar">
      <ui:VisualElement name="topbar-room-title-container" style="flex-direction: row; align-items: center;">
        <ui:VisualElement name="room-portrait" class="room-portrait" style="display: none;" />
        <ui:Label name="room-title" class="room-title" text="Room Name" />
      </ui:VisualElement>
      <ui:VisualElement style="flex-direction: row; align-items: center; column-gap: 12px;">
        <ui:Label name="game-info"  class="game-info"  text="by Author · v1.0" />
        <ui:Button name="help-btn" class="settings-btn" text="❓ Help" />
        <ui:Button name="history-log-btn" class="settings-btn" text="📖 Log" />
        <ui:Button name="settings-btn" class="settings-btn" text="⚙ Settings" />
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- ══ MAIN VERTICAL CONTAINER ═══════════════════════════════════════════ -->
    <ui:VisualElement name="main-container" style="flex-grow: 1; min-height: 0; flex-direction: column; position: relative;">
      
      <!-- Blown-up Background Artwork -->
      <ui:VisualElement name="media-canvas" class="scene-card" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; flex-grow: 1; width: 100%; height: 100%; justify-content: center; align-items: center;">
        <ui:VisualElement name="scene-image" class="scene-image" style="flex-grow: 1; width: 100%; height: 100%;" />
        <ui:VisualElement name="media-vignette" class="media-vignette" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
        <ui:Label name="scene-placeholder" class="scene-placeholder" picking-mode="Ignore" text="🏰" style="position: absolute; left: 50%; top: 50%; translate: -50% -50%;" />
      </ui:VisualElement>

      <!-- Overlay HUD Layout Wrapper -->
      <ui:VisualElement name="hud-layout-wrapper" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; flex-direction: row;">
        
        <!-- Contextual Action Callout Popover Card -->
        <ui:VisualElement name="contextual-action-popover" class="glass-card" picking-mode="Position" style="position: absolute; display: none; flex-direction: column; width: 170px; padding: 8px; border-radius: 10px; border-width: 1px; border-color: rgba(0, 188, 212, 0.4); background-color: rgba(13, 13, 21, 0.95); z-index: 1000;">
          <ui:VisualElement name="contextual-popover-actions" style="flex-direction: column; gap: 4px;" />
          <ui:Label name="contextual-popover-pointer" text="▶" style="position: absolute; font-size: 16px; color: #00bcd4;" />
        </ui:VisualElement>
        
        <!-- Left Sidebar Compartment: Interactive lists and collapsible compass -->
        <ui:VisualElement name="hud-left-sidebar-compartment" picking-mode="Ignore" style="flex-shrink: 1; min-height: 0; padding: 24px 0 24px 24px; flex-direction: column; justify-content: space-between; align-items: stretch; display: none;">
          <!-- Transparent Sidebar (Items and Inventory tabs) -->
          <ui:VisualElement name="left-sidebar-container" class="left-column glass-card" picking-mode="Position" style="flex-grow: 1; flex-shrink: 1; min-height: 0; border-radius: 16px; border-width: 1px; border-color: rgba(255, 255, 255, 0.15); padding: 14px; margin-bottom: 20px;" />
        </ui:VisualElement>

        <!-- Left Compartment: Floating profiles (player stats + room action thumbnail) & Narrative text card -->
        <ui:VisualElement name="hud-left-compartment" picking-mode="Ignore" style="flex-grow: 1; flex-shrink: 1; flex-basis: 0px; min-height: 0; padding: 24px; flex-direction: column; justify-content: space-between;">
          
          <!-- Floating Profiles (Top-Left) -->
          <ui:VisualElement name="floating-profiles-container" picking-mode="Position" style="flex-direction: row; column-gap: 16px; align-self: flex-start;">
            <!-- Player Portrait and Vitals Container -->
            <ui:VisualElement name="floating-player-card" class="glass-card" style="padding: 12px; flex-direction: row; align-items: flex-start; column-gap: 12px; border-radius: 56px 16px 16px 56px; border-width: 1px; border-color: rgba(0, 188, 212, 0.4);">
              <ui:VisualElement style="flex-direction: column; align-items: flex-start; max-width: 180px;">
                <ui:VisualElement name="player-portrait" class="player-portrait" style="width: 80px; height: 80px; border-radius: 40px; border-width: 2.5px; border-color: #00bcd4; align-self: center;" />
                <ui:ScrollView name="player-hud-scroll" style="margin-top: 6px; width: 100%; max-width: 180px;" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden">
                  <ui:VisualElement name="player-hud-container" style="flex-direction: column; align-items: flex-start; margin-left: 16px; gap: 4px; width: 100%;" />
                </ui:ScrollView>
              </ui:VisualElement>
              <ui:VisualElement name="player-details" style="flex-direction: column; margin-top: 8px;">
                <ui:Label name="player-name" class="player-name" text="Player" style="font-weight: bold; font-size: 14px; color: #ffffff;" />
                <ui:Label name="player-gender" class="player-gender" text="Male" style="font-size: 11px; color: #b0bec5; margin-top: 1px;" />
              </ui:VisualElement>
            </ui:VisualElement>

            <!-- Room Action Thumbnail (Pulsing interaction target) -->
            <ui:VisualElement name="room-action-thumbnail-wrapper" class="room-action-thumbnail-wrapper" style="width: 80px; height: 80px; border-radius: 40px; padding: 3px; border-width: 2px; border-color: rgba(0, 188, 212, 0.4); justify-content: center; align-items: center;">
              <ui:VisualElement name="room-action-thumbnail" class="room-action-thumbnail" style="width: 100%; height: 100%; border-radius: 37px; background-color: rgba(0, 0, 0, 0.6);" />
            </ui:VisualElement>
          </ui:VisualElement>

          <!-- Floating Narrative Description Card (Bottom-Left) -->
          <ui:VisualElement name="narrative-panel" class="narrative-panel glass-card" picking-mode="Position" style="padding: 16px; border-radius: 12px; border-width: 1px; border-color: rgba(255, 255, 255, 0.15);">
            <ui:ScrollView name="narrative-scroll" class="narrative-scroll"
                           vertical-scroller-visibility="AlwaysVisible"
                           horizontal-scroller-visibility="Hidden" style="flex-grow: 1;" />
          </ui:VisualElement>

          <!-- Bottom Compartment for Docked Elements (Placed in one row, next to each other left to right) -->
          <ui:VisualElement name="hud-bottom-compartment" class="glass-card" picking-mode="Position" style="flex-direction: row; justify-content: space-around; align-items: stretch; height: 220px; border-radius: 16px; border-width: 1px; border-color: rgba(255, 255, 255, 0.15); padding: 14px; margin-top: 12px; display: none;" />

        </ui:VisualElement>

        <!-- Right Compartment: Interactive lists and collapsible compass -->
        <ui:VisualElement name="hud-right-compartment" picking-mode="Ignore" style="flex-shrink: 1; min-height: 0; padding: 24px 24px 24px 0; flex-direction: column; justify-content: space-between; align-items: stretch;">
          
          <!-- Transparent Sidebar (Items and Inventory tabs) -->
          <ui:VisualElement name="right-sidebar-container" class="right-column glass-card" picking-mode="Position" style="flex-grow: 1; flex-shrink: 1; min-height: 0; border-radius: 16px; border-width: 1px; border-color: rgba(255, 255, 255, 0.15); padding: 14px; margin-bottom: 20px;">
            <!-- Room Actions Container -->
            <ui:VisualElement name="room-actions-container" class="entity-card" style="background-color: transparent; border-width: 0px; box-shadow: none; flex-grow: 1; flex-shrink: 1; min-height: 0; margin-bottom: 12px; flex-direction: column;">
              <!-- Room Actions Section -->
              <ui:Label text="Room Actions" class="section-header" style="margin-bottom: 6px; color: #a855f7; -unity-font-style: bold;" />
              <ui:ScrollView name="room-actions-scroll" style="flex-grow: 1; flex-basis: 0; flex-shrink: 1; min-height: 0;" vertical-scroller-visibility="AlwaysVisible" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement name="room-actions-list" class="entity-list" />
              </ui:ScrollView>
            </ui:VisualElement>

            <ui:VisualElement class="legend-separator" style="margin: 4px 0 8px 0; height: 1px; background-color: rgba(168, 85, 247, 0.2);" />

            <!-- Room Items Container -->
            <ui:VisualElement name="room-items-container" class="entity-card" style="background-color: transparent; border-width: 0px; box-shadow: none; flex-grow: 1; flex-shrink: 1; min-height: 0; margin-bottom: 12px; flex-direction: column;">
              <!-- Room Items Section -->
              <ui:Label text="Room Items" class="section-header" style="margin-bottom: 6px; color: #00bcd4; -unity-font-style: bold;" />
              <ui:ScrollView name="room-items-scroll" style="flex-grow: 1; flex-basis: 0; flex-shrink: 1; min-height: 0;" vertical-scroller-visibility="AlwaysVisible" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement name="characters-section">
                  <ui:VisualElement name="characters-list" class="entity-list" />
                </ui:VisualElement>
                <ui:VisualElement name="objects-section" style="margin-top: 4px;">
                  <ui:VisualElement name="objects-list" class="entity-list" />
                </ui:VisualElement>
              </ui:ScrollView>
            </ui:VisualElement>

            <ui:VisualElement class="legend-separator" style="margin: 4px 0 8px 0; height: 1px; background-color: rgba(0, 188, 212, 0.2);" />

            <!-- Inventory Container -->
            <ui:VisualElement name="inventory-container" class="entity-card" style="background-color: transparent; border-width: 0px; box-shadow: none; flex-grow: 1; flex-shrink: 1; min-height: 0; flex-direction: column;">
              <!-- Inventory Section -->
              <ui:Label text="Inventory" class="section-header" style="margin-bottom: 6px; color: #00bcd4; -unity-font-style: bold;" />
              <ui:ScrollView name="inventory-scroll" style="flex-grow: 1; flex-basis: 0; flex-shrink: 1; min-height: 0;" vertical-scroller-visibility="AlwaysVisible" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement name="inventory-section">
                  <ui:VisualElement name="inventory-list" class="entity-list" />
                </ui:VisualElement>
              </ui:ScrollView>
            </ui:VisualElement>
          </ui:VisualElement>

          <!-- Floating Collapsible Compass Dial Overlay -->
          <ui:VisualElement name="compass-hud-container" picking-mode="Position" style="align-items: flex-end; flex-shrink: 0;">
            <ui:VisualElement name="compass-dial-overlay" class="compass-dial-overlay glass-card" style="display: none; padding: 16px; margin-bottom: 12px; border-radius: 20px; border-width: 1px; border-color: rgba(255, 255, 255, 0.15); align-items: center;">
              
              <ui:Label name="navigation-title-hud" class="section-header" text="Navigation" style="margin-bottom: 8px; color: #00bcd4;" />
              
              <ui:VisualElement class="compass-rose">
                <ui:VisualElement class="compass-row">
                  <ui:Button name="compass-dir-nw" class="compass-rose-btn compass-btn--inactive" text="↖" />
                  <ui:Button name="compass-dir-north" class="compass-rose-btn compass-btn--inactive" text="▲" />
                  <ui:Button name="compass-dir-ne" class="compass-rose-btn compass-btn--inactive" text="↗" />
                </ui:VisualElement>
                <ui:VisualElement class="compass-row">
                  <ui:Button name="compass-dir-west" class="compass-rose-btn compass-btn--inactive" text="◀" />
                  <ui:VisualElement class="compass-center">
                    <ui:Label class="compass-center-dot" text="❖" />
                  </ui:VisualElement>
                  <ui:Button name="compass-dir-east" class="compass-rose-btn compass-btn--inactive" text="▶" />
                </ui:VisualElement>
                <ui:VisualElement class="compass-row">
                  <ui:Button name="compass-dir-sw" class="compass-rose-btn compass-btn--inactive" text="↙" />
                  <ui:Button name="compass-dir-south" class="compass-rose-btn compass-btn--inactive" text="▼" />
                  <ui:Button name="compass-dir-se" class="compass-rose-btn compass-btn--inactive" text="↘" />
                </ui:VisualElement>
              </ui:VisualElement>

              <ui:VisualElement class="compass-auxiliary" style="margin-top: 8px; flex-direction: row; flex-wrap: wrap; justify-content: center; gap: 4px;">
                <ui:Button name="compass-dir-up" class="compass-aux-btn compass-btn--inactive" text="▲ Up" />
                <ui:Button name="compass-dir-down" class="compass-aux-btn compass-btn--inactive" text="▼ Down" />
                <ui:Button name="compass-dir-in" class="compass-aux-btn compass-btn--inactive" text="📥 In" />
                <ui:Button name="compass-dir-out" class="compass-aux-btn compass-btn--inactive" text="📤 Out" />
              </ui:VisualElement>
            </ui:VisualElement>

            <!-- Compass Toggle Button -->
            <ui:Button name="compass-toggle-btn" class="settings-btn" text="🧭 Navigation" style="font-weight: bold; padding: 10px 16px; border-radius: 20px; margin: 0; width: 100%;" />
          </ui:VisualElement>

        </ui:VisualElement>

      </ui:VisualElement>

    </ui:VisualElement>

    <!-- ══ INTERACTION POPUP MENU (hidden by default) ═══════════════════════ -->
    <ui:VisualElement name="interaction-menu" class="interaction-menu" style="display: none;" />

    <!-- ══ UNIFIED GAME MENU OVERLAY (hidden by default) ════════════════════ -->
    <ui:VisualElement name="game-menu-overlay" class="game-menu-overlay" style="display: none;">
      
      <!-- Top Title Bar -->
      <ui:Label name="game-menu-title" class="game-menu-title" text="SAVE GAME" />

      <!-- Center Split Container -->
      <ui:VisualElement class="game-menu-body" style="flex-grow: 1; flex-direction: row; min-height: 0;">
        
        <!-- Left Sidebar Navigation List -->
        <ui:VisualElement class="game-menu-sidebar" style="width: 180px; flex-shrink: 0; padding-right: 16px; border-right-width: 1px; border-color: rgba(255, 255, 255, 0.1);">
          <ui:Button name="menu-btn-return" class="menu-nav-btn menu-nav-btn--return" text="✕ Return" />
          <ui:VisualElement style="height: 12px;" />
          <ui:Button name="menu-btn-save" class="menu-nav-btn" text="💾 Save" />
          <ui:Button name="menu-btn-load" class="menu-nav-btn" text="📂 Load" />
          <ui:Button name="menu-btn-settings" class="menu-nav-btn" text="⚙ Settings" />
          <ui:Button name="menu-btn-history" class="menu-nav-btn" text="📖 History" />
          <ui:Button name="menu-btn-help" class="menu-nav-btn" text="❓ Help" />
          <ui:VisualElement style="flex-grow: 1;" />
          <ui:Button name="menu-btn-restart" class="menu-nav-btn" style="border-color: rgba(0, 188, 212, 0.3);" text="↺ Restart" />
          <ui:Button name="menu-btn-quit" class="menu-nav-btn menu-nav-btn--quit" text="⏻ Quit" />
        </ui:VisualElement>

        <!-- Right Panels Area -->
        <ui:VisualElement name="game-menu-content" style="flex-grow: 1; min-width: 0; padding-left: 24px; position: relative;">
          
          <!-- SAVE / LOAD TAB CONTENT -->
          <ui:VisualElement name="menu-panel-save-load" style="flex-grow: 1; display: none; flex-direction: column;">
            <ui:Label name="save-load-subtitle" class="menu-panel-subtitle" text="Page 1" />
            
            <!-- Slots grid (6 items: 3 columns x 2 rows) -->
            <ui:VisualElement class="slots-grid" style="flex-grow: 1; flex-direction: row; flex-wrap: wrap; align-content: flex-start; justify-content: space-between; gap: 16px; min-height: 0; margin-bottom: 12px;">
              
              <!-- Slot 1 -->
              <ui:Button name="save-slot-1" class="save-slot-card">
                <ui:VisualElement name="save-slot-1-thumb" class="save-slot-thumbnail">
                  <ui:Label text="Empty Slot" class="save-slot-empty-label" />
                </ui:VisualElement>
                <ui:VisualElement class="save-slot-meta">
                  <ui:Label text="Slot 1" class="save-slot-num-label" />
                  <ui:Label text="No Save Data" name="save-slot-1-info" class="save-slot-info-label" />
                </ui:VisualElement>
              </ui:Button>

              <!-- Slot 2 -->
              <ui:Button name="save-slot-2" class="save-slot-card">
                <ui:VisualElement name="save-slot-2-thumb" class="save-slot-thumbnail">
                  <ui:Label text="Empty Slot" class="save-slot-empty-label" />
                </ui:VisualElement>
                <ui:VisualElement class="save-slot-meta">
                  <ui:Label text="Slot 2" class="save-slot-num-label" />
                  <ui:Label text="No Save Data" name="save-slot-2-info" class="save-slot-info-label" />
                </ui:VisualElement>
              </ui:Button>

              <!-- Slot 3 -->
              <ui:Button name="save-slot-3" class="save-slot-card">
                <ui:VisualElement name="save-slot-3-thumb" class="save-slot-thumbnail">
                  <ui:Label text="Empty Slot" class="save-slot-empty-label" />
                </ui:VisualElement>
                <ui:VisualElement class="save-slot-meta">
                  <ui:Label text="Slot 3" class="save-slot-num-label" />
                  <ui:Label text="No Save Data" name="save-slot-3-info" class="save-slot-info-label" />
                </ui:VisualElement>
              </ui:Button>

              <!-- Slot 4 -->
              <ui:Button name="save-slot-4" class="save-slot-card">
                <ui:VisualElement name="save-slot-4-thumb" class="save-slot-thumbnail">
                  <ui:Label text="Empty Slot" class="save-slot-empty-label" />
                </ui:VisualElement>
                <ui:VisualElement class="save-slot-meta">
                  <ui:Label text="Slot 4" class="save-slot-num-label" />
                  <ui:Label text="No Save Data" name="save-slot-4-info" class="save-slot-info-label" />
                </ui:VisualElement>
              </ui:Button>

              <!-- Slot 5 -->
              <ui:Button name="save-slot-5" class="save-slot-card">
                <ui:VisualElement name="save-slot-5-thumb" class="save-slot-thumbnail">
                  <ui:Label text="Empty Slot" class="save-slot-empty-label" />
                </ui:VisualElement>
                <ui:VisualElement class="save-slot-meta">
                  <ui:Label text="Slot 5" class="save-slot-num-label" />
                  <ui:Label text="No Save Data" name="save-slot-5-info" class="save-slot-info-label" />
                </ui:VisualElement>
              </ui:Button>

              <!-- Slot 6 -->
              <ui:Button name="save-slot-6" class="save-slot-card">
                <ui:VisualElement name="save-slot-6-thumb" class="save-slot-thumbnail">
                  <ui:Label text="Empty Slot" class="save-slot-empty-label" />
                </ui:VisualElement>
                <ui:VisualElement class="save-slot-meta">
                  <ui:Label text="Slot 6" class="save-slot-num-label" />
                  <ui:Label text="No Save Data" name="save-slot-6-info" class="save-slot-info-label" />
                </ui:VisualElement>
              </ui:Button>

            </ui:VisualElement>

            <!-- Ren'Py Page Navigation footer strip -->
            <ui:VisualElement class="pagination-container" style="flex-direction: row; justify-content: center; align-items: center; column-gap: 12px; margin-top: auto; padding-top: 8px; border-top-width: 1px; border-color: rgba(255, 255, 255, 0.05);">
              <ui:Button name="page-prev-btn" class="pagination-btn" text="◀" />
              <ui:VisualElement name="pagination-pages" style="flex-direction: row; column-gap: 8px;">
                <ui:Button name="page-btn-1" class="pagination-btn pagination-btn--active" text="1" />
                <ui:Button name="page-btn-2" class="pagination-btn" text="2" />
                <ui:Button name="page-btn-3" class="pagination-btn" text="3" />
                <ui:Button name="page-btn-4" class="pagination-btn" text="4" />
                <ui:Button name="page-btn-5" class="pagination-btn" text="5" />
              </ui:VisualElement>
              <ui:Button name="page-next-btn" class="pagination-btn" text="▶" />
            </ui:VisualElement>
          </ui:VisualElement>

          <!-- SETTINGS TAB CONTENT -->
          <ui:VisualElement name="menu-panel-settings" style="flex-grow: 1; display: none; flex-direction: column; row-gap: 16px; max-width: 520px;">
            <ui:Label class="menu-panel-subtitle" text="Preferences" />
            
            <ui:ScrollView style="flex-grow: 1;">
              <ui:VisualElement style="padding: 10px; row-gap: 16px;">
                <!-- Screen Mode Toggle -->
                <ui:VisualElement class="settings-row" style="flex-direction: row; justify-content: space-between; align-items: center;">
                  <ui:Label class="settings-label" text="Screen Mode" style="font-size: 14px; color: #ffffff;" />
                  <ui:Button name="fullscreen-toggle-btn" class="settings-toggle-btn" style="width: 180px;" text="Fullscreen" />
                </ui:VisualElement>

                <!-- Text Size Toggle -->
                <ui:VisualElement class="settings-row" style="flex-direction: row; justify-content: space-between; align-items: center;">
                  <ui:Label class="settings-label" text="Text Size" style="font-size: 14px; color: #ffffff;" />
                  <ui:Button name="font-size-toggle-btn" class="settings-toggle-btn" style="width: 180px;" text="Text: Normal" />
                </ui:VisualElement>


                <!-- Typewriter reveal toggle -->
                <ui:VisualElement class="settings-row" style="flex-direction: row; justify-content: space-between; align-items: center;">
                  <ui:Label class="settings-label" text="Text Scrolling" style="font-size: 14px; color: #ffffff;" />
                  <ui:Button name="typewriter-toggle-btn" class="settings-toggle-btn" style="width: 180px;" text="Typewriter ON" />
                </ui:VisualElement>

                <!-- Typewriter Speed Slider -->
                <ui:VisualElement class="settings-row" style="flex-direction: row; justify-content: space-between; align-items: center;">
                  <ui:Label class="settings-label" text="Text Speed" style="font-size: 14px; color: #ffffff;" />
                  <ui:Slider name="typewriter-speed-slider" class="settings-slider" style="width: 180px;" low-value="0.05" high-value="0.0001" value="0.018" />
                </ui:VisualElement>

                <!-- Master Volume Slider -->
                <ui:VisualElement class="settings-row" style="flex-direction: row; justify-content: space-between; align-items: center;">
                  <ui:Label class="settings-label" text="Master Volume" style="font-size: 14px; color: #ffffff;" />
                  <ui:SliderInt name="volume-slider" class="settings-slider" style="width: 180px;" low-value="0" high-value="100" value="100" />
                </ui:VisualElement>

                <!-- Developer & Support Links Section -->
                <ui:VisualElement name="menu-promo-links-section" style="margin-top: 16px; border-top-width: 1px; border-color: rgba(255, 255, 255, 0.15); padding-top: 12px; flex-direction: column; row-gap: 8px;">
                  <ui:Label text="Support &amp; Community Links" style="font-size: 13px; font-weight: bold; color: #00bcd4;" />
                  <ui:VisualElement name="menu-promo-links-container" style="flex-direction: row; flex-wrap: wrap; gap: 8px;" />
                </ui:VisualElement>
              </ui:VisualElement>
            </ui:ScrollView>

            <!-- Engine Credit Watermark Footer (Pinned at Bottom Footer) -->
            <ui:VisualElement name="menu-engine-credits-footer" style="margin-top: auto; padding-top: 12px; border-top-width: 1px; border-color: rgba(255, 255, 255, 0.1); align-items: center; justify-content: center; width: 100%;">
              <ui:Button name="ragnext-engine-credit-btn" style="background-color: rgba(192, 132, 252, 0.12); border-color: rgba(192, 132, 252, 0.3); border-width: 1px; border-radius: 4px; color: #c084fc; font-size: 12px; font-weight: bold; padding: 6px 14px; margin: 4px 0;" text="⚡ Built with RagNext Studio • RagNext.com" />
            </ui:VisualElement>
          </ui:VisualElement>

          <!-- HISTORY LOG TAB CONTENT -->
          <ui:VisualElement name="menu-panel-history" style="flex-grow: 1; display: none; flex-direction: column;">
            <ui:Label class="menu-panel-subtitle" text="Dialogue Log" />
            <ui:ScrollView name="history-log-scroll" class="narrative-scroll" style="flex-grow: 1; border-width: 1px; border-color: rgba(255, 255, 255, 0.1); padding: 12px; border-radius: 8px;" vertical-scroller-visibility="AlwaysVisible" horizontal-scroller-visibility="Hidden" />
          </ui:VisualElement>

          <!-- HELP TAB CONTENT -->
          <ui:VisualElement name="menu-panel-help" style="flex-grow: 1; display: none; flex-direction: column;">
            <ui:Label class="menu-panel-subtitle" text="Controls Guide" />
            <ui:ScrollView style="flex-grow: 1; border-width: 1px; border-color: rgba(255, 255, 255, 0.1); padding: 12px; border-radius: 8px;" vertical-scroller-visibility="AlwaysVisible" horizontal-scroller-visibility="Hidden">
              <ui:VisualElement style="flex-direction: column; row-gap: 8px; padding: 10px;">
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.15); padding-bottom: 4px; margin-bottom: 4px;">
                  <ui:Label text="Action / Exit" style="font-weight: bold; color: #00bcd4; font-size: 13px;" />
                  <ui:Label text="Keyboard Key" style="font-weight: bold; color: #00bcd4; font-size: 13px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                  <ui:Label text="North / Forward" style="color: #ffffff; font-size: 12px;" />
                  <ui:Label text="W / UpArrow / Numpad 8" style="color: #b0bec5; font-size: 12px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                  <ui:Label text="South / Backward" style="color: #ffffff; font-size: 12px;" />
                  <ui:Label text="S / DownArrow / Numpad 2" style="color: #b0bec5; font-size: 12px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                  <ui:Label text="East / Right" style="color: #ffffff; font-size: 12px;" />
                  <ui:Label text="D / RightArrow / Numpad 6" style="color: #b0bec5; font-size: 12px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                  <ui:Label text="West / Left" style="color: #ffffff; font-size: 12px;" />
                  <ui:Label text="A / LeftArrow / Numpad 4" style="color: #b0bec5; font-size: 12px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                  <ui:Label text="North West" style="color: #ffffff; font-size: 12px;" />
                  <ui:Label text="Numpad 7" style="color: #b0bec5; font-size: 12px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                  <ui:Label text="North East" style="color: #ffffff; font-size: 12px;" />
                  <ui:Label text="Numpad 9" style="color: #b0bec5; font-size: 12px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                  <ui:Label text="South West" style="color: #ffffff; font-size: 12px;" />
                  <ui:Label text="Numpad 1" style="color: #b0bec5; font-size: 12px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                  <ui:Label text="South East" style="color: #ffffff; font-size: 12px;" />
                  <ui:Label text="Numpad 3" style="color: #b0bec5; font-size: 12px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                  <ui:Label text="Up" style="color: #ffffff; font-size: 12px;" />
                  <ui:Label text="E / PageUp" style="color: #b0bec5; font-size: 12px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                  <ui:Label text="Down" style="color: #ffffff; font-size: 12px;" />
                  <ui:Label text="Q / PageDown" style="color: #b0bec5; font-size: 12px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                  <ui:Label text="In" style="color: #ffffff; font-size: 12px;" />
                  <ui:Label text="I" style="color: #b0bec5; font-size: 12px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                  <ui:Label text="Out" style="color: #ffffff; font-size: 12px;" />
                  <ui:Label text="O" style="color: #b0bec5; font-size: 12px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; border-top-width: 1px; border-color: rgba(255, 255, 255, 0.1); padding-top: 8px; margin-top: 4px;">
                  <ui:Label text="Toggle Menu" style="color: #ffffff; font-size: 12px; font-weight: bold;" />
                  <ui:Label text="Escape (Esc)" style="color: #00bcd4; font-size: 12px; font-weight: bold;" />
                </ui:VisualElement>
              </ui:VisualElement>
            </ui:ScrollView>
          </ui:VisualElement>

        </ui:VisualElement>

      </ui:VisualElement>
    </ui:VisualElement>

    <!-- Full screen dark scrim backdrop for popup modals -->
    <ui:VisualElement name="prompt-modal-backdrop" style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(6, 8, 14, 0.75); display: none; z-index: 450;" />

    <!-- ══ PLAYER PROMPT INPUT POPUP (hidden by default) ══════════════════ -->
    <ui:VisualElement name="prompt-input-menu" class="popup-modal-card settings-menu" style="display: none;">
      <ui:Label name="prompt-input-title" class="settings-menu-title" text="Input Required" />
      <ui:Label name="prompt-input-message" class="prompt-input-message" text="Please provide input:" />
      
      <!-- Text input container -->
      <ui:VisualElement name="prompt-text-container" style="flex-direction: row; align-items: center; margin-top: 8px; margin-bottom: 4px;">
        <ui:TextField name="prompt-text-field" style="flex-grow: 1;" />
      </ui:VisualElement>
      
      <!-- Selection list container (for Objects, Characters, and Custom list selection buttons) -->
      <ui:ScrollView name="prompt-selection-scroll" style="max-height: 150px; margin-top: 8px; display: none;" />
      
      <!-- Submit / Close options -->
      <ui:Button name="prompt-submit-btn" class="settings-toggle-btn" style="margin-top: 12px; width: auto;" text="✔ Submit" />
    </ui:VisualElement>

    <!-- ══ GAME OVER POPUP (hidden by default) ═══════════════════════════ -->
    <ui:VisualElement name="game-over-menu" class="popup-modal-card" style="display: none;">
      <ui:Label name="game-over-title" class="settings-menu-title" text="Game Over" />
      <ui:Label name="game-over-message" class="game-over-message" text="The game has ended." />
      
      <!-- Buttons container -->
      <ui:VisualElement style="margin-top: 12px; flex-direction: column;">
        <ui:Button name="game-over-restart-btn" class="prompt-choice-btn" style="margin-top: 4px; width: 100%;" text="↺ Restart" />
        <ui:Button name="game-over-load-btn" class="prompt-choice-btn" style="margin-top: 4px; width: 100%;" text="📂 Load Game" />
        <ui:Button name="game-over-exit-btn" class="prompt-choice-btn" style="margin-top: 4px; width: 100%;" text="⏻ Exit" />
      </ui:VisualElement>
    </ui:VisualElement>

    <!-- ══ SPLASH SCREEN OVERLAY ═════════════════════════════════════════════ -->
    <ui:VisualElement name="splash-screen" class="splash-screen">
      <ui:VisualElement class="splash-badge">
        <ui:Label class="splash-badge-text" text="RN" />
      </ui:VisualElement>
      <ui:Label class="splash-title" text="RAGNEXT" />
      <ui:Label class="splash-subtitle" text="PREMIUM STORY ENGINE &amp; RPG PLAYER" />
    </ui:VisualElement>

  </ui:VisualElement>
</ui:UXML>
