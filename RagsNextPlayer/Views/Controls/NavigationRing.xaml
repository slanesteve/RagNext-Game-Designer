<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RagsNextPlayer.Views.Controls.NavigationRing"
             x:Name="self">

    <ContentView.Resources>
        <ResourceDictionary>
            <!-- Inactive Exit Button Style: ghost/dim -->
            <Style x:Key="ExitInactiveStyle" TargetType="Border">
                <Setter Property="Stroke" Value="#252525" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Background" Value="#141414" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="Opacity" Value="0.18" />
            </Style>

            <!-- Active Exit Button Style: glowing cyan ring -->
            <Style x:Key="ExitActiveStyle" TargetType="Border">
                <Setter Property="Stroke" Value="{StaticResource ExitActiveGlow}" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="Background" Value="#0D1F1A" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="WidthRequest" Value="44" />
                <Setter Property="Opacity" Value="1.0" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="{StaticResource ExitActiveGlow}" Offset="0,0" Radius="8" Opacity="0.5" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Direction abbreviation label -->
            <Style x:Key="ExitLabelStyle" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource GameTextPrimary}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- Active indicator dot color -->
            <Color x:Key="ActiveDotColor">#00FFAA</Color>
            <Color x:Key="InactiveDotColor">#222222</Color>
        </ResourceDictionary>
    </ContentView.Resources>

    <Border StrokeThickness="1"
            Stroke="#2D2D2D"
            Background="#161616"
            StrokeShape="RoundRectangle 16"
            Padding="10"
            WidthRequest="174"
            HeightRequest="174">

        <!-- 3x3 compass grid -->
        <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*,*" RowSpacing="6" ColumnSpacing="6">

            <!-- Row 0: Up | North | Down -->
            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                <Border x:Name="Btn_Up" Style="{StaticResource ExitInactiveStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDirectionTapped" CommandParameter="Up" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label Text="↑" Style="{StaticResource ExitLabelStyle}" />
                        <Ellipse x:Name="Dot_Up" WidthRequest="6" HeightRequest="6"
                                 Fill="{StaticResource InactiveDotColor}"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 Margin="0,4,4,0" />
                    </Grid>
                </Border>
                <Label Text="Up" FontSize="9" TextColor="#555" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                <Border x:Name="Btn_North" Style="{StaticResource ExitInactiveStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDirectionTapped" CommandParameter="North" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label Text="N" Style="{StaticResource ExitLabelStyle}" />
                        <Ellipse x:Name="Dot_North" WidthRequest="6" HeightRequest="6"
                                 Fill="{StaticResource InactiveDotColor}"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 Margin="0,4,4,0" />
                    </Grid>
                </Border>
                <Label Text="North" FontSize="9" TextColor="#555" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                <Border x:Name="Btn_Down" Style="{StaticResource ExitInactiveStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDirectionTapped" CommandParameter="Down" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label Text="↓" Style="{StaticResource ExitLabelStyle}" />
                        <Ellipse x:Name="Dot_Down" WidthRequest="6" HeightRequest="6"
                                 Fill="{StaticResource InactiveDotColor}"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 Margin="0,4,4,0" />
                    </Grid>
                </Border>
                <Label Text="Down" FontSize="9" TextColor="#555" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Row 1: West | Core | East -->
            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                <Border x:Name="Btn_West" Style="{StaticResource ExitInactiveStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDirectionTapped" CommandParameter="West" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label Text="W" Style="{StaticResource ExitLabelStyle}" />
                        <Ellipse x:Name="Dot_West" WidthRequest="6" HeightRequest="6"
                                 Fill="{StaticResource InactiveDotColor}"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 Margin="0,4,4,0" />
                    </Grid>
                </Border>
                <Label Text="West" FontSize="9" TextColor="#555" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Compass Core Pulse -->
            <Grid Grid.Row="1" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                <Ellipse x:Name="CorePulseRing"
                         WidthRequest="26" HeightRequest="26"
                         Stroke="{StaticResource AccentGlowBrush}"
                         StrokeThickness="1"
                         Fill="Transparent"
                         Opacity="0.4" />
                <Ellipse WidthRequest="14" HeightRequest="14"
                         Fill="{StaticResource AccentGlowBrush}"
                         HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout Grid.Row="1" Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                <Border x:Name="Btn_East" Style="{StaticResource ExitInactiveStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDirectionTapped" CommandParameter="East" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label Text="E" Style="{StaticResource ExitLabelStyle}" />
                        <Ellipse x:Name="Dot_East" WidthRequest="6" HeightRequest="6"
                                 Fill="{StaticResource InactiveDotColor}"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 Margin="0,4,4,0" />
                    </Grid>
                </Border>
                <Label Text="East" FontSize="9" TextColor="#555" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Row 2: In | South | Out -->
            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                <Border x:Name="Btn_In" Style="{StaticResource ExitInactiveStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDirectionTapped" CommandParameter="In" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label Text="⤵" Style="{StaticResource ExitLabelStyle}" FontSize="12" />
                        <Ellipse x:Name="Dot_In" WidthRequest="6" HeightRequest="6"
                                 Fill="{StaticResource InactiveDotColor}"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 Margin="0,4,4,0" />
                    </Grid>
                </Border>
                <Label Text="In" FontSize="9" TextColor="#555" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                <Border x:Name="Btn_South" Style="{StaticResource ExitInactiveStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDirectionTapped" CommandParameter="South" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label Text="S" Style="{StaticResource ExitLabelStyle}" />
                        <Ellipse x:Name="Dot_South" WidthRequest="6" HeightRequest="6"
                                 Fill="{StaticResource InactiveDotColor}"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 Margin="0,4,4,0" />
                    </Grid>
                </Border>
                <Label Text="South" FontSize="9" TextColor="#555" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="2" Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                <Border x:Name="Btn_Out" Style="{StaticResource ExitInactiveStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDirectionTapped" CommandParameter="Out" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label Text="⤴" Style="{StaticResource ExitLabelStyle}" FontSize="11" />
                        <Ellipse x:Name="Dot_Out" WidthRequest="6" HeightRequest="6"
                                 Fill="{StaticResource InactiveDotColor}"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 Margin="0,4,4,0" />
                    </Grid>
                </Border>
                <Label Text="Out" FontSize="9" TextColor="#555" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
