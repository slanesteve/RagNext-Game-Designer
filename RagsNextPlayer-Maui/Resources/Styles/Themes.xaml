<?xml version="1.0" encoding="utf-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Game Premium Colors -->
    <Color x:Key="GameBg">#121212</Color>
    <Color x:Key="CardBg">#1E1E1E</Color>
    <Color x:Key="CardHeaderBg">#262626</Color>
    <Color x:Key="AccentGlow">#8A2BE2</Color>
    <Color x:Key="GameTextPrimary">#FFFFFF</Color>
    <Color x:Key="GameTextSecondary">#A0A0A0</Color>
    <Color x:Key="ExitActiveGlow">#00FA9A</Color>
    <Color x:Key="ExitInactive">#333333</Color>
    <Color x:Key="LinkColor">#00BFFF</Color>
    <Color x:Key="GlassOverlay">#2A2A2A</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="GameBgBrush" Color="{StaticResource GameBg}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBg}" />
    <SolidColorBrush x:Key="CardHeaderBgBrush" Color="{StaticResource CardHeaderBg}" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="{StaticResource AccentGlow}" />
    <SolidColorBrush x:Key="GameTextPrimaryBrush" Color="{StaticResource GameTextPrimary}" />
    <SolidColorBrush x:Key="GameTextSecondaryBrush" Color="{StaticResource GameTextSecondary}" />
    <SolidColorBrush x:Key="ExitActiveGlowBrush" Color="{StaticResource ExitActiveGlow}" />
    <SolidColorBrush x:Key="ExitInactiveBrush" Color="{StaticResource ExitInactive}" />
    <SolidColorBrush x:Key="LinkColorBrush" Color="{StaticResource LinkColor}" />
    <SolidColorBrush x:Key="GlassOverlayBrush" Color="{StaticResource GlassOverlay}" />

    <!-- Card Styles -->
    <Style x:Key="GameCardStyle" TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="#2D2D2D" />
        <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Typography Styles -->
    <Style x:Key="TitleTextStyle" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource GameTextPrimary}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <Style x:Key="SubtitleTextStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource GameTextSecondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
    </Style>

    <Style x:Key="CardTitleTextStyle" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource AccentGlow}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="NarrativeBodyStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource GameTextPrimary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="1.4" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
    </Style>

</ResourceDictionary>
