<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RagsNextPlayer.Views.Controls"
             x:Class="RagsNextPlayer.MainPage"
             x:Name="self"
             BackgroundColor="{StaticResource GameBg}"
             SizeChanged="OnPageSizeChanged">

    <!-- Outer Layout Grid -->
    <Grid RowDefinitions="Auto, *, Auto" Padding="20">
        
        <!-- ROW 0: Room Header Title Banner -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,16">
            <VerticalStackLayout Grid.Column="0">
                <Label x:Name="RoomNameLabel" 
                       Text="Wheat Field" 
                       Style="{StaticResource TitleTextStyle}" />
                <Label x:Name="AuthorVersionLabel" 
                       Text="by Author - v1.0.0" 
                       Style="{StaticResource SubtitleTextStyle}" />
            </VerticalStackLayout>

            <!-- Room Actions chip: tap to trigger room-level actions -->
            <Border Grid.Column="1"
                    Stroke="#2A2A2A"
                    StrokeThickness="1"
                    Background="#1A1A1A"
                    StrokeShape="RoundRectangle 8"
                    Padding="10,6"
                    Margin="0,0,10,0"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRoomActionsChipTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6">
                    <Label Text="&#x2699;" TextColor="#555" FontSize="14" VerticalOptions="Center" />
                    <Label Text="Room" TextColor="#888" FontSize="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Standard Hub/Main Menu button -->
            <Button Grid.Column="2" 
                    Text="Games Hub" 
                    TextColor="#FFFFFF"
                    Background="#2A2A2A"
                    BorderColor="#3D3D3D"
                    BorderWidth="1"
                    CornerRadius="8"
                    HeightRequest="36"
                    Padding="12,0"
                    VerticalOptions="Center"
                    Clicked="OnGamesHubClicked" />
        </Grid>

        <!-- ROW 1: The Widescreen Main Narrative & Scene Artwork (60 / 40 Split) -->
        <Grid x:Name="TopGrid" Grid.Row="1" ColumnDefinitions="6*, 4*" ColumnSpacing="20" RowSpacing="20" Margin="0,0,0,16">
            
            <!-- Left Column: Narrative Console Card (Scrolling Adventure Log) -->
            <Border Grid.Column="0" Style="{StaticResource GameCardStyle}">
                <ScrollView x:Name="NarrativeScrollView">
                    <VerticalStackLayout x:Name="NarrativeLog" Spacing="8" Padding="4" />
                </ScrollView>
            </Border>

            <!-- Right Column: Scene Artwork Card -->
            <Border x:Name="ArtworkCard" Grid.Column="1" Style="{StaticResource GameCardStyle}" Padding="0">
                <Grid>
                    <!-- Fallback placeholder graphic -->
                    <Grid x:Name="ArtworkPlaceholder" BackgroundColor="#1A1A1A" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                        <Label Text="NO ACTIVE SIGNAL" 
                               TextColor="#333333" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                    </Grid>
                    
                    <Image x:Name="SceneArtworkImage" 
                           Aspect="AspectFill" 
                           HorizontalOptions="FillAndExpand" 
                           VerticalOptions="FillAndExpand" />
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 2: Bottom Control Console (Widescreen Grid vs Mobile Stack) -->
        <Grid Grid.Row="2">
            
            <!-- Desktop Widescreen Deck: 3 cards side-by-side -->
            <Grid x:Name="DesktopControlDeck" ColumnDefinitions="*, *, *" ColumnSpacing="20" RowSpacing="20" HeightRequest="210">
                
                <!-- Card 1: Player & Navigation Card -->
                <Border Grid.Column="0" Style="{StaticResource GameCardStyle}" Padding="12">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" RowSpacing="10">
                        <!-- Left: Character portrait and details -->
                        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" ColumnSpacing="4" RowSpacing="4">
                            <Label Text="Protagonist" Style="{StaticResource CardTitleTextStyle}" Grid.Row="0" Margin="0" />
                            
                            <Grid Grid.Row="1" ColumnDefinitions="Auto, *" ColumnSpacing="8" RowSpacing="8" Margin="0,4">
                        <!-- Player portrait — tap to view player actions -->
                                <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#2D2D2D" WidthRequest="64" HeightRequest="64" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPlayerPortraitTapped" />
                                    </Border.GestureRecognizers>
                                    <Image x:Name="PlayerPortraitImage" Aspect="AspectFill" Source="dotnet_bot.png" />
                                </Border>
                                
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label x:Name="PlayerNameLabel" Text="Steve" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14" />
                                    <Label x:Name="PlayerDetailsLabel" Text="Male" TextColor="{StaticResource GameTextSecondary}" FontSize="12" />
                                </VerticalStackLayout>
                            </Grid>
                            
                            <ProgressBar x:Name="PlayerHealthBar" Progress="1.0" ProgressColor="{StaticResource AccentGlow}" BackgroundColor="#2D2D2D" HeightRequest="4" Grid.Row="2" />
                        </Grid>
                        
                        <!-- Right: Sleeping Compass / Exit Ring -->
                        <controls:NavigationRing x:Name="DesktopCompass" Grid.Column="1" 
                                                 VerticalOptions="Center" HorizontalOptions="End" 
                                                 DirectionClickedCommand="{Binding MoveCommand, Source={x:Reference self}}" />
                    </Grid>
                </Border>

                <!-- Card 2: Environment Card (Room Objects & Characters) -->
                <Border Grid.Column="1" Style="{StaticResource GameCardStyle}" Padding="12">
                    <Grid RowDefinitions="Auto, *">
                        <Label Grid.Row="0" Text="Environment" Style="{StaticResource CardTitleTextStyle}" />
                        
                        <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="10" RowSpacing="10">
                            <!-- Objects List -->
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Objects" TextColor="{StaticResource GameTextSecondary}" FontSize="12" FontAttributes="Bold" />
                                <ScrollView HeightRequest="120">
                                    <VerticalStackLayout x:Name="RoomObjectsList" Spacing="4" />
                                </ScrollView>
                            </VerticalStackLayout>
                            
                            <!-- Characters List -->
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Characters" TextColor="{StaticResource GameTextSecondary}" FontSize="12" FontAttributes="Bold" />
                                <ScrollView HeightRequest="120">
                                    <VerticalStackLayout x:Name="RoomCharactersList" Spacing="4" />
                                </ScrollView>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Card 3: Inventory Card -->
                <Border Grid.Column="2" Style="{StaticResource GameCardStyle}" Padding="12">
                    <Grid RowDefinitions="Auto, *">
                        <Label Grid.Row="0" Text="Inventory" Style="{StaticResource CardTitleTextStyle}" />
                        <ScrollView Grid.Row="1" HeightRequest="140">
                            <VerticalStackLayout x:Name="PlayerInventoryList" Spacing="4" />
                        </ScrollView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Mobile Tabbed Deck: Concentrated Stack with Tab Selectors -->
            <Grid x:Name="MobileControlDeck" RowDefinitions="Auto, *" HeightRequest="210" IsVisible="False">
                
                <!-- Tab Headers -->
                <Grid Grid.Row="0" ColumnDefinitions="*, *, *" Margin="0,0,0,8" HeightRequest="36">
                    <Button x:Name="TabBtn_Compass" Grid.Column="0" Text="Exits" TextColor="#FFFFFF" Background="#262626" CornerRadius="6" Margin="2" Clicked="OnMobileTabClicked" CommandParameter="Compass" />
                    <Button x:Name="TabBtn_Room" Grid.Column="1" Text="Room" TextColor="#A0A0A0" Background="#1A1A1A" CornerRadius="6" Margin="2" Clicked="OnMobileTabClicked" CommandParameter="Room" />
                    <Button x:Name="TabBtn_Inv" Grid.Column="2" Text="Inventory" TextColor="#A0A0A0" Background="#1A1A1A" CornerRadius="6" Margin="2" Clicked="OnMobileTabClicked" CommandParameter="Inventory" />
                </Grid>

                <!-- Tab Card Containers -->
                <Grid Grid.Row="1">
                    <!-- Tab 1: Navigation panel -->
                    <Border x:Name="MobileCard_Compass" Style="{StaticResource GameCardStyle}" Padding="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label x:Name="MobPlayerNameLabel" Text="Protagonist" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14" />
                                <Label x:Name="MobPlayerDetailsLabel" Text="Male" TextColor="{StaticResource GameTextSecondary}" FontSize="12" />
                            </VerticalStackLayout>
                            <controls:NavigationRing x:Name="MobileCompass" Grid.Column="1" 
                                                     VerticalOptions="Center" HorizontalOptions="End"
                                                     DirectionClickedCommand="{Binding MoveCommand, Source={x:Reference self}}" />
                        </Grid>
                    </Border>

                    <!-- Tab 2: Environment Objects & Characters panel -->
                    <Border x:Name="MobileCard_Room" Style="{StaticResource GameCardStyle}" Padding="12" IsVisible="False">
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="8" RowSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Objects" TextColor="{StaticResource GameTextSecondary}" FontSize="12" FontAttributes="Bold" />
                                <ScrollView HeightRequest="100">
                                    <VerticalStackLayout x:Name="MobRoomObjectsList" Spacing="4" />
                                </ScrollView>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Characters" TextColor="{StaticResource GameTextSecondary}" FontSize="12" FontAttributes="Bold" />
                                <ScrollView HeightRequest="100">
                                    <VerticalStackLayout x:Name="MobRoomCharactersList" Spacing="4" />
                                </ScrollView>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Tab 3: Inventory panel -->
                    <Border x:Name="MobileCard_Inv" Style="{StaticResource GameCardStyle}" Padding="12" IsVisible="False">
                        <Grid RowDefinitions="Auto, *">
                            <Label Grid.Row="0" Text="Carrying" TextColor="{StaticResource GameTextSecondary}" FontSize="12" FontAttributes="Bold" />
                            <ScrollView Grid.Row="1" HeightRequest="100">
                                <VerticalStackLayout x:Name="MobPlayerInventoryList" Spacing="4" />
                            </ScrollView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
