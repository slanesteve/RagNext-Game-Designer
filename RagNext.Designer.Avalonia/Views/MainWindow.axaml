<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RagNext.Designer.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.WebView"
        xmlns:models="using:RagsCore.Models"
        xmlns:views="using:RagNext.Designer.Avalonia.Views"
        xmlns:services="using:RagNext.Designer.Avalonia.Services"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
        x:Class="RagNext.Designer.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/ragnext-logo.png"
        Title="RagNext Studio"
        Background="{DynamicResource MainBg}"
        Foreground="{DynamicResource TextNormal}"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid Background="{DynamicResource CirclesPatternBrush}">
        <!-- Background decorative ambient glow -->
        <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False" Opacity="0.1">
            <Ellipse Width="600" Height="600" Fill="#8E2DE2" Canvas.Left="-100" Canvas.Top="-100" Margin="0" />
            <Ellipse Width="500" Height="500" Fill="#4A00E0" Canvas.Right="-100" Canvas.Bottom="-100" Margin="0" />
        </Canvas>

        <!-- Main Workspace Shell -->
        <Grid ColumnDefinitions="240,*,Auto" RowDefinitions="Auto,*">
            
            <!-- Top Action Header -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Height="54" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                     <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Branding Box -->
                        <Border CornerRadius="4" Width="28" Height="28">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Color="#8E2DE2" Offset="0.0"/>
                                    <GradientStop Color="#4A00E0" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="RN" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="RAGNEXT WORKSPACE" FontSize="14" FontWeight="Bold" LetterSpacing="1" Foreground="{DynamicResource TextNormal}" VerticalAlignment="Center"/>
                        
                        <!-- Manual Load / Launcher Button -->
                        <Button Content="📂 Launcher" Command="{Binding ShowLauncherCommand}" FontSize="12" Background="{DynamicResource ToolbarBtnBg}" Foreground="#A29BFE" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="10,0,0,0"/>

                        <!-- Help Menu -->
                        <Menu Background="Transparent" VerticalAlignment="Center" Margin="10,0,0,0">
                            <MenuItem Header="Help" Foreground="{DynamicResource TextNormal}">
                                <MenuItem Header="View Documentation" Click="OnInstructionsClicked"/>
                                <MenuItem Header="Report an Issue" Click="OnReportIssueClicked"/>
                                <Separator/>
                                <MenuItem Header="About RagNext" Click="OnAboutClicked"/>
                            </MenuItem>
                        </Menu>
                    </StackPanel>

                    <!-- Active Project Status -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasGame}">
                        <TextBlock Text="Project:" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Text="{Binding GameTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextNormal}" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Text="v" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" FontSize="12" Margin="4,0,-4,0"/>
                        <TextBlock Text="{Binding GameVersion}" Foreground="#8E2DE2" FontWeight="Bold" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>

                    <!-- Quick Tools -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding HasGame}">
                        <!-- Save Status Indicator -->
                        <Border Background="{DynamicResource ToolbarBtnBg}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" CornerRadius="4" Padding="8,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="#FFC107" VerticalAlignment="Center" IsVisible="{Binding IsSaving}"/>
                                <Ellipse Width="8" Height="8" Fill="#2ECC71" VerticalAlignment="Center" IsVisible="{Binding !IsSaving}"/>
                                <TextBlock Text="{Binding SaveStatusText}" FontSize="11" Foreground="{DynamicResource TextNormal}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Content="🚀 Publish Game" Command="{Binding NavigateCommand}" CommandParameter="Publish" FontSize="12" Foreground="White" FontWeight="Bold" CornerRadius="4" Padding="12,6">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Color="#8E2DE2" Offset="0.0"/>
                                    <GradientStop Color="#4A00E0" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Left Sidebar Navigation -->
            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid RowDefinitions="*">
            <!-- Nav Tabs -->
            <StackPanel Grid.Row="0" Spacing="6" IsEnabled="{Binding HasGame}">
            <TextBlock Text="DESIGNER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="8,0,0,8" LetterSpacing="1"/>
            
            <Button Classes="nav" Content="🏠 Project Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Dashboard, Converter={x:Static ObjectConverters.Equal}}"/>
            <Button Classes="nav" Content="👤 Player &amp; Start Config" Command="{Binding NavigateCommand}" CommandParameter="Player" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Player, Converter={x:Static ObjectConverters.Equal}}"/>
            <Button Classes="nav" Content="🚪 Rooms Editor" Command="{Binding NavigateCommand}" CommandParameter="Rooms" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Rooms, Converter={x:Static ObjectConverters.Equal}}"/>
            <Button Classes="nav" Content="👥 Characters Database" Command="{Binding NavigateCommand}" CommandParameter="Characters" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Characters, Converter={x:Static ObjectConverters.Equal}}"/>
            <Button Classes="nav" Content="📦 Game Objects &amp; Items" Command="{Binding NavigateCommand}" CommandParameter="Objects" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Objects, Converter={x:Static ObjectConverters.Equal}}"/>
            <Button Classes="nav" Content="📊 Global Variables" Command="{Binding NavigateCommand}" CommandParameter="Variables" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Variables, Converter={x:Static ObjectConverters.Equal}}"/>
            <Button Classes="nav" Content="⏱️ System Timers" Command="{Binding NavigateCommand}" CommandParameter="Timers" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Timers, Converter={x:Static ObjectConverters.Equal}}"/>
            <Button Classes="nav" Content="📜 Global Functions" Command="{Binding NavigateCommand}" CommandParameter="Functions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Functions, Converter={x:Static ObjectConverters.Equal}}"/>
            <Button Classes="nav" Content="🎨 Splash Screen" Command="{Binding NavigateCommand}" CommandParameter="SplashScreen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=SplashScreen, Converter={x:Static ObjectConverters.Equal}}"/>
            <Button Classes="nav" Content="🎨 HUD Theme Editor" Command="{Binding NavigateCommand}" CommandParameter="Theme" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Theme, Converter={x:Static ObjectConverters.Equal}}"/>
            <Button Classes="nav" Content="📊 Status Elements" Command="{Binding NavigateCommand}" CommandParameter="StatusBar" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=StatusBar, Converter={x:Static ObjectConverters.Equal}}"/>
            <Button Classes="nav" Content="📂 Media Asset Library" Command="{Binding NavigateCommand}" CommandParameter="Media" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Media, Converter={x:Static ObjectConverters.Equal}}"/>
            <Button Classes="nav" Content="🛠️ Action Library" Command="{Binding NavigateCommand}" CommandParameter="ActionLibrary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=ActionLibrary, Converter={x:Static ObjectConverters.Equal}}"/>
            
            <TextBlock Text="DIAGNOSTICS &amp; DISTRIBUTION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="8,16,0,8" LetterSpacing="1"/>
            <Button Classes="nav" Content="🔍 Validation Engine" Command="{Binding NavigateCommand}" CommandParameter="Validation" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Validation, Converter={x:Static ObjectConverters.Equal}}"/>
            <Button Classes="nav" Content="🚀 Publisher" Command="{Binding NavigateCommand}" CommandParameter="Publish" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Publish, Converter={x:Static ObjectConverters.Equal}}"/>
            <Button Classes="nav" Content="⚙️ Workspace Preferences" Command="{Binding NavigateCommand}" CommandParameter="Preferences" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Preferences, Converter={x:Static ObjectConverters.Equal}}"/>
            </StackPanel>
            </Grid>
            </ScrollViewer>
            </Border>

            <!-- Main Workstation Canvas -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="24">
                
                <!-- 1. Dashboard View -->
                <ScrollViewer IsVisible="{Binding ActiveView, ConverterParameter=Dashboard, Converter={x:Static ObjectConverters.Equal}}">
                    <StackPanel Spacing="24" HorizontalAlignment="Stretch">
                        <TextBlock Text="Project Dashboard" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextNormal}"/>
                        
                        <!-- Metadata Card -->
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="📝 Story Metadata" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2" Margin="0,0,0,4"/>
                                
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="140,*">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Game Title:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding GameTitle, Mode=TwoWay}" PlaceholderText="Name of your RPG / Interactive Fiction" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"/>
                                    
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Author:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GameAuthor, Mode=TwoWay}" PlaceholderText="Author or Studio" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"/>
                                    
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Version:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GameVersion, Mode=TwoWay}" PlaceholderText="e.g. 1.0.0" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="140,12,0,0">
                                    <Button Content="📦 Export Design Package (.ragnext)" Command="{Binding ExportPackageCommand}" Background="#8E2DE2" Foreground="White" FontWeight="Bold" CornerRadius="4" Padding="12,8"/>
                                    <Button Content="📥 Import Design Package (.ragnext)" Command="{Binding ImportPackageCommand}" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Wear Slots Management Card -->
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="👕 Wear Slots Settings" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2" Margin="0,0,0,4"/>
                                <TextBlock Text="Define the slots where wearable items can be worn. Only one item can occupy a slot at any time." Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" Margin="0,4,0,0" RowSpacing="12" ColumnSpacing="8">
                                    <ListBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding CurrentGame.WearSlots}" x:Name="WearSlotsListBox" Height="120" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"/>
                                    
                                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="NewWearSlotTextBox" PlaceholderText="New Slot Name (e.g. Head, Hands)" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Content="+ Add" Click="OnAddWearSlotClicked" Background="#8E2DE2" Foreground="White"/>
                                        <Button Content="Delete" Click="OnDeleteWearSlotClicked" Background="#C0392B" Foreground="White"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Project Statistics -->
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="📊 World Overview" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2" Margin="0,0,0,4"/>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                    <Border Background="{DynamicResource InputBg}" CornerRadius="6" Padding="16" Width="170" Margin="0,0,12,12">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🚪 Rooms" Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Rooms.Rooms.Count}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource InputBg}" CornerRadius="6" Padding="16" Width="170" Margin="0,0,12,12">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="👥 Characters" Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Characters.Characters.Count}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource InputBg}" CornerRadius="6" Padding="16" Width="170" Margin="0,0,12,12">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="📦 Game Objects" Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Objects.Objects.Count}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource InputBg}" CornerRadius="6" Padding="16" Width="170" Margin="0,0,12,12">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="📊 Variables" Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Variables.Variables.Count}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 1b. Player & Start Config Tab -->
                <ScrollViewer x:Name="PlayerDetailsScrollViewer" IsVisible="{Binding ActiveView, ConverterParameter=Player, Converter={x:Static ObjectConverters.Equal}}">
                    <StackPanel Spacing="24" HorizontalAlignment="Stretch" DataContext="{Binding Player}" x:DataType="models:Player">
                        <TextBlock Text="Player &amp; Start Config" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextNormal}"/>
                        
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="👤 Protagonist Identity" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="140,*" RowSpacing="12" Margin="0,10,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Protagonist Name:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                                    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" Padding="8,6"/>
                                        <Button Grid.Column="1" Content="✨" Click="OnCoAuthorNameClicked" Margin="8,0,0,0" Width="36" Height="34" Background="#8E2DE2" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                    </Grid>
                                    
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" VerticalAlignment="Top" Margin="0,6,0,0" Foreground="{DynamicResource TextMuted}"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                         <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                             <Button Classes="toolbar-btn" Content="B" FontWeight="Bold" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="11" Click="OnComposeBoldClicked"/>
                                             <Button Classes="toolbar-btn" Content="/" FontStyle="Italic" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="11" Click="OnComposeItalicClicked"/>
                                             <Button Classes="toolbar-btn" Content="U" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="11" Click="OnComposeUnderlineClicked"/>
                                             <Button Classes="toolbar-btn" Height="28" Padding="8,0">
                                                 <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                     <TextBlock Text="🎨" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" FontSize="11"/>
                                                     <TextBlock Text="Color" VerticalAlignment="Center" FontSize="11"/>
                                                 </StackPanel>
                                                 <Button.Flyout>
                                                     <Flyout>
                                                         <StackPanel Spacing="6" Width="200">
                                                             <ColorPicker Color="#FFFFFF" Margin="0" HorizontalAlignment="Center"/>
                                                             <Button Content="Apply" Click="OnInlineColorPickerApply" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#8E2DE2" Foreground="White" FontWeight="Bold"/>
                                                         </StackPanel>
                                                     </Flyout>
                                                 </Button.Flyout>
                                             </Button>
                                             <Button Classes="toolbar-btn" Height="28" Padding="8,0">
                                                 <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                     <TextBlock Text="🖊️" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" FontSize="11"/>
                                                     <TextBlock Text="Highlight" VerticalAlignment="Center" FontSize="11"/>
                                                 </StackPanel>
                                                 <Button.Flyout>
                                                     <Flyout>
                                                         <StackPanel Spacing="6" Width="200">
                                                             <ColorPicker Color="#EF4444" Margin="0" HorizontalAlignment="Center"/>
                                                             <Button Content="Apply" Click="OnInlineHighlightPickerApply" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#8E2DE2" Foreground="White" FontWeight="Bold"/>
                                                         </StackPanel>
                                                     </Flyout>
                                                 </Button.Flyout>
                                             </Button>
                                             <Button Classes="toolbar-btn" Content="Clear" Height="28" Foreground="{DynamicResource TextMuted}" FontSize="11" Padding="8,0" Click="OnComposeClearClicked"/>
                                             <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenComposeCommand}" CommandParameter="{Binding}" Height="28" Background="#8E2DE2" Foreground="White" Padding="10,0" Margin="10,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                 <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                     <TextBlock Text="📝" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" FontSize="11"/>
                                                     <TextBlock Text="Compose Description" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                                                 </StackPanel>
                                             </Button>
                                         </StackPanel>
                                         <Grid ColumnDefinitions="*,Auto">
                                             <TextBox x:Name="PlayerDescriptionTextBox" Grid.Column="0" Text="{Binding Description, Mode=TwoWay}" AcceptsReturn="True" Height="160" VerticalContentAlignment="Top" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" TextWrapping="Wrap"/>
                                             <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                                 <Button Classes="toolbar-btn" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenComposeCommand}" CommandParameter="{Binding}" Width="36" Height="32" ToolTip.Tip="Open Composer Popup" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                     <TextBlock Text="📝" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                 </Button>
                                                 <Button Content="✨" Click="OnCoAuthorDescriptionClicked" Width="36" Height="32" Background="#8E2DE2" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                             </StackPanel>
                                         </Grid>
                                    </StackPanel>
                                    
                                    <!-- Gender Combo -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Gender:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Starting Room:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                                    <ComboBox x:Name="StartingRoomComboBox" Grid.Row="3" Grid.Column="1" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" SelectedItem="{Binding StartingRoom, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:Room">
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <!-- Portrait Media Panel -->
                                <TextBlock Text="Portrait Media Artwork" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" DragDrop.AllowDrop="True" DragDrop.Drop="OnDragDropFile" Tag="Player">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Width="88" Height="88" Background="#0C0C12" CornerRadius="6" ClipToBounds="True">
                                            <Image Source="{Binding PortraitImagePath, Converter={x:Static views:ImagePathToBitmapConverter.Instance}}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PortraitImageFileName, FallbackValue='No Portrait Image set'}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Clear Image" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ClearPortraitCommand}" CommandParameter="{Binding}" Background="#C0392B" Foreground="White" FontSize="11" Padding="8,4"/>
                                                <Button Content="✨ Generate with AI..." Click="OnGeneratePortraitClicked" Tag="Player" Background="#8E2DE2" Foreground="White" FontSize="11" Padding="10,4"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Player Inventory Management Card -->
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="🎒 Starting Inventory" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                                        <TextBlock Text="Items that the player possesses at the beginning of the story" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="➕ Add Item" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TriggerAddInventoryCommand}" CommandParameter="{Binding}" Background="#8E2DE2" Foreground="White" CornerRadius="4" Padding="10,6" FontSize="12"/>
                                </Grid>

                                <ListBox ItemsSource="{Binding Inventory}" Height="120" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:GameObject">
                                            <Grid ColumnDefinitions="*,Auto" Height="36">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="📦" FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextNormal}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="🗑️ Remove" 
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveInventoryItemCommand}"
                                                        CommandParameter="{Binding}" 
                                                        Background="Transparent" Foreground="#E74C3C" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Player Custom Attributes Card -->
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="📊 Player Attributes" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                                        <TextBlock Text="Custom key-value parameters (e.g. Strength, Health, Mana)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="➕ Add Attribute" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TriggerAddAttributeCommand}" CommandParameter="{Binding}" Background="#8E2DE2" Foreground="White" CornerRadius="4" Padding="10,6" FontSize="12"/>
                                </Grid>

                                <ListBox ItemsSource="{Binding Attributes}" Height="120" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:CustomAttribute">
                                            <Grid ColumnDefinitions="*,Auto" Height="36">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="⚡" FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="=" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Value}" Foreground="#A29BFE" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                    <Button Content="✏️ Edit" 
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TriggerEditAttributeCommand}"
                                                            CommandParameter="{Binding}" 
                                                            Background="Transparent" Foreground="#A29BFE" FontSize="11"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                        <Button Content="✏️ Edit"
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TriggerEditAttributeCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent" Foreground="#A29BFE" FontSize="11"/>
                                                        <Button Content="🗑️ Remove"
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveAttributeCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent" Foreground="#E74C3C" FontSize="11"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Player Actions Scripting Card -->
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="📜 Global Player Action Scripts" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                                <Grid ColumnDefinitions="*, *" Height="220">
                                    <Grid Grid.Column="0" RowDefinitions="*, Auto" Margin="0,0,8,0">
                                        <ListBox Grid.Row="0" ItemsSource="{Binding Actions}" SelectedIndex="0" x:Name="PlayerActionsList" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:Action">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextNormal}"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                            <Button Content="+ Action" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddActionCommand}" CommandParameter="{Binding}" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="11" Padding="8,4"/>
                                            <Button Content="Delete" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteActionCommand}" CommandParameter="{Binding #PlayerActionsList.SelectedItem}" Background="#C0392B" FontSize="11" Padding="8,4"/>
                                            <Button Content="Copy" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyActionCommand}" CommandParameter="{Binding #PlayerActionsList.SelectedItem}" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="11" Padding="8,4"/>
                                            <Button Content="Paste" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PasteActionCommand}" CommandParameter="{Binding}" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="11" Padding="8,4" IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CanPasteAction}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Column="1" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" IsVisible="{Binding #PlayerActionsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <ScrollViewer>
                                            <StackPanel Spacing="10" DataContext="{Binding #PlayerActionsList.SelectedItem}" x:DataType="models:Action">
                                                <TextBlock Text="Edit Action" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                                <TextBox x:Name="PlayerActionNameTextBox" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Action Name" FontSize="12" Background="{DynamicResource CardBg}"/>
                                                <TextBlock Text="Trigger Event:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PlayerTriggers}" SelectedItem="{Binding Trigger, Mode=TwoWay}" HorizontalAlignment="Stretch" FontSize="11" Background="{DynamicResource CardBg}"/>
                                                <StackPanel Spacing="6" Margin="0,6,0,0" IsVisible="{Binding IsDirectionFilterVisible}">
                                                    <TextBlock Text="Direction Filter:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                    <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DirectionFilters}" SelectedItem="{Binding DirectionFilter, Mode=TwoWay}" HorizontalAlignment="Stretch" FontSize="11" Background="{DynamicResource CardBg}"/>
                                                </StackPanel>
                                                <CheckBox IsChecked="{Binding InitallyActive, Mode=TwoWay}" Content="Initially Active" FontSize="11" Foreground="Gray"/>
                                                <Button Content="🎨 Visual Graph Editor" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StartEditingActionCommand}" CommandParameter="{Binding}" Background="#8E2DE2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. Rooms Editor -->
                <Grid IsVisible="{Binding ActiveView, ConverterParameter=Rooms, Converter={x:Static ObjectConverters.Equal}}" ColumnDefinitions="300,*">
                    <!-- Left Rooms List -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                <TextBlock Grid.Column="0" Text="Rooms in World" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Sort A-Z ⇅" Command="{Binding Rooms.SortCommand}" Background="Transparent" Foreground="#8E2DE2" FontSize="11" Padding="4,2"/>
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Rooms.Rooms}" Background="Transparent" SelectedIndex="0" x:Name="RoomsList" SelectionChanged="OnRoomsSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Room">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,10,0,0" ColumnSpacing="8">
                                <Button Grid.Column="0" Content="+ Add Room" Command="{Binding AddRoomCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="Delete" Command="{Binding DeleteRoomCommand}" CommandParameter="{Binding #RoomsList.SelectedItem}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#C0392B"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- Right Room Fields -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="20" IsVisible="{Binding #RoomsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="Edit Room" FontSize="18" FontWeight="Bold" Foreground="#8E2DE2" Margin="0,0,0,10"/>
                            
                            <TabControl Grid.Row="1" DataContext="{Binding #RoomsList.SelectedItem}" x:DataType="models:Room">
                                <!-- Properties Tab -->
                                <TabItem Header="Properties">
                                    <ScrollViewer x:Name="RoomDetailsScrollViewer" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                         <StackPanel Spacing="16">
                                            <!-- Name -->
                                            <TextBlock Text="Name" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBox Text="{Binding Name, Mode=TwoWay}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" Padding="8,6"/>
                                                <Button Grid.Column="1" Content="✨" Click="OnCoAuthorNameClicked" Margin="8,0,0,0" Width="36" Height="34" Background="#8E2DE2" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                            </Grid>

                                            <!-- Description -->
                                            <TextBlock Text="Description" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                                <Button Classes="toolbar-btn" Content="B" FontWeight="Bold" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="11" Click="OnComposeBoldClicked"/>
                                                <Button Classes="toolbar-btn" Content="/" FontStyle="Italic" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="11" Click="OnComposeItalicClicked"/>
                                                <Button Classes="toolbar-btn" Content="U" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="11" Click="OnComposeUnderlineClicked"/>
                                                <Button Classes="toolbar-btn" Height="28" Padding="8,0">
                                                     <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                         <TextBlock Text="🎨" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" FontSize="11"/>
                                                         <TextBlock Text="Color" VerticalAlignment="Center" FontSize="11"/>
                                                     </StackPanel>
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <StackPanel Spacing="6" Width="200">
                                                                <ColorPicker Color="#FFFFFF" Margin="0" HorizontalAlignment="Center"/>
                                                                <Button Content="Apply" Click="OnInlineColorPickerApply" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#8E2DE2" Foreground="White" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                                <Button Classes="toolbar-btn" Height="28" Padding="8,0">
                                                     <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                         <TextBlock Text="🖊️" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" FontSize="11"/>
                                                         <TextBlock Text="Highlight" VerticalAlignment="Center" FontSize="11"/>
                                                     </StackPanel>
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <StackPanel Spacing="6" Width="200">
                                                                <ColorPicker Color="#EF4444" Margin="0" HorizontalAlignment="Center"/>
                                                                <Button Content="Apply" Click="OnInlineHighlightPickerApply" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#8E2DE2" Foreground="White" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                                <Button Classes="toolbar-btn" Content="Clear" Height="28" Foreground="{DynamicResource TextMuted}" FontSize="11" Padding="8,0" Click="OnComposeClearClicked"/>
                                                <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenComposeCommand}" CommandParameter="{Binding}" Height="28" Background="#8E2DE2" Foreground="White" Padding="10,0" Margin="10,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                 <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                     <TextBlock Text="📝" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" FontSize="11"/>
                                                     <TextBlock Text="Compose Description" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                                                 </StackPanel>
                                             </Button>
                                            </StackPanel>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBox x:Name="RoomDescriptionTextBox" Text="{Binding Description, Mode=TwoWay}" AcceptsReturn="True" Height="160" VerticalContentAlignment="Top" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" TextWrapping="Wrap"/>
                                                <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                                    <Button Classes="toolbar-btn" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenComposeCommand}" CommandParameter="{Binding}" Width="36" Height="32" ToolTip.Tip="Open Composer Popup" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                     <TextBlock Text="📝" FontFamily="Segoe UI Emoji" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                 </Button>
                                                    <Button Content="✨" Click="OnCoAuthorDescriptionClicked" Width="36" Height="32" Background="#8E2DE2" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Live Preview -->
                                            <TextBlock Text="👁️ Live Preview" Foreground="{DynamicResource TextMuted}" FontSize="11" FontStyle="Italic"/>
                                            <Border Background="{DynamicResource InputBg}" CornerRadius="4" Padding="8">
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="LightGray" TextWrapping="Wrap"/>
                                            </Border>

                                            <!-- Portrait Image -->
                                            <TextBlock Text="Portrait" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                            <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" DragDrop.AllowDrop="True" DragDrop.Drop="OnDragDropFile" Tag="Room">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Border Width="80" Height="80" Background="#0C0C12" CornerRadius="6" ClipToBounds="True">
                                                        <Image Source="{Binding PortraitImagePath, Converter={x:Static views:ImagePathToBitmapConverter.Instance}}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PortraitImageFileName, FallbackValue='No image selected'}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Button Content="Clear Image" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ClearPortraitCommand}" CommandParameter="{Binding}" Background="#C0392B" Foreground="White" FontSize="11" Padding="8,4"/>
                                                            <Button Content="Generate with AI..." Click="OnGeneratePortraitClicked" Tag="Room" Background="#8E2DE2" Foreground="White" FontSize="11" Padding="10,4"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Collapsible Exits & Navigation -->
                                            <Expander Header="Exits &amp; Navigation" Background="{DynamicResource InputBg}" Margin="0,8,0,0">
                                                <StackPanel Spacing="10" Margin="10">
                                                    <TextBlock Text="Select target rooms and toggles for exits directions:" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                    
                                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="16">
                                                        <!-- North -->
                                                        <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="*, Auto, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="North →" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="NorthPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                                <ToolTip.Tip>
                                                                    <Binding Path="SelectedItem.Name" RelativeSource="{RelativeSource Self}" x:CompileBindings="False"/>
                                                                </ToolTip.Tip>
                                                            </ComboBox>
                                                            <Button Grid.Row="1" Grid.Column="1" Content="×" Click="OnClearExitClick" Tag="North" Margin="4,0,0,0" Height="32" VerticalContentAlignment="Center" Background="{DynamicResource ToolbarBtnBg}" Foreground="Red" FontWeight="Bold" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="14" Width="28" HorizontalContentAlignment="Center"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="NorthOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="3" x:Name="NorthLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- South -->
                                                        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*, Auto, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="South ←" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="SouthPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                                <ToolTip.Tip>
                                                                    <Binding Path="SelectedItem.Name" RelativeSource="{RelativeSource Self}" x:CompileBindings="False"/>
                                                                </ToolTip.Tip>
                                                            </ComboBox>
                                                            <Button Grid.Row="1" Grid.Column="1" Content="×" Click="OnClearExitClick" Tag="South" Margin="4,0,0,0" Height="32" VerticalContentAlignment="Center" Background="{DynamicResource ToolbarBtnBg}" Foreground="Red" FontWeight="Bold" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="14" Width="28" HorizontalContentAlignment="Center"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="SouthOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="3" x:Name="SouthLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- East -->
                                                        <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*, Auto, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="East →" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="EastPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                                <ToolTip.Tip>
                                                                    <Binding Path="SelectedItem.Name" RelativeSource="{RelativeSource Self}" x:CompileBindings="False"/>
                                                                </ToolTip.Tip>
                                                            </ComboBox>
                                                            <Button Grid.Row="1" Grid.Column="1" Content="×" Click="OnClearExitClick" Tag="East" Margin="4,0,0,0" Height="32" VerticalContentAlignment="Center" Background="{DynamicResource ToolbarBtnBg}" Foreground="Red" FontWeight="Bold" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="14" Width="28" HorizontalContentAlignment="Center"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="EastOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="3" x:Name="EastLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- West -->
                                                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*, Auto, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="West ←" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="WestPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                                <ToolTip.Tip>
                                                                    <Binding Path="SelectedItem.Name" RelativeSource="{RelativeSource Self}" x:CompileBindings="False"/>
                                                                </ToolTip.Tip>
                                                            </ComboBox>
                                                            <Button Grid.Row="1" Grid.Column="1" Content="×" Click="OnClearExitClick" Tag="West" Margin="4,0,0,0" Height="32" VerticalContentAlignment="Center" Background="{DynamicResource ToolbarBtnBg}" Foreground="Red" FontWeight="Bold" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="14" Width="28" HorizontalContentAlignment="Center"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="WestOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="3" x:Name="WestLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- Northwest -->
                                                        <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="*, Auto, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Northwest ↖" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="NorthWestPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                                <ToolTip.Tip>
                                                                    <Binding Path="SelectedItem.Name" RelativeSource="{RelativeSource Self}" x:CompileBindings="False"/>
                                                                </ToolTip.Tip>
                                                            </ComboBox>
                                                            <Button Grid.Row="1" Grid.Column="1" Content="×" Click="OnClearExitClick" Tag="NorthWest" Margin="4,0,0,0" Height="32" VerticalContentAlignment="Center" Background="{DynamicResource ToolbarBtnBg}" Foreground="Red" FontWeight="Bold" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="14" Width="28" HorizontalContentAlignment="Center"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="NorthWestOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="3" x:Name="NorthWestLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- Northeast -->
                                                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*, Auto, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Northeast ↗" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="NorthEastPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                                <ToolTip.Tip>
                                                                    <Binding Path="SelectedItem.Name" RelativeSource="{RelativeSource Self}" x:CompileBindings="False"/>
                                                                </ToolTip.Tip>
                                                            </ComboBox>
                                                            <Button Grid.Row="1" Grid.Column="1" Content="×" Click="OnClearExitClick" Tag="NorthEast" Margin="4,0,0,0" Height="32" VerticalContentAlignment="Center" Background="{DynamicResource ToolbarBtnBg}" Foreground="Red" FontWeight="Bold" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="14" Width="28" HorizontalContentAlignment="Center"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="NorthEastOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="3" x:Name="NorthEastLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- Southwest -->
                                                        <Grid Grid.Row="3" Grid.Column="0" ColumnDefinitions="*, Auto, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Southwest ↙" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="SouthWestPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                                <ToolTip.Tip>
                                                                    <Binding Path="SelectedItem.Name" RelativeSource="{RelativeSource Self}" x:CompileBindings="False"/>
                                                                </ToolTip.Tip>
                                                            </ComboBox>
                                                            <Button Grid.Row="1" Grid.Column="1" Content="×" Click="OnClearExitClick" Tag="SouthWest" Margin="4,0,0,0" Height="32" VerticalContentAlignment="Center" Background="{DynamicResource ToolbarBtnBg}" Foreground="Red" FontWeight="Bold" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="14" Width="28" HorizontalContentAlignment="Center"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="SouthWestOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="3" x:Name="SouthWestLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- Southeast -->
                                                        <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*, Auto, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Southeast ↘" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="SouthEastPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                                <ToolTip.Tip>
                                                                    <Binding Path="SelectedItem.Name" RelativeSource="{RelativeSource Self}" x:CompileBindings="False"/>
                                                                </ToolTip.Tip>
                                                            </ComboBox>
                                                            <Button Grid.Row="1" Grid.Column="1" Content="×" Click="OnClearExitClick" Tag="SouthEast" Margin="4,0,0,0" Height="32" VerticalContentAlignment="Center" Background="{DynamicResource ToolbarBtnBg}" Foreground="Red" FontWeight="Bold" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="14" Width="28" HorizontalContentAlignment="Center"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="SouthEastOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="3" x:Name="SouthEastLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- Up -->
                                                        <Grid Grid.Row="4" Grid.Column="0" ColumnDefinitions="*, Auto, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Up ▲" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="UpPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                                <ToolTip.Tip>
                                                                    <Binding Path="SelectedItem.Name" RelativeSource="{RelativeSource Self}" x:CompileBindings="False"/>
                                                                </ToolTip.Tip>
                                                            </ComboBox>
                                                            <Button Grid.Row="1" Grid.Column="1" Content="×" Click="OnClearExitClick" Tag="Up" Margin="4,0,0,0" Height="32" VerticalContentAlignment="Center" Background="{DynamicResource ToolbarBtnBg}" Foreground="Red" FontWeight="Bold" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="14" Width="28" HorizontalContentAlignment="Center"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="UpOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="3" x:Name="UpLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- Down -->
                                                        <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*, Auto, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Down ▼" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="DownPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                                <ToolTip.Tip>
                                                                    <Binding Path="SelectedItem.Name" RelativeSource="{RelativeSource Self}" x:CompileBindings="False"/>
                                                                </ToolTip.Tip>
                                                            </ComboBox>
                                                            <Button Grid.Row="1" Grid.Column="1" Content="×" Click="OnClearExitClick" Tag="Down" Margin="4,0,0,0" Height="32" VerticalContentAlignment="Center" Background="{DynamicResource ToolbarBtnBg}" Foreground="Red" FontWeight="Bold" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="14" Width="28" HorizontalContentAlignment="Center"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="DownOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="3" x:Name="DownLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- In -->
                                                        <Grid Grid.Row="5" Grid.Column="0" ColumnDefinitions="*, Auto, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="In ↵" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="InPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                                <ToolTip.Tip>
                                                                    <Binding Path="SelectedItem.Name" RelativeSource="{RelativeSource Self}" x:CompileBindings="False"/>
                                                                </ToolTip.Tip>
                                                            </ComboBox>
                                                            <Button Grid.Row="1" Grid.Column="1" Content="×" Click="OnClearExitClick" Tag="In" Margin="4,0,0,0" Height="32" VerticalContentAlignment="Center" Background="{DynamicResource ToolbarBtnBg}" Foreground="Red" FontWeight="Bold" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="14" Width="28" HorizontalContentAlignment="Center"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="InOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="3" x:Name="InLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- Out -->
                                                        <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*, Auto, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Out ↳" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="OutPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                                <ToolTip.Tip>
                                                                    <Binding Path="SelectedItem.Name" RelativeSource="{RelativeSource Self}" x:CompileBindings="False"/>
                                                                </ToolTip.Tip>
                                                            </ComboBox>
                                                            <Button Grid.Row="1" Grid.Column="1" Content="×" Click="OnClearExitClick" Tag="Out" Margin="4,0,0,0" Height="32" VerticalContentAlignment="Center" Background="{DynamicResource ToolbarBtnBg}" Foreground="Red" FontWeight="Bold" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="14" Width="28" HorizontalContentAlignment="Center"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="OutOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="3" x:Name="OutLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>
                                                    </Grid>
                                                </StackPanel>
                                            </Expander>

                                            <!-- VFX & Ambient Effects -->
                                            <Expander Header="VFX &amp; Ambient Effects" Background="{DynamicResource InputBg}" Margin="0,8,0,0" IsExpanded="True">
                                                <StackPanel Spacing="10" Margin="10">
                                                    <!-- Ambient Overlay Selector -->
                                                    <Grid ColumnDefinitions="*,2*">
                                                        <TextBlock Grid.Column="0" Text="Ambient Overlay:" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextNormal}"/>
                                                        <ComboBox Grid.Column="1" SelectedItem="{Binding AmbientOverlay}" Height="32" HorizontalAlignment="Stretch">
                                                            <x:String>None</x:String>
                                                            <x:String>Embers</x:String>
                                                            <x:String>Rain</x:String>
                                                            <x:String>Snow</x:String>
                                                            <x:String>Sand</x:String>
                                                            <x:String>Smoke</x:String>
                                                        </ComboBox>
                                                    </Grid>

                                                    <!-- Camera Shake Selector -->
                                                    <Grid ColumnDefinitions="*,2*">
                                                        <TextBlock Grid.Column="0" Text="Screen Shake:" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextNormal}"/>
                                                        <ComboBox Grid.Column="1" SelectedItem="{Binding ScreenEffect}" Height="32" HorizontalAlignment="Stretch">
                                                            <x:String>None</x:String>
                                                            <x:String>0.1</x:String>
                                                            <x:String>0.2</x:String>
                                                            <x:String>0.3</x:String>
                                                            <x:String>0.4</x:String>
                                                            <x:String>0.5</x:String>
                                                            <x:String>0.6</x:String>
                                                            <x:String>0.7</x:String>
                                                            <x:String>0.8</x:String>
                                                            <x:String>0.9</x:String>
                                                            <x:String>1.0</x:String>
                                                        </ComboBox>
                                                    </Grid>
                                                </StackPanel>
                                            </Expander>

                                            <!-- Collapsible Attributes -->
                                            <Expander Header="Attributes" Background="{DynamicResource InputBg}" Margin="0,8,0,0">
                                                <StackPanel Spacing="10" Margin="10">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="Manage custom story variable parameters on this room:" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="➕ Add Attribute" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TriggerAddAttributeCommand}" CommandParameter="{Binding}" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="11" Padding="8,4"/>
                                                    </Grid>
                                                    <ListBox ItemsSource="{Binding Attributes}" Height="110" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:CustomAttribute">
                                                                <Grid ColumnDefinitions="*,Auto" Height="36">
                                                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                                        <TextBlock Text="⚡" FontSize="12" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="=" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Value}" Foreground="#A29BFE" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                                        <Button Content="✏️ Edit" 
                                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TriggerEditAttributeCommand}"
                                                                                CommandParameter="{Binding}" 
                                                                                Background="Transparent" Foreground="#A29BFE" FontSize="11"/>
                                                                        <Button Content="🗑️ Remove"
                                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveAttributeCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                Background="Transparent" Foreground="#E74C3C" FontSize="11"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Expander>

                                            <!-- Collapsible Room Objects -->
                                            <Expander Header="Room Objects" Background="{DynamicResource InputBg}">
                                                <StackPanel Spacing="10" Margin="10">
                                                    <TextBlock Text="Select Objects starting in this Room:" FontSize="11" Foreground="{DynamicResource TextMuted}" FontWeight="Bold"/>
                                                    <ListBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Objects.Objects}" Height="150" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:GameObject">
                                                                <CheckBox Content="{Binding Name}" Foreground="{DynamicResource TextNormal}" FontSize="12" IsCheckedChanged="OnRoomObjectCheckedChanged" Loaded="OnRoomObjectCheckBoxLoaded" Unloaded="OnRoomObjectCheckBoxUnloaded"/>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Expander>

                                            <!-- Actions & Events -->
                                            <TextBlock Text="Actions &amp; Events" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2" Margin="0,16,0,0"/>
                                            <Grid ColumnDefinitions="*, *" Height="220">
                                                <Grid Grid.Column="0" RowDefinitions="*, Auto" Margin="0,0,8,0">
                                                    <ListBox Grid.Row="0" ItemsSource="{Binding Actions}" SelectedIndex="0" x:Name="RoomActionsList" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:Action">
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextNormal}"/>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                                        <Button Content="+ Action" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddActionCommand}" CommandParameter="{Binding}" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="11" Padding="8,4"/>
                                                        <Button Content="Delete" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteActionCommand}" CommandParameter="{Binding #RoomActionsList.SelectedItem}" Background="#C0392B" FontSize="11" Padding="8,4"/>
                                                         <Button Content="Copy" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyActionCommand}" CommandParameter="{Binding #RoomActionsList.SelectedItem}" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="11" Padding="8,4"/>
                                                         <Button Content="Paste" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PasteActionCommand}" CommandParameter="{Binding}" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="11" Padding="8,4" IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CanPasteAction}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Border Grid.Column="1" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" IsVisible="{Binding #RoomActionsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <ScrollViewer>
                                                        <StackPanel Spacing="10" DataContext="{Binding #RoomActionsList.SelectedItem}" x:DataType="models:Action">
                                                            <TextBlock Text="Edit Action" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                                            <TextBox x:Name="RoomActionNameTextBox" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Action Name" FontSize="12" Background="{DynamicResource CardBg}"/>
                                                            <TextBlock Text="Trigger Event:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                            <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RoomTriggers}" SelectedItem="{Binding Trigger, Mode=TwoWay}" HorizontalAlignment="Stretch" FontSize="11" Background="{DynamicResource CardBg}"/>
                                                            <StackPanel Spacing="6" Margin="0,6,0,0" IsVisible="{Binding IsDirectionFilterVisible}">
                                                                <TextBlock Text="Direction Filter:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                                <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DirectionFilters}" SelectedItem="{Binding DirectionFilter, Mode=TwoWay}" HorizontalAlignment="Stretch" FontSize="11" Background="{DynamicResource CardBg}"/>
                                                            </StackPanel>
                                                            <CheckBox IsChecked="{Binding InitallyActive, Mode=TwoWay}" Content="Initially Active" FontSize="11" Foreground="Gray"/>
                                                            <Button Content="🎨 Visual Graph Editor" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StartEditingActionCommand}" CommandParameter="{Binding}" Background="#8E2DE2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12"/>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <TabItem Header="Interactive Screen">
                                    <Border DragDrop.AllowDrop="True" DragDrop.Drop="OnInteractiveScreenDrop">
                                        <Grid ColumnDefinitions="325,*" Margin="0,10,0,0">
                                            <!-- Column 0: Global Settings & List -->
                                            <ScrollViewer Grid.Column="0" Margin="0,0,8,0">
                                                <StackPanel Spacing="16">
                                                    <CheckBox IsChecked="{Binding InteractiveScreenSettings.Enabled}" Content="Enable Interactive Mode" Foreground="{DynamicResource TextNormal}" FontSize="12"/>
                                                    
                                                    <TextBlock Text="Backdrop Asset ID / Path:" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                                    <ComboBox Text="{Binding InteractiveScreenSettings.BackdropAssetId, Mode=TwoWay}" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CurrentGame.MediaAssets}" HorizontalAlignment="Stretch" IsEditable="True" Background="{DynamicResource CardBg}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:MediaAsset">
                                                                <TextBlock Text="{Binding OriginalFileName}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,4">
                                                        <TextBlock Grid.Column="0" Text="Clickable Hotspots" FontSize="14" FontWeight="Bold" Foreground="#8E2DE2" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="➕ Add" Click="OnAddHotspotClicked" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="11" Padding="8,4"/>
                                                    </Grid>
                                                    
                                                    <ListBox ItemsSource="{Binding InteractiveScreenSettings.Hotspots}" x:Name="RoomHotspotsList" Height="180" SelectedIndex="0" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:ScreenHotspot">
                                                                <Grid ColumnDefinitions="*,Auto" Height="36">
                                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                    <Button Grid.Column="1" Content="🗑️" Click="OnRemoveHotspotClicked" CommandParameter="{Binding}" Background="Transparent" Foreground="#E74C3C" FontSize="10" Padding="4,2" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <!-- Hotspot Property Inspector stacked below -->
                                                    <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,12,0,0" IsVisible="{Binding #RoomHotspotsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                        <StackPanel Spacing="10" DataContext="{Binding #RoomHotspotsList.SelectedItem}" x:DataType="models:ScreenHotspot">
                                                        <TextBlock Text="Edit Hotspot Properties" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                                        
                                                        <TextBlock Text="Button Name (Designer Only):" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                        <TextBox Text="{Binding Name, Mode=TwoWay}" Watermark="Button Name" FontSize="11" Background="{DynamicResource CardBg}"/>
                                                        
                                                        <TextBlock Text="Linked Action:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                        <ComboBox SelectedItem="{Binding LinkedActionId, Mode=TwoWay, Converter={x:Static views:ActionToIdStringConverter.Instance}}" ItemsSource="{Binding $parent[TabControl].DataContext.Actions}" HorizontalAlignment="Stretch" Background="{DynamicResource CardBg}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:Action">
                                                                    <TextBlock Text="{Binding Name}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>

                                                        <!-- Position grid -->
                                                        <TextBlock Text="Coordinates &amp; Dimensions (%):" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                        <Grid ColumnDefinitions="*,*,*,*" Margin="0,2">
                                                            <StackPanel Margin="0,0,4,0">
                                                                <TextBlock Text="Left (X)" FontSize="9" Foreground="Gray"/>
                                                                <TextBox Text="{Binding X, Mode=TwoWay}" FontSize="10" Padding="4,3"/>
                                                            </StackPanel>
                                                            <StackPanel Margin="4,0" Grid.Column="1">
                                                                <TextBlock Text="Top (Y)" FontSize="9" Foreground="Gray"/>
                                                                <TextBox Text="{Binding Y, Mode=TwoWay}" FontSize="10" Padding="4,3"/>
                                                            </StackPanel>
                                                            <StackPanel Margin="4,0" Grid.Column="2">
                                                                <TextBlock Text="Width" FontSize="9" Foreground="Gray"/>
                                                                <TextBox Text="{Binding Width, Mode=TwoWay}" FontSize="10" Padding="4,3"/>
                                                            </StackPanel>
                                                            <StackPanel Margin="4,0,0,0" Grid.Column="3">
                                                                <TextBlock Text="Height" FontSize="9" Foreground="Gray"/>
                                                                <TextBox Text="{Binding Height, Mode=TwoWay}" FontSize="10" Padding="4,3"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        
                                                        <TextBlock Text="Style Type:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                        <ComboBox SelectedItem="{Binding StyleType, Mode=TwoWay}" HorizontalAlignment="Stretch" FontSize="11" Background="{DynamicResource CardBg}">
                                                            <ComboBox.Items>
                                                                <sys:String>Invisible</sys:String>
                                                                <sys:String>TextButton</sys:String>
                                                                <sys:String>IconButton</sys:String>
                                                                <sys:String>ImageButton</sys:String>
                                                                <sys:String>CustomBorder</sys:String>
                                                            </ComboBox.Items>
                                                        </ComboBox>
                                                        
                                                        <StackPanel Spacing="10" IsVisible="{Binding StyleType, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter=Invisible}">
                                                            <TextBlock Text="Label Text:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                            <TextBox Text="{Binding LabelText, Mode=TwoWay}" Watermark="Label (supports {var.name})" FontSize="11" Background="{DynamicResource CardBg}"/>
                                                            
                                                            <TextBlock Text="Background Color:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBox Text="{Binding BackgroundColor, Mode=TwoWay}" Watermark="#1A1A1A or {var.color}" FontSize="11" Background="{DynamicResource CardBg}"/>
                                                                <ColorPicker Grid.Column="1" Color="{Binding BackgroundColor, Mode=TwoWay, Converter={x:Static views:HexToColorConverter.Instance}}" Margin="8,0,0,0"/>
                                                            </Grid>

                                                            <TextBlock Text="Font Color:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBox Text="{Binding FontColor, Mode=TwoWay}" Watermark="#FFFFFF or {var.color}" FontSize="11" Background="{DynamicResource CardBg}"/>
                                                                <ColorPicker Grid.Column="1" Color="{Binding FontColor, Mode=TwoWay, Converter={x:Static views:HexToColorConverter.Instance}}" Margin="8,0,0,0"/>
                                                            </Grid>

                                                            <TextBlock Text="Font Size:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                            <TextBox Text="{Binding FontSize, Mode=TwoWay}" FontSize="11" Background="{DynamicResource CardBg}"/>

                                                            <TextBlock Text="Image Asset ID / Template:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                            <ComboBox Text="{Binding ImageAssetId, Mode=TwoWay}" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CurrentGame.MediaAssets}" HorizontalAlignment="Stretch" IsEditable="True" Background="{DynamicResource CardBg}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:MediaAsset">
                                                                        <TextBlock Text="{Binding OriginalFileName}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                             </ComboBox>
                                                         </StackPanel>
                                                     </StackPanel>
                                                 </Border>
                                             </StackPanel>
                                         </ScrollViewer>
                                            
                                            <!-- Column 1: Interactive Screen Canvas Coordinates Preview -->
                                            <StackPanel Grid.Column="1" Spacing="10" Margin="16,0,0,0">
                                                <TextBlock Text="Live Screen Coordinates Preview" FontSize="14" FontWeight="Bold" Foreground="#8E2DE2"/>
                                                <Border Background="Black" BorderBrush="#3A3A4C" BorderThickness="2" CornerRadius="4" ClipToBounds="True" Height="450">
                                                    <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <Canvas Width="100" Height="56.25" Background="#14141F">
                                                            <!-- Backdrop Image in Preview -->
                                                            <Image Source="{Binding InteractiveScreenSettings.BackdropAssetId, Converter={x:Static views:AssetIdToBitmapConverter.Instance}}" Width="100" Height="56.25" Stretch="UniformToFill"/>
                                                            <TextBlock Text="Interactive Screen Canvas Preview (16:9)" FontSize="4" Foreground="Gray" Canvas.Left="4" Canvas.Top="4" IsVisible="False"/>
                                                            
                                                             <ItemsControl ItemsSource="{Binding InteractiveScreenSettings.Hotspots}">
                                                                 <ItemsControl.ItemsPanel>
                                                                     <ItemsPanelTemplate>
                                                                         <Canvas Width="100" Height="56.25"/>
                                                                     </ItemsPanelTemplate>
                                                                 </ItemsControl.ItemsPanel>
                                                                 <ItemsControl.Styles>
                                                                     <Style Selector="ContentPresenter" x:DataType="models:ScreenHotspot">
                                                                         <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                                         <Setter Property="Canvas.Top" Value="{Binding Y, Converter={x:Static views:YScaleConverter.Instance}}"/>
                                                                     </Style>
                                                                 </ItemsControl.Styles>
                                                                 <ItemsControl.ItemTemplate>
                                                                     <DataTemplate x:DataType="models:ScreenHotspot">
                                                                         <Border Width="{Binding Width}" Height="{Binding Height, Converter={x:Static views:YScaleConverter.Instance}}" BorderBrush="{Binding FontColor, Converter={x:Static views:HexToBrushConverter.Instance}}" BorderThickness="0.6" Background="{Binding BackgroundColor, Converter={x:Static views:HexToBrushConverter.Instance}}" CornerRadius="0.5" Cursor="Hand" PointerPressed="OnHotspotPointerPressed" PointerMoved="OnHotspotPointerMoved" PointerReleased="OnHotspotPointerReleased">
                                                                             <Grid>
                                                                                 <!-- Button background icon/image -->
                                                                                 <Image Source="{Binding ImageAssetId, Converter={x:Static views:AssetIdToBitmapConverter.Instance}}" Stretch="UniformToFill"/>
                                                                                 <TextBlock Text="{Binding DisplayName}" FontSize="{Binding FontSize, Converter={x:Static views:HotspotFontSizeScaleConverter.Instance}}" Foreground="{Binding FontColor, Converter={x:Static views:HexToBrushConverter.Instance}}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                             </Grid>
                                                                         </Border>
                                                                     </DataTemplate>
                                                                 </ItemsControl.ItemTemplate>
                                                             </ItemsControl>
                                                         </Canvas>
                                                    </Viewbox>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. Characters Database -->
                <Grid IsVisible="{Binding ActiveView, ConverterParameter=Characters, Converter={x:Static ObjectConverters.Equal}}" ColumnDefinitions="300,*">
                    <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                <TextBlock Grid.Column="0" Text="Characters" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Sort A-Z ⇅" Command="{Binding Characters.SortCommand}" Background="Transparent" Foreground="#8E2DE2" FontSize="11" Padding="4,2"/>
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Characters.Characters}" Background="Transparent" SelectedIndex="0" x:Name="CharsList" SelectionChanged="OnCharsSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Character">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,10,0,0" ColumnSpacing="8">
                                <Button Grid.Column="0" Content="+ Create Character" Command="{Binding AddCharacterCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="Delete" Command="{Binding DeleteCharacterCommand}" CommandParameter="{Binding #CharsList.SelectedItem}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#C0392B"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="20" IsVisible="{Binding #CharsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ScrollViewer x:Name="CharDetailsScrollViewer" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16" DataContext="{Binding #CharsList.SelectedItem}" x:DataType="models:Character">
                                <TextBlock Text="Edit Character" FontSize="18" FontWeight="Bold" Foreground="#8E2DE2"/>
                                
                                <TextBlock Text="Name:" Foreground="{DynamicResource TextMuted}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" Padding="8,6"/>
                                    <Button Grid.Column="1" Content="✨" Click="OnCoAuthorNameClicked" Margin="8,0,0,0" Width="36" Height="34" Background="#8E2DE2" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                </Grid>
                                
                                 <TextBlock Text="Description:" Foreground="{DynamicResource TextMuted}"/>
                                 <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                     <Button Content="B" FontWeight="Bold" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Classes="toolbar-btn" FontSize="11" Click="OnComposeBoldClicked"/>
                                     <Button Content="/" FontStyle="Italic" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Classes="toolbar-btn" FontSize="11" Click="OnComposeItalicClicked"/>
                                     <Button Content="U" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Classes="toolbar-btn" FontSize="11" Click="OnComposeUnderlineClicked"/>
                                     <Button Classes="toolbar-btn" Height="28" Padding="8,0">
                                                     <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                         <TextBlock Text="🎨" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" FontSize="11"/>
                                                         <TextBlock Text="Color" VerticalAlignment="Center" FontSize="11"/>
                                                     </StackPanel>
                                         <Button.Flyout>
                                             <Flyout>
                                                 <StackPanel Spacing="6" Width="200">
                                                     <ColorPicker Color="#FFFFFF" Margin="0" HorizontalAlignment="Center"/>
                                                     <Button Content="Apply" Click="OnInlineColorPickerApply" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#8E2DE2" Foreground="White" FontWeight="Bold"/>
                                                 </StackPanel>
                                             </Flyout>
                                         </Button.Flyout>
                                     </Button>
                                     <Button Classes="toolbar-btn" Height="28" Padding="8,0">
                                                     <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                         <TextBlock Text="🖊️" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" FontSize="11"/>
                                                         <TextBlock Text="Highlight" VerticalAlignment="Center" FontSize="11"/>
                                                     </StackPanel>
                                         <Button.Flyout>
                                             <Flyout>
                                                 <StackPanel Spacing="6" Width="200">
                                                     <ColorPicker Color="#EF4444" Margin="0" HorizontalAlignment="Center"/>
                                                     <Button Content="Apply" Click="OnInlineHighlightPickerApply" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#8E2DE2" Foreground="White" FontWeight="Bold"/>
                                                 </StackPanel>
                                             </Flyout>
                                         </Button.Flyout>
                                     </Button>
                                     <Button Content="Clear" Height="28" Classes="toolbar-btn" Foreground="{DynamicResource TextMuted}" FontSize="11" Padding="8,0" Click="OnComposeClearClicked"/>
                                     <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenComposeCommand}" CommandParameter="{Binding}" Height="28" Background="#8E2DE2" Foreground="White" Padding="10,0" Margin="10,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                 <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                     <TextBlock Text="📝" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" FontSize="11"/>
                                                     <TextBlock Text="Compose Description" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                                                 </StackPanel>
                                             </Button>
                                 </StackPanel>
                                 <Grid ColumnDefinitions="*,Auto">
                                     <TextBox x:Name="CharacterDescriptionTextBox" Grid.Column="0" Text="{Binding Description, Mode=TwoWay}" AcceptsReturn="True" Height="160" VerticalContentAlignment="Top" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" TextWrapping="Wrap"/>
                                     <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                         <Button Content="📝" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenComposeCommand}" CommandParameter="{Binding}" Width="36" Height="32" Classes="toolbar-btn emoji" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Open Composer Popup"/>
                                         <Button Content="✨" Click="OnCoAuthorDescriptionClicked" Width="36" Height="32" Background="#8E2DE2" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                     </StackPanel>
                                 </Grid>

                                <!-- Portrait Image -->
                                <TextBlock Text="Portrait" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" DragDrop.AllowDrop="True" DragDrop.Drop="OnDragDropFile" Tag="Character">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Width="80" Height="80" Background="#0C0C12" CornerRadius="6" ClipToBounds="True">
                                            <Image Source="{Binding PortraitImagePath, Converter={x:Static views:ImagePathToBitmapConverter.Instance}}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PortraitImageFileName, FallbackValue='No image selected'}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Clear Image" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ClearPortraitCommand}" CommandParameter="{Binding}" Background="#C0392B" Foreground="White" FontSize="11" Padding="8,4"/>
                                                <Button Content="Generate with AI..." Click="OnGeneratePortraitClicked" Tag="Character" Background="#8E2DE2" Foreground="White" FontSize="11" Padding="10,4"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Health & Hostile & Gender -->
                                <Grid ColumnDefinitions="*, *, Auto" RowDefinitions="Auto, Auto" Margin="0,8,0,0">
                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,16,0">
                                        <TextBlock Text="Health" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding Health, Mode=TwoWay}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" Padding="8,6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6" Margin="0,0,16,0">
                                        <TextBlock Text="Gender" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                        <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Hostile" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                        <CheckBox IsChecked="{Binding IsHostile, Mode=TwoWay}" Foreground="White" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>


                                <!-- Starting Room -->
                                <TextBlock Text="Starting Room" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" SelectedItem="{Binding StartingRoom, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:Room">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Inventory -->
                                <Expander Header="🎒 Starting Inventory" Background="{DynamicResource InputBg}" Margin="0,8,0,0" IsExpanded="True">
                                    <StackPanel Spacing="12" Margin="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="Items that this character possesses at the beginning of the story" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="➕ Add Item" 
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TriggerAddInventoryCommand}" 
                                                    CommandParameter="{Binding}" 
                                                    Background="#8E2DE2" Foreground="White" CornerRadius="4" Padding="10,6" FontSize="12"/>
                                        </Grid>
                                        <ListBox ItemsSource="{Binding Inventory}" Height="120" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:GameObject">
                                                    <Grid ColumnDefinitions="*,Auto" Height="36">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="📦" FontSize="14" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextNormal}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="🗑️ Remove" 
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveInventoryItemCommand}"
                                                                Background="Transparent" Foreground="#E74C3C" FontSize="11">
                                                            <Button.CommandParameter>
                                                                <MultiBinding Converter="{x:Static vm:MainWindowViewModel.MakeTupleConverter}">
                                                                    <Binding Path="$parent[Expander].DataContext"/>
                                                                    <Binding Path="."/>
                                                                </MultiBinding>
                                                            </Button.CommandParameter>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Expander>

                                <!-- Attributes -->
                                <Expander Header="Attributes" Background="{DynamicResource InputBg}" Margin="0,8,0,0">
                                    <StackPanel Spacing="10" Margin="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Manage custom attributes on this character:" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="➕ Add Attribute" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TriggerAddAttributeCommand}" CommandParameter="{Binding}" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="11" Padding="8,4"/>
                                        </Grid>
                                        <ListBox ItemsSource="{Binding Attributes}" Height="120" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:CustomAttribute">
                                                    <Grid ColumnDefinitions="*,Auto" Height="36">
                                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                            <TextBlock Text="⚡" FontSize="12" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="=" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Value}" Foreground="#A29BFE" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                            <Button Content="✏️ Edit" 
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TriggerEditAttributeCommand}"
                                                                    CommandParameter="{Binding}" 
                                                                    Background="Transparent" Foreground="#A29BFE" FontSize="11"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                                <Button Content="✏️ Edit"
                                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TriggerEditAttributeCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent" Foreground="#A29BFE" FontSize="11"/>
                                                                <Button Content="🗑️ Remove"
                                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveAttributeCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent" Foreground="#E74C3C" FontSize="11"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Expander>

                                <TextBlock Text="Actions &amp; Events" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2" Margin="0,16,0,0"/>
                                <Grid ColumnDefinitions="*, *" Height="220">
                                    <Grid Grid.Column="0" RowDefinitions="*, Auto" Margin="0,0,8,0">
                                        <ListBox Grid.Row="0" ItemsSource="{Binding Actions}" SelectedIndex="0" x:Name="CharacterActionsList" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:Action">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextNormal}"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                            <Button Content="+ Action" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddActionCommand}" CommandParameter="{Binding}" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="11" Padding="8,4"/>
                                            <Button Content="Delete" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteActionCommand}" CommandParameter="{Binding #CharacterActionsList.SelectedItem}" Background="#C0392B" FontSize="11" Padding="8,4"/>
                                             <Button Content="Copy" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyActionCommand}" CommandParameter="{Binding #CharacterActionsList.SelectedItem}" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="11" Padding="8,4"/>
                                             <Button Content="Paste" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PasteActionCommand}" CommandParameter="{Binding}" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="11" Padding="8,4" IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CanPasteAction}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Column="1" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" IsVisible="{Binding #CharacterActionsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <ScrollViewer>
                                            <StackPanel Spacing="10" DataContext="{Binding #CharacterActionsList.SelectedItem}" x:DataType="models:Action">
                                                <TextBlock Text="Edit Action" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                                <TextBox x:Name="CharacterActionNameTextBox" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Action Name" FontSize="12" Background="{DynamicResource CardBg}"/>
                                                <TextBlock Text="Trigger Event:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CharacterTriggers}" SelectedItem="{Binding Trigger, Mode=TwoWay}" HorizontalAlignment="Stretch" FontSize="11" Background="{DynamicResource CardBg}"/>
                                                <StackPanel Spacing="6" Margin="0,6,0,0" IsVisible="{Binding IsDirectionFilterVisible}">
                                                    <TextBlock Text="Direction Filter:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                    <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DirectionFilters}" SelectedItem="{Binding DirectionFilter, Mode=TwoWay}" HorizontalAlignment="Stretch" FontSize="11" Background="{DynamicResource CardBg}"/>
                                                </StackPanel>
                                                <CheckBox IsChecked="{Binding InitallyActive, Mode=TwoWay}" Content="Initially Active" FontSize="11" Foreground="Gray"/>
                                                <Button Content="🎨 Visual Graph Editor" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StartEditingActionCommand}" CommandParameter="{Binding}" Background="#8E2DE2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 4. Game Objects & Items -->
                <Grid IsVisible="{Binding ActiveView, ConverterParameter=Objects, Converter={x:Static ObjectConverters.Equal}}" ColumnDefinitions="300,*">
                    <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                <TextBlock Grid.Column="0" Text="Objects &amp; Items" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Sort A-Z ⇅" Command="{Binding Objects.SortCommand}" Background="Transparent" Foreground="#8E2DE2" FontSize="11" Padding="4,2"/>
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Objects.Objects}" Background="Transparent" SelectedIndex="0" x:Name="ObjectsList" SelectionChanged="OnObjectsSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:GameObject">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,10,0,0" ColumnSpacing="8">
                                <Button Grid.Column="0" Content="+ Create Object" Command="{Binding AddObjectCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="Delete" Command="{Binding DeleteObjectCommand}" CommandParameter="{Binding #ObjectsList.SelectedItem}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#C0392B"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="20" IsVisible="{Binding #ObjectsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="Edit Object" FontSize="18" FontWeight="Bold" Foreground="#8E2DE2" Margin="0,0,0,10"/>
                            
                            <TabControl Grid.Row="1" DataContext="{Binding #ObjectsList.SelectedItem}" x:DataType="models:GameObject">
                                <!-- Properties Tab -->
                                <TabItem Header="Properties">
                                    <ScrollViewer x:Name="ObjectDetailsScrollViewer" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                        <StackPanel Spacing="16">
                                            <!-- Name -->
                                            <TextBlock Text="Name" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBox Text="{Binding Name, Mode=TwoWay}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" Padding="8,6"/>
                                                <Button Grid.Column="1" Content="✨" Click="OnCoAuthorNameClicked" Margin="8,0,0,0" Width="36" Height="34" Background="#8E2DE2" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                            </Grid>
                                            
                                            <!-- Carryable / Grabable Checkbox -->
                                            <CheckBox IsChecked="{Binding IsCollectible, Mode=TwoWay}" Content="Carryable / Grabable (Can be picked up and placed in inventory)" Foreground="{DynamicResource TextNormal}" FontSize="12" Margin="0,4,0,0"/>

                                            <!-- Wearable Options -->
                                            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,4,0,0">
                                                <CheckBox IsChecked="{Binding IsWearable, Mode=TwoWay}" Content="Is Wearable (Can be worn by player)" Foreground="{DynamicResource TextNormal}" FontSize="12"/>
                                                <CheckBox IsChecked="{Binding IsWorn, Mode=TwoWay}" IsEnabled="{Binding IsWearable}" Content="Initially Worn" Foreground="{DynamicResource TextNormal}" FontSize="12"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0" IsVisible="{Binding IsWearable}">
                                                <TextBlock Text="Wear Slot:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                                <ComboBox ItemsSource="{Binding $parent[Window].DataContext.CurrentGame.WearSlots}" SelectedItem="{Binding WearSlot, Mode=TwoWay}" Width="150" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"/>
                                            </StackPanel>

                                            <!-- Description -->
                                            <TextBlock Text="Description" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                                <Button Content="B" FontWeight="Bold" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Classes="toolbar-btn" FontSize="11" Click="OnComposeBoldClicked"/>
                                                <Button Content="/" FontStyle="Italic" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Classes="toolbar-btn" FontSize="11" Click="OnComposeItalicClicked"/>
                                                <Button Content="U" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Classes="toolbar-btn" FontSize="11" Click="OnComposeUnderlineClicked"/>
                                                <Button Classes="toolbar-btn" Height="28" Padding="8,0">
                                                     <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                         <TextBlock Text="🎨" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" FontSize="11"/>
                                                         <TextBlock Text="Color" VerticalAlignment="Center" FontSize="11"/>
                                                     </StackPanel>
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <StackPanel Spacing="6" Width="200">
                                                                <ColorPicker Color="#FFFFFF" Margin="0" HorizontalAlignment="Center"/>
                                                                <Button Content="Apply" Click="OnInlineColorPickerApply" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#8E2DE2" Foreground="White" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                                <Button Classes="toolbar-btn" Height="28" Padding="8,0">
                                                     <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                         <TextBlock Text="🖊️" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" FontSize="11"/>
                                                         <TextBlock Text="Highlight" VerticalAlignment="Center" FontSize="11"/>
                                                     </StackPanel>
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <StackPanel Spacing="6" Width="200">
                                                                <ColorPicker Color="#EF4444" Margin="0" HorizontalAlignment="Center"/>
                                                                <Button Content="Apply" Click="OnInlineHighlightPickerApply" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#8E2DE2" Foreground="White" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                                <Button Content="Clear" Height="28" Classes="toolbar-btn" Foreground="{DynamicResource TextMuted}" FontSize="11" Padding="8,0" Click="OnComposeClearClicked"/>
                                                <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenComposeCommand}" CommandParameter="{Binding}" Height="28" Background="#8E2DE2" Foreground="White" Padding="10,0" Margin="10,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                 <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                     <TextBlock Text="📝" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" FontSize="11"/>
                                                     <TextBlock Text="Compose Description" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                                                 </StackPanel>
                                             </Button>
                                            </StackPanel>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBox x:Name="ObjectDescriptionTextBox" Text="{Binding Description, Mode=TwoWay}" AcceptsReturn="True" Height="160" VerticalContentAlignment="Top" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" TextWrapping="Wrap"/>
                                                <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                                    <Button Content="📝" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenComposeCommand}" CommandParameter="{Binding}" Width="36" Height="32" Classes="toolbar-btn emoji" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Open Composer Popup"/>
                                                    <Button Content="✨" Click="OnCoAuthorDescriptionClicked" Width="36" Height="32" Background="#8E2DE2" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Live Preview -->
                                            <TextBlock Text="👁️ Live Preview" Foreground="{DynamicResource TextMuted}" FontSize="11" FontStyle="Italic"/>
                                            <Border Background="{DynamicResource InputBg}" CornerRadius="4" Padding="8">
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="LightGray" TextWrapping="Wrap"/>
                                            </Border>

                                            <!-- Portrait Image -->
                                            <TextBlock Text="Portrait" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                            <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" DragDrop.AllowDrop="True" DragDrop.Drop="OnDragDropFile" Tag="Object">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Border Width="80" Height="80" Background="#0C0C12" CornerRadius="6" ClipToBounds="True">
                                                        <Image Source="{Binding PortraitImagePath, Converter={x:Static views:ImagePathToBitmapConverter.Instance}}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PortraitImageFileName, FallbackValue='No image selected'}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Button Content="Clear Image" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ClearPortraitCommand}" CommandParameter="{Binding}" Background="#C0392B" Foreground="White" FontSize="11" Padding="8,4"/>
                                                            <Button Content="Generate with AI..." Click="OnGeneratePortraitClicked" Tag="Object" Background="#8E2DE2" Foreground="White" FontSize="11" Padding="10,4"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Collapsible Attributes -->
                                            <Expander Header="Attributes" Background="{DynamicResource InputBg}" Margin="0,8,0,0">
                                                <StackPanel Spacing="10" Margin="10">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="Manage custom attributes on this item:" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="➕ Add Attribute" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TriggerAddAttributeCommand}" CommandParameter="{Binding}" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="11" Padding="8,4"/>
                                                    </Grid>
                                                    <ListBox ItemsSource="{Binding Attributes}" Height="120" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:CustomAttribute">
                                                                <Grid ColumnDefinitions="*,Auto" Height="36">
                                                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                                        <TextBlock Text="⚡" FontSize="12" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="=" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Value}" Foreground="#A29BFE" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                                        <Button Content="✏️ Edit" 
                                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TriggerEditAttributeCommand}"
                                                                                CommandParameter="{Binding}" 
                                                                                Background="Transparent" Foreground="#A29BFE" FontSize="11"/>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                                            <Button Content="✏️ Edit"
                                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TriggerEditAttributeCommand}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Background="Transparent" Foreground="#A29BFE" FontSize="11"/>
                                                                            <Button Content="🗑️ Remove"
                                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveAttributeCommand}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Background="Transparent" Foreground="#E74C3C" FontSize="11"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Expander>

                                            <!-- Collapsible Container Settings -->
                                            <Expander Header="Container Settings" Background="{DynamicResource InputBg}">
                                                <StackPanel Spacing="12" Margin="10">
                                                    <CheckBox IsChecked="{Binding IsContainer, Mode=TwoWay}" Content="Is Container" Foreground="{DynamicResource TextNormal}" FontSize="12"/>
                                                    
                                                    <!-- Contained items sub-grid visible only if IsContainer is true -->
                                                    <StackPanel Spacing="8" IsVisible="{Binding IsContainer}" Margin="0,8,0,0">
                                                        <TextBlock Text="Contained Objects:" FontSize="11" Foreground="{DynamicResource TextMuted}" FontWeight="Bold"/>
                                                        <ListBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Objects.Objects}" Height="120" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:GameObject">
                                                                    <CheckBox Content="{Binding Name}" Foreground="{DynamicResource TextNormal}" FontSize="12" IsCheckedChanged="OnContainedObjectCheckedChanged" Loaded="OnContainedObjectCheckBoxLoaded"/>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Expander>

                                            <!-- Actions & Events -->
                                            <TextBlock Text="Actions &amp; Events" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2" Margin="0,16,0,0"/>
                                            <Grid ColumnDefinitions="*, *" Height="220">
                                                <Grid Grid.Column="0" RowDefinitions="*, Auto" Margin="0,0,8,0">
                                                    <ListBox Grid.Row="0" ItemsSource="{Binding Actions}" SelectedIndex="0" x:Name="ObjectActionsList" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:Action">
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextNormal}"/>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                                        <Button Content="+ Action" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddActionCommand}" CommandParameter="{Binding}" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="11" Padding="8,4"/>
                                                        <Button Content="Delete" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteActionCommand}" CommandParameter="{Binding #ObjectActionsList.SelectedItem}" Background="#C0392B" FontSize="11" Padding="8,4"/>
                                                         <Button Content="Copy" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyActionCommand}" CommandParameter="{Binding #ObjectActionsList.SelectedItem}" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="11" Padding="8,4"/>
                                                         <Button Content="Paste" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PasteActionCommand}" CommandParameter="{Binding}" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" FontSize="11" Padding="8,4" IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CanPasteAction}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Border Grid.Column="1" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" IsVisible="{Binding #ObjectActionsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <ScrollViewer>
                                                        <StackPanel Spacing="10" DataContext="{Binding #ObjectActionsList.SelectedItem}" x:DataType="models:Action">
                                                            <TextBlock Text="Edit Action" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                                            <TextBox x:Name="ObjectActionNameTextBox" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Action Name" FontSize="12" Background="{DynamicResource CardBg}"/>
                                                            <TextBlock Text="Trigger Event:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                            <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ObjectTriggers}" SelectedItem="{Binding Trigger, Mode=TwoWay}" HorizontalAlignment="Stretch" FontSize="11" Background="{DynamicResource CardBg}"/>
                                                            <StackPanel Spacing="6" Margin="0,6,0,0" IsVisible="{Binding IsDirectionFilterVisible}">
                                                                <TextBlock Text="Direction Filter:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                                <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DirectionFilters}" SelectedItem="{Binding DirectionFilter, Mode=TwoWay}" HorizontalAlignment="Stretch" FontSize="11" Background="{DynamicResource CardBg}"/>
                                                            </StackPanel>
                                                            <CheckBox IsChecked="{Binding InitallyActive, Mode=TwoWay}" Content="Initially Active" FontSize="11" Foreground="Gray"/>
                                                            <Button Content="🎨 Visual Graph Editor" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StartEditingActionCommand}" CommandParameter="{Binding}" Background="#8E2DE2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12"/>
                                                        </StackPanel>
                                                     </ScrollViewer>
                                                 </Border>
                                             </Grid>
                                         </StackPanel>
                                     </ScrollViewer>
                                 </TabItem>

                                <TabItem Header="Interactive Screen">
                                    <Border DragDrop.AllowDrop="True" DragDrop.Drop="OnInteractiveScreenDrop">
                                        <Grid ColumnDefinitions="325,*" Margin="0,10,0,0">
                                            <!-- Column 0: Global Settings & List -->
                                            <ScrollViewer Grid.Column="0" Margin="0,0,8,0">
                                                <StackPanel Spacing="16">
                                                    <CheckBox IsChecked="{Binding InteractiveScreenSettings.Enabled}" Content="Enable Interactive Mode" Foreground="{DynamicResource TextNormal}" FontSize="12"/>
                                                    
                                                    <TextBlock Text="Backdrop Asset ID / Path:" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                                    <ComboBox Text="{Binding InteractiveScreenSettings.BackdropAssetId, Mode=TwoWay}" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CurrentGame.MediaAssets}" HorizontalAlignment="Stretch" IsEditable="True" Background="{DynamicResource CardBg}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:MediaAsset">
                                                                <TextBlock Text="{Binding OriginalFileName}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,4">
                                                        <TextBlock Grid.Column="0" Text="Clickable Hotspots" FontSize="14" FontWeight="Bold" Foreground="#8E2DE2" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="➕ Add" Click="OnAddObjectHotspotClicked" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="11" Padding="8,4"/>
                                                    </Grid>
                                                    
                                                    <ListBox ItemsSource="{Binding InteractiveScreenSettings.Hotspots}" x:Name="ObjectHotspotsList" Height="180" SelectedIndex="0" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:ScreenHotspot">
                                                                <Grid ColumnDefinitions="*,Auto" Height="36">
                                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                    <Button Grid.Column="1" Content="🗑️" Click="OnRemoveObjectHotspotClicked" CommandParameter="{Binding}" Background="Transparent" Foreground="#E74C3C" FontSize="10" Padding="4,2" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <!-- Hotspot Property Inspector stacked below -->
                                                    <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,12,0,0" IsVisible="{Binding #ObjectHotspotsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                        <StackPanel Spacing="10" DataContext="{Binding #ObjectHotspotsList.SelectedItem}" x:DataType="models:ScreenHotspot">
                                                        <TextBlock Text="Edit Hotspot Properties" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                                        
                                                        <TextBlock Text="Button Name (Designer Only):" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                        <TextBox Text="{Binding Name, Mode=TwoWay}" Watermark="Button Name" FontSize="11" Background="{DynamicResource CardBg}"/>
                                                        
                                                        <TextBlock Text="Linked Action:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                        <ComboBox SelectedItem="{Binding LinkedActionId, Mode=TwoWay, Converter={x:Static views:ActionToIdStringConverter.Instance}}" ItemsSource="{Binding $parent[TabControl].DataContext.Actions}" HorizontalAlignment="Stretch" Background="{DynamicResource CardBg}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:Action">
                                                                    <TextBlock Text="{Binding Name}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>

                                                        <!-- Position grid -->
                                                        <TextBlock Text="Coordinates &amp; Dimensions (%):" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                        <Grid ColumnDefinitions="*,*,*,*" Margin="0,2">
                                                            <StackPanel Margin="0,0,4,0">
                                                                <TextBlock Text="Left (X)" FontSize="9" Foreground="Gray"/>
                                                                <TextBox Text="{Binding X, Mode=TwoWay}" FontSize="10" Padding="4,3"/>
                                                            </StackPanel>
                                                            <StackPanel Margin="4,0" Grid.Column="1">
                                                                <TextBlock Text="Top (Y)" FontSize="9" Foreground="Gray"/>
                                                                <TextBox Text="{Binding Y, Mode=TwoWay}" FontSize="10" Padding="4,3"/>
                                                            </StackPanel>
                                                            <StackPanel Margin="4,0" Grid.Column="2">
                                                                <TextBlock Text="Width" FontSize="9" Foreground="Gray"/>
                                                                <TextBox Text="{Binding Width, Mode=TwoWay}" FontSize="10" Padding="4,3"/>
                                                            </StackPanel>
                                                            <StackPanel Margin="4,0,0,0" Grid.Column="3">
                                                                <TextBlock Text="Height" FontSize="9" Foreground="Gray"/>
                                                                <TextBox Text="{Binding Height, Mode=TwoWay}" FontSize="10" Padding="4,3"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        
                                                        <TextBlock Text="Style Type:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                        <ComboBox SelectedItem="{Binding StyleType, Mode=TwoWay}" HorizontalAlignment="Stretch" FontSize="11" Background="{DynamicResource CardBg}">
                                                            <ComboBox.Items>
                                                                <sys:String>Invisible</sys:String>
                                                                <sys:String>TextButton</sys:String>
                                                                <sys:String>IconButton</sys:String>
                                                                <sys:String>ImageButton</sys:String>
                                                                <sys:String>CustomBorder</sys:String>
                                                            </ComboBox.Items>
                                                        </ComboBox>
                                                        
                                                        <StackPanel Spacing="10" IsVisible="{Binding StyleType, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter=Invisible}">
                                                            <TextBlock Text="Label Text:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                            <TextBox Text="{Binding LabelText, Mode=TwoWay}" Watermark="Label (supports {var.name})" FontSize="11" Background="{DynamicResource CardBg}"/>
                                                            
                                                            <TextBlock Text="Background Color (HTML Hex):" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                            <TextBox Text="{Binding BackgroundColor, Mode=TwoWay}" Watermark="#1A1A1A or {var.color}" FontSize="11" Background="{DynamicResource CardBg}"/>

                                                            <TextBlock Text="Font Color (HTML Hex):" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                            <TextBox Text="{Binding FontColor, Mode=TwoWay}" Watermark="#FFFFFF or {var.color}" FontSize="11" Background="{DynamicResource CardBg}"/>

                                                             <TextBlock Text="Font Size:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                             <TextBox Text="{Binding FontSize, Mode=TwoWay}" FontSize="11" Background="{DynamicResource CardBg}"/>

                                                             <TextBlock Text="Image Asset ID / Template:" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                                             <ComboBox Text="{Binding ImageAssetId, Mode=TwoWay}" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CurrentGame.MediaAssets}" HorizontalAlignment="Stretch" IsEditable="True" Background="{DynamicResource CardBg}">
                                                                 <ComboBox.ItemTemplate>
                                                                     <DataTemplate x:DataType="models:MediaAsset">
                                                                         <TextBlock Text="{Binding OriginalFileName}"/>
                                                                     </DataTemplate>
                                                                 </ComboBox.ItemTemplate>
                                                             </ComboBox>
                                                         </StackPanel>
                                                     </StackPanel>
                                                 </Border>
                                             </StackPanel>
                                         </ScrollViewer>
                                            
                                            <!-- Column 1: Interactive Screen Canvas Coordinates Preview -->
                                            <StackPanel Grid.Column="1" Spacing="10" Margin="16,0,0,0">
                                                <TextBlock Text="Live Screen Coordinates Preview" FontSize="14" FontWeight="Bold" Foreground="#8E2DE2"/>
                                                <Border Background="Black" BorderBrush="#3A3A4C" BorderThickness="2" CornerRadius="4" ClipToBounds="True" Height="450">
                                                    <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <Canvas Width="100" Height="56.25" Background="#14141F">
                                                            <!-- Backdrop Image in Preview -->
                                                            <Image Source="{Binding InteractiveScreenSettings.BackdropAssetId, Converter={x:Static views:AssetIdToBitmapConverter.Instance}}" Width="100" Height="56.25" Stretch="UniformToFill"/>
                                                            <TextBlock Text="Interactive Screen Canvas Preview (16:9)" FontSize="4" Foreground="Gray" Canvas.Left="4" Canvas.Top="4" IsVisible="False"/>
                                                            
                                                             <ItemsControl ItemsSource="{Binding InteractiveScreenSettings.Hotspots}">
                                                                 <ItemsControl.ItemsPanel>
                                                                     <ItemsPanelTemplate>
                                                                         <Canvas Width="100" Height="56.25"/>
                                                                     </ItemsPanelTemplate>
                                                                 </ItemsControl.ItemsPanel>
                                                                 <ItemsControl.Styles>
                                                                     <Style Selector="ContentPresenter" x:DataType="models:ScreenHotspot">
                                                                         <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                                         <Setter Property="Canvas.Top" Value="{Binding Y, Converter={x:Static views:YScaleConverter.Instance}}"/>
                                                                     </Style>
                                                                 </ItemsControl.Styles>
                                                                 <ItemsControl.ItemTemplate>
                                                                     <DataTemplate x:DataType="models:ScreenHotspot">
                                                                         <Border Width="{Binding Width}" Height="{Binding Height, Converter={x:Static views:YScaleConverter.Instance}}" BorderBrush="{Binding FontColor, Converter={x:Static views:HexToBrushConverter.Instance}}" BorderThickness="0.6" Background="{Binding BackgroundColor, Converter={x:Static views:HexToBrushConverter.Instance}}" CornerRadius="0.5" Cursor="Hand" PointerPressed="OnHotspotPointerPressed" PointerMoved="OnHotspotPointerMoved" PointerReleased="OnHotspotPointerReleased">
                                                                             <Grid>
                                                                                 <!-- Button background icon/image -->
                                                                                 <Image Source="{Binding ImageAssetId, Converter={x:Static views:AssetIdToBitmapConverter.Instance}}" Stretch="UniformToFill"/>
                                                                                 <TextBlock Text="{Binding DisplayName}" FontSize="{Binding FontSize, Converter={x:Static views:HotspotFontSizeScaleConverter.Instance}}" Foreground="{Binding FontColor, Converter={x:Static views:HexToBrushConverter.Instance}}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                             </Grid>
                                                                         </Border>
                                                                     </DataTemplate>
                                                                 </ItemsControl.ItemTemplate>
                                                             </ItemsControl>
                                                         </Canvas>
                                                    </Viewbox>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 5. Global Variables -->
                <Grid IsVisible="{Binding ActiveView, ConverterParameter=Variables, Converter={x:Static ObjectConverters.Equal}}" ColumnDefinitions="300,*">
                    <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                <TextBlock Grid.Column="0" Text="Game Variables" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Sort A-Z ⇅" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Variables.SortCommand}" Background="Transparent" Foreground="#8E2DE2" FontSize="11" Padding="4,2"/>
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Variables.Variables}" Background="Transparent" x:Name="VarsList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:GameVariable">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,10,0,0" ColumnSpacing="8">
                                <Button Grid.Column="0" Content="+ Define Variable" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Variables.AddVariableCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="Delete" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteVariableCommand}" CommandParameter="{Binding #VarsList.SelectedItem}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#C0392B"/>
                            </Grid>
                        </Grid>
                    </Border>
                    
                    <Border Grid.Column="1" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="20" IsVisible="{Binding #VarsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16" DataContext="{Binding #VarsList.SelectedItem}" x:DataType="models:GameVariable" Margin="0,0,12,0">
                                <TextBlock Text="Edit Variable" FontSize="18" FontWeight="Bold" Foreground="#8E2DE2"/>
                                
                                <TextBlock Text="Name:" Foreground="{DynamicResource TextMuted}"/>
                                <TextBox Text="{Binding Name, Mode=TwoWay}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"/>
                                
                                <TextBlock Text="Type Hint:" Foreground="{DynamicResource TextMuted}"/>
                                <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Variables.VariableTypes}"
                                          SelectedItem="{Binding Type, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"/>

                                <TextBlock Text="Initial Value:" Foreground="{DynamicResource TextMuted}"/>
                                <TextBox Text="{Binding Value, Mode=TwoWay}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"/>

                                <!-- Validation Warning -->
                                <TextBlock Text="{Binding ValidationWarning}" Foreground="#FF6B6B" FontWeight="SemiBold" FontSize="12"
                                           IsVisible="{Binding ValidationWarning, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                                <!-- Type Instructions Helper Cards -->
                                <!-- text / string -->
                                <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12"
                                        IsVisible="{Binding Type, ConverterParameter=string, Converter={x:Static ObjectConverters.Equal}}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="💡 String Variable Info" FontWeight="Bold" Foreground="#8E2DE2" FontSize="13"/>
                                        <TextBlock Text="• Stores raw text, descriptions, or choices." FontSize="11" Foreground="DarkGray" TextWrapping="Wrap"/>
                                        <TextBlock Text="• Use in messages/descriptions with: {variable_name}" FontSize="11" Foreground="DarkGray" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- int / number -->
                                <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12"
                                        IsVisible="{Binding Type, ConverterParameter=int, Converter={x:Static ObjectConverters.Equal}}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="💡 Numeric Variable Info" FontWeight="Bold" Foreground="#8E2DE2" FontSize="13"/>
                                        <TextBlock Text="• Stores integer or floating point numbers (e.g. gold, health, level)." FontSize="11" Foreground="DarkGray" TextWrapping="Wrap"/>
                                        <TextBlock Text="• Check value in actions using mathematical conditions." FontSize="11" Foreground="DarkGray" TextWrapping="Wrap"/>
                                        <TextBlock Text="• Embed in text with: {variable_name}" FontSize="11" Foreground="DarkGray" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                
                                <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12"
                                        IsVisible="{Binding Type, ConverterParameter=number, Converter={x:Static ObjectConverters.Equal}}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="💡 Numeric Variable Info" FontWeight="Bold" Foreground="#8E2DE2" FontSize="13"/>
                                        <TextBlock Text="• Stores integer or floating point numbers (e.g. gold, health, level)." FontSize="11" Foreground="DarkGray" TextWrapping="Wrap"/>
                                        <TextBlock Text="• Check value in actions using mathematical conditions." FontSize="11" Foreground="DarkGray" TextWrapping="Wrap"/>
                                        <TextBlock Text="• Embed in text with: {variable_name}" FontSize="11" Foreground="DarkGray" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- bool / boolean -->
                                <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12"
                                        IsVisible="{Binding Type, ConverterParameter=bool, Converter={x:Static ObjectConverters.Equal}}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="💡 True / False Variable Info" FontWeight="Bold" Foreground="#8E2DE2" FontSize="13"/>
                                        <TextBlock Text="• Stores boolean status. Initial value must be 'true' or 'false'." FontSize="11" Foreground="DarkGray" TextWrapping="Wrap"/>
                                        <TextBlock Text="• Avoid numeric 1 or 0 values to prevent logic errors." FontSize="11" Foreground="DarkGray" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- datetime -->
                                <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12"
                                        IsVisible="{Binding Type, ConverterParameter=datetime, Converter={x:Static ObjectConverters.Equal}}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="💡 Date &amp; Time Variable Info" FontWeight="Bold" Foreground="#8E2DE2" FontSize="13"/>
                                        <TextBlock Text="• Must be formatted as ISO-8601 (e.g. 2026-06-04T12:00:00)." FontSize="11" Foreground="DarkGray" TextWrapping="Wrap"/>
                                        <TextBlock Text="• Display just the Date part using: {variable_name:date}" FontSize="11" Foreground="LightGray" TextWrapping="Wrap"/>
                                        <TextBlock Text="• Display just the Time part using: {variable_name:time}" FontSize="11" Foreground="LightGray" TextWrapping="Wrap"/>
                                        <TextBlock Text="• Display full Date &amp; Time using: {variable_name:datetime}" FontSize="11" Foreground="LightGray" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- array / Multi-Dimensional Array Grid -->
                                <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12"
                                        IsVisible="{Binding Type, ConverterParameter=array, Converter={x:Static ObjectConverters.Equal}}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="💡 Multi-Dimensional Array Setup" FontWeight="Bold" Foreground="#8E2DE2" FontSize="13"/>
                                        <TextBlock Text="• Columns define variables or fields. Rows store row records." FontSize="11" Foreground="DarkGray" TextWrapping="Wrap"/>
                                        
                                        <!-- Column configuration -->
                                        <TextBlock Text="Columns:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                        <ItemsControl ItemsSource="{Binding Columns}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                        <TextBox Text="{Binding .}" Grid.Column="0" Height="28" Background="{DynamicResource CardBg}" FontSize="11" LostFocus="OnColumnTextBoxLostFocus"/>
                                                        <!-- Delete column button -->
                                                        <Button Grid.Column="1" Content="✕" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Variables.RemoveColumnCommand}" Height="28" Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center">
                                                            <Button.CommandParameter>
                                                                <MultiBinding Converter="{x:Static vm:MainWindowViewModel.MakeTupleConverter}">
                                                                    <Binding Path="$parent[Border].DataContext"/>
                                                                    <Binding Path="."/>
                                                                </MultiBinding>
                                                            </Button.CommandParameter>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="+ Add Column" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Variables.AddColumnCommand}" CommandParameter="{Binding}" Height="28" Padding="10,2" FontSize="11"/>

                                        <!-- Rows seeding -->
                                        <TextBlock Text="Initial Row Data:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,0"/>
                                        
                                        <!-- Dynamically generated column header label row for rows -->
                                        <ItemsControl ItemsSource="{Binding Columns}" IsVisible="{Binding Columns.Count}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,84,2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{Binding}" Width="100" FontSize="10" FontWeight="Bold" Foreground="#8E2DE2" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Scrollable grid list of rows -->
                                        <ScrollViewer MaxHeight="200">
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                                            <!-- Values in this row -->
                                                            <ItemsControl ItemsSource="{Binding}" Grid.Column="0">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <!-- Direct edit of cell text -->
                                                                        <TextBox Text="{Binding .}" Width="100" Height="28" Background="{DynamicResource CardBg}" FontSize="11" LostFocus="OnCellTextBoxLostFocus"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <!-- Delete row button -->
                                                            <Button Grid.Column="1" Content="Delete Row" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Variables.RemoveRowCommand}" Height="28" FontSize="10" Padding="6,2" Margin="8,0,0,0">
                                                                <Button.CommandParameter>
                                                                    <MultiBinding Converter="{x:Static vm:MainWindowViewModel.MakeTupleConverter}">
                                                                        <Binding Path="$parent[Border].DataContext"/>
                                                                        <Binding Path="."/>
                                                                    </MultiBinding>
                                                                </Button.CommandParameter>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <Button Content="+ Add Row" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Variables.AddRowCommand}" CommandParameter="{Binding}" Height="28" Padding="10,2" FontSize="11"/>
                                    </StackPanel>
                                 </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 6. System Timers -->
                <Grid IsVisible="{Binding ActiveView, ConverterParameter=Timers, Converter={x:Static ObjectConverters.Equal}}" ColumnDefinitions="300,*">
                    <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                <TextBlock Grid.Column="0" Text="Game Timers" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Sort A-Z ⇅" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Timers.SortCommand}" Background="Transparent" Foreground="#8E2DE2" FontSize="11" Padding="4,2"/>
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Timers.Timers}" Background="Transparent" SelectedIndex="0" x:Name="TimersList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:GameTimer">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,10,0,0" ColumnSpacing="8">
                                <Button Grid.Column="0" Content="+ Add Timer" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Timers.AddTimerCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="Delete" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteTimerCommand}" CommandParameter="{Binding #TimersList.SelectedItem}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#C0392B"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="20" IsVisible="{Binding #TimersList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="16" DataContext="{Binding #TimersList.SelectedItem}" x:DataType="models:GameTimer">
                            <TextBlock Text="Edit Timer" FontSize="18" FontWeight="Bold" Foreground="#8E2DE2"/>
                            
                            <TextBlock Text="Name" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding Name, Mode=TwoWay}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" Padding="8,6"/>
                                <Button Grid.Column="1" Content="✨" Click="OnCoAuthorNameClicked" Margin="8,0,0,0" Width="36" Height="34" Background="#8E2DE2" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            </Grid>
                            
                            <TextBlock Text="Interval (Seconds)" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding IntervalSeconds, Mode=TwoWay}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"/>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                <TextBlock Text="Timer Active" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsActive, Mode=TwoWay}" OnContent="" OffContent="" Foreground="White" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                <TextBlock Text="Repeating" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsRepeating, Mode=TwoWay}" OnContent="" OffContent="" Foreground="White" VerticalAlignment="Center"/>
                            </Grid>

                            <Button Content="✨ Edit Timer Action Visually" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StartEditingActionCommand}" CommandParameter="{Binding}" Background="#8E2DE2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 7. Global Functions -->
                <Grid IsVisible="{Binding ActiveView, ConverterParameter=Functions, Converter={x:Static ObjectConverters.Equal}}" ColumnDefinitions="300,*">
                    <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                <TextBlock Grid.Column="0" Text="Global Scripting Functions" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Sort A-Z ⇅" Command="{Binding Functions.SortCommand}" Background="Transparent" Foreground="#8E2DE2" FontSize="11" Padding="4,2"/>
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding CurrentGame.Functions}" Background="Transparent" SelectedIndex="0" x:Name="FuncsList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:GlobalFunction">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,10,0,0" ColumnSpacing="8">
                                <Button Grid.Column="0" Content="+ Create Function" Command="{Binding Functions.AddFunctionCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="Delete" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteFunctionCommand}" CommandParameter="{Binding #FuncsList.SelectedItem}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#C0392B"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16" DataContext="{Binding #FuncsList.SelectedItem}" x:DataType="models:GlobalFunction">
                            <TextBlock Text="Edit Function Routine" FontSize="18" FontWeight="Bold" Foreground="#8E2DE2"/>
                            
                            <TextBlock Text="Function Name:" Foreground="{DynamicResource TextMuted}"/>
                            <TextBox Text="{Binding Name, Mode=TwoWay}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"/>

                            <TextBlock Text="Trigger Events:" Foreground="{DynamicResource TextMuted}"/>
                            <Border Background="{DynamicResource InputBg}" CornerRadius="4" Padding="12">
                                <TextBlock Text="This function acts as a reusable sub-routine that can be called from any command block." FontSize="12" FontStyle="Italic" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </Border>

                            <Button Content="✨ Edit Function Script Visually" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StartEditingActionCommand}" CommandParameter="{Binding}" Background="#8E2DE2" Foreground="White" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 7b. Splash Screen Settings Tab -->
                <ScrollViewer IsVisible="{Binding ActiveView, ConverterParameter=SplashScreen, Converter={x:Static ObjectConverters.Equal}}">
                    <StackPanel Spacing="16" Margin="0,0,0,20">
                        <!-- Top Controls: Multiple Splash Screens Management -->
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="Select Setup:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontWeight="Bold"/>
                                    <ComboBox ItemsSource="{Binding CurrentGame.SplashScreens}" SelectedItem="{Binding SelectedSplashScreen, Mode=TwoWay}" Width="250" Background="{DynamicResource InputBg}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:SplashScreenSettings">
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <Button Grid.Column="1" Content="➕ Add Setup" Command="{Binding AddSplashScreenCommand}" Margin="10,0,0,0"/>
                                <Button Grid.Column="2" Content="❌ Delete Setup" Command="{Binding DeleteSplashScreenCommand}" Margin="10,0,0,0"/>
                                
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="20,0,0,0" DataContext="{Binding SelectedSplashScreen}" x:DataType="models:SplashScreenSettings">
                                    <TextBlock Text="Rename Setup:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBox Text="{Binding Name, Mode=TwoWay}" Width="180" Background="{DynamicResource InputBg}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*, *" HorizontalAlignment="Stretch" DataContext="{Binding SplashScreen}" x:DataType="models:SplashScreenSettings">
                        <!-- Left Side: Customization Parameters -->
                        <StackPanel Grid.Column="0" Spacing="20" Margin="0,0,24,0">
                            <TextBlock Text="Splash Screen Settings" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextNormal}"/>
                            
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="🎨 Active Setup" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                                    
                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="270,*">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Enable Startup Splash Screen (Global):" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                                        <ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CurrentGame.SplashScreen.Enabled, Mode=TwoWay}" OnContent="" OffContent=""/>
                                        
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Use as Startup Splash Screen:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,10,0,0"/>
                                        <ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSelectedSplashDefault, Mode=TwoWay}" IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CanToggleDefaultSplash}" OnContent="" OffContent="" Margin="0,10,0,0"/>
                                        
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Splash Mode:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,10,0,0"/>
                                        <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding Mode, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}" Margin="0,10,0,0">
                                            <x:String>ImageAndText</x:String>
                                            <x:String>Video</x:String>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
 
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="🎬 Cinematic Customization" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                                    
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="200,*">
                                        <!-- Image Mode Background Selector -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Background Image Asset:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" IsVisible="{Binding Mode, ConverterParameter=ImageAndText, Converter={x:Static ObjectConverters.Equal}}"/>
                                        <ComboBox x:Name="SplashImageComboBox" Grid.Row="0" Grid.Column="1" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ImageMediaAssets}" SelectedItem="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedSplashImageAsset, Mode=OneWay}" SelectionChanged="OnSplashImageSelectionChanged" HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}" IsVisible="{Binding Mode, ConverterParameter=ImageAndText, Converter={x:Static ObjectConverters.Equal}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:MediaAsset">
                                                    <TextBlock Text="{Binding OriginalFileName}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Video Mode Video Selector -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Background Video Asset:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" IsVisible="{Binding Mode, ConverterParameter=Video, Converter={x:Static ObjectConverters.Equal}}"/>
                                        <ComboBox x:Name="SplashVideoComboBox" Grid.Row="0" Grid.Column="1" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).VideoMediaAssets}" SelectedItem="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedSplashVideoAsset, Mode=OneWay}" SelectionChanged="OnSplashVideoSelectionChanged" HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}" IsVisible="{Binding Mode, ConverterParameter=Video, Converter={x:Static ObjectConverters.Equal}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:MediaAsset">
                                                    <TextBlock Text="{Binding OriginalFileName}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
 
                                        <!-- Dramatic Sound / Music Selector (Ignored & Hidden in Video Mode) -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Dramatic Sound / Music:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,10,0,0" IsVisible="{Binding Mode, ConverterParameter=Video, Converter={x:Static ObjectConverters.NotEqual}}"/>
                                        <ComboBox x:Name="SplashSoundComboBox" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AudioMediaAssets}" SelectedItem="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedSplashSoundAsset, Mode=OneWay}" SelectionChanged="OnSplashSoundSelectionChanged" HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}" Margin="0,10,0,0" IsVisible="{Binding Mode, ConverterParameter=Video, Converter={x:Static ObjectConverters.NotEqual}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:MediaAsset">
                                                    <TextBlock Text="{Binding OriginalFileName}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
 
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Transition Style Effect:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,10,0,0"/>
                                        <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding TransitionStyle, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}" Margin="0,10,0,0">
                                            <x:String>Fade</x:String>
                                            <x:String>Rise</x:String>
                                            <x:String>Cinematic</x:String>
                                            <x:String>Glitch</x:String>
                                            <x:String>Exposure</x:String>
                                            <x:String>CRT</x:String>
                                            <x:String>RGBSplit</x:String>
                                            <x:String>ParticleSmoke</x:String>
                                            <x:String>ParticleSand</x:String>
                                            <x:String>ParticleEmbers</x:String>
                                            <x:String>ParticleRain</x:String>
                                            <x:String>ParticleSnow</x:String>
                                            <x:String>SoundReactive</x:String>
                                        </ComboBox>
 
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Display Title Text:" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,10,0,0"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Text, Mode=TwoWay}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" Margin="0,10,0,0"/>
 
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Font Color (Hex):" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,10,0,0"/>
                                        <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                            <TextBox Grid.Column="0" Text="{Binding FontColor, Mode=TwoWay}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"/>
                                            <ColorPicker Grid.Column="1" Color="{Binding FontColor, Mode=TwoWay, Converter={x:Static views:HexToColorConverter.Instance}}" Margin="8,0,0,0"/>
                                        </Grid>
 
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Font Size (pt):" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,10,0,0"/>
                                        <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding FontSize, Mode=TwoWay}" Minimum="10" Maximum="120" Background="{DynamicResource InputBg}" Margin="0,10,0,0"/>
                                    </Grid>
                                    <TextBlock Text="ℹ️ Particle effects (Smoke, Sand) are simulated approximations in this preview. They render as high-fidelity visual elements in the Unity Player." FontSize="11" Foreground="#4A90E2" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
 
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="⏱️ Animation Timeline (Seconds)" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                                    
                                    <TextBlock Text="Fade-in Duration:" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Slider Grid.Column="0" Value="{Binding FadeInDuration, Mode=TwoWay}" Minimum="0.1" Maximum="10.0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FadeInDuration, StringFormat='{}{0:F1}s'}" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Foreground="{DynamicResource TextNormal}"/>
                                    </Grid>
                                    
                                    <TextBlock Text="Hold/Display Duration:" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Slider Grid.Column="0" Value="{Binding DisplayDuration, Mode=TwoWay}" Minimum="0.5" Maximum="20.0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayDuration, StringFormat='{}{0:F1}s'}" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Foreground="{DynamicResource TextNormal}"/>
                                    </Grid>
                                    
                                    <TextBlock Text="Fade-out Duration:" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Slider Grid.Column="0" Value="{Binding FadeOutDuration, Mode=TwoWay}" Minimum="0.1" Maximum="10.0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FadeOutDuration, StringFormat='{}{0:F1}s'}" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Foreground="{DynamicResource TextNormal}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="🖼️ Viewport Border Customization" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                                    
                                    <TextBlock Text="Border Color (Hex):" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding BorderColor, Mode=TwoWay}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"/>
                                        <ColorPicker Grid.Column="1" Color="{Binding BorderColor, Mode=TwoWay, Converter={x:Static views:HexToColorConverter.Instance}}" Margin="8,0,0,0"/>
                                    </Grid>
                                    
                                    <TextBlock Text="Border Thickness (px):" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Slider Grid.Column="0" Value="{Binding BorderWidth, Mode=TwoWay}" Minimum="0" Maximum="24" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                        <TextBlock Grid.Column="1" Text="{Binding BorderWidth, StringFormat='{}{0:0}px'}" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Foreground="{DynamicResource TextNormal}"/>
                                    </Grid>
                                    
                                    <TextBlock Text="Corner Radius (Rounding):" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Slider Grid.Column="0" Value="{Binding BorderRadius, Mode=TwoWay}" Minimum="0" Maximum="40" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                        <TextBlock Grid.Column="1" Text="{Binding BorderRadius, StringFormat='{}{0:0}px'}" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Foreground="{DynamicResource TextNormal}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
 
                        <!-- Right Side: Live WYSIWYG Screen Coordinates & Preview -->
                        <StackPanel Grid.Column="1" Spacing="20" VerticalAlignment="Top">
                            <TextBlock Text="Live Screen Preview" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextNormal}"/>
                            
                            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="Title Text Alignment Coordinates:" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TextX, StringFormat='X: {0:0}%'}" Foreground="#8E2DE2" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TextY, StringFormat='Y: {0:0}%'}" Foreground="#8E2DE2" FontWeight="Bold"/>
                                    </StackPanel>
 
                                    <!-- Sliders to position text visually -->
                                    <TextBlock Text="Horizontal Alignment (X):" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                    <Slider Value="{Binding TextX, Mode=TwoWay}" Minimum="0" Maximum="100"/>
 
                                    <TextBlock Text="Vertical Alignment (Y):" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                    <Slider Value="{Binding TextY, Mode=TwoWay}" Minimum="0" Maximum="100"/>
 
                                    <!-- Image Mode Preview: Viewbox with absolute layout -->
                                     <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxHeight="450"
                                              IsVisible="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsSplashVideoMode}">
                                         <Border Width="1920" Height="1080" Background="Black" BorderBrush="#3A3A4C" BorderThickness="2" CornerRadius="4" ClipToBounds="True">
                                             <Canvas Width="1920" Height="1080">
                                                 <!-- Image Mode: Dynamically loaded custom background image asset -->
                                                 <Image Width="1920" Height="1080" 
                                                        Source="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SplashBackgroundPath, Converter={x:Static views:ImagePathToBitmapConverter.Instance}}" 
                                                        Stretch="UniformToFill" 
                                                        Opacity="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SplashPreviewImageOpacity}"
                                                        RenderTransformOrigin="50%,50%">
                                                     <Image.RenderTransform>
                                                         <ScaleTransform ScaleX="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SplashPreviewImageScale}"
                                                                         ScaleY="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SplashPreviewImageScale}"/>
                                                     </Image.RenderTransform>
                                                 </Image>
                                                 
                                                 <!-- Image Mode Text Overlay: Only visible when NOT video mode -->
                                                 <TextBlock Text="{Binding Text}" 
                                                            Foreground="{Binding FontColor}" 
                                                            FontWeight="Bold" 
                                                            FontSize="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SplashPreviewFontSize}" 
                                                            Canvas.Left="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SplashPreviewTextLeftWithOffset}" 
                                                            Canvas.Top="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SplashPreviewTextTopWithOffset}" 
                                                            Opacity="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SplashPreviewTextOpacity}"
                                                            TextWrapping="Wrap"
                                                            Width="2000"
                                                            Height="200"
                                                            Margin="-1000,-100,0,0"
                                                            TextAlignment="Center"
                                                            RenderTransformOrigin="50%,50%">
                                                     <TextBlock.RenderTransform>
                                                         <ScaleTransform ScaleX="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SplashPreviewTextScale}"
                                                                         ScaleY="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SplashPreviewTextScale}"/>
                                                     </TextBlock.RenderTransform>
                                                 </TextBlock>
                                             </Canvas>
                                         </Border>
                                     </Viewbox>

                                     <!-- Video Mode Preview: Dedicated 16:9 native browser rendering to prevent layout overflow -->
                                     <Panel x:Name="SplashPreviewParentPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="200" MaxHeight="450"
                                            IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSplashVideoPreviewVisible}">
                                         <Border x:Name="SplashPreviewContainer" Width="640" Height="360" Background="Black" BorderBrush="#3A3A4C" BorderThickness="2" CornerRadius="4" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                                             <wv:NativeWebView x:Name="SplashPreviewWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                               IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSplashVideoPreviewVisible}"/>
                                         </Border>
                                     </Panel>
                                    
                                    <Button Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PreviewButtonText}" 
                                            IsEnabled="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsPlayingSplashPreview}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PreviewTransitionCommand}" 
                                            Background="#8E2DE2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,8" FontSize="13"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                    </ScrollViewer>
                    
                    <!-- 7c. HUD Theme Editor Tab -->
                    <ScrollViewer IsVisible="{Binding ActiveView, ConverterParameter=Theme, Converter={x:Static ObjectConverters.Equal}}">
                    <StackPanel Spacing="16" Margin="0,0,0,20">
                    <Grid ColumnDefinitions="*, *" HorizontalAlignment="Stretch" DataContext="{Binding CurrentGame.Theme}" x:DataType="models:ThemeSettings">
                    <!-- Left Column: Customization Parameters -->
                    <StackPanel Grid.Column="0" Spacing="20" Margin="0,0,24,0">
                    <TextBlock Text="HUD Theme Editor" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextNormal}"/>
                    
                    <!-- Preset Manager -->
                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="14">
                    <TextBlock Text="💾 Theme Presets &amp; Library" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                    
                    <Grid ColumnDefinitions="*,Auto">
                    <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ThemePresets}" 
                    SelectedItem="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedThemePreset, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}" PlaceholderText="Select Theme Preset..."/>
                    <Button Grid.Column="1" Content="Delete" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteThemePresetCommand}" Margin="8,0,0,0"/>
                    </Grid>
                    
                    <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NewPresetName, Mode=TwoWay}" PlaceholderText="Preset Name..." Background="{DynamicResource InputBg}"/>
                    <Button Grid.Column="1" Content="Save Preset" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SaveThemePresetCommand}" Margin="8,0,0,0"/>
                    </Grid>
                    </StackPanel>
                    </Border>
                    
                    <!-- Panel 1: Colors & Rounded Corners -->
                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="14">
                    <TextBlock Text="🎨 Colors &amp; Styling" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                    
                    <TextBlock Text="Primary HUD Background Color:" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                    <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding PrimaryBgColor, Mode=TwoWay}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"/>
                    <ColorPicker Color="{Binding PrimaryBgColor, Mode=TwoWay, Converter={x:Static views:HexToColorConverter.Instance}}" Margin="8,0,0,0" Grid.Column="1"/>
                    </Grid>
                    
                    <TextBlock Text="Main Narrative Text Color:" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                    <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding TextMainColor, Mode=TwoWay}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"/>
                    <ColorPicker Color="{Binding TextMainColor, Mode=TwoWay, Converter={x:Static views:HexToColorConverter.Instance}}" Margin="8,0,0,0" Grid.Column="1"/>
                    </Grid>
                    
                    <TextBlock Text="Accent/Border Color:" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                    <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding BorderAccentColor, Mode=TwoWay}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"/>
                    <ColorPicker Color="{Binding BorderAccentColor, Mode=TwoWay, Converter={x:Static views:HexToColorConverter.Instance}}" Margin="8,0,0,0" Grid.Column="1"/>
                    </Grid>
                    
                    <TextBlock Text="Corner Radius (Rounding):" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                    <Grid ColumnDefinitions="*,Auto">
                    <Slider Value="{Binding BorderRadius, Mode=TwoWay}" Minimum="0" Maximum="32" IsSnapToTickEnabled="True" TickFrequency="1" Grid.Column="0"/>
                    <TextBlock Text="{Binding BorderRadius, StringFormat='{}{0:0}px'}" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Foreground="{DynamicResource TextNormal}" Grid.Column="1"/>
                    </Grid>
                    
                    <TextBlock Text="Panel Padding (spacing inside HUD panels):" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                    <Grid ColumnDefinitions="*,Auto">
                    <Slider Value="{Binding PanelPadding, Mode=TwoWay}" Minimum="0" Maximum="40" IsSnapToTickEnabled="True" TickFrequency="1" Grid.Column="0"/>
                    <TextBlock Text="{Binding PanelPadding, StringFormat='{}{0:0}px'}" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Foreground="{DynamicResource TextNormal}" Grid.Column="1"/>
                    </Grid>
                    </StackPanel>
                    </Border>
                    
                    <!-- Panel 2: Alignment & Docking -->
                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="14">
                    <TextBlock Text="🧱 Layout Alignment &amp; Docking" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                    
                    <TextBlock Text="Room Items Panel Dock Position:" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                    <ComboBox SelectedItem="{Binding RoomItemsDockPosition, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}">
                    <x:String>Right</x:String>
                    <x:String>Left</x:String>
                    <x:String>Bottom</x:String>
                    </ComboBox>
                    
                    <TextBlock Text="Inventory Panel Dock Position:" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                    <ComboBox SelectedItem="{Binding InventoryDockPosition, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}">
                    <x:String>Right</x:String>
                    <x:String>Left</x:String>
                    <x:String>Bottom</x:String>
                    </ComboBox>
                    
                    <TextBlock Text="Directions Compass Dock Position:" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                    <ComboBox SelectedItem="{Binding NavigationDockPosition, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}">
                    <x:String>Right</x:String>
                    <x:String>Left</x:String>
                    <x:String>Bottom</x:String>
                    </ComboBox>
                    
                    <Separator Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8,0,8"/>
                    
                    <TextBlock Text="Main Narrative Text Box Alignment:" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                    <ComboBox SelectedItem="{Binding TextBoxAlignment, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}">
                    <x:String>Left</x:String>
                    <x:String>Center</x:String>
                    <x:String>Right</x:String>
                    </ComboBox>
                    
                    <TextBlock Text="Narrative Text Box Width (pixels):" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                    <Grid ColumnDefinitions="*,Auto">
                    <Slider Value="{Binding TextBoxWidth, Mode=TwoWay}" Minimum="300" Maximum="1000" IsSnapToTickEnabled="True" TickFrequency="10" Grid.Column="0"/>
                    <TextBlock Text="{Binding TextBoxWidth, StringFormat='{}{0:0}px'}" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Foreground="{DynamicResource TextNormal}" Grid.Column="1"/>
                    </Grid>
                    
                    <TextBlock Text="Narrative Text Box Height (pixels):" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                    <Grid ColumnDefinitions="*,Auto">
                    <Slider Value="{Binding TextBoxHeight, Mode=TwoWay}" Minimum="100" Maximum="600" IsSnapToTickEnabled="True" TickFrequency="10" Grid.Column="0"/>
                    <TextBlock Text="{Binding TextBoxHeight, StringFormat='{}{0:0}px'}" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Foreground="{DynamicResource TextNormal}" Grid.Column="1"/>
                    </Grid>
                    
                    <Separator Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8,0,8"/>
                    
                    <TextBlock Text="Sidebars Panel Width (pixels):" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                    <Grid ColumnDefinitions="*,Auto">
                    <Slider Value="{Binding SidebarWidth, Mode=TwoWay}" Minimum="200" Maximum="500" IsSnapToTickEnabled="True" TickFrequency="10" Grid.Column="0"/>
                    <TextBlock Text="{Binding SidebarWidth, StringFormat='{}{0:0}px'}" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Foreground="{DynamicResource TextNormal}" Grid.Column="1"/>
                    </Grid>
                    
                    <TextBlock Text="Player Portrait Panel Alignment:" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                    <ComboBox SelectedItem="{Binding PortraitAlignment, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}">
                    <x:String>TopLeft</x:String>
                    <x:String>TopRight</x:String>
                    <x:String>BottomLeft</x:String>
                    <x:String>BottomRight</x:String>
                    </ComboBox>
                    </StackPanel>
                    </Border>
                    
                    <!-- Panel 3: Typography & Assets -->
                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="14">
                    <TextBlock Text="🖼️ Assets &amp; Fonts" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                    
                    <TextBlock Text="Custom Font Asset:" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).FontMediaAssets}" 
                    SelectedItem="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedThemeFont, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}" PlaceholderText="Select Font Asset (TTF/OTF)..."/>
                    
                    <TextBlock Text="HUD Background Image/Texture:" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                    <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ImageMediaAssets}" 
                    SelectedItem="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedThemeBackground, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}" PlaceholderText="Select Background Texture..."/>
                    
                    <TextBlock Text="Decorative Frame Image:" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                    <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ImageMediaAssets}" 
                    SelectedItem="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedThemeFrame, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}" PlaceholderText="Select Frame Border Asset..."/>
                    
                    <TextBlock Text="Scene Viewport Aspect Ratio (Width / Height):" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                    <Grid ColumnDefinitions="*,Auto">
                    <Slider Value="{Binding AspectRatio, Mode=TwoWay}" Minimum="0.5" Maximum="2.5" SmallChange="0.05" LargeChange="0.1" Grid.Column="0"/>
                    <TextBlock Text="{Binding AspectRatio, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Foreground="{DynamicResource TextNormal}" Grid.Column="1"/>
                    </Grid>
                    </StackPanel>
                    </Border>
                    </StackPanel>
                    
                    <!-- Right Column: Live Mockup HUD Preview -->
                    <StackPanel Grid.Column="1" Spacing="20" VerticalAlignment="Top">
                    <TextBlock Text="HUD Layout Preview" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextNormal}"/>
                    
                    <Border Background="#0f0f12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Viewbox Stretch="Uniform" Width="480" Height="380">
                    <Border Width="1000" Height="800" Background="#111115" BorderBrush="#3f3f50" BorderThickness="2" CornerRadius="{Binding BorderRadius}" ClipToBounds="True">
                    <!-- Overall HUD Container layout -->
                    <DockPanel LastChildFill="True" Margin="{Binding PanelPadding}">
                    
                    <!-- Title Bar -->
                    <Border DockPanel.Dock="Top" Height="40" Background="#1c1c24" BorderBrush="#3a3a48" BorderThickness="1.5" Margin="0,0,0,12" CornerRadius="6">
                    <TextBlock Text="BATHROOM" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="#ffffff"/>
                    </Border>
                    
                    <!-- Left Dock Stack Compartment -->
                    <StackPanel DockPanel.Dock="Left" Width="{Binding SidebarWidth}" Margin="0,0,12,0" Spacing="12" VerticalAlignment="Stretch">
                    <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static views:LeftDockVisibleConverter.Instance}">
                    <Binding Path="RoomItemsDockPosition"/>
                    <Binding Path="InventoryDockPosition"/>
                    <Binding Path="NavigationDockPosition"/>
                    </MultiBinding>
                    </StackPanel.IsVisible>
                    <!-- Left Room Items -->
                    <Border Background="#252530" BorderBrush="#4a4a5f" BorderThickness="1.5" CornerRadius="6" Padding="12" Height="180"
                    IsVisible="{Binding RoomItemsDockPosition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Left}">
                    <TextBlock Text="👥 Room Items" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#ffffff" FontWeight="Bold"/>
                    </Border>
                    
                    <!-- Left Inventory -->
                    <Border Background="#252530" BorderBrush="#4a4a5f" BorderThickness="1.5" CornerRadius="6" Padding="12" Height="180"
                    IsVisible="{Binding InventoryDockPosition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Left}">
                    <TextBlock Text="👝 Inventory" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#ffffff" FontWeight="Bold"/>
                    </Border>
                    
                    <!-- Left Compass -->
                    <Border Background="#252530" BorderBrush="#4a4a5f" BorderThickness="1.5" CornerRadius="6" Padding="12" Height="180"
                    IsVisible="{Binding NavigationDockPosition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Left}">
                    <TextBlock Text="🧭 Navigation" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#ffffff" FontWeight="Bold"/>
                    </Border>
                    </StackPanel>
                    
                    <!-- Right Dock Stack Compartment -->
                    <StackPanel DockPanel.Dock="Right" Width="{Binding SidebarWidth}" Margin="12,0,0,0" Spacing="12" VerticalAlignment="Stretch">
                    <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static views:RightDockVisibleConverter.Instance}">
                    <Binding Path="RoomItemsDockPosition"/>
                    <Binding Path="InventoryDockPosition"/>
                    <Binding Path="NavigationDockPosition"/>
                    </MultiBinding>
                    </StackPanel.IsVisible>
                    <!-- Right Room Items -->
                    <Border Background="#252530" BorderBrush="#4a4a5f" BorderThickness="1.5" CornerRadius="6" Padding="12" Height="180"
                    IsVisible="{Binding RoomItemsDockPosition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Right}">
                    <TextBlock Text="👥 Room Items" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#ffffff" FontWeight="Bold"/>
                    </Border>
                    
                    <!-- Right Inventory -->
                    <Border Background="#252530" BorderBrush="#4a4a5f" BorderThickness="1.5" CornerRadius="6" Padding="12" Height="180"
                    IsVisible="{Binding InventoryDockPosition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Right}">
                    <TextBlock Text="👝 Inventory" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#ffffff" FontWeight="Bold"/>
                    </Border>
                    
                    <!-- Right Compass -->
                    <Border Background="#252530" BorderBrush="#4a4a5f" BorderThickness="1.5" CornerRadius="6" Padding="12" Height="180"
                    IsVisible="{Binding NavigationDockPosition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Right}">
                    <TextBlock Text="🧭 Navigation" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#ffffff" FontWeight="Bold"/>
                    </Border>
                    </StackPanel>
                    
                    <!-- Main Content Area: Viewport extending all the way to the bottom with overlapping elements -->
                    <Grid>
                    <!-- Scene Image Background (extends all the way to the bottom!) -->
                    <Border BorderBrush="{Binding BorderAccentColor, Converter={x:Static views:HexToColorConverter.Instance}}" BorderThickness="2.5" CornerRadius="6" Background="#1c1c24" ClipToBounds="True">
                    <Grid>
                    <!-- Custom frame texture simulation -->
                    <Border BorderBrush="#ffaa00" BorderThickness="5" IsVisible="{Binding FrameAssetId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Opacity="0.5"/>
                    <TextBlock Text="🖼️ Scene Background Viewport" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#555566"/>
                    </Grid>
                    </Border>
                    
                    <!-- Top Player Portrait Panel (Overlay, only visible if aligned to Top!) -->
                    <Border Width="160" Height="220" Margin="16" Background="#282835" BorderBrush="#4a4a5a" BorderThickness="2" CornerRadius="8" Padding="12"
                    HorizontalAlignment="{Binding PortraitAlignment, Converter={x:Static views:PortraitHorizontalAlignmentConverter.Instance}}"
                    VerticalAlignment="Top"
                    IsVisible="{Binding PortraitAlignment, Converter={x:Static views:PortraitPositionConverter.Instance}, ConverterParameter=Top}">
                    <StackPanel Spacing="8">
                    <Ellipse Width="80" Height="80" Fill="#444455" Stroke="#8E2DE2" StrokeThickness="3" HorizontalAlignment="Center"/>
                    <TextBlock Text="Joe" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="#ffffff"/>
                    <TextBlock Text="Stats panel..." HorizontalAlignment="Center" FontSize="11" Foreground="#aaaaaa"/>
                    </StackPanel>
                    </Border>
                    
                    <!-- Bottom Overlays (Narrative Text box + bottom-docked items stacked vertically) -->
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="16" Spacing="12">
                    <!-- Narrative Text Panel -->
                    <Border Background="#282835" BorderBrush="#4a4a5a" BorderThickness="2" CornerRadius="8" Padding="16"
                    HorizontalAlignment="{Binding TextBoxAlignment}"
                    Width="{Binding TextBoxWidth}"
                    Height="{Binding TextBoxHeight}">
                    <TextBlock Text="Lorem ipsum dolor sit amet, adventure text panel. You are inside the custom HUD layout overlaying the room scene." 
                    Foreground="#ffffff" FontSize="13" TextWrapping="Wrap"/>
                    </Border>
                    
                    <!-- Bottom Dock Stack Compartment (Shared Glass Border) -->
                    <Border Background="#282835" BorderBrush="#4a4a5a" BorderThickness="2" CornerRadius="8" Padding="12"
                            Height="{Binding BottomBarHeight}"
                            HorizontalAlignment="Center">
                        <Border.IsVisible>
                            <MultiBinding Converter="{x:Static views:BottomDockVisibleConverter.Instance}">
                                <Binding Path="InventoryDockPosition"/>
                                <Binding Path="RoomItemsDockPosition"/>
                                <Binding Path="NavigationDockPosition"/>
                                <Binding Path="PortraitAlignment"/>
                            </MultiBinding>
                        </Border.IsVisible>
                        <StackPanel Spacing="12" Orientation="Horizontal" VerticalAlignment="Stretch">
                            <!-- Bottom Portrait (if BottomLeft) -->
                            <Border Width="200" Background="Transparent" Padding="12" VerticalAlignment="Stretch"
                                    IsVisible="{Binding PortraitAlignment, Converter={x:Static views:PortraitPositionConverter.Instance}, ConverterParameter=BottomLeft}">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="48" Height="48" Fill="#444455" Stroke="#8E2DE2" StrokeThickness="2"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Joe" FontWeight="Bold" FontSize="12" Foreground="#ffffff"/>
                                        <TextBlock Text="Stats..." FontSize="10" Foreground="#aaaaaa"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            
                            <!-- Bottom Room Items -->
                            <Border Background="Transparent" Padding="12" Width="200" VerticalAlignment="Stretch"
                                    IsVisible="{Binding RoomItemsDockPosition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Bottom}">
                                <TextBlock Text="👥 Room Items" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#ffffff" FontWeight="Bold"/>
                            </Border>
                            
                            <!-- Bottom Inventory -->
                            <Border Background="Transparent" Padding="12" Width="200" VerticalAlignment="Stretch"
                                    IsVisible="{Binding InventoryDockPosition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Bottom}">
                                <TextBlock Text="👝 Inventory" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#ffffff" FontWeight="Bold"/>
                            </Border>
                            
                            <!-- Bottom Compass -->
                            <Border Background="Transparent" Padding="12" Width="200" VerticalAlignment="Stretch"
                                    IsVisible="{Binding NavigationDockPosition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Bottom}">
                                <TextBlock Text="🧭 Navigation" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#ffffff" FontWeight="Bold"/>
                            </Border>
                            
                            <!-- Bottom Portrait (if BottomRight) -->
                            <Border Width="200" Background="Transparent" Padding="12" VerticalAlignment="Stretch"
                                    IsVisible="{Binding PortraitAlignment, Converter={x:Static views:PortraitPositionConverter.Instance}, ConverterParameter=BottomRight}">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="48" Height="48" Fill="#444455" Stroke="#8E2DE2" StrokeThickness="2"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Joe" FontWeight="Bold" FontSize="12" Foreground="#ffffff"/>
                                        <TextBlock Text="Stats..." FontSize="10" Foreground="#aaaaaa"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                    </Grid>
                    </DockPanel>
                    </Border>
                    </Viewbox>
                    </Border>
                    </StackPanel>
                    </Grid>
                    </StackPanel>
                    </ScrollViewer>
                    
                    <!-- 5b. Status Elements Tab -->
                <Grid IsVisible="{Binding ActiveView, ConverterParameter=StatusBar, Converter={x:Static ObjectConverters.Equal}}" ColumnDefinitions="300,*">
                    <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Row="0" Text="Status Elements" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding StatusBar.Elements}" Background="Transparent" x:Name="StatusBarList" SelectionChanged="OnStatusBarListSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:StatusBarElement">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,10,0,0" ColumnSpacing="8">
                                <Button Grid.Column="0" Content="+ Define Element" Command="{Binding StatusBar.AddElementCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="Delete" Command="{Binding StatusBar.DeleteElementCommand}" CommandParameter="{Binding #StatusBarList.SelectedItem}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#C0392B"/>
                            </Grid>
                        </Grid>
                    </Border>
                    
                    <Grid Grid.Column="1" RowDefinitions="*,Auto" Margin="12,0,0,0">
                        <!-- Upper panel with properties -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16" DataContext="{Binding #StatusBarList.SelectedItem}" x:DataType="models:StatusBarElement" Margin="0,0,12,0" IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Text="Edit Status Element" FontSize="18" FontWeight="Bold" Foreground="#8E2DE2"/>
                                    
                                    <TextBlock Text="Name:" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBox Text="{Binding Name, Mode=TwoWay}" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"/>
                                    
                                    <TextBlock Text="Visual Option:" Foreground="{DynamicResource TextMuted}"/>
                                    <ComboBox SelectedItem="{Binding VisualOption, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}">
                                        <!-- Use raw strings to match the model property -->
                                        <x:String>TextOnly</x:String>
                                        <x:String>ImageOnly</x:String>
                                        <x:String>ImageAndText</x:String>
                                    </ComboBox>

                                    <TextBlock Text="Text / Expression:" Foreground="{DynamicResource TextMuted}" IsVisible="{Binding VisualOption, ConverterParameter=ImageOnly, Converter={x:Static ObjectConverters.NotEqual}}"/>
                                    <StackPanel IsVisible="{Binding VisualOption, ConverterParameter=ImageOnly, Converter={x:Static ObjectConverters.NotEqual}}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <Button Content="B" FontWeight="Bold" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Classes="toolbar-btn" FontSize="11" Click="OnComposeBoldClicked"/>
                                            <Button Content="/" FontStyle="Italic" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Classes="toolbar-btn" FontSize="11" Click="OnComposeItalicClicked"/>
                                            <Button Content="U" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Classes="toolbar-btn" FontSize="11" Click="OnComposeUnderlineClicked"/>
                                            <Button Classes="toolbar-btn" Height="28" Padding="8,0">
                                                     <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                         <TextBlock Text="🎨" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" FontSize="11"/>
                                                         <TextBlock Text="Color" VerticalAlignment="Center" FontSize="11"/>
                                                     </StackPanel>
                                                <Button.Flyout>
                                                    <Flyout>
                                                        <StackPanel Spacing="6" Width="200">
                                                            <ColorPicker x:Name="InlineColorPicker" Color="#FFFFFF" Margin="0" HorizontalAlignment="Center"/>
                                                            <Button Content="Apply" Click="OnInlineColorPickerApply" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#8E2DE2" Foreground="White" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                            <Button Classes="toolbar-btn" Height="28" Padding="8,0">
                                                     <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                         <TextBlock Text="🖊️" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" FontSize="11"/>
                                                         <TextBlock Text="Highlight" VerticalAlignment="Center" FontSize="11"/>
                                                     </StackPanel>
                                                <Button.Flyout>
                                                    <Flyout>
                                                        <StackPanel Spacing="6" Width="200">
                                                            <ColorPicker x:Name="InlineHighlightPicker" Color="#EF4444" Margin="0" HorizontalAlignment="Center"/>
                                                            <Button Content="Apply" Click="OnInlineHighlightPickerApply" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#8E2DE2" Foreground="White" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                            <Button Content="Clear" Height="28" Classes="toolbar-btn" Foreground="{DynamicResource TextMuted}" FontSize="11" Padding="8,0" Click="OnComposeClearClicked"/>
                                            <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenComposeCommand}" CommandParameter="{Binding}" Height="28" Background="#8E2DE2" Foreground="White" Padding="10,0" Margin="10,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                 <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                     <TextBlock Text="📝" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" FontSize="11"/>
                                                     <TextBlock Text="Compose Text" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                                                 </StackPanel>
                                             </Button>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox x:Name="ComposeTextBox_Status" Text="{Binding Text, Mode=TwoWay}" AcceptsReturn="True" Height="70" VerticalContentAlignment="Top" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" TextWrapping="Wrap"/>
                                            <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                                <Button Content="📝" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenComposeCommand}" CommandParameter="{Binding}" Width="36" Height="32" Classes="toolbar-btn emoji" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Open Composer Popup"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Text="Icon Image:" Foreground="{DynamicResource TextMuted}" IsVisible="{Binding VisualOption, ConverterParameter=TextOnly, Converter={x:Static ObjectConverters.NotEqual}}"/>
                                    <ComboBox x:Name="StatusIconComboBox"
                                              ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ImageMediaAssets}"
                                              HorizontalAlignment="Stretch"
                                              Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"
                                              IsVisible="{Binding VisualOption, ConverterParameter=TextOnly, Converter={x:Static ObjectConverters.NotEqual}}"
                                              SelectionChanged="OnStatusIconSelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:MediaAsset">
                                                <TextBlock Text="{Binding OriginalFileName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <CheckBox Content="Initially Visible" IsChecked="{Binding IsVisible, Mode=TwoWay}" Foreground="{DynamicResource TextNormal}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- WYSIWYG Preview Panel -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                            <StackPanel Spacing="10">
                                <TextBlock Text="🖥️ Status Preview" FontSize="14" FontWeight="Bold" Foreground="#8E2DE2"/>
                                <Border Background="#0D0E12" CornerRadius="56 16 16 56" Padding="16" BorderBrush="#00bcd4" BorderThickness="1.5" HorizontalAlignment="Left" MinWidth="300">
                                    <!-- Horizontal layout like the player's card -->
                                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Top">
                                        <!-- Left Column: Portrait and Status elements -->
                                        <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="180">
                                            <!-- Mock Portrait -->
                                            <Border CornerRadius="28" Width="56" Height="56" Background="#2A2A38" BorderBrush="#00bcd4" BorderThickness="2" HorizontalAlignment="Center">
                                                <TextBlock Text="👤" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            
                                            <!-- Status elements stacked vertically under the portrait circle -->
                                            <ItemsControl ItemsSource="{Binding StatusBar.Elements}" Margin="12,0,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="4" HorizontalAlignment="Left"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:StatusBarElement">
                                                        <Border Margin="0,0,0,2" IsVisible="{Binding IsVisible}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <Image Width="14" Height="14" Stretch="Uniform"
                                                                       IsVisible="{Binding ShowImage}"
                                                                       Source="{Binding MediaAssetId, Converter={x:Static views:MediaIdToBitmapConverter.Instance}}"/>
                                                                <TextBlock views:TextBlockExtensions.HtmlText="{Binding Text}" 
                                                                           IsVisible="{Binding VisualOption, ConverterParameter=ImageOnly, Converter={x:Static ObjectConverters.NotEqual}}"
                                                                           FontSize="12" Foreground="#E2E2EC" VerticalAlignment="Center"
                                                                           TextWrapping="Wrap" MaxWidth="180"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Right Column: Details like Name/Gender -->
                                        <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Top" Margin="0,8,0,0">
                                            <TextBlock Text="Bilbo" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                            <TextBlock Text="Male" Foreground="#B0BEC5" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 7c. Media Asset Library Tab -->
                <Grid IsVisible="{Binding ActiveView, ConverterParameter=Media, Converter={x:Static ObjectConverters.Equal}}" RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="📂 Media Asset Catalog" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" Margin="0,0,0,16"/>
                    <Grid Grid.Row="1" ColumnDefinitions="300,*" DataContext="{Binding Media}" x:DataType="vm:MediaLibraryViewModel">
                        <!-- Left sidebar: Treeview directory structure -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="12" Margin="0,0,12,0" DragDrop.AllowDrop="True" DragDrop.Drop="OnDragDropFile">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <WrapPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Button Content="+ Folder" Command="{Binding AddFolderCommand}" FontSize="11" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" Padding="8,6" Margin="0,0,6,6"/>
                                    <Button Content="Import..." Command="{Binding ImportFilesCommand}" FontSize="11" Background="#8E2DE2" Foreground="White" Padding="8,6" Margin="0,0,6,6"/>
                                    <Button Content="Sort A-Z ⇅" Command="{Binding SortCommand}" FontSize="11" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" Padding="8,6" Margin="0,0,6,6"/>
                                    <Button Content="Rename" Command="{Binding RenameCommand}" FontSize="11" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" Padding="8,6" Margin="0,0,6,6"/>
                                    <Button Content="Delete" Command="{Binding DeleteCommand}" FontSize="11" Background="#C0392B" Padding="8,6" Margin="0,0,6,6"/>
                                </WrapPanel>
                                
                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                                    <TreeView ItemsSource="{Binding Roots}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                                        <TreeView.Styles>
                                            <Style Selector="TreeViewItem" x:DataType="vm:MediaLibraryViewModel+Node">
                                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                            </Style>
                                        </TreeView.Styles>
                                        <TreeView.ItemTemplate>
                                            <TreeDataTemplate DataType="{x:Type vm:MediaLibraryViewModel+Node}" ItemsSource="{Binding Children}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" PointerPressed="OnMediaItemPointerPressed" PointerMoved="OnMediaItemPointerMoved" PointerReleased="OnMediaItemPointerReleased" DragDrop.AllowDrop="True" DragDrop.DragOver="OnMediaItemDragOver" DragDrop.Drop="OnMediaItemDrop">
                                                    <TextBlock Text="{Binding Icon}"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </StackPanel>
                                            </TreeDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        
                        <!-- Right side: Selected Asset Preview Panel -->
                        <Border Grid.Column="1" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="20">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Row="0" Text="Asset Preview &amp; Properties" FontSize="18" FontWeight="Bold" Foreground="#8E2DE2" Margin="0,0,0,16"/>
                                
                                <!-- Preview Area -->
                                <Border Grid.Row="1" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16" ClipToBounds="True">
                                    <Grid x:Name="TabPreviewWebViewContainer">
                                        <!-- No selection fallback -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" IsVisible="{Binding !HasSelectedFile}">
                                            <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="Select a media file from the library to view details" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <!-- Image Preview -->
                                        <Image Source="{Binding SelectedFilePath, Converter={x:Static views:ImagePathToBitmapConverter.Instance}}" IsVisible="{Binding IsSelectedImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        
                                        <!-- WebView HTML5 Player for Audio/Video in Main Media Catalog Tab -->
                                        <wv:NativeWebView x:Name="TabPreviewWebView" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="8"/>

                                        <!-- Fallback details (for none of the above) -->
                                        <StackPanel IsVisible="{Binding IsSelectedFallback}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                                            <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Selected.Name}" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                            <TextBlock Text="Binary/Other Media Format" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                
                                <!-- Asset details list at bottom -->
                                <Border Grid.Row="2" Background="{DynamicResource InputBg}" CornerRadius="6" Padding="12" IsVisible="{Binding HasSelectedFile}">
                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="120,*">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Selected.Name}" Foreground="{DynamicResource TextNormal}" FontWeight="Bold" FontSize="12"/>
                                        
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Relative Path:" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.Asset.RelativePath}" Foreground="#8E2DE2" FontSize="12" Margin="0,4,0,0"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Content Type:" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.Asset.ContentType}" Foreground="{DynamicResource TextNormal}" FontSize="12" Margin="0,4,0,0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 7d. Global Action Library Tab -->
                <Grid IsVisible="{Binding ActiveView, ConverterParameter=ActionLibrary, Converter={x:Static ObjectConverters.Equal}}" ColumnDefinitions="300,*">
                    <!-- Left Sidebar: Actions List -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="12" Margin="0,0,12,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Row="0" Text="🛠️ Action Templates" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" Margin="0,0,0,10"/>
                            
                            <ListBox Grid.Row="1" ItemsSource="{Binding GlobalActions}" SelectedIndex="0" x:Name="GlobalActionsList" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Action">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextNormal}" FontSize="12" Padding="4"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                                <Button Content="+ Action" Command="{Binding AddGlobalActionCommand}" Background="#8E2DE2" Foreground="White" FontWeight="Bold" FontSize="11" Padding="8,6" CornerRadius="4"/>
                                <Button Content="Delete" Command="{Binding DeleteGlobalActionCommand}" CommandParameter="{Binding #GlobalActionsList.SelectedItem}" Background="#C0392B" Foreground="White" FontSize="11" Padding="8,6" CornerRadius="4"/>
                                <Button Content="Copy" Command="{Binding CopyActionCommand}" CommandParameter="{Binding #GlobalActionsList.SelectedItem}" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="11" Padding="8,6" CornerRadius="4"/>
                                <Button Content="Paste" Command="{Binding PasteGlobalActionCommand}" IsEnabled="{Binding CanPasteAction}" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="11" Padding="8,6" CornerRadius="4"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Right Content Pane: Selected Action Properties & Scripting -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" IsVisible="{Binding #GlobalActionsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ScrollViewer>
                            <StackPanel Spacing="16" DataContext="{Binding #GlobalActionsList.SelectedItem}" x:DataType="models:Action">
                                <TextBlock Text="Template Configuration" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextNormal}"/>
                                
                                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" Margin="0,8,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Action Name:" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,0,12" FontSize="12"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBg}" BorderBrush="#3D3D58" Margin="0,0,0,12" FontSize="12"/>
                                    
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Trigger Event:" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,0,12" FontSize="12"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AllTriggers}" SelectedItem="{Binding Trigger, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}" BorderBrush="#3D3D58" Margin="0,0,0,12" FontSize="12"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Direction Filter:" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,0,12" FontSize="12" IsVisible="{Binding IsDirectionFilterVisible}"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DirectionFilters}" SelectedItem="{Binding DirectionFilter, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}" BorderBrush="#3D3D58" Margin="0,0,0,12" FontSize="12" IsVisible="{Binding IsDirectionFilterVisible}"/>
                                </Grid>

                                <Separator Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8"/>

                                <TextBlock Text="Apply Template to Target Types:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextNormal}"/>
                                
                                <WrapPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding ApplyToRooms, Mode=TwoWay}" Content="Rooms" Margin="0,0,16,8" FontSize="12" Foreground="{DynamicResource TextNormal}"/>
                                    <CheckBox IsChecked="{Binding ApplyToPlayer, Mode=TwoWay}" Content="Player" Margin="0,0,16,8" FontSize="12" Foreground="{DynamicResource TextNormal}"/>
                                    <CheckBox IsChecked="{Binding ApplyToCharacters, Mode=TwoWay}" Content="Characters" Margin="0,0,16,8" FontSize="12" Foreground="{DynamicResource TextNormal}"/>
                                    <CheckBox IsChecked="{Binding ApplyToGrabableObjects, Mode=TwoWay}" Content="Grabable Objects" Margin="0,0,16,8" FontSize="12" Foreground="{DynamicResource TextNormal}"/>
                                    <CheckBox IsChecked="{Binding ApplyToWearableObjects, Mode=TwoWay}" Content="Wearable Objects" Margin="0,0,16,8" FontSize="12" Foreground="{DynamicResource TextNormal}"/>
                                    <CheckBox IsChecked="{Binding ApplyToContainerObjects, Mode=TwoWay}" Content="Container Objects" Margin="0,0,16,8" FontSize="12" Foreground="{DynamicResource TextNormal}"/>
                                    <CheckBox IsChecked="{Binding ApplyToStaticObjects, Mode=TwoWay}" Content="Static Objects" Margin="0,0,16,8" FontSize="12" Foreground="{DynamicResource TextNormal}"/>
                                    <CheckBox IsChecked="{Binding ApplyToTimers, Mode=TwoWay}" Content="Timers" Margin="0,0,16,8" FontSize="12" Foreground="{DynamicResource TextNormal}"/>
                                    <CheckBox IsChecked="{Binding ApplyToFunctions, Mode=TwoWay}" Content="Functions" Margin="0,0,16,8" FontSize="12" Foreground="{DynamicResource TextNormal}"/>
                                </WrapPanel>

                                <Separator Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8"/>

                                <Button Content="🎨 Visual Script Editor" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StartEditingActionCommand}" CommandParameter="{Binding}" Background="#8E2DE2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="13" Padding="12" CornerRadius="6"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 8. Validation Engine -->
                <ScrollViewer IsVisible="{Binding ActiveView, ConverterParameter=Validation, Converter={x:Static ObjectConverters.Equal}}">
                    <StackPanel Spacing="20">
                        <TextBlock Text="🔍 Project Integrity Diagnostics" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextNormal}"/>
                        
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Active Database Scan Reports" FontSize="16" FontWeight="Bold" Foreground="#E2D02D"/>
                                <ListBox ItemsSource="{Binding ValidationErrors}" Background="Transparent" Foreground="{DynamicResource TextNormal}" FontSize="13">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                                                <TextBlock Text="{Binding}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 9. Standalone Compiler (Publish target) -->
                <ScrollViewer IsVisible="{Binding ActiveView, ConverterParameter=Publish, Converter={x:Static ObjectConverters.Equal}}">
                    <StackPanel Spacing="24" HorizontalAlignment="Stretch">
                        <TextBlock Text="🚀 Standalone Game Publisher" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextNormal}"/>
                        
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="📦 Build Standalone Executable" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                                <TextBlock Text="Package your game logic and media assets with the integrated Unity runtime engine to produce a standalone executable or WebGL package for distribution." FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                                
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="150,*,Auto" RowSpacing="12" Margin="0,10,0,10">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Game Title" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}" FontSize="13"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PublishTitle}" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Version" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}" FontSize="13"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PublishVersion}" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Author" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}" FontSize="13"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PublishAuthor}" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Publish Destination" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}" FontSize="13"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PublishDestination}" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,8,0"/>
                                    <Button Grid.Row="3" Grid.Column="2" Content="Browse..." Command="{Binding BrowsePublishDestinationCommand}" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" Padding="14,6" CornerRadius="4"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Target Platform" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}" FontSize="13"/>
                                    <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*,*" Margin="0,4,0,0" Height="80">
                                        <Button Grid.Column="0" Command="{Binding SelectPlatformCommand}" CommandParameter="Windows" Classes="platform-btn" Tag="{Binding IsWindowsSelected}" Margin="0,0,8,0">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🪟 Windows" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextNormal}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding WinStatusText}" Foreground="{Binding WinStatusColor}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Command="{Binding SelectPlatformCommand}" CommandParameter="MacOS" Classes="platform-btn" Tag="{Binding IsMacSelected}" Margin="0,0,8,0">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🍎 macOS" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextNormal}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding MacStatusText}" Foreground="{Binding MacStatusColor}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Command="{Binding SelectPlatformCommand}" CommandParameter="Linux" Classes="platform-btn" Tag="{Binding IsLinuxSelected}" Margin="0,0,8,0">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🐧 Linux" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextNormal}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding LinuxStatusText}" Foreground="{Binding LinuxStatusColor}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="3" Command="{Binding SelectPlatformCommand}" CommandParameter="WebGL" Classes="platform-btn" Tag="{Binding IsWebGLSelected}">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🌐 WebGL" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextNormal}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding WebGLStatusText}" Foreground="{Binding WebGLStatusColor}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>

                                <Button Content="🚀 Publish standalone game now" Command="{Binding PublishCommand}" IsEnabled="{Binding !IsPublishing}" HorizontalAlignment="Left" Foreground="White" FontWeight="Bold" CornerRadius="4" Padding="20,12">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Color="#8E2DE2" Offset="0.0"/>
                                            <GradientStop Color="#4A00E0" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource InputBg}" BorderBrush="#232333" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Build Output Logs" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                <ScrollViewer Height="200" Background="#0C0C12" Padding="12" CornerRadius="4">
                                    <TextBlock Text="{Binding PublishLogs}" FontFamily="Consolas, Monospace" FontSize="11" Foreground="#00FF00" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 10. Workspace Preferences -->
                <ScrollViewer IsVisible="{Binding ActiveView, ConverterParameter=Preferences, Converter={x:Static ObjectConverters.Equal}}">
                    <StackPanel Spacing="24" HorizontalAlignment="Stretch" Margin="10,0,10,20">
                        <TextBlock Text="⚙️ Workspace Preferences" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextNormal}"/>

                        <!-- Visual Appearance Card -->
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="🎨 Visual Appearance" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Configure the visual theme of the story designer workspace." FontSize="13" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="150,*">
                                    <TextBlock Text="Theme" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}"/>
                                    <ComboBox Grid.Column="1" SelectedItem="{Binding Preferences.ThemeName, Mode=TwoWay}" HorizontalAlignment="Left" Width="200" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}">
                                        <ComboBox.Items>
                                            <x:String>Dark</x:String>
                                            <x:String>Light</x:String>
                                        </ComboBox.Items>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- AI Co-Author Settings Card -->
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="🤖 AI Co-Author Services" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    <ToggleSwitch IsChecked="{Binding Preferences.AiCoAuthorEnableHelper, Mode=TwoWay}" OnContent="Enabled" OffContent="Disabled" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <TextBlock Text="Set up endpoints for real-time storytelling hints, narrative suggestions, and descriptions co-writing." FontSize="13" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                
                                <!-- Setup Help Instructions Box -->
                                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" IsVisible="{Binding Preferences.IsCoAuthorHelpVisible}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding Preferences.CoAuthorSetupStepsTitle}" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" FontSize="13"/>
                                        <TextBlock Text="{Binding Preferences.CoAuthorStep1}" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Preferences.CoAuthorStep2}" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Preferences.CoAuthorStep3}" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                        <Button Content="{Binding Preferences.CoAuthorHelpButtonText}" Command="{Binding Preferences.OpenHelpCommand}" CommandParameter="{Binding Preferences.CoAuthorHelpUrl}" Background="#8E2DE2" Foreground="White" CornerRadius="4" Padding="10,6" FontSize="11" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>

                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="150,*" RowSpacing="12">
                                    <!-- Provider -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="AI Provider" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding Preferences.AiCoAuthorProvider, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}">
                                        <ComboBox.Items>
                                            <x:String>Ollama</x:String>
                                            <x:String>LMStudio</x:String>
                                            <x:String>OpenAICompatible</x:String>
                                            <x:String>OpenRouter</x:String>
                                            <x:String>Google Gemini</x:String>
                                        </ComboBox.Items>
                                    </ComboBox>

                                    <!-- Endpoint -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="API Endpoint" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}" IsVisible="{Binding Preferences.ShowCoAuthorEndpoint}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Preferences.AiCoAuthorEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="e.g. https://api.openai.com/v1" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}" IsVisible="{Binding Preferences.ShowCoAuthorEndpoint}"/>

                                    <!-- Key -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="API Key" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}" IsVisible="{Binding Preferences.ShowCoAuthorApiKey}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Preferences.AiCoAuthorKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PasswordChar="●" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}" IsVisible="{Binding Preferences.ShowCoAuthorApiKey}"/>

                                    <!-- Model -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Model ID" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding Preferences.AiCoAuthorModel, Mode=TwoWay}" Watermark="Select or type model ID..." Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Preferences.AvailableModels}" SelectedItem="{Binding Preferences.AiCoAuthorModel, Mode=TwoWay}" Width="150" Margin="8,0,0,0" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}" PlaceholderText="Pulled Models"/>
                                            <Button Grid.Column="2" Content="⟳" Command="{Binding Preferences.FetchModelsCommand}" CommandParameter="CoAuthor" Margin="8,0,0,0" Width="36" Height="34" Background="#8E2DE2" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Fetch Available Models"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Preferences.CoAuthorConnectionStatus}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>

                                    <!-- Host (Conditional for Local Servers) -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Host (include scheme)" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}" IsVisible="{Binding Preferences.ShowCoAuthorHostPort}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Preferences.AiCoAuthorHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="http://localhost" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}" IsVisible="{Binding Preferences.ShowCoAuthorHostPort}"/>

                                    <!-- Port (Conditional for Local Servers) -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Port" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}" IsVisible="{Binding Preferences.ShowCoAuthorHostPort}"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Preferences.AiCoAuthorPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="1234" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}" IsVisible="{Binding Preferences.ShowCoAuthorHostPort}"/>

                                    <!-- Generation Parameters -->
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Temperature" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}"/>
                                    <Grid Grid.Row="6" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,5,0,5">
                                        <Slider Grid.Column="0" Value="{Binding Preferences.AiCoAuthorTemperature, Mode=TwoWay}" Minimum="0.0" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Preferences.AiCoAuthorTemperature, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}" Margin="10,0,0,0" Width="40"/>
                                    </Grid>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Max Tokens" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Preferences.AiCoAuthorMaxTokens, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}"/>
                                </Grid>

                                <TextBlock Text="System Assistant Instructions (Prompt Template)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextNormal}" Margin="0,10,0,0"/>
                                <TextBox Text="{Binding Preferences.AiCoAuthorAssistantPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- AI Image Generator Settings Card -->
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="🖼️ AI Image Generator" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    <ToggleSwitch IsChecked="{Binding Preferences.AiImageGenEnableHelper, Mode=TwoWay}" OnContent="Enabled" OffContent="Disabled" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <TextBlock Text="Set up Stable Diffusion or Dall-E services to automatically create room portraits, items icons, and character artwork." FontSize="13" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>

                                <!-- Setup Help Instructions Box -->
                                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15" IsVisible="{Binding Preferences.IsImageGenHelpVisible}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding Preferences.ImageGenSetupStepsTitle}" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" FontSize="13"/>
                                        <TextBlock Text="{Binding Preferences.ImageGenStep1}" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Preferences.ImageGenStep2}" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Preferences.ImageGenStep3}" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                        <Button Content="{Binding Preferences.ImageGenHelpButtonText}" Command="{Binding Preferences.OpenHelpCommand}" CommandParameter="{Binding Preferences.ImageGenHelpUrl}" Background="#8E2DE2" Foreground="White" CornerRadius="4" Padding="10,6" FontSize="11" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>

                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="150,*" RowSpacing="12">
                                    <!-- Provider -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="AI Provider" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding Preferences.AiImageGenProvider, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}">
                                        <ComboBox.Items>
                                            <x:String>Pollinations.ai</x:String>
                                            <x:String>ChatGPT</x:String>
                                            <x:String>Azure OpenAI Images</x:String>
                                            <x:String>Google Gemini</x:String>
                                            <x:String>Local Stable Diffusion</x:String>
                                            <x:String>Local ComfyUI</x:String>
                                            <x:String>Other</x:String>
                                        </ComboBox.Items>
                                    </ComboBox>

                                    <!-- Endpoint -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="API Endpoint" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}" IsVisible="{Binding Preferences.ShowImageGenEndpoint}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Preferences.AiImageGenEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="e.g. https://api.openai.com/v1" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}" IsVisible="{Binding Preferences.ShowImageGenEndpoint}"/>

                                    <!-- Key -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="API Key" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}" IsVisible="{Binding Preferences.ShowImageGenApiKey}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Preferences.AiImageGenKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PasswordChar="●" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}" IsVisible="{Binding Preferences.ShowImageGenApiKey}"/>

                                    <!-- Model -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Model / Checkpoint Name" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding Preferences.AiImageGenModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}"/>
                                            <Button Grid.Column="1" Content="Test" Command="{Binding Preferences.FetchModelsCommand}" CommandParameter="ImageGen" Margin="8,0,0,0" Height="34" Background="#8E2DE2" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Test Connection"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Preferences.ImageGenConnectionStatus}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>

                                    <!-- Host (Conditional for Local Servers) -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Host (include scheme)" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}" IsVisible="{Binding Preferences.ShowImageGenHostPort}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Preferences.AiImageGenHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="http://localhost" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}" IsVisible="{Binding Preferences.ShowImageGenHostPort}"/>

                                    <!-- Port (Conditional for Local Servers) -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Port" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}" IsVisible="{Binding Preferences.ShowImageGenHostPort}"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Preferences.AiImageGenPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="7860" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}" IsVisible="{Binding Preferences.ShowImageGenHostPort}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>

            <!-- Slide-out Collapsible Assets Library Sidebar (Column 2) -->
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" IsVisible="{Binding HasGame}">
                <!-- Small Vertical Toggle Bar pinned to the right edge -->
                <Button Command="{Binding ToggleAssetsSidebarCommand}" Background="{DynamicResource CardBg}" Width="36" VerticalAlignment="Stretch" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="0">
                    <TextBlock Text="📁" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <!-- Drawer Panel -->
                <Border Width="260" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" IsVisible="{Binding IsAssetsSidebarOpen}">
                    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" DataContext="{Binding Media}">
                        <!-- Drawer Header -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBg}" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="📁 Assets Catalog" FontWeight="Bold" Foreground="{DynamicResource TextNormal}"/>
                        </Border>
                        <!-- Quick info / Actions -->
                        <StackPanel Grid.Row="1" Spacing="6" Margin="12,8">
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Content="+ Folder" Command="{Binding AddFolderCommand}" FontSize="10" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" Padding="6,4" Margin="0,0,4,4"/>
                                <Button Content="Import..." Command="{Binding ImportFilesCommand}" FontSize="10" Background="#8E2DE2" Foreground="White" Padding="6,4" Margin="0,0,4,4"/>
                                <Button Content="Sort A-Z ⇅" Command="{Binding SortCommand}" FontSize="10" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" Padding="6,4" Margin="0,0,4,4"/>
                                <Button Content="Rename" Command="{Binding RenameCommand}" FontSize="10" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" Padding="6,4" Margin="0,0,4,4"/>
                                <Button Content="Delete" Command="{Binding DeleteCommand}" FontSize="10" Background="#C0392B" Padding="6,4" Margin="0,0,4,4"/>
                            </WrapPanel>
                            <TextBlock Text="Double-click or drag items into portraits/objects to link assets." FontSize="10" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                        <!-- TreeView -->
                        <TreeView Grid.Row="2" x:Name="MediaTreeView" SelectionMode="Multiple" ItemsSource="{Binding Roots}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="Transparent" Margin="8" DragDrop.AllowDrop="True" DragDrop.Drop="OnDragDropFile" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem" x:DataType="vm:MediaLibraryViewModel+Node">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate DataType="{x:Type vm:MediaLibraryViewModel+Node}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="2" Background="Transparent" HorizontalAlignment="Stretch" PointerPressed="OnMediaItemPointerPressed" PointerMoved="OnMediaItemPointerMoved" PointerReleased="OnMediaItemPointerReleased" DragDrop.AllowDrop="True" DragDrop.DragOver="OnMediaItemDragOver" DragDrop.Drop="OnMediaItemDrop">
                                        <TextBlock Text="{Binding Icon}"/>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextNormal}" FontSize="12"/>
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        
                        <!-- Resizable Splitter (Slidebar adjustable slider) -->
                        <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="#2D2D3E" Margin="0,4"/>
                        
                        <!-- Media Preview Pane at Bottom -->
                        <Border Grid.Row="4" Height="180" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="8" ClipToBounds="True">
                            <Grid x:Name="PreviewWebViewContainer">
                                <!-- No selection fallback -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" IsVisible="{Binding !HasSelectedFile}">
                                    <TextBlock Text="📂" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="No preview available" Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- Image Preview -->
                                <Image Source="{Binding SelectedFilePath, Converter={x:Static views:ImagePathToBitmapConverter.Instance}}" IsVisible="{Binding IsSelectedImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6"/>
                                
                                <!-- WebView HTML5 Player for Audio/Video -->
                                <wv:NativeWebView x:Name="PreviewWebView" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2"/>
                                
                                <!-- Fallback details -->
                                <StackPanel IsVisible="{Binding IsSelectedFallback}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Margin="6">
                                    <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Selected.Name}" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock Text="Binary Resource" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Full-Screen Visual Graph Scripting Overlay -->
        <Border x:Name="VisualEditorOverlayBorder" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource SidebarBg}" Width="1" Height="1" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.0">
            <Grid RowDefinitions="Auto,*">
                <!-- Overlay Header -->
                <Border Grid.Row="0" Height="54" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" DataContext="{Binding ActiveAction}" x:DataType="models:Action">
                            <TextBlock Text="🎨 Visual Script Editor:" Foreground="{DynamicResource TextMuted}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name, FallbackValue=''}" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="❌ Cancel" Command="{Binding StopEditingActionCommand}" IsEnabled="{Binding IsNotAiGenerating}" FontSize="12" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" CornerRadius="4" Padding="12,6"/>
                            <Button Content="💾 Save &amp; Return" Click="OnSyncGraphClicked" IsEnabled="{Binding IsNotAiGenerating}" FontSize="12" Foreground="White" FontWeight="Bold" CornerRadius="4" Padding="14,6">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#8E2DE2" Offset="0.0"/>
                                        <GradientStop Color="#4A00E0" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Visual Graph WebView Canvas -->
                <Border x:Name="CanvasWebViewContainer" Grid.Row="1" Background="{DynamicResource InputBg}" ClipToBounds="True">
                    <wv:NativeWebView x:Name="CanvasWebView" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Border>
            </Grid>
        </Border>

        <!-- Dynamic Welcome/Launcher Overlay -->
        <Border Background="#B005050C" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding ShowWelcomeOverlay}">
            <Grid>
                <!-- Stage 1: Cinematic Splash Screen Sequence -->
                <Border IsVisible="{Binding ShowSplashOverlay}" Background="#05050C" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid>
                        <!-- High fidelity background mockup image generated -->
                        <Image Source="/Assets/splash_mockup.png" Stretch="UniformToFill" Opacity="0.5"/>
                        
                        <StackPanel Spacing="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Classes="splashLogo" CornerRadius="16" Width="110" Height="110" HorizontalAlignment="Center" ClipToBounds="True">
                                <Image Source="/Assets/ragnext-logo.png" Stretch="UniformToFill"/>
                            </Border>
                            
                            <StackPanel Spacing="8" Classes="splashText">
                                <TextBlock Text="RAGNEXT WORKSPACE" FontSize="32" FontWeight="Bold" Foreground="White" LetterSpacing="2" HorizontalAlignment="Center"/>
                                <TextBlock Text="INITIALIZING SECURE STORYTELLING WORKSPACE..." FontSize="12" FontWeight="SemiBold" Foreground="#8E2DE2" LetterSpacing="1" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            
                            <!-- Pulsing smooth progress indicator -->
                            <ProgressBar Width="240" Height="4" IsIndeterminate="True" Background="#2A2A3E" Foreground="#8E2DE2" HorizontalAlignment="Center" CornerRadius="2"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Stage 2: Sleek Launcher Dashboard with Sample Games support -->
                <Border IsVisible="{Binding !ShowSplashOverlay}" Width="1050" Height="500" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource CardBg}" BorderBrush="#35354A" BorderThickness="1" CornerRadius="16" Padding="32" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*" ColumnDefinitions="260,*,300">
                        <!-- Header -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="12" Margin="0,0,0,24">
                            <Border CornerRadius="4" Width="36" Height="36">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#8E2DE2" Offset="0.0"/>
                                        <GradientStop Color="#4A00E0" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="RN" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2">
                                <TextBlock Text="RagNext Launcher" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextNormal}"/>
                                <TextBlock Text="Manage your storytelling story assets and save workspaces" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Left Column: Actions -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="12" Margin="0,0,24,0" VerticalAlignment="Center">
                            <Button Content="✨ Create New Story Project" Command="{Binding NewGameCommand}" Height="46" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#8E2DE2" Foreground="White" FontWeight="Bold" CornerRadius="8" FontSize="13"/>
                            <Button Content="📂 Load Existing Save" Command="{Binding ShowLoadGameCommand}" Height="46" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" CornerRadius="8" FontSize="13"/>
                            <Button Content="📦 Import Design Package (.ragnext)" Command="{Binding ImportPackageCommand}" Height="46" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource ToolbarBtnBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource ToolbarBtnBorder}" BorderThickness="1" CornerRadius="8" FontSize="13"/>
                            <Button Content="⏱️ Load Last Workspace" Command="{Binding LoadLastWorkspaceCommand}" Height="46" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                            
                            <Button Content="🚪 Close Launcher" Command="{Binding CloseWelcomeCommand}" FontSize="12" HorizontalAlignment="Center" Foreground="Gray" Background="Transparent" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Middle Column: Recent Workspaces -->
                        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,24,0">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0" Text="Recent Workspaces" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"/>
                                
                                <!-- Recents empty state -->
                                <TextBlock Grid.Row="1" Text="No recently loaded projects yet." Foreground="{DynamicResource TextMuted}" FontSize="11" IsVisible="{Binding !RecentProjects.Count}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                
                                <ListBox Grid.Row="1" ItemsSource="{Binding RecentProjects}" Background="Transparent" BorderThickness="0" IsVisible="{Binding RecentProjects.Count}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid ColumnDefinitions="*,Auto" Height="36">
                                                <!-- Open project on double click or select -->
                                                <Button Grid.Column="0" Content="{Binding}" 
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LoadRecentProjectCommand}" 
                                                        CommandParameter="{Binding}" 
                                                        Background="Transparent" 
                                                        Foreground="{DynamicResource TextNormal}" 
                                                        FontSize="11" 
                                                        HorizontalAlignment="Stretch" 
                                                        HorizontalContentAlignment="Left" 
                                                        Padding="4,8"
                                                        ClipToBounds="True"/>
                                                <!-- Remove from history button -->
                                                <Button Grid.Column="1" Content="×" 
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveRecentProjectCommand}" 
                                                        CommandParameter="{Binding}" 
                                                        Background="Transparent" 
                                                        Foreground="Red" 
                                                        FontWeight="Bold" 
                                                        FontSize="14"
                                                        Padding="6,4"
                                                        Margin="4,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Right Column: Sample/Demo Projects -->
                        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0" Text="Quick Start Sample Games" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"/>
                                
                                <!-- Empty state for samples -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" IsVisible="{Binding !SampleGames.Count}">
                                    <TextBlock Text="No sample games found." Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Place .ragnext packages inside the 'Samples' folder." Foreground="{DynamicResource TextMuted}" FontSize="9" HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SampleGames}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MainWindowViewModel+SampleGameItem">
                                                <Button HorizontalAlignment="Stretch" 
                                                        Command="{Binding LoadCommand}" 
                                                        Background="Transparent"
                                                        Padding="4,8"
                                                        Margin="0,0,0,4">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextNormal}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Saves List Load Dialog Overlay -->
        <Border Background="#B005050C" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding ShowSavesOverlay}">
            <Border Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource CardBg}" BorderBrush="#35354A" BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Select a Project File" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" HorizontalAlignment="Center"/>
                    
                    <ListBox ItemsSource="{Binding AvailableSaves}" SelectedItem="{Binding SelectedSave}" Height="180" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="*,Auto" Height="30">
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource TextNormal}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <Button Grid.Column="1" Content="×" 
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteSelectedGameCommand}" 
                                            CommandParameter="{Binding}" 
                                            Background="Transparent" 
                                            Foreground="Red" 
                                            FontWeight="Bold" 
                                            FontSize="14"
                                            Padding="6,2"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button x:Name="CancelLoadButton" Content="Cancel" Background="Transparent" Foreground="Gray"/>
                        <Button Content="Load Game" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LoadSelectedGameCommand}" Background="#8E2DE2" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Premium Inventory Item Selector Popup Overlay -->
        <Border Background="#B005050C" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding ShowInventorySelectorOverlay}">
            <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource CardBg}" BorderBrush="#35354A" BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="👜 Add Item to Inventory" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Select from the existing story items database:" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                    
                    <ListBox ItemsSource="{Binding Objects.Objects}" Height="180" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" x:Name="SelectorItemsList">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:GameObject">
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextNormal}" FontSize="12" Padding="4"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button x:Name="CancelInventorySelectorButton" Content="Cancel" Background="Transparent" Foreground="Gray"/>
                        <Button x:Name="SelectInventoryItemButton" Content="Add to Inventory" Background="#8E2DE2" Foreground="White" FontWeight="Bold" IsEnabled="{Binding #SelectorItemsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Premium Action Template Selector Popup Overlay -->
        <Border Background="#B005050C" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding ShowActionSelectorOverlay}">
            <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource CardBg}" BorderBrush="#35354A" BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="🛠️ Add Action Template" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Choose an action template to create on this entity:" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                    
                    <ListBox ItemsSource="{Binding MatchActionTemplates}" Height="180" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" x:Name="SelectorTemplatesList" SelectedIndex="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Action">
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextNormal}" FontSize="12" Padding="4"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button x:Name="CancelActionSelectorButton" Content="Cancel" Background="Transparent" Foreground="Gray"/>
                        <Button x:Name="SelectActionTemplateButton" Content="Add Action" Background="#8E2DE2" Foreground="White" FontWeight="Bold" IsEnabled="{Binding #SelectorTemplatesList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Premium Custom Attributes Input Popup Overlay -->
        <Border Background="#B005050C" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding ShowAttributeDialogOverlay}">
            <Border Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource CardBg}" BorderBrush="#35354A" BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="⚡ Custom Attribute Editor" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" HorizontalAlignment="Center"/>
                    
                    <StackPanel Spacing="6">
                        <TextBlock Text="Attribute Name:" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                        <TextBox Text="{Binding NewAttributeName, Mode=TwoWay}" PlaceholderText="e.g. Strength, MaxHealth, GoldCount" Background="{DynamicResource InputBg}" BorderBrush="#3D3D58"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Attribute Value (Text or Numeric):" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                        <TextBox Text="{Binding NewAttributeValue, Mode=TwoWay}" PlaceholderText="e.g. 100, Warrior, True" Background="{DynamicResource InputBg}" BorderBrush="#3D3D58"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                        <Button x:Name="CancelAttributeButton" Content="Cancel" Background="Transparent" Foreground="Gray"/>
                        <Button x:Name="SaveAttributeButton" Content="Save Parameter" Background="#8E2DE2" Foreground="White" FontWeight="Bold" IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        <Popup Name="AutocompletePopup" IsOpen="False" Placement="Bottom" IsLightDismissEnabled="True" Focusable="False">
            <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" MaxHeight="220" Width="280" Focusable="False">
                <ListBox Name="AutocompleteListBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextNormal}" SelectionChanged="OnAutocompleteSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.Styles>
                        <Style Selector="ScrollBar">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="IsTabStop" Value="False"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="views:AutocompleteItem">
                            <StackPanel Spacing="2" Margin="2" Background="Transparent">
                                <TextBlock Text="{Binding DisplayToken}" FontWeight="Bold" Foreground="{DynamicResource TextNormal}"/>
                                <TextBlock Text="{Binding TypeName}" FontSize="10" Foreground="#A855F7"/>
                                <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>

        <!-- Compose Overlay -->
        <Border Background="#A0000000" IsVisible="{Binding ShowComposeOverlay}" ZIndex="1000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Width="1150" Height="780" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 8 32 0 #40000000">
                <Grid RowDefinitions="Auto,*,Auto" Margin="24">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <TextBlock Grid.Column="0" Text="{Binding ComposeTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextNormal}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseComposeCommand}" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="Gray" HotKey="Escape"/>
                    </Grid>
                    
                    <!-- Body: Split editor and preview -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,0,0,16">
                        <!-- Left side: Editor -->
                        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,12,0">
                            <!-- Formatting Toolbar -->
                            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <WrapPanel.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Margin" Value="0,0,6,6"/>
                                    </Style>
                                </WrapPanel.Styles>
                                <Button Content="B" FontWeight="Bold" Click="OnComposeBoldClicked" Width="32" Height="30" Classes="toolbar-btn" HorizontalContentAlignment="Center"/>
                                <Button Content="I" FontStyle="Italic" Click="OnComposeItalicClicked" Width="32" Height="30" Classes="toolbar-btn" HorizontalContentAlignment="Center"/>
                                <Button Content="U" Click="OnComposeUnderlineClicked" Width="32" Height="30" Classes="toolbar-btn" HorizontalContentAlignment="Center">
                                    <TextBlock Text="U" TextDecorations="Underline" HorizontalAlignment="Center"/>
                                </Button>
                                <Button Classes="toolbar-btn" Height="30" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="🎨" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" FontSize="11"/>
                                        <TextBlock Text="Color" VerticalAlignment="Center" FontSize="11"/>
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout>
                                            <StackPanel Spacing="8" Width="350">
                                                <ColorView x:Name="ComposeColorPicker" Loaded="OnColorViewLoaded" Color="#FFFFFF" Margin="0" IsAlphaEnabled="True" Height="320" Width="330"/>
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,2">
                                                    <TextBlock Grid.Column="0" Text="Recent Colors:" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="Preview:" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                        <Border Width="20" Height="20" CornerRadius="10" x:CompileBindings="False" Background="{Binding #ComposeColorPicker.Color, Converter={x:Static views:ColorToBrushConverter.Instance}}" BorderBrush="White" BorderThickness="1" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding $parent[views:MainWindow].RecentColors}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Button Width="24" Height="24" CornerRadius="12" Background="{Binding}" Click="OnRecentColorClicked" ToolTip.Tip="{Binding}" BorderBrush="Transparent" BorderThickness="1">
                                                                <Button.Styles>
                                                                    <Style Selector="Button:hover">
                                                                        <Setter Property="BorderBrush" Value="White"/>
                                                                    </Style>
                                                                </Button.Styles>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="Apply" Click="OnComposeColorPickerApply" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#8E2DE2" Foreground="White" FontWeight="Bold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Classes="toolbar-btn" Height="30" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="🖊️" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" FontSize="11"/>
                                        <TextBlock Text="Highlight" VerticalAlignment="Center" FontSize="11"/>
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout>
                                            <StackPanel Spacing="8" Width="350">
                                                <ColorView x:Name="ComposeHighlightPicker" Loaded="OnColorViewLoaded" Color="#EF4444" Margin="0" IsAlphaEnabled="True" Height="320" Width="330"/>
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,2">
                                                    <TextBlock Grid.Column="0" Text="Recent Colors:" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="Preview:" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                        <Border Width="20" Height="20" CornerRadius="10" x:CompileBindings="False" Background="{Binding #ComposeHighlightPicker.Color, Converter={x:Static views:ColorToBrushConverter.Instance}}" BorderBrush="White" BorderThickness="1" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding $parent[views:MainWindow].RecentColors}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Button Width="24" Height="24" CornerRadius="12" Background="{Binding}" Click="OnRecentColorClicked" ToolTip.Tip="{Binding}" BorderBrush="Transparent" BorderThickness="1">
                                                                <Button.Styles>
                                                                    <Style Selector="Button:hover">
                                                                        <Setter Property="BorderBrush" Value="White"/>
                                                                    </Style>
                                                                </Button.Styles>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="Apply" Click="OnComposeHighlightPickerApply" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#8E2DE2" Foreground="White" FontWeight="Bold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Content="✕ Clear" Click="OnComposeClearClicked" Height="30" Classes="toolbar-btn" Padding="8,4" FontSize="11"/>
                                <Button Content="✨ AI Rewrite" Click="OnComposeAIClicked" Height="30" Background="#8E2DE2" Foreground="White" Padding="8,4" FontSize="11"/>
                            </WrapPanel>
                            <!-- Editor TextBox -->
                            <TextBox Grid.Row="1" x:Name="ComposeTextBox" Text="{Binding ComposeText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Watermark="Enter rich text description..." Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" AcceptsTab="True"/>
                        </Grid>
                        
                        <!-- Right side: Preview -->
                        <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="12,0,0,0">
                            <TextBlock Grid.Row="0" Text="👁️ Live Preview" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,8" FontWeight="SemiBold"/>
                            <Border x:Name="ComposePreviewWebViewContainer" Grid.Row="1" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                <wv:NativeWebView x:Name="ComposePreviewWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>
                        </Grid>
                    </Grid>
                    
                    <!-- Footer Actions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                        <Button Content="Cancel" Command="{Binding CloseComposeCommand}" Background="Transparent" Foreground="Gray" Padding="16,8"/>
                        <Button Content="Save &amp; Close" Command="{Binding CloseComposeCommand}" Background="#8E2DE2" Foreground="White" FontWeight="Bold" Padding="20,8" CornerRadius="4"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>

    <Window.Styles>
        <!-- Global button styles to ensure vertical alignment -->
        <Style Selector="Button">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Toolbar/Formatting Buttons styling and hover exit restoration fixes -->
        <Style Selector="Button.toolbar-btn">
            <Setter Property="Background" Value="{DynamicResource ToolbarBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ToolbarBtnFg}"/>
        </Style>
        <Style Selector="Button.toolbar-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarBtnBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource ToolbarBtnFg}"/>
        </Style>
        <Style Selector="Button.toolbar-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavHoverBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarBtnBorder}"/>
        </Style>
        <Style Selector="Button.toolbar-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavActiveBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        
        <Style Selector="Button.nav">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource NavNormalFg}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.nav:hover">
            <Setter Property="Foreground" Value="{DynamicResource NavHoverFg}"/>
            <Setter Property="Background" Value="{DynamicResource NavHoverBg}"/>
        </Style>
        <Style Selector="Button.nav[Tag=True]">
            <Setter Property="Foreground" Value="{DynamicResource NavHoverFg}"/>
            <Setter Property="Background" Value="{DynamicResource NavActiveBg}"/>
        </Style>
        <Style Selector="Button.platform-btn">
            <Setter Property="Background" Value="{DynamicResource ToolbarBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.platform-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource NavHoverBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style Selector="Button.platform-btn[Tag=True]">
            <Setter Property="Background" Value="{DynamicResource NavActiveBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
        <Style Selector="Border.splashLogo">
            <Style.Animations>
                <Animation Duration="0:0:1.8" IterationCount="1">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.0"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="0.4"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.4"/>
                    </KeyFrame>
                    <KeyFrame Cue="65%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="StackPanel.splashText">
            <Style.Animations>
                <Animation Duration="0:0:2.2" IterationCount="1">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.0"/>
                        <Setter Property="TranslateTransform.Y" Value="30"/>
                    </KeyFrame>
                    <KeyFrame Cue="30%">
                        <Setter Property="Opacity" Value="0.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>
</Window>
