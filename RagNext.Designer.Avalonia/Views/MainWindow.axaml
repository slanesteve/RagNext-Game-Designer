<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RagNext.Designer.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.WebView"
        xmlns:models="using:RagsCore.Models"
        xmlns:views="using:RagNext.Designer.Avalonia.Views"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
        x:Class="RagNext.Designer.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/ragnext-logo.png"
        Title="RagNext Designer Workspace (Native AOT)"
        Background="#181822"
        Foreground="#E0E0F0"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        RequestedThemeVariant="Dark">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <!-- Background decorative ambient glow -->
        <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False" Opacity="0.1">
            <Ellipse Width="600" Height="600" Fill="#8E2DE2" Canvas.Left="-100" Canvas.Top="-100" Margin="0" />
            <Ellipse Width="500" Height="500" Fill="#4A00E0" Canvas.Right="-100" Canvas.Bottom="-100" Margin="0" />
        </Canvas>

        <!-- Main Workspace Shell -->
        <Grid ColumnDefinitions="240,*,Auto" RowDefinitions="Auto,*">
            
            <!-- Top Action Header -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Height="54" Background="#1D1D28" BorderBrush="#2D2D3E" BorderThickness="0,0,0,1" Padding="16,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                     <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Branding Box -->
                        <Border CornerRadius="4" Width="28" Height="28">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Color="#8E2DE2" Offset="0.0"/>
                                    <GradientStop Color="#4A00E0" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="RN" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="RAGNEXT WORKSPACE" FontSize="14" FontWeight="Bold" LetterSpacing="1" Foreground="White" VerticalAlignment="Center"/>
                        <Border Background="#35354A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="NATIVE AOT PROTECTED" FontSize="9" FontWeight="Bold" Foreground="#A29BFE"/>
                        </Border>
                        
                        <!-- Manual Load / Launcher Button -->
                        <Button Content="📂 Launcher" Command="{Binding ShowLauncherCommand}" FontSize="12" Background="#262635" Foreground="#A29BFE" BorderBrush="#3D3D5A" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Active Project Status -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasGame}">
                        <TextBlock Text="Project:" Foreground="Gray" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Text="{Binding GameTitle}" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Text="v" Foreground="Gray" VerticalAlignment="Center" FontSize="12" Margin="4,0,-4,0"/>
                        <TextBlock Text="{Binding GameVersion}" Foreground="#8E2DE2" FontWeight="Bold" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>

                    <!-- Quick Tools -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding HasGame}">
                        <Button Content="💾 Quick Save" Command="{Binding SaveGameCommand}" FontSize="12" Background="#262635" BorderBrush="#3D3D5A" BorderThickness="1" CornerRadius="4" Padding="10,6"/>
                        <Button Content="🚀 Publish Standalone" Command="{Binding NavigateCommand}" CommandParameter="Publish" FontSize="12" Foreground="White" FontWeight="Bold" CornerRadius="4" Padding="12,6">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Color="#8E2DE2" Offset="0.0"/>
                                    <GradientStop Color="#4A00E0" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Left Sidebar Navigation -->
            <Border Grid.Row="1" Grid.Column="0" Background="#14141E" BorderBrush="#2D2D3E" BorderThickness="0,0,1,0" Padding="12,16">
                <Grid RowDefinitions="*">
                    <!-- Nav Tabs -->
                    <StackPanel Grid.Row="0" Spacing="6" IsEnabled="{Binding HasGame}">
                        <TextBlock Text="DESIGNER" FontSize="11" FontWeight="Bold" Foreground="Gray" Margin="8,0,0,8" LetterSpacing="1"/>
                        
                        <Button Classes="nav" Content="🏠 Project Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Dashboard, Converter={x:Static ObjectConverters.Equal}}"/>
                        <Button Classes="nav" Content="👤 Player &amp; Start Config" Command="{Binding NavigateCommand}" CommandParameter="Player" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Player, Converter={x:Static ObjectConverters.Equal}}"/>
                        <Button Classes="nav" Content="🚪 Rooms Editor" Command="{Binding NavigateCommand}" CommandParameter="Rooms" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Rooms, Converter={x:Static ObjectConverters.Equal}}"/>
                        <Button Classes="nav" Content="👥 Characters Database" Command="{Binding NavigateCommand}" CommandParameter="Characters" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Characters, Converter={x:Static ObjectConverters.Equal}}"/>
                        <Button Classes="nav" Content="📦 Game Objects &amp; Items" Command="{Binding NavigateCommand}" CommandParameter="Objects" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Objects, Converter={x:Static ObjectConverters.Equal}}"/>
                        <Button Classes="nav" Content="📊 Global Variables" Command="{Binding NavigateCommand}" CommandParameter="Variables" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Variables, Converter={x:Static ObjectConverters.Equal}}"/>
                        <Button Classes="nav" Content="⏱️ System Timers" Command="{Binding NavigateCommand}" CommandParameter="Timers" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Timers, Converter={x:Static ObjectConverters.Equal}}"/>
                        <Button Classes="nav" Content="📜 Global Functions" Command="{Binding NavigateCommand}" CommandParameter="Functions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Functions, Converter={x:Static ObjectConverters.Equal}}"/>
                        <Button Classes="nav" Content="🎨 Splash Screen" Command="{Binding NavigateCommand}" CommandParameter="SplashScreen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=SplashScreen, Converter={x:Static ObjectConverters.Equal}}"/>
                        <Button Classes="nav" Content="📂 Media Asset Library" Command="{Binding NavigateCommand}" CommandParameter="Media" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Media, Converter={x:Static ObjectConverters.Equal}}"/>

                        <TextBlock Text="DIAGNOSTICS &amp; DISTRIBUTION" FontSize="11" FontWeight="Bold" Foreground="Gray" Margin="8,16,0,8" LetterSpacing="1"/>
                        <Button Classes="nav" Content="🔍 Validation Engine" Command="{Binding NavigateCommand}" CommandParameter="Validation" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Validation, Converter={x:Static ObjectConverters.Equal}}"/>
                        <Button Classes="nav" Content="🚀 Standalone Compiler" Command="{Binding NavigateCommand}" CommandParameter="Publish" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Publish, Converter={x:Static ObjectConverters.Equal}}"/>
                        <Button Classes="nav" Content="⚙️ Workspace Preferences" Command="{Binding NavigateCommand}" CommandParameter="Preferences" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{Binding ActiveView, ConverterParameter=Preferences, Converter={x:Static ObjectConverters.Equal}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Workstation Canvas -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="24">
                
                <!-- 1. Dashboard View -->
                <ScrollViewer IsVisible="{Binding ActiveView, ConverterParameter=Dashboard, Converter={x:Static ObjectConverters.Equal}}">
                    <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left">
                        <TextBlock Text="Project Dashboard" FontSize="26" FontWeight="Bold" Foreground="White"/>
                        
                        <!-- Metadata Card -->
                        <Border Background="#1C1C28" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="📝 Story Metadata" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2" Margin="0,0,0,4"/>
                                
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="140,*">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Game Title:" VerticalAlignment="Center" Foreground="Gray"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding GameTitle, Mode=TwoWay}" PlaceholderText="Name of your RPG / Interactive Fiction" Background="#13131F" BorderBrush="#33334A"/>
                                    
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Author:" VerticalAlignment="Center" Foreground="Gray"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GameAuthor, Mode=TwoWay}" PlaceholderText="Author or Studio" Background="#13131F" BorderBrush="#33334A"/>
                                    
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Version:" VerticalAlignment="Center" Foreground="Gray"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GameVersion, Mode=TwoWay}" PlaceholderText="e.g. 1.0.0" Background="#13131F" BorderBrush="#33334A"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Project Statistics -->
                        <Border Background="#1C1C28" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="📊 World Overview" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2" Margin="0,0,0,4"/>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                    <Border Background="#13131F" CornerRadius="6" Padding="16" Width="170" Margin="0,0,12,12">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🚪 Rooms" Foreground="Gray" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Rooms.Rooms.Count}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#13131F" CornerRadius="6" Padding="16" Width="170" Margin="0,0,12,12">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="👥 Characters" Foreground="Gray" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Characters.Characters.Count}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#13131F" CornerRadius="6" Padding="16" Width="170" Margin="0,0,12,12">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="📦 Game Objects" Foreground="Gray" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Objects.Objects.Count}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#13131F" CornerRadius="6" Padding="16" Width="170" Margin="0,0,12,12">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="📊 Variables" Foreground="Gray" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Variables.Variables.Count}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 1b. Player & Start Config Tab -->
                <ScrollViewer IsVisible="{Binding ActiveView, ConverterParameter=Player, Converter={x:Static ObjectConverters.Equal}}">
                    <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left" DataContext="{Binding Player}" x:DataType="models:Player">
                        <TextBlock Text="Player &amp; Start Config" FontSize="26" FontWeight="Bold" Foreground="White"/>
                        
                        <Border Background="#1C1C28" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="👤 Protagonist Identity" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="140,*" RowSpacing="12" Margin="0,10,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Protagonist Name:" VerticalAlignment="Center" Foreground="Gray"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" Background="#13131F" BorderBrush="#33334A"/>
                                    
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" VerticalAlignment="Top" Margin="0,6,0,0" Foreground="Gray"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Description, Mode=TwoWay}" AcceptsReturn="True" Height="60" VerticalContentAlignment="Top" Background="#13131F" BorderBrush="#33334A"/>
                                    
                                    <!-- Prompt for Name switch -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Prompt for Name:" VerticalAlignment="Center" Foreground="Gray"/>
                                    <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding bPromptForName, Mode=TwoWay}" OnContent="Yes" OffContent="No" Foreground="White" VerticalAlignment="Center"/>

                                    <!-- Gender Combo -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Gender:" VerticalAlignment="Center" Foreground="Gray"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="#13131F"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Starting Room:" VerticalAlignment="Center" Foreground="Gray"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" SelectedItem="{Binding StartingRoom, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="#13131F">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:Room">
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <!-- Portrait Media Panel -->
                                <TextBlock Text="Portrait Media Artwork" Foreground="Gray" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                <Border Background="#13131F" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="8" Padding="12" DragDrop.AllowDrop="True" DragDrop.Drop="OnDragDropFile" Tag="Player">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Width="88" Height="88" Background="#0C0C12" CornerRadius="6" ClipToBounds="True">
                                            <Image Source="{Binding PortraitImagePath, Converter={x:Static views:ImagePathToBitmapConverter.Instance}}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PortraitImageFileName, FallbackValue='No Portrait Image set'}" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Clear Image" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Media.RemoveAssetCommand}" CommandParameter="{Binding}" Background="#C0392B" Foreground="White" FontSize="11" Padding="8,4"/>
                                                <Button Content="✨ Generate with AI..." Background="#8E2DE2" Foreground="White" FontSize="11" Padding="10,4"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Player Inventory Management Card -->
                        <Border Background="#1C1C28" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="🎒 Starting Inventory" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                                        <TextBlock Text="Items that the player possesses at the beginning of the story" FontSize="11" Foreground="Gray"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="➕ Add Item" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TriggerAddInventoryCommand}" CommandParameter="{Binding}" Background="#8E2DE2" Foreground="White" CornerRadius="4" Padding="10,6" FontSize="12"/>
                                </Grid>

                                <ListBox ItemsSource="{Binding Inventory}" Height="120" Background="#13131F" BorderBrush="#33334A" BorderThickness="1" CornerRadius="6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:GameObject">
                                            <Grid ColumnDefinitions="*,Auto" Height="36">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="📦" FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="🗑️ Remove" 
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveInventoryItemCommand}"
                                                        CommandParameter="{Binding $parent[ListBox].((models:Player)DataContext).Inventory, Converter={x:Static ObjectConverters.Equal}}" 
                                                        Background="Transparent" Foreground="#E74C3C" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Player Custom Attributes Card -->
                        <Border Background="#1C1C28" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="📊 Player Attributes" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                                        <TextBlock Text="Custom key-value parameters (e.g. Strength, Health, Mana)" FontSize="11" Foreground="Gray"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="➕ Add Attribute" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TriggerAddAttributeCommand}" CommandParameter="{Binding}" Background="#8E2DE2" Foreground="White" CornerRadius="4" Padding="10,6" FontSize="12"/>
                                </Grid>

                                <ListBox ItemsSource="{Binding Attributes}" Height="120" Background="#13131F" BorderBrush="#33334A" BorderThickness="1" CornerRadius="6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:CustomAttribute">
                                            <Grid ColumnDefinitions="*,Auto" Height="36">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="⚡" FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                    <TextBlock Text="=" Foreground="Gray" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Value}" Foreground="#A29BFE" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="🗑️ Remove" 
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveAttributeCommand}"
                                                        CommandParameter="{Binding $parent[ListBox].((models:Player)DataContext).Attributes, Converter={x:Static ObjectConverters.Equal}}" 
                                                        Background="Transparent" Foreground="#E74C3C" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Player Actions Scripting Card -->
                        <Border Background="#1C1C28" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="📜 Global Player Action Scripts" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                                <Grid ColumnDefinitions="*, *" Height="220">
                                    <Grid Grid.Column="0" RowDefinitions="*, Auto" Margin="0,0,8,0">
                                        <ListBox Grid.Row="0" ItemsSource="{Binding Actions}" SelectedIndex="0" x:Name="PlayerActionsList" Background="#13131F" BorderBrush="#33334A" BorderThickness="1">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:Action">
                                                    <TextBlock Text="{Binding Name}" Foreground="White"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                            <Button Content="+ Action" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddActionCommand}" CommandParameter="{Binding}" Background="#2B2B3A" FontSize="11" Padding="8,4"/>
                                            <Button Content="Delete" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteActionCommand}" CommandParameter="{Binding #PlayerActionsList.SelectedItem}" Background="#C0392B" FontSize="11" Padding="8,4"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Column="1" Background="#13131F" BorderBrush="#33334A" BorderThickness="1" CornerRadius="4" Padding="10" IsVisible="{Binding #PlayerActionsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <ScrollViewer>
                                            <StackPanel Spacing="10" DataContext="{Binding #PlayerActionsList.SelectedItem}" x:DataType="models:Action">
                                                <TextBlock Text="Edit Action" FontSize="12" FontWeight="Bold" Foreground="Gray"/>
                                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Action Name" FontSize="12" Background="#1C1C28"/>
                                                <TextBlock Text="Trigger Event:" FontSize="10" Foreground="Gray"/>
                                                <ComboBox SelectedIndex="{Binding Trigger, Mode=TwoWay}" HorizontalAlignment="Stretch" FontSize="11" Background="#1C1C28">
                                                    <ComboBoxItem Content="UserClicked"/>
                                                    <ComboBoxItem Content="OnGameStart"/>
                                                    <ComboBoxItem Content="OnGameLoad"/>
                                                    <ComboBoxItem Content="OnTurnTick"/>
                                                    <ComboBoxItem Content="OnPlayerEnter"/>
                                                    <ComboBoxItem Content="OnPlayerExit"/>
                                                    <ComboBoxItem Content="OnCharacterEnter"/>
                                                    <ComboBoxItem Content="OnCharacterExit"/>
                                                    <ComboBoxItem Content="OnRoomTick"/>
                                                    <ComboBoxItem Content="OnInteract"/>
                                                    <ComboBoxItem Content="OnCharacterTick"/>
                                                    <ComboBoxItem Content="OnCharacterKilled"/>
                                                    <ComboBoxItem Content="OnObjectExamined"/>
                                                    <ComboBoxItem Content="OnObjectTaken"/>
                                                    <ComboBoxItem Content="OnObjectDropped"/>
                                                </ComboBox>
                                                <CheckBox IsChecked="{Binding InitallyActive, Mode=TwoWay}" Content="Initially Active" FontSize="11" Foreground="Gray"/>
                                                <Button Content="🎨 Visual Graph Editor" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StartEditingActionCommand}" CommandParameter="{Binding}" Background="#8E2DE2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. Rooms Editor -->
                <Grid IsVisible="{Binding ActiveView, ConverterParameter=Rooms, Converter={x:Static ObjectConverters.Equal}}" ColumnDefinitions="300,*">
                    <!-- Left Rooms List -->
                    <Border Grid.Column="0" Background="#1C1C28" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Row="0" Text="Rooms in World" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Rooms.Rooms}" Background="Transparent" SelectedIndex="0" x:Name="RoomsList" SelectionChanged="OnRoomsSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Room">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="2" Content="+ Add Room" Command="{Binding AddRoomCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                    <!-- Right Room Fields -->
                    <Border Grid.Column="1" Background="#1C1C28" CornerRadius="8" Padding="20" IsVisible="{Binding #RoomsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="Edit Room" FontSize="18" FontWeight="Bold" Foreground="#8E2DE2" Margin="0,0,0,10"/>
                            
                            <TabControl Grid.Row="1" DataContext="{Binding #RoomsList.SelectedItem}" x:DataType="models:Room">
                                <!-- Properties Tab -->
                                <TabItem Header="Properties">
                                    <ScrollViewer x:Name="RoomDetailsScrollViewer" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" Height="500">
                                        <StackPanel Spacing="16">
                                            <!-- Name -->
                                            <TextBlock Text="Name" Foreground="Gray" FontSize="12" FontWeight="SemiBold"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBox Text="{Binding Name, Mode=TwoWay}" Background="#13131F" BorderBrush="#33334A" Padding="8,6"/>
                                                <Button Grid.Column="1" Content="✨" Margin="8,0,0,0" Width="36" Height="34" Background="#8E2DE2" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                            </Grid>

                                            <!-- Description -->
                                            <TextBlock Text="Description" Foreground="Gray" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                                <Button Content="B" FontWeight="Bold" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#262635" Foreground="White" FontSize="11"/>
                                                <Button Content="/" FontStyle="Italic" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#262635" Foreground="White" FontSize="11"/>
                                                <Button Content="U" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#262635" Foreground="White" FontSize="11"/>
                                                <Button Content="🎨 Color" Height="28" Background="#262635" Foreground="White" FontSize="11" Padding="8,0"/>
                                                <Button Content="🖌️ Highlight" Height="28" Background="#262635" Foreground="White" FontSize="11" Padding="8,0"/>
                                                <Button Content="Clear" Height="28" Background="#2B2B3A" Foreground="Gray" FontSize="11" Padding="8,0"/>
                                            </StackPanel>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBox Text="{Binding Description, Mode=TwoWay}" AcceptsReturn="True" Height="70" VerticalContentAlignment="Top" Background="#13131F" BorderBrush="#33334A" TextWrapping="Wrap"/>
                                                <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                                    <Button Content="?" Width="36" Height="32" Background="#262635" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                    <Button Content="✨" Width="36" Height="32" Background="#8E2DE2" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Live Preview -->
                                            <TextBlock Text="👁️ Live Preview" Foreground="Gray" FontSize="11" FontStyle="Italic"/>
                                            <Border Background="#13131F" CornerRadius="4" Padding="8">
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="LightGray" TextWrapping="Wrap"/>
                                            </Border>

                                            <!-- Portrait Image -->
                                            <TextBlock Text="Portrait" Foreground="Gray" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                            <Border Background="#13131F" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="8" Padding="12" DragDrop.AllowDrop="True" DragDrop.Drop="OnDragDropFile" Tag="Room">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Border Width="80" Height="80" Background="#0C0C12" CornerRadius="6" ClipToBounds="True">
                                                        <Image Source="{Binding PortraitImagePath, Converter={x:Static views:ImagePathToBitmapConverter.Instance}}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PortraitImageFileName, FallbackValue='No image selected'}" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Button Content="Clear Image" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Media.RemoveAssetCommand}" CommandParameter="{Binding}" Background="#C0392B" Foreground="White" FontSize="11" Padding="8,4"/>
                                                            <Button Content="Generate with AI..." Background="#8E2DE2" Foreground="White" FontSize="11" Padding="10,4"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Collapsible Exits & Navigation -->
                                            <Expander Header="Exits &amp; Navigation" Background="#13131F" Margin="0,8,0,0">
                                                <StackPanel Spacing="10" Margin="10">
                                                    <TextBlock Text="Select target rooms and toggles for exits directions:" FontSize="11" Foreground="Gray"/>
                                                    
                                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="16">
                                                        <!-- Helper macros to inject direction block. -->
                                                        <!-- North -->
                                                        <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="North →" FontSize="11" Foreground="Gray"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="NorthPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="NorthOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="NorthLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- South -->
                                                        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="South ←" FontSize="11" Foreground="Gray"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="SouthPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="SouthOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="SouthLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- East -->
                                                        <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="East →" FontSize="11" Foreground="Gray"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="EastPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="EastOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="EastLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- West -->
                                                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="West ←" FontSize="11" Foreground="Gray"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="WestPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="WestOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="WestLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- Northwest -->
                                                        <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Northwest ↖" FontSize="11" Foreground="Gray"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="NorthWestPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="NorthWestOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="NorthWestLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- Northeast -->
                                                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Northeast ↗" FontSize="11" Foreground="Gray"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="NorthEastPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="NorthEastOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="NorthEastLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- Southwest -->
                                                        <Grid Grid.Row="3" Grid.Column="0" ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Southwest ↙" FontSize="11" Foreground="Gray"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="SouthWestPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="SouthWestOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="SouthWestLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- Southeast -->
                                                        <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Southeast ↘" FontSize="11" Foreground="Gray"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="SouthEastPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="SouthEastOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="SouthEastLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- Up -->
                                                        <Grid Grid.Row="4" Grid.Column="0" ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Up ▲" FontSize="11" Foreground="Gray"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="UpPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="UpOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="UpLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- Down -->
                                                        <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Down ▼" FontSize="11" Foreground="Gray"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="DownPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="DownOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="DownLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- In -->
                                                        <Grid Grid.Row="5" Grid.Column="0" ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="In ↵" FontSize="11" Foreground="Gray"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="InPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="InOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="InLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>

                                                        <!-- Out -->
                                                        <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto">
                                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Out ↳" FontSize="11" Foreground="Gray"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="OutPicker" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" HorizontalAlignment="Stretch" Height="32">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:Room">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="OutOneWay" Content="One Way" Margin="8,0,0,0" FontSize="11"/>
                                                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="OutLocked" Content="Locked" Margin="8,0,0,0" FontSize="11"/>
                                                        </Grid>
                                                    </Grid>
                                                </StackPanel>
                                            </Expander>

                                            <!-- Collapsible Attributes -->
                                            <Expander Header="Attributes" Background="#13131F" Margin="0,8,0,0">
                                                <StackPanel Spacing="10" Margin="10">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="Manage custom story variable parameters on this room:" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="➕ Add Attribute" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TriggerAddAttributeCommand}" CommandParameter="{Binding}" Background="#2A2A3E" Foreground="#A29BFE" FontSize="11" Padding="8,4"/>
                                                    </Grid>
                                                    <ListBox ItemsSource="{Binding Attributes}" Height="110" Background="#0C0C12" BorderBrush="#2D2D3E" BorderThickness="1">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:CustomAttribute">
                                                                <Grid ColumnDefinitions="*,Auto" Height="36">
                                                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                                        <TextBlock Text="⚡" FontSize="12" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="=" Foreground="Gray" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Value}" Foreground="#A29BFE" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="1" Content="🗑️ Remove" 
                                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveAttributeCommand}"
                                                                            CommandParameter="{Binding $parent[ListBox].((models:Room)DataContext).Attributes, Converter={x:Static ObjectConverters.Equal}}" 
                                                                            Background="Transparent" Foreground="#E74C3C" FontSize="11"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Expander>

                                            <!-- Collapsible Room Objects -->
                                            <Expander Header="Room Objects" Background="#13131F">
                                                <StackPanel Spacing="10" Margin="10">
                                                    <TextBlock Text="Select Objects starting in this Room:" FontSize="11" Foreground="Gray" FontWeight="Bold"/>
                                                    <ListBox x:Name="ObjectsCheckList" Height="150" Background="#0C0C12">
                                                        <ListBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ListBox.ItemsPanel>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="views:ObjectCheckItem">
                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="OnRoomObjectClicked" Margin="6,4" Foreground="White"/>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Expander>

                                            <!-- Actions & Events -->
                                            <TextBlock Text="Actions &amp; Events" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2" Margin="0,16,0,0"/>
                                            <Grid ColumnDefinitions="*, *" Height="220">
                                                <Grid Grid.Column="0" RowDefinitions="*, Auto" Margin="0,0,8,0">
                                                    <ListBox Grid.Row="0" ItemsSource="{Binding Actions}" SelectedIndex="0" x:Name="RoomActionsList" Background="#13131F" BorderBrush="#33334A" BorderThickness="1">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:Action">
                                                                <TextBlock Text="{Binding Name}" Foreground="White"/>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                                        <Button Content="+ Action" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddActionCommand}" CommandParameter="{Binding}" Background="#2B2B3A" FontSize="11" Padding="8,4"/>
                                                        <Button Content="Delete" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteActionCommand}" CommandParameter="{Binding #RoomActionsList.SelectedItem}" Background="#C0392B" FontSize="11" Padding="8,4"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Border Grid.Column="1" Background="#13131F" BorderBrush="#33334A" BorderThickness="1" CornerRadius="4" Padding="10" IsVisible="{Binding #RoomActionsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <ScrollViewer>
                                                        <StackPanel Spacing="10" DataContext="{Binding #RoomActionsList.SelectedItem}" x:DataType="models:Action">
                                                            <TextBlock Text="Edit Action" FontSize="12" FontWeight="Bold" Foreground="Gray"/>
                                                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Action Name" FontSize="12" Background="#1C1C28"/>
                                                            <TextBlock Text="Trigger Event:" FontSize="10" Foreground="Gray"/>
                                                            <ComboBox SelectedIndex="{Binding Trigger, Mode=TwoWay}" HorizontalAlignment="Stretch" FontSize="11" Background="#1C1C28">
                                                                <ComboBoxItem Content="UserClicked"/>
                                                                <ComboBoxItem Content="OnGameStart"/>
                                                                <ComboBoxItem Content="OnGameLoad"/>
                                                                <ComboBoxItem Content="OnTurnTick"/>
                                                                <ComboBoxItem Content="OnPlayerEnter"/>
                                                                <ComboBoxItem Content="OnPlayerExit"/>
                                                                <ComboBoxItem Content="OnCharacterEnter"/>
                                                                <ComboBoxItem Content="OnCharacterExit"/>
                                                                <ComboBoxItem Content="OnRoomTick"/>
                                                                <ComboBoxItem Content="OnInteract"/>
                                                                <ComboBoxItem Content="OnCharacterTick"/>
                                                                <ComboBoxItem Content="OnCharacterKilled"/>
                                                                <ComboBoxItem Content="OnObjectExamined"/>
                                                                <ComboBoxItem Content="OnObjectTaken"/>
                                                                <ComboBoxItem Content="OnObjectDropped"/>
                                                            </ComboBox>
                                                            <CheckBox IsChecked="{Binding InitallyActive, Mode=TwoWay}" Content="Initially Active" FontSize="11" Foreground="Gray"/>
                                                            <Button Content="🎨 Visual Graph Editor" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StartEditingActionCommand}" CommandParameter="{Binding}" Background="#8E2DE2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12"/>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. Characters Database -->
                <Grid IsVisible="{Binding ActiveView, ConverterParameter=Characters, Converter={x:Static ObjectConverters.Equal}}" ColumnDefinitions="300,*">
                    <Border Grid.Column="0" Background="#1C1C28" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Row="0" Text="Characters" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Characters.Characters}" Background="Transparent" SelectedIndex="0" x:Name="CharsList" SelectionChanged="OnCharsSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Character">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="2" Content="+ Create Character" Command="{Binding AddCharacterCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="#1C1C28" CornerRadius="8" Padding="20" IsVisible="{Binding #CharsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ScrollViewer x:Name="CharDetailsScrollViewer" VerticalScrollBarVisibility="Auto" Height="620">
                            <StackPanel Spacing="16" DataContext="{Binding #CharsList.SelectedItem}" x:DataType="models:Character">
                                <TextBlock Text="Edit Character" FontSize="18" FontWeight="Bold" Foreground="#8E2DE2"/>
                                
                                <TextBlock Text="Name:" Foreground="Gray"/>
                                <TextBox Text="{Binding Name, Mode=TwoWay}" Background="#13131F" BorderBrush="#33334A"/>
                                
                                <TextBlock Text="Description:" Foreground="Gray"/>
                                <TextBox Text="{Binding Description, Mode=TwoWay}" AcceptsReturn="True" Height="80" VerticalContentAlignment="Top" Background="#13131F" BorderBrush="#33334A" TextWrapping="Wrap"/>

                                <!-- Portrait Image -->
                                <TextBlock Text="Portrait" Foreground="Gray" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <Border Background="#13131F" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="8" Padding="12" DragDrop.AllowDrop="True" DragDrop.Drop="OnDragDropFile" Tag="Character">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Width="80" Height="80" Background="#0C0C12" CornerRadius="6" ClipToBounds="True">
                                            <Image Source="{Binding PortraitImagePath, Converter={x:Static views:ImagePathToBitmapConverter.Instance}}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PortraitImageFileName, FallbackValue='No image selected'}" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Clear Image" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Media.RemoveAssetCommand}" CommandParameter="{Binding}" Background="#C0392B" Foreground="White" FontSize="11" Padding="8,4"/>
                                                <Button Content="Generate with AI..." Background="#8E2DE2" Foreground="White" FontSize="11" Padding="10,4"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Health & Hostile -->
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" Margin="0,8,0,0">
                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,16,0">
                                        <TextBlock Text="Health" Foreground="Gray" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding Health, Mode=TwoWay}" Background="#13131F" BorderBrush="#33334A" Padding="8,6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Hostile" Foreground="Gray" FontSize="12" FontWeight="SemiBold"/>
                                        <CheckBox IsChecked="{Binding IsHostile, Mode=TwoWay}" Foreground="White" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Starting Room -->
                                <TextBlock Text="Starting Room" Foreground="Gray" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <ComboBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Rooms.Rooms}" SelectedItem="{Binding StartingRoom, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="#13131F" BorderBrush="#33334A">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:Room">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Inventory -->
                                <Expander Header="Inventory" Background="#13131F" Margin="0,8,0,0">
                                    <StackPanel Spacing="10" Margin="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Manage items carried by this character:" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="➕ Add Item" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TriggerAddInventoryCommand}" CommandParameter="{Binding}" Background="#2A2A3E" Foreground="#A29BFE" FontSize="11" Padding="8,4"/>
                                        </Grid>
                                        <ListBox ItemsSource="{Binding Inventory}" Height="120" Background="#0C0C12" BorderBrush="#2D2D3E" BorderThickness="1">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:GameObject">
                                                    <Grid ColumnDefinitions="*,Auto" Height="36">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="📦" FontSize="14" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="🗑️ Remove" 
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveInventoryItemCommand}"
                                                                CommandParameter="{Binding $parent[ListBox].((models:Character)DataContext).Inventory, Converter={x:Static ObjectConverters.Equal}}" 
                                                                Background="Transparent" Foreground="#E74C3C" FontSize="11"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Expander>

                                <!-- Attributes -->
                                <Expander Header="Attributes" Background="#13131F" Margin="0,8,0,0">
                                    <StackPanel Spacing="10" Margin="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Manage custom attributes on this character:" FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="➕ Add Attribute" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TriggerAddAttributeCommand}" CommandParameter="{Binding}" Background="#2A2A3E" Foreground="#A29BFE" FontSize="11" Padding="8,4"/>
                                        </Grid>
                                        <ListBox ItemsSource="{Binding Attributes}" Height="120" Background="#0C0C12" BorderBrush="#2D2D3E" BorderThickness="1">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:CustomAttribute">
                                                    <Grid ColumnDefinitions="*,Auto" Height="36">
                                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                            <TextBlock Text="⚡" FontSize="12" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                            <TextBlock Text="=" Foreground="Gray" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Value}" Foreground="#A29BFE" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="🗑️ Remove" 
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveAttributeCommand}"
                                                                CommandParameter="{Binding $parent[ListBox].((models:Character)DataContext).Attributes, Converter={x:Static ObjectConverters.Equal}}" 
                                                                Background="Transparent" Foreground="#E74C3C" FontSize="11"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Expander>

                                <TextBlock Text="Actions &amp; Events" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2" Margin="0,16,0,0"/>
                                <Grid ColumnDefinitions="*, *" Height="220">
                                    <Grid Grid.Column="0" RowDefinitions="*, Auto" Margin="0,0,8,0">
                                        <ListBox Grid.Row="0" ItemsSource="{Binding Actions}" SelectedIndex="0" x:Name="CharacterActionsList" Background="#13131F" BorderBrush="#33334A" BorderThickness="1">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:Action">
                                                    <TextBlock Text="{Binding Name}" Foreground="White"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                            <Button Content="+ Action" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddActionCommand}" CommandParameter="{Binding}" Background="#2B2B3A" FontSize="11" Padding="8,4"/>
                                            <Button Content="Delete" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteActionCommand}" CommandParameter="{Binding #CharacterActionsList.SelectedItem}" Background="#C0392B" FontSize="11" Padding="8,4"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Column="1" Background="#13131F" BorderBrush="#33334A" BorderThickness="1" CornerRadius="4" Padding="10" IsVisible="{Binding #CharacterActionsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <ScrollViewer>
                                            <StackPanel Spacing="10" DataContext="{Binding #CharacterActionsList.SelectedItem}" x:DataType="models:Action">
                                                <TextBlock Text="Edit Action" FontSize="12" FontWeight="Bold" Foreground="Gray"/>
                                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Action Name" FontSize="12" Background="#1C1C28"/>
                                                <TextBlock Text="Trigger Event:" FontSize="10" Foreground="Gray"/>
                                                <ComboBox SelectedIndex="{Binding Trigger, Mode=TwoWay}" HorizontalAlignment="Stretch" FontSize="11" Background="#1C1C28">
                                                    <ComboBoxItem Content="UserClicked"/>
                                                    <ComboBoxItem Content="OnGameStart"/>
                                                    <ComboBoxItem Content="OnGameLoad"/>
                                                    <ComboBoxItem Content="OnTurnTick"/>
                                                    <ComboBoxItem Content="OnPlayerEnter"/>
                                                    <ComboBoxItem Content="OnPlayerExit"/>
                                                    <ComboBoxItem Content="OnCharacterEnter"/>
                                                    <ComboBoxItem Content="OnCharacterExit"/>
                                                    <ComboBoxItem Content="OnRoomTick"/>
                                                    <ComboBoxItem Content="OnInteract"/>
                                                    <ComboBoxItem Content="OnCharacterTick"/>
                                                    <ComboBoxItem Content="OnCharacterKilled"/>
                                                    <ComboBoxItem Content="OnObjectExamined"/>
                                                    <ComboBoxItem Content="OnObjectTaken"/>
                                                    <ComboBoxItem Content="OnObjectDropped"/>
                                                </ComboBox>
                                                <CheckBox IsChecked="{Binding InitallyActive, Mode=TwoWay}" Content="Initially Active" FontSize="11" Foreground="Gray"/>
                                                <Button Content="🎨 Visual Graph Editor" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StartEditingActionCommand}" CommandParameter="{Binding}" Background="#8E2DE2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 4. Game Objects & Items -->
                <Grid IsVisible="{Binding ActiveView, ConverterParameter=Objects, Converter={x:Static ObjectConverters.Equal}}" ColumnDefinitions="300,*">
                    <Border Grid.Column="0" Background="#1C1C28" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Row="0" Text="Objects &amp; Items" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Objects.Objects}" Background="Transparent" SelectedIndex="0" x:Name="ObjectsList" SelectionChanged="OnObjectsSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:GameObject">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="2" Content="+ Create Object" Command="{Binding AddObjectCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="#1C1C28" CornerRadius="8" Padding="20" IsVisible="{Binding #ObjectsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="Edit Object" FontSize="18" FontWeight="Bold" Foreground="#8E2DE2" Margin="0,0,0,10"/>
                            
                            <TabControl Grid.Row="1" DataContext="{Binding #ObjectsList.SelectedItem}" x:DataType="models:GameObject">
                                <!-- Properties Tab -->
                                <TabItem Header="Properties">
                                    <ScrollViewer x:Name="ObjectDetailsScrollViewer" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" Height="500">
                                        <StackPanel Spacing="16">
                                            <!-- Name -->
                                            <TextBlock Text="Name" Foreground="Gray" FontSize="12" FontWeight="SemiBold"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBox Text="{Binding Name, Mode=TwoWay}" Background="#13131F" BorderBrush="#33334A" Padding="8,6"/>
                                                <Button Grid.Column="1" Content="✨" Margin="8,0,0,0" Width="36" Height="34" Background="#8E2DE2" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                            </Grid>

                                            <!-- Description -->
                                            <TextBlock Text="Description" Foreground="Gray" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                                <Button Content="B" FontWeight="Bold" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#262635" Foreground="White" FontSize="11"/>
                                                <Button Content="/" FontStyle="Italic" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#262635" Foreground="White" FontSize="11"/>
                                                <Button Content="U" Width="28" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#262635" Foreground="White" FontSize="11"/>
                                                <Button Content="🎨 Color" Height="28" Background="#262635" Foreground="White" FontSize="11" Padding="8,0"/>
                                                <Button Content="🖌️ Highlight" Height="28" Background="#262635" Foreground="White" FontSize="11" Padding="8,0"/>
                                                <Button Content="Clear" Height="28" Background="#2B2B3A" Foreground="Gray" FontSize="11" Padding="8,0"/>
                                            </StackPanel>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBox Text="{Binding Description, Mode=TwoWay}" AcceptsReturn="True" Height="70" VerticalContentAlignment="Top" Background="#13131F" BorderBrush="#33334A" TextWrapping="Wrap"/>
                                                <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                                    <Button Content="?" Width="36" Height="32" Background="#262635" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                    <Button Content="✨" Width="36" Height="32" Background="#8E2DE2" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Live Preview -->
                                            <TextBlock Text="👁️ Live Preview" Foreground="Gray" FontSize="11" FontStyle="Italic"/>
                                            <Border Background="#13131F" CornerRadius="4" Padding="8">
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="LightGray" TextWrapping="Wrap"/>
                                            </Border>

                                            <!-- Portrait Image -->
                                            <TextBlock Text="Portrait" Foreground="Gray" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                            <Border Background="#13131F" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="8" Padding="12" DragDrop.AllowDrop="True" DragDrop.Drop="OnDragDropFile" Tag="Object">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Border Width="80" Height="80" Background="#0C0C12" CornerRadius="6" ClipToBounds="True">
                                                        <Image Source="{Binding PortraitImagePath, Converter={x:Static views:ImagePathToBitmapConverter.Instance}}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PortraitImageFileName, FallbackValue='No image selected'}" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Button Content="Clear Image" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Media.RemoveAssetCommand}" CommandParameter="{Binding}" Background="#C0392B" Foreground="White" FontSize="11" Padding="8,4"/>
                                                            <Button Content="Generate with AI..." Background="#8E2DE2" Foreground="White" FontSize="11" Padding="10,4"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Collapsible Attributes -->
                                            <Expander Header="Attributes" Background="#13131F" Margin="0,8,0,0">
                                                <StackPanel Spacing="10" Margin="10">
                                                    <TextBlock Text="Manage custom story variable parameters on this item:" FontSize="11" Foreground="Gray"/>
                                                    <ListBox ItemsSource="{Binding Attributes}" Height="100" Background="#0C0C12" BorderBrush="#2D2D3E" BorderThickness="1">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:CustomAttribute">
                                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White"/>
                                                                    <TextBlock Text="=" Foreground="Gray"/>
                                                                    <TextBlock Text="{Binding Value}" Foreground="LightGray"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </StackPanel>
                                            </Expander>

                                            <!-- Collapsible Container Settings -->
                                            <Expander Header="Container Settings" Background="#13131F">
                                                <StackPanel Spacing="12" Margin="10">
                                                    <CheckBox IsChecked="{Binding IsContainer, Mode=TwoWay}" Content="Is Container" Foreground="White" FontSize="12"/>
                                                    
                                                    <!-- Contained items sub-grid visible only if IsContainer is true -->
                                                    <StackPanel Spacing="8" IsVisible="{Binding IsContainer}" Margin="0,8,0,0">
                                                        <TextBlock Text="Contained Objects:" FontSize="11" Foreground="Gray" FontWeight="Bold"/>
                                                        <ListBox ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Objects.Objects}" Height="120" Background="#0C0C12">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate x:DataType="models:GameObject">
                                                                    <CheckBox Content="{Binding Name}" Foreground="White" FontSize="12"/>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Expander>

                                            <!-- Actions & Events -->
                                            <TextBlock Text="Actions &amp; Events" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2" Margin="0,16,0,0"/>
                                            <Grid ColumnDefinitions="*, *" Height="220">
                                                <Grid Grid.Column="0" RowDefinitions="*, Auto" Margin="0,0,8,0">
                                                    <ListBox Grid.Row="0" ItemsSource="{Binding Actions}" SelectedIndex="0" x:Name="ObjectActionsList" Background="#13131F" BorderBrush="#33334A" BorderThickness="1">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:Action">
                                                                <TextBlock Text="{Binding Name}" Foreground="White"/>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                                        <Button Content="+ Action" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddActionCommand}" CommandParameter="{Binding}" Background="#2B2B3A" FontSize="11" Padding="8,4"/>
                                                        <Button Content="Delete" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteActionCommand}" CommandParameter="{Binding #ObjectActionsList.SelectedItem}" Background="#C0392B" FontSize="11" Padding="8,4"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Border Grid.Column="1" Background="#13131F" BorderBrush="#33334A" BorderThickness="1" CornerRadius="4" Padding="10" IsVisible="{Binding #ObjectActionsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <ScrollViewer>
                                                        <StackPanel Spacing="10" DataContext="{Binding #ObjectActionsList.SelectedItem}" x:DataType="models:Action">
                                                            <TextBlock Text="Edit Action" FontSize="12" FontWeight="Bold" Foreground="Gray"/>
                                                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="Action Name" FontSize="12" Background="#1C1C28"/>
                                                            <TextBlock Text="Trigger Event:" FontSize="10" Foreground="Gray"/>
                                                            <ComboBox SelectedIndex="{Binding Trigger, Mode=TwoWay}" HorizontalAlignment="Stretch" FontSize="11" Background="#1C1C28">
                                                                <ComboBoxItem Content="UserClicked"/>
                                                                <ComboBoxItem Content="OnGameStart"/>
                                                                <ComboBoxItem Content="OnGameLoad"/>
                                                                <ComboBoxItem Content="OnTurnTick"/>
                                                                <ComboBoxItem Content="OnPlayerEnter"/>
                                                                <ComboBoxItem Content="OnPlayerExit"/>
                                                                <ComboBoxItem Content="OnCharacterEnter"/>
                                                                <ComboBoxItem Content="OnCharacterExit"/>
                                                                <ComboBoxItem Content="OnRoomTick"/>
                                                                <ComboBoxItem Content="OnInteract"/>
                                                                <ComboBoxItem Content="OnCharacterTick"/>
                                                                <ComboBoxItem Content="OnCharacterKilled"/>
                                                                <ComboBoxItem Content="OnObjectExamined"/>
                                                                <ComboBoxItem Content="OnObjectTaken"/>
                                                                <ComboBoxItem Content="OnObjectDropped"/>
                                                            </ComboBox>
                                                            <CheckBox IsChecked="{Binding InitallyActive, Mode=TwoWay}" Content="Initially Active" FontSize="11" Foreground="Gray"/>
                                                            <Button Content="🎨 Visual Graph Editor" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StartEditingActionCommand}" CommandParameter="{Binding}" Background="#8E2DE2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12"/>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 5. Global Variables -->
                <Grid IsVisible="{Binding ActiveView, ConverterParameter=Variables, Converter={x:Static ObjectConverters.Equal}}" ColumnDefinitions="300,*">
                    <Border Grid.Column="0" Background="#1C1C28" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Row="0" Text="Game Variables" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Variables.Variables}" Background="Transparent" SelectedIndex="0" x:Name="VarsList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:GameVariable">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="2" Content="+ Define Variable" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="#1C1C28" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16" DataContext="{Binding #VarsList.SelectedItem}" x:DataType="models:GameVariable">
                            <TextBlock Text="Edit Variable" FontSize="18" FontWeight="Bold" Foreground="#8E2DE2"/>
                            
                            <TextBlock Text="Name:" Foreground="Gray"/>
                            <TextBox Text="{Binding Name, Mode=TwoWay}" Background="#13131F" BorderBrush="#33334A"/>
                            
                            <TextBlock Text="Initial Value:" Foreground="Gray"/>
                            <TextBox Text="{Binding Value, Mode=TwoWay}" Background="#13131F" BorderBrush="#33334A"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 6. System Timers -->
                <Grid IsVisible="{Binding ActiveView, ConverterParameter=Timers, Converter={x:Static ObjectConverters.Equal}}" ColumnDefinitions="300,*">
                    <Border Grid.Column="0" Background="#1C1C28" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Row="0" Text="Game Timers" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Timers.Timers}" Background="Transparent" SelectedIndex="0" x:Name="TimersList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:GameTimer">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="2" Content="+ Add Timer" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="#1C1C28" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16" DataContext="{Binding #TimersList.SelectedItem}" x:DataType="models:GameTimer">
                            <TextBlock Text="Edit Timer" FontSize="18" FontWeight="Bold" Foreground="#8E2DE2"/>
                            
                            <TextBlock Text="Name:" Foreground="Gray"/>
                            <TextBox Text="{Binding Name, Mode=TwoWay}" Background="#13131F" BorderBrush="#33334A"/>
                            
                            <TextBlock Text="Ticks Interval (Seconds):" Foreground="Gray"/>
                            <TextBox Text="{Binding IntervalSeconds, Mode=TwoWay}" Background="#13131F" BorderBrush="#33334A"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 7. Global Functions -->
                <Grid IsVisible="{Binding ActiveView, ConverterParameter=Functions, Converter={x:Static ObjectConverters.Equal}}" ColumnDefinitions="300,*">
                    <Border Grid.Column="0" Background="#1C1C28" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Row="0" Text="Global Scripting Functions" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding CurrentGame.Functions}" Background="Transparent" SelectedIndex="0" x:Name="FuncsList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:GlobalFunction">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="2" Content="+ Create Function" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="#1C1C28" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16" DataContext="{Binding #FuncsList.SelectedItem}" x:DataType="models:GlobalFunction">
                            <TextBlock Text="Edit Function Routine" FontSize="18" FontWeight="Bold" Foreground="#8E2DE2"/>
                            
                            <TextBlock Text="Function Name:" Foreground="Gray"/>
                            <TextBox Text="{Binding Name, Mode=TwoWay}" Background="#13131F" BorderBrush="#33334A"/>

                            <TextBlock Text="Trigger Events:" Foreground="Gray"/>
                            <Border Background="#13131F" CornerRadius="4" Padding="12">
                                <TextBlock Text="This function acts as a reusable sub-routine that can be called from any command block." FontSize="12" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap"/>
                            </Border>

                            <Button Content="✨ Edit Function Script Visually" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StartEditingActionCommand}" CommandParameter="{Binding}" Background="#8E2DE2" Foreground="White" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 7b. Splash Screen Settings Tab -->
                <!-- 7b. Splash Screen Settings Tab -->
                <ScrollViewer IsVisible="{Binding ActiveView, ConverterParameter=SplashScreen, Converter={x:Static ObjectConverters.Equal}}">
                    <Grid ColumnDefinitions="*, *" MaxWidth="1100" HorizontalAlignment="Left" DataContext="{Binding SplashScreen}" x:DataType="models:SplashScreenSettings">
                        <!-- Left Side: Customization Parameters -->
                        <StackPanel Grid.Column="0" Spacing="20" Margin="0,0,24,0">
                            <TextBlock Text="Splash Screen Settings" FontSize="26" FontWeight="Bold" Foreground="White"/>
                            
                            <Border Background="#1C1C28" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="🎨 Active Setup" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                                    
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="200,*">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Enable Custom Splash Screen:" VerticalAlignment="Center" Foreground="Gray"/>
                                        <ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}" OnContent="" OffContent=""/>
                                        
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Splash Mode:" VerticalAlignment="Center" Foreground="Gray" Margin="0,10,0,0"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding Mode, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="#13131F" Margin="0,10,0,0">
                                            <ComboBoxItem Content="ImageAndText"/>
                                            <ComboBoxItem Content="Video"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="#1C1C28" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="🎬 Cinematic Customization" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                                    
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="200,*">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Background Image Asset:" VerticalAlignment="Center" Foreground="Gray"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CurrentGame.MediaAssets}" SelectedValue="{Binding ImageAssetId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" HorizontalAlignment="Stretch" Background="#13131F">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:MediaAsset">
                                                    <TextBlock Text="{Binding OriginalFileName}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Dramatic Sound / Music:" VerticalAlignment="Center" Foreground="Gray" Margin="0,10,0,0"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CurrentGame.MediaAssets}" SelectedValue="{Binding SoundAssetId, Mode=TwoWay}" SelectedValueBinding="{Binding Id}" HorizontalAlignment="Stretch" Background="#13131F" Margin="0,10,0,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:MediaAsset">
                                                    <TextBlock Text="{Binding OriginalFileName}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Transition Style Effect:" VerticalAlignment="Center" Foreground="Gray" Margin="0,10,0,0"/>
                                        <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding TransitionStyle, Mode=TwoWay}" HorizontalAlignment="Stretch" Background="#13131F" Margin="0,10,0,0">
                                            <ComboBoxItem Content="Fade"/>
                                            <ComboBoxItem Content="Rise"/>
                                            <ComboBoxItem Content="Cinematic"/>
                                            <ComboBoxItem Content="Glitch"/>
                                            <ComboBoxItem Content="Exposure"/>
                                        </ComboBox>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Display Title Text:" VerticalAlignment="Center" Foreground="Gray" Margin="0,10,0,0"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Text, Mode=TwoWay}" Background="#13131F" BorderBrush="#33334A" Margin="0,10,0,0"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Font Color (Hex):" VerticalAlignment="Center" Foreground="Gray" Margin="0,10,0,0"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding FontColor, Mode=TwoWay}" Background="#13131F" BorderBrush="#33334A" Margin="0,10,0,0"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Font Size (pt):" VerticalAlignment="Center" Foreground="Gray" Margin="0,10,0,0"/>
                                        <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding FontSize, Mode=TwoWay}" Minimum="10" Maximum="120" Background="#13131F" Margin="0,10,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="#1C1C28" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="⏱️ Animation Timeline (Seconds)" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                                    
                                    <TextBlock Text="Fade-in Duration:" Foreground="Gray" FontSize="12"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Slider Grid.Column="0" Value="{Binding FadeInDuration, Mode=TwoWay}" Minimum="0.1" Maximum="10.0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FadeInDuration, StringFormat='{}{0:F1}s'}" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Foreground="White"/>
                                    </Grid>
                                    
                                    <TextBlock Text="Hold/Display Duration:" Foreground="Gray" FontSize="12" Margin="0,6,0,0"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Slider Grid.Column="0" Value="{Binding DisplayDuration, Mode=TwoWay}" Minimum="0.5" Maximum="20.0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayDuration, StringFormat='{}{0:F1}s'}" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Foreground="White"/>
                                    </Grid>
                                    
                                    <TextBlock Text="Fade-out Duration:" Foreground="Gray" FontSize="12" Margin="0,6,0,0"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Slider Grid.Column="0" Value="{Binding FadeOutDuration, Mode=TwoWay}" Minimum="0.1" Maximum="10.0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FadeOutDuration, StringFormat='{}{0:F1}s'}" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Foreground="White"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Side: Live WYSIWYG Screen Coordinates & Preview -->
                        <StackPanel Grid.Column="1" Spacing="20" VerticalAlignment="Top">
                            <TextBlock Text="Live WYSIWYG Screen Preview" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            
                            <Border Background="#1C1C28" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="Title Text Alignment Coordinates:" Foreground="Gray" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TextX, StringFormat='X: {0:0}%'}" Foreground="#8E2DE2" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TextY, StringFormat='Y: {0:0}%'}" Foreground="#8E2DE2" FontWeight="Bold"/>
                                    </StackPanel>

                                    <!-- Sliders to position text visually -->
                                    <TextBlock Text="Horizontal Alignment (X):" Foreground="Gray" FontSize="11"/>
                                    <Slider Value="{Binding TextX, Mode=TwoWay}" Minimum="0" Maximum="100"/>

                                    <TextBlock Text="Vertical Alignment (Y):" Foreground="Gray" FontSize="11"/>
                                    <Slider Value="{Binding TextY, Mode=TwoWay}" Minimum="0" Maximum="100"/>

                                    <!-- 16:9 Preview Frame -->
                                    <Border Width="400" Height="225" Background="Black" BorderBrush="#3A3A4C" BorderThickness="2" CornerRadius="4" HorizontalAlignment="Center" ClipToBounds="True">
                                        <Canvas Width="400" Height="225">
                                            <!-- Ambient mockup image background for preview -->
                                            <Image Width="400" Height="225" Source="/Assets/splash_mockup.png" Stretch="UniformToFill" Opacity="0.5"/>
                                            
                                            <!-- Dynamically positioned title text -->
                                            <TextBlock Text="{Binding Text}" 
                                                       Foreground="White" 
                                                       FontWeight="Bold" 
                                                       FontSize="{Binding FontSize}" 
                                                       Canvas.Left="{Binding TextX}" 
                                                       Canvas.Top="{Binding TextY}" />
                                        </Canvas>
                                    </Border>
                                    
                                    <Button Content="Preview Transition Sequence" Background="#2B2B3A" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,8" FontSize="13"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- 7c. Media Asset Library Tab -->
                <Grid IsVisible="{Binding ActiveView, ConverterParameter=Media, Converter={x:Static ObjectConverters.Equal}}" RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="📂 Media Asset Catalog" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>
                    <Grid Grid.Row="1" ColumnDefinitions="300,*" DataContext="{Binding Media}" x:DataType="vm:MediaLibraryViewModel">
                        <!-- Left sidebar: Treeview directory structure -->
                        <Border Grid.Column="0" Background="#1C1C28" CornerRadius="8" Padding="12" Margin="0,0,12,0" DragDrop.AllowDrop="True" DragDrop.Drop="OnDragDropFile">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,10">
                                    <Button Content="+ Folder" Command="{Binding AddFolderCommand}" FontSize="11" Background="#2B2B3A" Padding="8,6"/>
                                    <Button Content="Import..." Command="{Binding ImportFilesCommand}" FontSize="11" Background="#8E2DE2" Foreground="White" Padding="8,6"/>
                                    <Button Content="Rename" Command="{Binding RenameCommand}" FontSize="11" Background="#2B2B3A" Padding="8,6"/>
                                    <Button Content="Delete" Command="{Binding DeleteCommand}" FontSize="11" Background="#C0392B" Padding="8,6"/>
                                </StackPanel>
                                
                                <ScrollViewer Grid.Row="1">
                                    <TreeView ItemsSource="{Binding Roots}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                                        <TreeView.ItemTemplate>
                                            <TreeDataTemplate DataType="{x:Type vm:MediaLibraryViewModel+Node}" ItemsSource="{Binding Children}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Icon}"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </StackPanel>
                                            </TreeDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        
                        <!-- Right side: Selected Asset Preview Panel -->
                        <Border Grid.Column="1" Background="#1C1C28" CornerRadius="8" Padding="20">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Row="0" Text="Asset Preview &amp; Properties" FontSize="18" FontWeight="Bold" Foreground="#8E2DE2" Margin="0,0,0,16"/>
                                
                                <!-- Preview Area -->
                                <Border Grid.Row="1" Background="#13131F" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16" ClipToBounds="True">
                                    <Grid>
                                        <!-- No selection fallback -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" IsVisible="{Binding !HasSelectedFile}">
                                            <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center" Foreground="Gray"/>
                                            <TextBlock Text="Select a media file from the library to view details" Foreground="Gray" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <!-- Image Preview -->
                                        <Image Source="{Binding SelectedFilePath, Converter={x:Static views:ImagePathToBitmapConverter.Instance}}" IsVisible="{Binding IsSelectedImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        
                                        <!-- Audio / Video / Fallback details -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" IsVisible="{Binding HasSelectedFile}">
                                            <StackPanel IsVisible="{Binding IsSelectedAudio}" Spacing="12">
                                                <TextBlock Text="🔊" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Selected.Name}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Audio Track Loaded" Foreground="Gray" HorizontalAlignment="Center" FontSize="12"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,10,0,0">
                                                    <Button Content="▶ Play" Command="{Binding PlaySelectedCommand}" Background="#8E2DE2" Foreground="White" FontSize="11" Padding="14,6"/>
                                                    <Button Content="⏹ Stop" Command="{Binding StopSelectedCommand}" Background="#2B2B3A" Foreground="White" FontSize="11" Padding="14,6"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel IsVisible="{Binding IsSelectedVideo}" Spacing="12">
                                                <TextBlock Text="🎞️" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Selected.Name}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Video Track Loaded" Foreground="Gray" HorizontalAlignment="Center" FontSize="12"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,10,0,0">
                                                    <Button Content="▶ Play" Command="{Binding PlaySelectedCommand}" Background="#8E2DE2" Foreground="White" FontSize="11" Padding="14,6"/>
                                                    <Button Content="⏹ Stop" Command="{Binding StopSelectedCommand}" Background="#2B2B3A" Foreground="White" FontSize="11" Padding="14,6"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel IsVisible="{Binding IsSelectedFallback}" Spacing="12">
                                                <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Selected.Name}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Binary/Other Media Format" Foreground="Gray" HorizontalAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                
                                <!-- Asset details list at bottom -->
                                <Border Grid.Row="2" Background="#13131F" CornerRadius="6" Padding="12" IsVisible="{Binding HasSelectedFile}">
                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="120,*">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Foreground="Gray" FontSize="12"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Selected.Name}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                        
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Relative Path:" Foreground="Gray" FontSize="12" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.Asset.RelativePath}" Foreground="#8E2DE2" FontSize="12" Margin="0,4,0,0"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Content Type:" Foreground="Gray" FontSize="12" Margin="0,4,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.Asset.ContentType}" Foreground="White" FontSize="12" Margin="0,4,0,0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 8. Validation Engine -->
                <ScrollViewer IsVisible="{Binding ActiveView, ConverterParameter=Validation, Converter={x:Static ObjectConverters.Equal}}">
                    <StackPanel Spacing="20">
                        <TextBlock Text="🔍 Project Integrity Diagnostics" FontSize="24" FontWeight="Bold"/>
                        
                        <Border Background="#1C1C28" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Active Database Scan Reports" FontSize="16" FontWeight="Bold" Foreground="#E2D02D"/>
                                <ListBox ItemsSource="{Binding ValidationErrors}" Background="Transparent" Foreground="#F0F0FA" FontSize="13">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#2B2B3A" BorderThickness="0,0,0,1" Padding="8,4">
                                                <TextBlock Text="{Binding}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 9. Standalone Compiler (Publish target) -->
                <ScrollViewer IsVisible="{Binding ActiveView, ConverterParameter=Publish, Converter={x:Static ObjectConverters.Equal}}">
                    <StackPanel Spacing="24" MaxWidth="800">
                        <TextBlock Text="🚀 .NET Native AOT Package Publisher" FontSize="26" FontWeight="Bold" Foreground="White"/>
                        
                        <Border Background="#1C1C28" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="🔒 High-Security Executable Generation" FontSize="16" FontWeight="Bold" Foreground="#8E2DE2"/>
                                <TextBlock Text="Compile your story logic directly into zero-dependency C# native machine code (no MSIL, no decompile hacks possible!). Your licensing and logic are completely secure." FontSize="13" TextWrapping="Wrap" Foreground="Gray"/>
                                
                                <Button Content="🚀 Compile standalone game now" Command="{Binding PublishCommand}" IsEnabled="{Binding !IsPublishing}" HorizontalAlignment="Left" Foreground="White" FontWeight="Bold" CornerRadius="4" Padding="20,12">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Color="#8E2DE2" Offset="0.0"/>
                                            <GradientStop Color="#4A00E0" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Background="#13131F" BorderBrush="#232333" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Compiler Logs" FontSize="14" FontWeight="Bold" Foreground="Gray"/>
                                <ScrollViewer Height="200" Background="#0C0C12" Padding="12" CornerRadius="4">
                                    <TextBlock Text="{Binding PublishLogs}" FontFamily="Consolas, Monospace" FontSize="11" Foreground="#00FF00" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 10. Workspace Preferences -->
                <ScrollViewer IsVisible="{Binding ActiveView, ConverterParameter=Preferences, Converter={x:Static ObjectConverters.Equal}}">
                    <StackPanel Spacing="24" MaxWidth="800" Margin="10,0,10,20">
                        <TextBlock Text="⚙️ Workspace Preferences" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextNormal}"/>

                        <!-- Visual Appearance Card -->
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="🎨 Visual Appearance" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Configure the visual theme of the story designer workspace." FontSize="13" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="150,*">
                                    <TextBlock Text="Theme" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}"/>
                                    <ComboBox Grid.Column="1" SelectedItem="{Binding Preferences.ThemeName}" HorizontalAlignment="Left" Width="200" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}">
                                        <ComboBoxItem Content="Dark"/>
                                        <ComboBoxItem Content="Light"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- AI Co-Author Settings Card -->
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="🤖 AI Co-Author Services" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    <ToggleSwitch IsChecked="{Binding Preferences.AiCoAuthorEnableHelper, Mode=TwoWay}" OnContent="Enabled" OffContent="Disabled" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <TextBlock Text="Set up endpoints for real-time storytelling hints, narrative suggestions, and descriptions co-writing." FontSize="13" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="150,*" RowSpacing="12">
                                    <!-- Provider -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="AI Provider" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding Preferences.AiCoAuthorProvider}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}">
                                        <ComboBoxItem Content="Ollama"/>
                                        <ComboBoxItem Content="LMStudio"/>
                                        <ComboBoxItem Content="OpenAICompatible"/>
                                        <ComboBoxItem Content="OpenRouter"/>
                                    </ComboBox>

                                    <!-- Endpoint -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="API Endpoint" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Preferences.AiCoAuthorEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="e.g. https://api.openai.com/v1" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}"/>

                                    <!-- Key -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="API Key" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Preferences.AiCoAuthorKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PasswordChar="●" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}"/>

                                    <!-- Model -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Model ID" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Preferences.AiCoAuthorModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}"/>

                                    <!-- Host & Port (Conditional for Local Servers) -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Local Connection" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}" IsVisible="{Binding Preferences.ShowCoAuthorHostPort}"/>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="10" IsVisible="{Binding Preferences.ShowCoAuthorHostPort}">
                                        <TextBox Width="250" Text="{Binding Preferences.AiCoAuthorHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="http://localhost" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}"/>
                                        <TextBox Width="100" Text="{Binding Preferences.AiCoAuthorPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="1234" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}"/>
                                    </StackPanel>

                                    <!-- Generation Parameters -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Temperature" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}"/>
                                    <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,5,0,5">
                                        <Slider Grid.Column="0" Value="{Binding Preferences.AiCoAuthorTemperature, Mode=TwoWay}" Minimum="0.0" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Preferences.AiCoAuthorTemperature, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}" Margin="10,0,0,0" Width="40"/>
                                    </Grid>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Max Tokens" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Preferences.AiCoAuthorMaxTokens, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}"/>
                                </Grid>

                                <TextBlock Text="System Assistant Instructions (Prompt Template)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextNormal}" Margin="0,10,0,0"/>
                                <TextBox Text="{Binding Preferences.AiCoAuthorAssistantPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- AI Image Generator Settings Card -->
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="🖼️ AI Image Generator" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    <ToggleSwitch IsChecked="{Binding Preferences.AiImageGenEnableHelper, Mode=TwoWay}" OnContent="Enabled" OffContent="Disabled" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <TextBlock Text="Set up Stable Diffusion or Dall-E services to automatically create room portraits, items icons, and character artwork." FontSize="13" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>

                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="150,*" RowSpacing="12">
                                    <!-- Provider -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="AI Provider" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding Preferences.AiImageGenProvider}" HorizontalAlignment="Stretch" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}">
                                        <ComboBoxItem Content="Pollinations.ai"/>
                                        <ComboBoxItem Content="ChatGPT"/>
                                        <ComboBoxItem Content="Azure OpenAI Images"/>
                                        <ComboBoxItem Content="Google Gemini"/>
                                        <ComboBoxItem Content="Local Stable Diffusion"/>
                                        <ComboBoxItem Content="Local ComfyUI"/>
                                        <ComboBoxItem Content="Other"/>
                                    </ComboBox>

                                    <!-- Endpoint -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="API Endpoint" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Preferences.AiImageGenEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="e.g. https://api.openai.com/v1" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}"/>

                                    <!-- Key -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="API Key" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Preferences.AiImageGenKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PasswordChar="●" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}"/>

                                    <!-- Model -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Model ID" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Preferences.AiImageGenModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}"/>

                                    <!-- Host & Port (Conditional for Local Servers) -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Local Connection" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}" IsVisible="{Binding Preferences.ShowImageGenHostPort}"/>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="10" IsVisible="{Binding Preferences.ShowImageGenHostPort}">
                                        <TextBox Width="250" Text="{Binding Preferences.AiImageGenHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="http://localhost" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}"/>
                                        <TextBlock Text=":" VerticalAlignment="Center" Foreground="{DynamicResource TextNormal}"/>
                                        <TextBox Width="100" Text="{Binding Preferences.AiImageGenPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Watermark="7860" Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextNormal}" BorderBrush="{DynamicResource BorderBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>

            <!-- Slide-out Collapsible Assets Library Sidebar (Column 2) -->
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" IsVisible="{Binding HasGame}">
                <!-- Small Vertical Toggle Bar pinned to the right edge -->
                <Button Command="{Binding ToggleAssetsSidebarCommand}" Background="#1C1C28" Width="36" VerticalAlignment="Stretch" BorderBrush="#2D2D3E" BorderThickness="1,0,0,0" Padding="0">
                    <TextBlock Text="📁" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <!-- Drawer Panel -->
                <Border Width="260" Background="#14141E" BorderBrush="#2D2D3E" BorderThickness="1,0,0,0" IsVisible="{Binding IsAssetsSidebarOpen}">
                    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" DataContext="{Binding Media}">
                        <!-- Drawer Header -->
                        <Border Grid.Row="0" Background="#1D1D28" Padding="12" BorderBrush="#2D2D3E" BorderThickness="0,0,0,1">
                            <TextBlock Text="📁 Assets Catalog" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <!-- Quick info / Actions -->
                        <StackPanel Grid.Row="1" Spacing="6" Margin="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <Button Content="+ Folder" Command="{Binding AddFolderCommand}" FontSize="10" Background="#2B2B3A" Padding="6,4"/>
                                <Button Content="Import..." Command="{Binding ImportFilesCommand}" FontSize="10" Background="#8E2DE2" Foreground="White" Padding="6,4"/>
                                <Button Content="Rename" Command="{Binding RenameCommand}" FontSize="10" Background="#2B2B3A" Padding="6,4"/>
                                <Button Content="Delete" Command="{Binding DeleteCommand}" FontSize="10" Background="#C0392B" Padding="6,4"/>
                            </StackPanel>
                            <TextBlock Text="Double-click or drag items into portraits/objects to link assets." FontSize="10" Foreground="Gray" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                        <!-- TreeView -->
                        <TreeView Grid.Row="2" ItemsSource="{Binding Roots}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="Transparent" Margin="8" DragDrop.AllowDrop="True" DragDrop.Drop="OnDragDropFile">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate DataType="{x:Type vm:MediaLibraryViewModel+Node}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="2">
                                        <TextBlock Text="{Binding Icon}"/>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        
                        <!-- Resizable Splitter (Slidebar adjustable slider) -->
                        <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="#2D2D3E" Margin="0,4"/>
                        
                        <!-- Media Preview Pane at Bottom -->
                        <Border Grid.Row="4" Height="180" Background="#13131F" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="6" Margin="8" ClipToBounds="True">
                            <Grid>
                                <!-- No selection fallback -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" IsVisible="{Binding !HasSelectedFile}">
                                    <TextBlock Text="📂" FontSize="32" HorizontalAlignment="Center" Foreground="Gray"/>
                                    <TextBlock Text="No preview available" Foreground="Gray" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- Image Preview -->
                                <Image Source="{Binding SelectedFilePath, Converter={x:Static views:ImagePathToBitmapConverter.Instance}}" IsVisible="{Binding IsSelectedImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6"/>
                                
                                <!-- WebView HTML5 Player for Audio/Video -->
                                <wv:NativeWebView x:Name="PreviewWebView" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2"/>
                                
                                <!-- Fallback details -->
                                <StackPanel IsVisible="{Binding IsSelectedFallback}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Margin="6">
                                    <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Selected.Name}" FontWeight="Bold" Foreground="White" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock Text="Binary Resource" Foreground="Gray" HorizontalAlignment="Center" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Full-Screen Visual Graph Scripting Overlay -->
        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#14141E" IsVisible="{Binding IsVisualEditing}">
            <Grid RowDefinitions="Auto,*">
                <!-- Overlay Header -->
                <Border Grid.Row="0" Height="54" Background="#1D1D28" BorderBrush="#2D2D3E" BorderThickness="0,0,0,1" Padding="16,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="🎨 Visual Script Editor:" Foreground="Gray" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveAction.Name}" FontWeight="Bold" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="❌ Cancel" Command="{Binding StopEditingActionCommand}" FontSize="12" Background="#262635" BorderBrush="#3D3D5A" BorderThickness="1" CornerRadius="4" Padding="12,6"/>
                            <Button Content="💾 Save &amp; Return" Click="OnSyncGraphClicked" FontSize="12" Foreground="White" FontWeight="Bold" CornerRadius="4" Padding="14,6">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#8E2DE2" Offset="0.0"/>
                                        <GradientStop Color="#4A00E0" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Visual Graph WebView Canvas -->
                <Border Grid.Row="1" Background="#13131F" ClipToBounds="True">
                    <wv:NativeWebView x:Name="CanvasWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Border>
            </Grid>
        </Border>

        <!-- Dynamic Welcome/Launcher Overlay -->
        <Border Background="#B005050C" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding ShowWelcomeOverlay}">
            <Grid>
                <!-- Stage 1: Cinematic Splash Screen Sequence -->
                <Border IsVisible="{Binding ShowSplashOverlay}" Background="#05050C" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid>
                        <!-- High fidelity background mockup image generated -->
                        <Image Source="/Assets/splash_mockup.png" Stretch="UniformToFill" Opacity="0.5"/>
                        
                        <StackPanel Spacing="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Classes="splashLogo" CornerRadius="16" Width="110" Height="110" HorizontalAlignment="Center" ClipToBounds="True">
                                <Image Source="/Assets/ragnext-logo.png" Stretch="UniformToFill"/>
                            </Border>
                            
                            <StackPanel Spacing="8" Classes="splashText">
                                <TextBlock Text="RAGNEXT WORKSPACE" FontSize="32" FontWeight="Bold" Foreground="White" LetterSpacing="2" HorizontalAlignment="Center"/>
                                <TextBlock Text="INITIALIZING SECURE STORYTELLING WORKSPACE..." FontSize="12" FontWeight="SemiBold" Foreground="#8E2DE2" LetterSpacing="1" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            
                            <!-- Pulsing smooth progress indicator -->
                            <ProgressBar Width="240" Height="4" IsIndeterminate="True" Background="#2A2A3E" Foreground="#8E2DE2" HorizontalAlignment="Center" CornerRadius="2"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Stage 2: Sleek Dual-Column Launcher Dashboard -->
                <Border IsVisible="{Binding !ShowSplashOverlay}" Width="750" Height="480" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#1C1C28" BorderBrush="#35354A" BorderThickness="1" CornerRadius="16" Padding="32" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,300">
                        <!-- Header -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12" Margin="0,0,0,24">
                            <Border CornerRadius="4" Width="36" Height="36">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#8E2DE2" Offset="0.0"/>
                                        <GradientStop Color="#4A00E0" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="RN" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="2">
                                <TextBlock Text="RagNext Launcher" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Manage your storytelling story assets and save workspaces" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Left Column: Actions -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="16" Margin="0,0,24,0" VerticalAlignment="Center">
                            <Button Content="✨ Create New Story Project" Command="{Binding NewGameCommand}" Height="54" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#8E2DE2" Foreground="White" FontWeight="Bold" CornerRadius="8" FontSize="14"/>
                            <Button Content="📂 Load Existing Save" Command="{Binding ShowLoadGameCommand}" Height="54" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#2A2A3E" BorderBrush="#3D3D58" BorderThickness="1" CornerRadius="8" FontSize="14"/>
                            <Button Content="⏱️ Load Last Workspace" Command="{Binding LoadLastWorkspaceCommand}" Height="54" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#14141E" BorderBrush="#252538" BorderThickness="1" CornerRadius="8" FontSize="14" Foreground="#A29BFE"/>
                            
                            <Button Content="🚪 Close Launcher" Command="{Binding CloseWelcomeCommand}" FontSize="12" HorizontalAlignment="Center" Foreground="Gray" Background="Transparent" Margin="0,12,0,0"/>
                        </StackPanel>

                        <!-- Right Column: Recent Projects -->
                        <Border Grid.Row="1" Grid.Column="1" Background="#13131F" BorderBrush="#2D2D3E" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0" Text="Recent Workspaces" FontSize="12" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,12"/>
                                
                                <!-- Recents empty state -->
                                <TextBlock Grid.Row="1" Text="No recently loaded projects yet." Foreground="Gray" FontSize="11" IsVisible="{Binding !RecentProjects.Count}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                
                                <ListBox Grid.Row="1" ItemsSource="{Binding RecentProjects}" Background="Transparent" BorderThickness="0" IsVisible="{Binding RecentProjects.Count}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid ColumnDefinitions="*,Auto" Height="36">
                                                <!-- Open project on double click or select -->
                                                <Button Grid.Column="0" Content="{Binding}" 
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LoadRecentProjectCommand}" 
                                                        CommandParameter="{Binding}" 
                                                        Background="Transparent" 
                                                        Foreground="#E0E0F0" 
                                                        FontSize="11" 
                                                        HorizontalAlignment="Stretch" 
                                                        HorizontalContentAlignment="Left" 
                                                        Padding="4,8"
                                                        ClipToBounds="True"/>
                                                <!-- Remove from history button -->
                                                <Button Grid.Column="1" Content="×" 
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveRecentProjectCommand}" 
                                                        CommandParameter="{Binding}" 
                                                        Background="Transparent" 
                                                        Foreground="Red" 
                                                        FontWeight="Bold" 
                                                        FontSize="14"
                                                        Padding="6,4"
                                                        Margin="4,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Saves List Load Dialog Overlay -->
        <Border Background="#B005050C" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding ShowSavesOverlay}">
            <Border Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#1C1C28" BorderBrush="#35354A" BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Select a Project File" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    
                    <ListBox ItemsSource="{Binding AvailableSaves}" SelectedItem="{Binding SelectedSave}" Height="180" Background="#13131F" BorderBrush="#2D2D3E" BorderThickness="1" CornerRadius="6"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="Cancel" Click="OnCancelLoadClicked" Background="Transparent" Foreground="Gray"/>
                        <Button Content="Load Game" Command="{Binding LoadSelectedGameCommand}" Background="#8E2DE2" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Premium Inventory Item Selector Popup Overlay -->
        <Border Background="#B005050C" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding ShowInventorySelectorOverlay}">
            <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#1C1C28" BorderBrush="#35354A" BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="👜 Add Item to Inventory" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Select from the existing story items database:" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                    
                    <ListBox ItemsSource="{Binding Objects.Objects}" Height="180" Background="#13131F" BorderBrush="#2D2D3E" BorderThickness="1" CornerRadius="6" x:Name="SelectorItemsList">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:GameObject">
                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" Padding="4"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="Cancel" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TriggerAddInventoryCommand}" CommandParameter="{x:Null}" Click="OnCancelLoadClicked" Background="Transparent" Foreground="Gray"/>
                        <Button Content="Add to Inventory" Command="{Binding SelectInventoryItemCommand}" CommandParameter="{Binding #SelectorItemsList.SelectedItem}" Background="#8E2DE2" Foreground="White" FontWeight="Bold" IsEnabled="{Binding #SelectorItemsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Premium Custom Attributes Input Popup Overlay -->
        <Border Background="#B005050C" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding ShowAttributeDialogOverlay}">
            <Border Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#1C1C28" BorderBrush="#35354A" BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="⚡ Custom Attribute Editor" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    
                    <StackPanel Spacing="6">
                        <TextBlock Text="Attribute Name:" Foreground="Gray" FontSize="11"/>
                        <TextBox Text="{Binding NewAttributeName, Mode=TwoWay}" PlaceholderText="e.g. Strength, MaxHealth, GoldCount" Background="#13131F" BorderBrush="#3D3D58"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Attribute Value (Text or Numeric):" Foreground="Gray" FontSize="11"/>
                        <TextBox Text="{Binding NewAttributeValue, Mode=TwoWay}" PlaceholderText="e.g. 100, Warrior, True" Background="#13131F" BorderBrush="#3D3D58"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                        <Button Content="Cancel" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TriggerAddAttributeCommand}" CommandParameter="{x:Null}" Click="OnCancelLoadClicked" Background="Transparent" Foreground="Gray"/>
                        <Button Content="Save Parameter" Command="{Binding SaveAttributeCommand}" Background="#8E2DE2" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#A0A0B0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.nav:hover">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#252535"/>
        </Style>
        <Style Selector="Button.nav[Tag=True]">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2D2D3E"/>
        </Style>
        <Style Selector="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#13131F"/>
            <Setter Property="BorderBrush" Value="#2D2D3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
        <Style Selector="Border.splashLogo">
            <Style.Animations>
                <Animation Duration="0:0:1.8" IterationCount="1">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.0"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="0.4"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.4"/>
                    </KeyFrame>
                    <KeyFrame Cue="65%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="StackPanel.splashText">
            <Style.Animations>
                <Animation Duration="0:0:2.2" IterationCount="1">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.0"/>
                        <Setter Property="TranslateTransform.Y" Value="30"/>
                    </KeyFrame>
                    <KeyFrame Cue="30%">
                        <Setter Property="Opacity" Value="0.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>
</Window>
