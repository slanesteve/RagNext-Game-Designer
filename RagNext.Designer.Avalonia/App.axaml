<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RagNext.Designer.Avalonia.App"
             xmlns:local="using:RagNext.Designer.Avalonia"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" 
                                       RegionColor="#1E1E1E" 
                                       ListLow="#252526" 
                                       ListMedium="#2D2D2D"
                                       Accent="#007ACC" 
                                       ChromeLow="#3F3F46" />
                
                <ColorPaletteResources x:Key="Light" 
                                       RegionColor="#F3F3F3" 
                                       ListLow="#FFFFFF" 
                                       ListMedium="#EAEAEA"
                                       Accent="#007ACC" 
                                       ChromeLow="#CCCCCC" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <Style Selector="TextBlock.spinner">
            <Setter Property="RenderTransform">
                <RotateTransform />
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame KeyTime="0:0:0">
                        <Setter Property="(RotateTransform.Angle)" Value="0"/>
                    </KeyFrame>
                    <KeyFrame KeyTime="0:0:1">
                        <Setter Property="(RotateTransform.Angle)" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <DrawingBrush x:Key="CirclesPatternBrush" TileMode="Tile" Stretch="None" DestinationRect="0,0,24,24">
                <DrawingBrush.Drawing>
                    <GeometryDrawing Brush="{DynamicResource GridDotsBrush}">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="12,12" RadiusX="1.5" RadiusY="1.5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="MainBg" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="SidebarBg" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="InputBg" Color="#EAEAEA"/>
                    <SolidColorBrush x:Key="TextNormal" Color="#1E1E1E"/>
                    <SolidColorBrush x:Key="TextMuted" Color="#7F7F7F"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#CCCCCC"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
                    <SolidColorBrush x:Key="GridDotsBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="NavHoverBg" Color="#EAEAEA"/>
                    <SolidColorBrush x:Key="NavActiveBg" Color="#CCCCCC"/>
                    <SolidColorBrush x:Key="NavHoverFg" Color="#1E1E1E"/>
                    <SolidColorBrush x:Key="NavNormalFg" Color="#7F7F7F"/>
                    <SolidColorBrush x:Key="ToolbarBtnBg" Color="#EAEAEA"/>
                    <SolidColorBrush x:Key="ToolbarBtnFg" Color="#1E1E1E"/>
                    <SolidColorBrush x:Key="ToolbarBtnBorder" Color="#CCCCCC"/>
                    
                    <!-- Native Button Overrides to fix hover stickiness -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#EAEAEA"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D6D6D6"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#CCCCCC"/>
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#CCCCCC"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#BBBBBB"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#007ACC"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="MainBg" Color="#1E1E1E"/>
                    <SolidColorBrush x:Key="SidebarBg" Color="#252526"/>
                    <SolidColorBrush x:Key="CardBg" Color="#252526"/>
                    <SolidColorBrush x:Key="InputBg" Color="#2D2D2D"/>
                    <SolidColorBrush x:Key="TextNormal" Color="#F5F5F5"/>
                    <SolidColorBrush x:Key="TextMuted" Color="#A1A1AA"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
                    <SolidColorBrush x:Key="GridDotsBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="NavHoverBg" Color="#252535"/>
                    <SolidColorBrush x:Key="NavActiveBg" Color="#2D2D3E"/>
                    <SolidColorBrush x:Key="NavHoverFg" Color="White"/>
                    <SolidColorBrush x:Key="NavNormalFg" Color="#A0A0B0"/>
                    <SolidColorBrush x:Key="ToolbarBtnBg" Color="#262635"/>
                    <SolidColorBrush x:Key="ToolbarBtnFg" Color="White"/>
                    <SolidColorBrush x:Key="ToolbarBtnBorder" Color="#3D3D5A"/>
                    
                    <!-- Native Button Overrides to fix hover stickiness -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#262635"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#252535"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2D2D3E"/>
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3D3D5A"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#4E4E6E"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#007ACC"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>