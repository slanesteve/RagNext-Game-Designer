<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RagNext.Views.GameTimerEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RagNext.Views.Controls"
    xmlns:behaviors="clr-namespace:RagNext.Behaviors"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="Edit Timer">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Clicked="OnSaveClicked" />
    </ContentPage.ToolbarItems>

    <controls:RightPaneLayout>
        <controls:RightPaneLayout.Main>
            <Grid RowDefinitions="Auto, *">
                <!-- Segmented Tab Selection -->
                <Grid Grid.Row="0" ColumnDefinitions="*, *" ColumnSpacing="0" Margin="12,12,12,0" HeightRequest="40" BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#1F1F29}">
                    <Border x:Name="DetailsTabBorder" Grid.Column="0" BackgroundColor="{DynamicResource Primary}" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDetailsTabClicked" />
                        </Border.GestureRecognizers>
                        <Label x:Name="DetailsTabLabel" Text="Properties" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Border x:Name="ActionsTabBorder" Grid.Column="1" BackgroundColor="Transparent" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnActionsTabClicked" />
                        </Border.GestureRecognizers>
                        <Label x:Name="ActionsTabLabel" Text="Actions &amp; Events" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Tab 1: Details (Scrollable) -->
                <ScrollView x:Name="DetailsScrollView"
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Always"
                            IsVisible="True">
                    <ScrollView.Behaviors>
                        <behaviors:SuppressJumpScrollBehavior />
                    </ScrollView.Behaviors>
                    <VerticalStackLayout Padding="12,16,12,12" Spacing="12">
                        <Label Text="Name" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry x:Name="NameEntry" Text="{Binding Name}" Placeholder="Timer name" Grid.Column="0" />
                            <Button Text="✨" Grid.Column="1" WidthRequest="28" HeightRequest="28" Padding="0"
                                    Clicked="OnAskAIClicked" CommandParameter="{x:Reference NameEntry}" />
                        </Grid>

                        <Label Text="Interval (Seconds)" />
                        <Entry x:Name="IntervalEntry" Text="{Binding IntervalSeconds}" Keyboard="Numeric" Placeholder="60" />

                        <Grid ColumnDefinitions="*, Auto" Margin="0,6,0,0">
                            <Label Grid.Column="0" Text="Timer Active" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding IsActive}" />
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" Margin="0,6,0,0">
                            <Label Grid.Column="0" Text="Repeating" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding IsRepeating}" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- Tab 2: Actions & Events -->
                <Grid x:Name="ActionsContainer"
                      Grid.Row="1"
                      IsVisible="False"
                      VerticalOptions="FillAndExpand">
                    <controls:ActionTreeView x:Name="TimerTreeView" HostElementType="Timer" VerticalOptions="FillAndExpand" />
                </Grid>
            </Grid>
        </controls:RightPaneLayout.Main>
    </controls:RightPaneLayout>
</ContentPage>
