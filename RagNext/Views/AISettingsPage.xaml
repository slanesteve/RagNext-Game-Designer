<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RagNext.Views.AISettingsPage"
             Title="AI Settings">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Provider" />
            <Picker x:Name="ProviderPicker"
                    Title="Choose provider"
                    SelectedIndexChanged="OnProviderChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Ollama</x:String>
                        <x:String>LMStudio</x:String>
                        <x:String>OpenAICompatible</x:String>
                        <x:String>OpenRouter</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Border x:Name="HelpBox"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3F3F46}"
                    BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#1E1E24}"
                    Padding="12"
                    StrokeShape="RoundRectangle 8"
                    IsVisible="False"
                    Margin="0,4,0,8">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="HelpBoxTitle" FontAttributes="Bold" Text="Configuration Guide:" FontSize="14" />
                    <Label x:Name="HelpBoxStep1" Text="" LineBreakMode="WordWrap" />
                    <Label x:Name="HelpBoxStep2" Text="" LineBreakMode="WordWrap" />
                    <Label x:Name="HelpBoxStep3" Text="" LineBreakMode="WordWrap" />
                    <Button x:Name="HelpActionButton"
                            Text="Action Button"
                            Clicked="OnHelpActionButtonClicked"
                            Margin="0,4,0,0"
                            HeightRequest="36"
                            Padding="12,0"
                            HorizontalOptions="Start"
                            BackgroundColor="{AppThemeBinding Light=#512BD4, Dark=#7752FE}"
                            TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Host (include scheme)" />
            <Entry x:Name="HostEntry" Placeholder="http://localhost" />

            <Label Text="Port" />
            <Entry x:Name="PortEntry" Keyboard="Numeric" Placeholder="11434" />

            <Label Text="Model" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="ModelEntry" Placeholder="llama3" Grid.Column="0" />
                <Button x:Name="FetchModelsButton"
                        Grid.Column="1"
                        Text="↻"
                        WidthRequest="36"
                        HeightRequest="36"
                        Padding="0"
                        Clicked="OnFetchModelsClicked" />
            </Grid>

            <Label Text="Temperature (0-2)" />
            <Slider x:Name="TempSlider" Minimum="0" Maximum="2" />
            <Label x:Name="TempValue" />

            <Label Text="Max Tokens" />
            <Entry x:Name="MaxTokensEntry" Keyboard="Numeric" Placeholder="512" />

            <Label Text="API Key (if needed)" />
            <Entry x:Name="ApiKeyEntry" IsPassword="True" Placeholder="(optional)" />

            <HorizontalStackLayout>
                <Label Text="Enable AI Helper" VerticalOptions="Center" />
                <Switch x:Name="EnableSwitch" />
            </HorizontalStackLayout>

            <Label Text="Assistant Prompt (optional; leave blank to use default)" />
            <Editor x:Name="SystemPromptEditor"
                    AutoSize="Disabled"
                    HeightRequest="180"
                    Placeholder="Leave empty to use the built-in assistant prompt" />

            <Button Text="Save" Clicked="OnSaveClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>