<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RagNext.Views.AISettingsPage"
             Title="AI Settings"
             BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#0F172A}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="0">
            <!-- Header Grid / Top Actions -->
            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12" Margin="0,0,0,20" VerticalOptions="Center">
                <Label Text="AI Co-Author Settings" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#1A202C, Dark=#F7FAFC}" />
                <Button Grid.Column="1" Text="Cancel" Clicked="OnCancelClicked" BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" TextColor="{AppThemeBinding Light=#4A5568, Dark=#E2E8F0}" HeightRequest="40" Padding="16,0" CornerRadius="8" FontAttributes="Bold" />
                <Button Grid.Column="2" Text="Save" Clicked="OnSaveClicked" BackgroundColor="{AppThemeBinding Light=#512BD4, Dark=#7752FE}" TextColor="White" HeightRequest="40" Padding="16,0" CornerRadius="8" FontAttributes="Bold" />
            </Grid>

            <!-- Bento Card 1: AI Provider -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Padding="16"
                    Margin="0,0,0,16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="AI Provider" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2D3748, Dark=#EDF2F7}" />
                    <Label Text="Select the backend service hosting your large language models." FontSize="12" TextColor="{AppThemeBinding Light=#718096, Dark=#A0AEC0}" Margin="0,0,0,4" />
                    
                    <Picker x:Name="ProviderPicker"
                            Title="Choose provider"
                            SelectedIndexChanged="OnProviderChanged">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Ollama</x:String>
                                <x:String>LMStudio</x:String>
                                <x:String>OpenAICompatible</x:String>
                                <x:String>OpenRouter</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                    <Border x:Name="HelpBox"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3F3F46}"
                            BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#1E1E24}"
                            Padding="12"
                            StrokeShape="RoundRectangle 8"
                            IsVisible="False"
                            Margin="0,4,0,0">
                        <VerticalStackLayout Spacing="6">
                            <Label x:Name="HelpBoxTitle" FontAttributes="Bold" Text="Configuration Guide:" FontSize="14" />
                            <Label x:Name="HelpBoxStep1" Text="" LineBreakMode="WordWrap" />
                            <Label x:Name="HelpBoxStep2" Text="" LineBreakMode="WordWrap" />
                            <Label x:Name="HelpBoxStep3" Text="" LineBreakMode="WordWrap" />
                            <Button x:Name="HelpActionButton"
                                    Text="Action Button"
                                    Clicked="OnHelpActionButtonClicked"
                                    Margin="0,4,0,0"
                                    HeightRequest="36"
                                    Padding="12,0"
                                    HorizontalOptions="Start"
                                    BackgroundColor="{AppThemeBinding Light=#512BD4, Dark=#7752FE}"
                                    TextColor="White" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Bento Card 2: Connection Details -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Padding="16"
                    Margin="0,0,0,16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Connection Settings" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2D3748, Dark=#EDF2F7}" />
                    
                    <Label Text="Host (include scheme)" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}" />
                    <Entry x:Name="HostEntry" Placeholder="http://localhost" HeightRequest="40" />

                    <Label Text="Port" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}" Margin="0,4,0,0" />
                    <Entry x:Name="PortEntry" Keyboard="Numeric" Placeholder="11434" HeightRequest="40" />
                </VerticalStackLayout>
            </Border>

            <!-- Bento Card 3: Model & Generation -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Padding="16"
                    Margin="0,0,0,16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Model &amp; Generation Parameters" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2D3748, Dark=#EDF2F7}" />

                    <Label Text="Model" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry x:Name="ModelEntry" Placeholder="llama3" Grid.Column="0" HeightRequest="40" />
                        <Button x:Name="FetchModelsButton"
                                Grid.Column="1"
                                Text="↻"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"
                                Clicked="OnFetchModelsClicked"
                                BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                                TextColor="{AppThemeBinding Light=#4A5568, Dark=#E2E8F0}" />
                    </Grid>

                    <Label Text="Temperature" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}" Margin="0,4,0,0" />
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <Slider x:Name="TempSlider" Minimum="0" Maximum="2" Grid.Column="0" VerticalOptions="Center" />
                        <Label x:Name="TempValue" Grid.Column="1" VerticalOptions="Center" FontAttributes="Bold" WidthRequest="40" HorizontalTextAlignment="End" />
                    </Grid>

                    <Label Text="Max Tokens" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}" Margin="0,4,0,0" />
                    <Entry x:Name="MaxTokensEntry" Keyboard="Numeric" Placeholder="512" HeightRequest="40" />
                </VerticalStackLayout>
            </Border>

            <!-- Bento Card 4: Prompts & Credentials -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Padding="16"
                    Margin="0,0,0,16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Credentials &amp; Prompts" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2D3748, Dark=#EDF2F7}" />

                    <Label Text="API Key (if required by provider)" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}" />
                    <Entry x:Name="ApiKeyEntry" IsPassword="True" Placeholder="(optional)" HeightRequest="40" />

                    <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,4">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Enable AI Helper" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2D3748, Dark=#EDF2F7}" />
                            <Label Text="Toggles direct AI code/text assistance inside narrative and room description fields." FontSize="11" TextColor="{AppThemeBinding Light=#718096, Dark=#A0AEC0}" />
                        </VerticalStackLayout>
                        <Switch x:Name="EnableSwitch" Grid.Column="1" VerticalOptions="Center" />
                    </Grid>

                    <Label Text="Assistant Prompt (optional; leave blank to use default)" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}" Margin="0,4,0,0" />
                    <Editor x:Name="SystemPromptEditor"
                            AutoSize="Disabled"
                            HeightRequest="150"
                            Placeholder="Leave empty to use the built-in assistant prompt" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>