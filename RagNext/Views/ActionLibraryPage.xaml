<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RagNext.Views.ActionLibraryPage"
             x:Name="ActionLibraryPageRoot"
             Title="Actions">
    <CollectionView ItemsSource="{Binding Roots}" SelectionMode="None">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Grid Padding="4">
                    <HorizontalStackLayout>
                        <Label Text="{Binding Icon}" />
                        <Label Text="{Binding Name}" Margin="8,0,0,0" />
                    </HorizontalStackLayout>
                    <Grid.GestureRecognizers>
                        <!-- Double-click edit -->
                        <TapGestureRecognizer NumberOfTapsRequired="2"
                                              Command="{Binding Source={x:Reference ActionLibraryPageRoot}, Path=BindingContext.EditNodeCommand}"
                                              CommandParameter="{Binding .}" />
                        <!-- Single-click select (optional) -->
                        <TapGestureRecognizer NumberOfTapsRequired="1"
                                              Command="{Binding Source={x:Reference ActionLibraryPageRoot}, Path=BindingContext.SelectNodeCommand}"
                                              CommandParameter="{Binding .}" />
                    </Grid.GestureRecognizers>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>