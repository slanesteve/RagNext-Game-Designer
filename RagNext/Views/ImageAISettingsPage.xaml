<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RagNext.Views.ImageAISettingsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Image AI Settings"
             BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#0F172A}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="0">
            <!-- Header Grid / Top Actions -->
            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12" Margin="0,0,0,20" VerticalOptions="Center">
                <Label Text="Image AI Settings" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#1A202C, Dark=#F7FAFC}" />
                <Button Grid.Column="1" Text="Cancel" Clicked="OnCancelClicked" BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" TextColor="{AppThemeBinding Light=#4A5568, Dark=#E2E8F0}" HeightRequest="40" Padding="16,0" CornerRadius="8" FontAttributes="Bold" />
                <Button Grid.Column="2" Text="Save" Clicked="OnSaveClicked" BackgroundColor="{DynamicResource Primary}" TextColor="White" HeightRequest="40" Padding="16,0" CornerRadius="8" FontAttributes="Bold" />
            </Grid>

            <!-- Bento Card 1: Provider Selection -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Padding="16"
                    Margin="0,0,0,16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Image AI Provider" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2D3748, Dark=#EDF2F7}" />
                    <Label Text="Select the system for generating room backgrounds and object graphics." FontSize="12" TextColor="{AppThemeBinding Light=#718096, Dark=#A0AEC0}" Margin="0,0,0,4" />

                    <Picker x:Name="ProviderPicker"
                            Title="Select provider"
                            SelectedIndexChanged="OnProviderChanged">
                        <Picker.Items>
                            <x:String>Pollinations.ai (Free Online)</x:String>
                            <x:String>ChatGPT (OpenAI Images)</x:String>
                            <x:String>Azure OpenAI Images</x:String>
                            <x:String>Google Gemini (Vertex AI)</x:String>
                            <x:String>Local Stable Diffusion (Automatic1111)</x:String>
                            <x:String>Local ComfyUI</x:String>
                            <x:String>Other</x:String>
                        </Picker.Items>
                    </Picker>

                    <Border x:Name="HelpBox"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3F3F46}"
                            BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#1E1E24}"
                            Padding="12"
                            StrokeShape="RoundRectangle 8"
                            IsVisible="False"
                            Margin="0,4,0,0">
                        <VerticalStackLayout Spacing="6">
                            <Label x:Name="HelpBoxTitle" FontAttributes="Bold" Text="Configuration Guide:" FontSize="14" />
                            <Label x:Name="HelpBoxStep1" Text="" LineBreakMode="WordWrap" />
                            <Label x:Name="HelpBoxStep2" Text="" LineBreakMode="WordWrap" />
                            <Label x:Name="HelpBoxStep3" Text="" LineBreakMode="WordWrap" />
                            <Button x:Name="HelpActionButton"
                                    Text="Action Button"
                                    Clicked="OnHelpActionButtonClicked"
                                    Margin="0,4,0,0"
                                    HeightRequest="36"
                                    Padding="12,0"
                                    HorizontalOptions="Start"
                                    BackgroundColor="{DynamicResource Primary}"
                                    TextColor="White" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Bento Card 2: Server Settings -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Padding="16"
                    Margin="0,0,0,16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Connection &amp; Credentials" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2D3748, Dark=#EDF2F7}" />

                    <Label Text="Host URL" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}" />
                    <Entry x:Name="HostEntry" HeightRequest="40" />

                    <Label Text="Port" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}" Margin="0,4,0,0" />
                    <Entry x:Name="PortEntry" Keyboard="Numeric" HeightRequest="40" />

                    <Label Text="Model / Checkpoint Name" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}" Margin="0,4,0,0" />
                    <Entry x:Name="ModelEntry" HeightRequest="40" />

                    <Label x:Name="ApiKeyLabel" Text="API Key" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}" Margin="0,4,0,0" />
                    <Entry x:Name="ApiKeyEntry" IsPassword="True" HeightRequest="40" />
                </VerticalStackLayout>
            </Border>

            <!-- Bento Card 3: Advanced ComfyUI Settings -->
            <!-- Note: visibility is toggled programmatically on the labels and entries -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Padding="16"
                    Margin="0,0,0,16"
                    x:Name="ComfyPanelBorder">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Advanced ComfyUI Configuration" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2D3748, Dark=#EDF2F7}" />
                    <Label Text="Tweak these node parameter names to map the generation request perfectly to your custom workflow API JSON." FontSize="11" TextColor="{AppThemeBinding Light=#718096, Dark=#A0AEC0}" Margin="0,0,0,4" />

                    <Label x:Name="ComfyWorkflowLabel" Text="ComfyUI Workflow JSON Path" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}" />
                    <Entry x:Name="ComfyWorkflowEntry" Placeholder="C:\\ComfyUI\\workflows\\my_workflow.json" HeightRequest="40" />

                    <Label x:Name="ComfyPositiveLabel" Text="ComfyUI Positive Prompt Node Name" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}" Margin="0,4,0,0" />
                    <Entry x:Name="ComfyPositiveNodeEntry" Placeholder="positive_prompt" HeightRequest="40" />

                    <Label x:Name="ComfyNegativeLabel" Text="ComfyUI Negative Prompt Node Name" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}" Margin="0,4,0,0" />
                    <Entry x:Name="ComfyNegativeNodeEntry" Placeholder="negative_prompt" HeightRequest="40" />

                    <Label x:Name="ComfySizeLabel" Text="ComfyUI Size Node Name (optional)" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}" Margin="0,4,0,0" />
                    <Entry x:Name="ComfySizeNodeEntry" Placeholder="EmptyLatentImage" HeightRequest="40" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>