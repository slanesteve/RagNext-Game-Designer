<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RagNext.Views.GeneralSettingsPage"
             Title="General Settings"
             BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#0F172A}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="0">
            <!-- Header Grid / Top Actions -->
            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12" Margin="0,0,0,20" VerticalOptions="Center">
                <Label Text="General Settings" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#1A202C, Dark=#F7FAFC}" />
                <Button Grid.Column="1" Text="Cancel" Clicked="OnCancelClicked" BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" TextColor="{AppThemeBinding Light=#4A5568, Dark=#E2E8F0}" HeightRequest="40" Padding="16,0" CornerRadius="8" FontAttributes="Bold" />
                <Button Grid.Column="2" Text="Save" Clicked="OnSaveClicked" BackgroundColor="{AppThemeBinding Light=#512BD4, Dark=#7752FE}" TextColor="White" HeightRequest="40" Padding="16,0" CornerRadius="8" FontAttributes="Bold" />
            </Grid>

            <!-- Bento Card: Theme Settings -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Padding="20"
                    Margin="0,0,0,16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Theme &amp; Color Palette" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2D3748, Dark=#EDF2F7}" />
                    <Label Text="Select your designer look and color palette theme. This changes the visual styling of the workspace." FontSize="12" TextColor="{AppThemeBinding Light=#718096, Dark=#A0AEC0}" Margin="0,0,0,4" />
                    
                    <Picker x:Name="CombinedThemePicker" Title="Choose theme/palette">
                        <Picker.Items>
                            <x:String>System (Default)</x:String>        <!-- 0 -->
                            <x:String>Light (Default)</x:String>         <!-- 1 -->
                            <x:String>Dark (Default)</x:String>          <!-- 2 -->
                            <x:String>Nord</x:String>                    <!-- 3 -->
                            <x:String>Dracula</x:String>                 <!-- 4 -->
                            <x:String>One Dark</x:String>                <!-- 5 -->
                            <x:String>Sepia</x:String>                   <!-- 6 -->
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>