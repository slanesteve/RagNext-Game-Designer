<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RagNext.Views.CharactersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Characters">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" Clicked="OnAddClicked" />
        <ToolbarItem Text="Save" Clicked="OnSaveClicked" />
    </ContentPage.ToolbarItems>

    <CollectionView x:Name="CharactersView"
                    ItemsSource="{Binding Characters}"
                    SelectionMode="Single"
                    SelectionChanged="OnSelectionChanged">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Grid Padding="8" RowDefinitions="Auto,Auto">
                    <Label Grid.Row="0" Text="{Binding Name}" FontAttributes="Bold" />
                    <Label Grid.Row="1" Text="{Binding Description}" LineBreakMode="TailTruncation" MaxLines="1" />
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        <CollectionView.EmptyView>
            <Label Text="No characters. Tap Add to create one." Padding="16" />
        </CollectionView.EmptyView>
    </CollectionView>
</ContentPage>