<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RagNext.Views.CharacterEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:RagsCore.Models;assembly=RagsCore"
    xmlns:controls="clr-namespace:RagNext.Views.Controls"
    xmlns:behaviors="clr-namespace:RagNext.Behaviors"
    x:DataType="models:Character"
    Title="Edit Character">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Clicked="OnSaveClicked" />
    </ContentPage.ToolbarItems>

    <Grid>
        <ScrollView x:Name="MainScroll"
                    VerticalScrollBarVisibility="Always">
            <ScrollView.Behaviors>
                <behaviors:ScrollAwareBehavior x:Name="ScrollAwareCharacter"/>
                <behaviors:SuppressJumpScrollBehavior />
            </ScrollView.Behaviors>
            <VerticalStackLayout Padding="12" Spacing="10">
                <Label Text="Name" />
                <Grid ColumnDefinitions="*,Auto">
                    <Entry x:Name="NameEntry" Text="{Binding Name}" Placeholder="Character name" Grid.Column="0" />
                    <Button Text="✨" Grid.Column="1" WidthRequest="28" HeightRequest="28" Padding="0"
                            Clicked="OnAskAIClicked" CommandParameter="{x:Reference NameEntry}" />
                </Grid>

                <Label Text="Description" />
                <Grid ColumnDefinitions="*,Auto">
                    <controls:SuggestiveEditor x:Name="DescriptionEditor" Text="{Binding Description, Mode=TwoWay}" Grid.Column="0" />
                    <Button Text="✨" Grid.Column="1" WidthRequest="28" HeightRequest="28" Padding="0"
                            Clicked="OnAskAIClicked" CommandParameter="{x:Reference DescriptionEditor}" />
                </Grid>

                <Label Text="Health" />
                <Grid ColumnDefinitions="*,Auto">
                    <Entry x:Name="HealthEntry" Text="{Binding Health}" Keyboard="Numeric" Grid.Column="0" />
                    <Button Text="✨" Grid.Column="1" WidthRequest="28" HeightRequest="28" Padding="0"
                            Clicked="OnAskAIClicked" CommandParameter="{x:Reference HealthEntry}" />
                </Grid>

                <StackLayout Orientation="Horizontal" Spacing="12">
                    <Label Text="Hostile" VerticalOptions="Center" />
                    <Switch IsToggled="{Binding IsHostile}" />
                </StackLayout>

                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray400}" />

                <Label Text="Inventory" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Add" Clicked="OnAddInventoryClicked" />
                    <Button Text="Remove" Clicked="OnRemoveInventoryClicked" />
                </HorizontalStackLayout>
                <CollectionView x:Name="InventoryList"
                                ItemsSource="{Binding Inventory}"
                                SelectionMode="Single"
                                HeightRequest="160">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:GameObject">
                            <Grid Padding="6" ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Name}" VerticalOptions="Center" Grid.Column="0" />
                                <Button Grid.Column="1"
                                        Text="❌"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        Padding="0"
                                        BackgroundColor="#E05B5B"
                                        TextColor="White"
                                        Clicked="OnRemoveIndividualInventoryClicked" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray400}" />

                <Label Text="Attributes" FontAttributes="Bold" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Add" Clicked="OnAddAttributeClicked" />
                    <Button Text="Remove" Clicked="OnRemoveAttributeClicked" />
                </HorizontalStackLayout>
                <CollectionView x:Name="AttributesList"
                                ItemsSource="{Binding Attributes}"
                                SelectionMode="Single"
                                HeightRequest="220">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CustomAttribute">
                            <Grid Padding="6" ColumnSpacing="8" ColumnDefinitions="*,*">
                                <Grid ColumnDefinitions="*,Auto" Grid.Column="0">
                                    <Entry x:Name="AttrNameEntry" Placeholder="Name" Text="{Binding Name}" Grid.Column="0" />
                                    <Button Grid.Column="1"
                                            Text="✨"
                                            WidthRequest="28"
                                            HeightRequest="28"
                                            Padding="0"
                                            Clicked="OnAskAIClicked"
                                            CommandParameter="{x:Reference AttrNameEntry}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Grid.Column="1">
                                    <Entry x:Name="AttrValueEntry" Placeholder="Value" Text="{Binding Value}" Grid.Column="0" />
                                    <Button Grid.Column="1"
                                            Text="✨"
                                            WidthRequest="28"
                                            HeightRequest="28"
                                            Padding="0"
                                            Clicked="OnAskAIClicked"
                                            CommandParameter="{x:Reference AttrValueEntry}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray400}" />

                <!-- Actions -->
                <controls:ActionTreeView GameObject="{Binding .}" />
            </VerticalStackLayout>
        </ScrollView>

        <Border InputTransparent="True"
                IsVisible="{Binding Source={x:Reference ScrollAwareCharacter}, Path=HasMoreAbove}"
                Background="{AppThemeBinding Light={StaticResource TopFadeLight}, Dark={StaticResource TopFadeDark}}"
                HeightRequest="32"
                HorizontalOptions="Fill"
                VerticalOptions="Start">
            <Label Text="▲" HorizontalOptions="Center" VerticalOptions="Center" FontSize="12" Opacity="0.6"/>
        </Border>

        <Border InputTransparent="True"
                IsVisible="{Binding Source={x:Reference ScrollAwareCharacter}, Path=HasMoreBelow}"
                Background="{AppThemeBinding Light={StaticResource BottomFadeLight}, Dark={StaticResource BottomFadeDark}}"
                HeightRequest="40"
                HorizontalOptions="Fill"
                VerticalOptions="End">
            <Label Text="Scroll for more ▼" HorizontalOptions="Center" VerticalOptions="Center" FontSize="12" Opacity="0.7"/>
        </Border>
    </Grid>
</ContentPage>