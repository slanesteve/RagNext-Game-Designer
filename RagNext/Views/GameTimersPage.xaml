<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RagNext.Views.GameTimersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Timers">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" Clicked="OnAddClicked" />
        <ToolbarItem Text="Save" Clicked="OnSaveClicked" />
    </ContentPage.ToolbarItems>

    <Grid BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#111116}">
        <Border StrokeShape="RoundRectangle 12"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2E2E3C}"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E28}"
                Margin="12"
                Padding="8">
            <Border.Shadow>
                <Shadow Radius="8" Opacity="{AppThemeBinding Light=0.04, Dark=0.2}" Brush="Black" Offset="0,2" />
            </Border.Shadow>
            <CollectionView x:Name="TimersView"
                            ItemsSource="{Binding Timers}"
                            SelectionMode="Single"
                            SelectionChanged="OnSelectionChanged"
                            Margin="0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnDefinitions="*,Auto">
                            <StackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding IntervalSeconds, StringFormat='Ticks every {0}s'}" TextColor="Gray" FontSize="12" />
                            </StackLayout>
                            <Label Grid.Column="1" Text="Active" TextColor="Green" FontAttributes="Bold" IsVisible="{Binding IsActive}" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No scheduled timers. Tap Add to create one." Padding="16" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>
