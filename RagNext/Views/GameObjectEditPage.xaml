<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RagNext.Views.GameObjectEditPage" 
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RagsCore.Models;assembly=RagsCore"
             x:DataType="models:GameObject"
             Title="Edit Object">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Clicked="OnSaveClicked" />
        <ToolbarItem Text="Cancel" Clicked="OnCancelClicked" Priority="1" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="10">
            <Label Text="Name" />
            <Entry Text="{Binding Name}" Placeholder="Object name" />

            <Label Text="Description" />
            <Editor Text="{Binding Description}" HeightRequest="150" />

            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray400}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>