<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RagNext.Views.PlayerEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Edit Player">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Clicked="OnSaveClicked" />
        <ToolbarItem Text="Cancel" Clicked="OnCancelClicked" Priority="1" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="10">
            <Label Text="Name" />
            <Entry Text="{Binding Name}" Placeholder="Player name" />

            <Label Text="Health" />
            <Entry Text="{Binding Health}" Keyboard="Numeric" />

            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray400}" />

            <Label Text="Actions" FontAttributes="Bold" />
            

           
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>