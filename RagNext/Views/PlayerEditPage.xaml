<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RagNext.Views.PlayerEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:rag="clr-namespace:RagNext"
    xmlns:controls="clr-namespace:RagNext.Views.Controls"
    xmlns:behaviors="clr-namespace:RagNext.Behaviors"
    xmlns:models="clr-namespace:RagsCore.Models;assembly=RagsCore"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="Edit Player">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Clicked="OnSaveClicked" />
    </ContentPage.ToolbarItems>

    <controls:RightPaneLayout>
        <controls:RightPaneLayout.Main>
            <Grid RowDefinitions="Auto, *">
                <!-- Segmented Tab Selection -->
                <Grid Grid.Row="0" ColumnDefinitions="*, *" ColumnSpacing="0" Margin="12,12,12,0" HeightRequest="40" BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#1F1F29}">
                    <Border x:Name="DetailsTabBorder" Grid.Column="0" BackgroundColor="#512BD4" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDetailsTabClicked" />
                        </Border.GestureRecognizers>
                        <Label x:Name="DetailsTabLabel" Text="Properties" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Border x:Name="ActionsTabBorder" Grid.Column="1" BackgroundColor="Transparent" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnActionsTabClicked" />
                        </Border.GestureRecognizers>
                        <Label x:Name="ActionsTabLabel" Text="Actions &amp; Events" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Tab 1: Details (Scrollable) -->
                <ScrollView x:Name="DetailsScrollView"
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Always"
                            IsVisible="True">
                    <ScrollView.Behaviors>
                        <behaviors:ScrollAwareBehavior x:Name="ScrollAwarePlayer"/>
                        <behaviors:SuppressJumpScrollBehavior />
                    </ScrollView.Behaviors>
                    <VerticalStackLayout Padding="12,16,12,12" Spacing="10">
                        <Label Text="Name" />
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Entry x:Name="NameEntry" Text="{Binding Name}" Placeholder="Player name" Grid.Column="0" />
                            <Button Grid.Column="1"
                                    Text="✨"
                                    WidthRequest="28"
                                    HeightRequest="28"
                                    Padding="0"
                                    Clicked="OnAskAIClicked"
                                    CommandParameter="{x:Reference NameEntry}" />
                        </Grid>

                        <Label Text="Description" />
                        <Grid ColumnDefinitions="*,Auto">
                            <controls:SuggestiveEditor x:Name="DescriptionEditor"
                                    Text="{Binding Description, Mode=TwoWay}"
                                    ShowToolbar="True"
                                    Grid.Column="0" />
                            <Button Grid.Column="1"
                                    Text="✨"
                                    WidthRequest="28"
                                    HeightRequest="28"
                                    Padding="0"
                                    Clicked="OnAskAIClicked"
                                    CommandParameter="{x:Reference DescriptionEditor}" />
                        </Grid>
                        <Label Text="Portrait" FontAttributes="Bold" Margin="0,10,0,0" />
                        <Grid ColumnDefinitions="150,*" ColumnSpacing="12" VerticalOptions="Center">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 12" StrokeDashArray="4,4" Stroke="Gray" BackgroundColor="#F5F5F5" HeightRequest="150" WidthRequest="150" Padding="0" Loaded="OnPortraitBorderLoaded">
                                <Border.GestureRecognizers>
                                    <DropGestureRecognizer AllowDrop="True" Drop="OnPortraitDrop" DragOver="OnPortraitDragOver" />
                                </Border.GestureRecognizers>
                                <Grid>
                                    <!-- Drop Image Here Placeholder -->
                                    <VerticalStackLayout x:Name="PlaceholderLayout" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6" InputTransparent="True">
                                        <Label Text="🖼️" FontSize="36" HorizontalOptions="Center" />
                                        <Label Text="Drop Image Here" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                    
                                    <!-- Actual Image -->
                                    <Image x:Name="PortraitImage" Aspect="AspectFill" HeightRequest="150" WidthRequest="150" IsVisible="False" InputTransparent="True" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Label x:Name="PortraitFileNameLabel" Text="No image selected" FontSize="13" TextColor="DimGray" FontAttributes="Italic" LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button x:Name="ClearPortraitButton" Text="Clear Image" Clicked="OnClearPortraitClicked" FontSize="12" BackgroundColor="#E05B5B" TextColor="White" Padding="10,4" HeightRequest="30" IsVisible="False" />
                                    <Button Text="Generate with AI..." Clicked="OnGeneratePortraitClicked" FontSize="12" BackgroundColor="#5B93E0" TextColor="White" Padding="10,4" HeightRequest="30" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Text="Prompt for name on start" Grid.Column="0" VerticalOptions="Center" />
                            <Switch IsToggled="{Binding bPromptForName}" Grid.Column="1" />
                        </Grid>

                        <Label Text="Gender" />
                        <Picker
                            ItemsSource="{Binding Genders}"
                            SelectedItem="{Binding Gender}" />

                        <Label Text="Starting Room" />
                        <Picker
                            ItemsSource="{Binding Source={x:Static rag:App.CurrentGame}, Path=Rooms}"
                            SelectedItem="{Binding StartingRoom}"
                            ItemDisplayBinding="{Binding Name}" />

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray400}" />

                        <toolkit:Expander IsExpanded="True" x:Name="InventoryExpander">
                            <toolkit:Expander.Header>
                                <Grid ColumnDefinitions="*,Auto" Padding="0,10,0,10" BackgroundColor="Transparent">
                                    <Label Text="Inventory" FontAttributes="Bold" FontSize="15" Grid.Column="0" VerticalOptions="Center" />
                                    <Label Text="▼" Grid.Column="1" VerticalOptions="Center" FontSize="12">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference InventoryExpander}, Path=IsExpanded}" Value="False">
                                                <Setter Property="Text" Value="▶" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </toolkit:Expander.Header>
                            <toolkit:Expander.Content>
                                <VerticalStackLayout Spacing="8">
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Text="Add" Clicked="OnAddInventoryClicked" />
                                        <Button Text="Remove" Clicked="OnRemoveInventoryClicked" />
                                    </HorizontalStackLayout>
                                    <CollectionView x:Name="InventoryList"
                                                    ItemsSource="{Binding InventoryIds}"
                                                    SelectionMode="Single"
                                                    HeightRequest="180">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <!-- We bind to item display name from game catalog -->
                                                <Label Text="{Binding ., Converter={StaticResource ObjectIdToNameConverter}}" Padding="6" FontSize="14" />
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>
                            </toolkit:Expander.Content>
                        </toolkit:Expander>

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray400}" />

                        <toolkit:Expander IsExpanded="True" x:Name="AttrsExpander">
                            <toolkit:Expander.Header>
                                <Grid ColumnDefinitions="*,Auto" Padding="0,10,0,10" BackgroundColor="Transparent">
                                    <Label Text="Attributes" FontAttributes="Bold" FontSize="15" Grid.Column="0" VerticalOptions="Center" />
                                    <Label Text="▼" Grid.Column="1" VerticalOptions="Center" FontSize="12">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference AttrsExpander}, Path=IsExpanded}" Value="False">
                                                <Setter Property="Text" Value="▶" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </toolkit:Expander.Header>
                            <toolkit:Expander.Content>
                                <VerticalStackLayout Spacing="8">
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Text="Add" Clicked="OnAddAttributeClicked" />
                                        <Button Text="Remove" Clicked="OnRemoveAttributeClicked" />
                                    </HorizontalStackLayout>
                                    <CollectionView x:Name="AttributesList"
                                            ItemsSource="{Binding Attributes}"
                                            SelectionMode="Single"
                                            HeightRequest="220">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="models:CustomAttribute">
                                                <Grid Padding="6" ColumnSpacing="8" ColumnDefinitions="*,*">
                                                    <Grid ColumnDefinitions="*,Auto" Grid.Column="0">
                                                        <Entry x:Name="AttrNameEntry" Placeholder="Name" Text="{Binding Name}" Grid.Column="0" />
                                                        <Button Grid.Column="1"
                                                                Text="✨"
                                                                WidthRequest="28"
                                                                HeightRequest="28"
                                                                Padding="0"
                                                                Clicked="OnAskAIClicked"
                                                                CommandParameter="{x:Reference AttrNameEntry}" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,Auto" Grid.Column="1">
                                                        <Entry x:Name="AttrValueEntry" Placeholder="Value" Text="{Binding Value}" Grid.Column="0" />
                                                        <Button Grid.Column="1"
                                                                Text="✨"
                                                                WidthRequest="28"
                                                                HeightRequest="28"
                                                                Padding="0"
                                                                Clicked="OnAskAIClicked"
                                                                CommandParameter="{x:Reference AttrValueEntry}" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>
                            </toolkit:Expander.Content>
                        </toolkit:Expander>

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray400}" />
                    </VerticalStackLayout>
                </ScrollView>

                <!-- Tab 2: Actions & Events (Dedicated Full-Height Workarea) -->
                <Grid x:Name="ActionsContainer"
                      Grid.Row="1"
                      IsVisible="False"
                      VerticalOptions="FillAndExpand">
                    <controls:ActionTreeView x:Name="PlayerActionsView" Player="{Binding .}" VerticalOptions="FillAndExpand" />
                </Grid>
            </Grid>
        </controls:RightPaneLayout.Main>
    </controls:RightPaneLayout>
</ContentPage>