<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RagNext.Views.GameObjectsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Objects">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" Clicked="OnAddClicked" />
        <ToolbarItem Text="Save" Clicked="OnSaveClicked" />
    </ContentPage.ToolbarItems>

    <Grid BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#111116}">
        <Border StrokeShape="RoundRectangle 12"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E5E7EB, Dark={DynamicResource Gray900}}"
                BackgroundColor="{AppThemeBinding Light=White, Dark={DynamicResource OffBlack}}"
                Margin="12"
                Padding="8">
            <Border.Shadow>
                <Shadow Radius="8" Opacity="{AppThemeBinding Light=0.04, Dark=0.2}" Brush="Black" Offset="0,2" />
            </Border.Shadow>
            <CollectionView x:Name="ObjectsView"
                            ItemsSource="{Binding Objects}"
                            SelectionMode="Single"
                            SelectionChanged="OnSelectionChanged"
                            Margin="0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding Description}" LineBreakMode="TailTruncation" MaxLines="1" />
                            </VerticalStackLayout>
                            <ImageButton Grid.Column="1"
                                         WidthRequest="36"
                                         HeightRequest="36"
                                         Padding="6"
                                         VerticalOptions="Center"
                                         BackgroundColor="Transparent"
                                         Clicked="OnDeleteClicked"
                                         CommandParameter="{Binding .}">
                                <ImageButton.Source>
                                    <FontImageSource Glyph="🗑️" Color="#E05B5B" />
                                </ImageButton.Source>
                            </ImageButton>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No objects. Tap Add to create one." Padding="16" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>