<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:RagNext.Behaviors"
             xmlns:controls="clr-namespace:RagNext.Views.Controls"
             x:Class="RagNext.Views.EditStepPage"
             Title="{Binding SelectedDefinition.Name, StringFormat='Edit Step - {0}'}">
    <Grid>
        <ScrollView VerticalScrollBarVisibility="Always">
            <ScrollView.Behaviors>
                <behaviors:ScrollAwareBehavior x:Name="ScrollAware"/>
            </ScrollView.Behaviors>
            <VerticalStackLayout Padding="16" Spacing="12">
                <Label Text="Select Type" FontAttributes="Bold"/>
                <Picker x:Name="DefinitionPicker"
                        ItemsSource="{Binding Definitions}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedDefinition}" />

                <Label Text="Inputs" FontAttributes="Bold" />
                <CollectionView ItemsSource="{Binding EditableInputs}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Label}" />
                                <Grid IsVisible="{Binding ControlType, Converter={StaticResource ControlTypeEqualsConverter}, ConverterParameter=Text}"
                                      ColumnDefinitions="*, Auto"
                                      ColumnSpacing="8">
                                    <controls:SuggestiveEditor x:Name="TextEditor"
                                                               Grid.Column="0"
                                                               Text="{Binding Value, Mode=TwoWay}" />
                                    <Button Grid.Column="1"
                                            Text="✨"
                                            WidthRequest="28"
                                            HeightRequest="28"
                                            Padding="0"
                                            VerticalOptions="Center"
                                            Clicked="OnAskAIClicked"
                                            CommandParameter="{x:Reference TextEditor}" />
                                </Grid>
                                <Grid IsVisible="{Binding ControlType, Converter={StaticResource ControlTypeEqualsConverter}, ConverterParameter=TextArea}"
                                      ColumnDefinitions="*, Auto"
                                      ColumnSpacing="8">
                                    <controls:SuggestiveEditor x:Name="TextAreaEditor"
                                                               Grid.Column="0"
                                                               Text="{Binding Value, Mode=TwoWay}" />
                                    <Button Grid.Column="1"
                                            Text="✨"
                                            WidthRequest="28"
                                            HeightRequest="28"
                                            Padding="0"
                                            VerticalOptions="Center"
                                            Clicked="OnAskAIClicked"
                                            CommandParameter="{x:Reference TextAreaEditor}" />
                                </Grid>
                                <Grid IsVisible="{Binding ControlType, Converter={StaticResource ControlTypeEqualsConverter}, ConverterParameter=ComboBox}"
                                      ColumnDefinitions="*, Auto"
                                      ColumnSpacing="8">
                                    <Grid Grid.Column="0">
                                        <Picker ItemsSource="{Binding PickerSource}"
                                                ItemDisplayBinding="{Binding Name}"
                                                SelectedItem="{Binding Value, Mode=TwoWay}"
                                                Loaded="OnInputPickerLoaded"
                                                IsVisible="{Binding IsNormalMode}" />
                                        <controls:SuggestiveEditor Text="{Binding Value, Mode=TwoWay}"
                                               IsVisible="{Binding IsManualMode}" />
                                    </Grid>
                                    <Button Grid.Column="1"
                                            Text="{Binding ToggleButtonText}"
                                            Clicked="OnToggleManualMode"
                                            WidthRequest="70"
                                            HeightRequest="36"
                                            Padding="0"
                                            VerticalOptions="Center" />
                                </Grid>
                                <CheckBox IsChecked="{Binding Value, Mode=TwoWay}"
                                          IsVisible="{Binding ControlType, Converter={StaticResource ControlTypeEqualsConverter}, ConverterParameter=Checkbox}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <HorizontalStackLayout Spacing="12">
                    <Button Text="Save" Command="{Binding SaveCommand}" />
                    <Button Text="Cancel" Command="{Binding CancelCommand}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Top fade -->
        <Border InputTransparent="True"
                IsVisible="{Binding Source={x:Reference ScrollAware}, Path=HasMoreAbove}"
                Background="{AppThemeBinding Light={StaticResource TopFadeLight}, Dark={StaticResource TopFadeDark}}"
                HeightRequest="32"
                HorizontalOptions="Fill"
                VerticalOptions="Start">
            <Label Text="▲"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   FontSize="12"
                   Opacity="0.6"/>
        </Border>

        <!-- Bottom fade -->
        <Border InputTransparent="True"
                IsVisible="{Binding Source={x:Reference ScrollAware}, Path=HasMoreBelow}"
                Background="{AppThemeBinding Light={StaticResource BottomFadeLight}, Dark={StaticResource BottomFadeDark}}"
                HeightRequest="40"
                HorizontalOptions="Fill"
                VerticalOptions="End">
            <Label Text="Scroll for more ▼"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   FontSize="12"
                   Opacity="0.7"/>
        </Border>
    </Grid>
</ContentPage>