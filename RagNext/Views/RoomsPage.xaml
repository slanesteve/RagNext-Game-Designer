<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RagNext.Views.RoomsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:RagsCore.Models;assembly=RagsCore"
    Title="Rooms">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" Command="{Binding AddRoomCommand}" />
        <ToolbarItem Text="Save" Clicked="OnSaveClicked" Priority="1" Order="Primary" />
    </ContentPage.ToolbarItems>

    <Grid BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#111116}">
        <Border StrokeShape="RoundRectangle 12"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2E2E3C}"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E28}"
                Margin="12"
                Padding="8">
            <Border.Shadow>
                <Shadow Radius="8" Opacity="{AppThemeBinding Light=0.04, Dark=0.2}" Brush="Black" Offset="0,2" />
            </Border.Shadow>
            <CollectionView
                ItemsSource="{Binding Rooms}"
                SelectionMode="Single"
                SelectionChanged="OnRoomSelected"
                Margin="0">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Room">
                        <Grid Padding="10" ColumnDefinitions="*,Auto">
                            <StackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding Description}" LineBreakMode="TailTruncation" MaxLines="1" />
                            </StackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Button
                                    Text="Edit"
                                    Clicked="OnEditClicked"
                                    CommandParameter="{Binding .}"
                                    HeightRequest="36" />
                                <ImageButton
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    Padding="6"
                                    BackgroundColor="Transparent"
                                    Clicked="OnDeleteClicked"
                                    CommandParameter="{Binding .}">
                                    <ImageButton.Source>
                                        <FontImageSource Glyph="🗑️" Color="#E05B5B" />
                                    </ImageButton.Source>
                                </ImageButton>
                            </HorizontalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="No rooms. Use Add to create one."
                           HorizontalOptions="Center"
                           VerticalOptions="CenterAndExpand" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>