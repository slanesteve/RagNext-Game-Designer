<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RagNext.Views.GameVariableEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:RagsCore.Models;assembly=RagsCore"
    x:DataType="models:GameVariable"
    Title="Edit Variable">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Clicked="OnSaveClicked" />
        <ToolbarItem Text="Cancel" Clicked="OnCancelClicked" Priority="1" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="10">
            <Label Text="Name" />
            <Grid ColumnDefinitions="*,Auto">
                <Entry x:Name="NameEntry" Text="{Binding Name}" Placeholder="Variable name" Grid.Column="0" />
                <Button Text="✨" Grid.Column="1" WidthRequest="28" HeightRequest="28" Padding="0"
                        Clicked="OnAskAIClicked" CommandParameter="{x:Reference NameEntry}" />
            </Grid>

            <Label Text="Type" />
            <Grid ColumnDefinitions="*,Auto">
                <Entry x:Name="TypeEntry" Text="{Binding Type}" Placeholder="string | int | bool" Grid.Column="0" />
                <Button Text="✨" Grid.Column="1" WidthRequest="28" HeightRequest="28" Padding="0"
                        Clicked="OnAskAIClicked" CommandParameter="{x:Reference TypeEntry}" />
            </Grid>

            <Label Text="Value" />
            <Grid ColumnDefinitions="*,Auto">
                <Entry x:Name="ValueEntry" Text="{Binding Value}" Grid.Column="0" />
                <Button Text="✨" Grid.Column="1" WidthRequest="28" HeightRequest="28" Padding="0"
                        Clicked="OnAskAIClicked" CommandParameter="{x:Reference ValueEntry}" />
            </Grid>

            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray400}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>