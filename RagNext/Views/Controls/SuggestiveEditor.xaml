<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RagNext.Services"
             x:Class="RagNext.Views.Controls.SuggestiveEditor"
             x:Name="self">

    <Grid VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" RowDefinitions="Auto, *, Auto">
        <!-- Rich Text Formatting Toolbar -->
        <HorizontalStackLayout Grid.Row="0"
                               Spacing="6"
                               Margin="0,0,0,8"
                               IsVisible="{Binding ShowToolbar, Source={x:Reference self}}"
                               VerticalOptions="Center"
                               HeightRequest="32">
            <!-- Bold Button -->
            <Border BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#2A2A35}" StrokeShape="RoundRectangle 6" StrokeThickness="0" WidthRequest="32" HeightRequest="28" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBoldClicked" />
                </Border.GestureRecognizers>
                <Label Text="B" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#111111, Dark=#f0f0f4}" FontSize="12" />
            </Border>

            <!-- Italic Button -->
            <Border BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#2A2A35}" StrokeShape="RoundRectangle 6" StrokeThickness="0" WidthRequest="32" HeightRequest="28" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnItalicClicked" />
                </Border.GestureRecognizers>
                <Label Text="I" FontAttributes="Italic" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#111111, Dark=#f0f0f4}" FontSize="12" />
            </Border>

            <!-- Underline Button -->
            <Border BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#2A2A35}" StrokeShape="RoundRectangle 6" StrokeThickness="0" WidthRequest="32" HeightRequest="28" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnUnderlineClicked" />
                </Border.GestureRecognizers>
                <Label Text="U" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#111111, Dark=#f0f0f4}" FontSize="12" />
            </Border>

            <!-- Color Button -->
            <Border BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#2A2A35}" StrokeShape="RoundRectangle 6" StrokeThickness="0" WidthRequest="74" HeightRequest="28" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnColorClicked" />
                </Border.GestureRecognizers>
                <Label Text="🎨 Color" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#111111, Dark=#f0f0f4}" FontSize="11" />
            </Border>

            <!-- Highlight Button -->
            <Border BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#2A2A35}" StrokeShape="RoundRectangle 6" StrokeThickness="0" WidthRequest="88" HeightRequest="28" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHighlightClicked" />
                </Border.GestureRecognizers>
                <Label Text="🧪 Highlight" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#111111, Dark=#f0f0f4}" FontSize="11" />
            </Border>
            <!-- Clear Formatting Button -->
            <Border BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#2A2A35}" StrokeShape="RoundRectangle 6" StrokeThickness="0" WidthRequest="64" HeightRequest="28" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnClearFormattingClicked" />
                </Border.GestureRecognizers>
                <Label Text="Clear" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#111111, Dark=#f0f0f4}" FontSize="11" />
            </Border>
        </HorizontalStackLayout>

        <!-- The underlying Editor -->
        <Editor x:Name="MainEditor"
                Grid.Row="1"
                Text="{Binding Text, Source={x:Reference self}, Mode=TwoWay}"
                Placeholder="{Binding Placeholder, Source={x:Reference self}}"
                VerticalOptions="FillAndExpand"
                HorizontalOptions="FillAndExpand"
                AutoSize="TextChanges"
                TextChanged="OnEditorTextChanged"
                Focused="OnEditorFocused"
                Unfocused="OnEditorUnfocused"
                HandlerChanged="OnMainEditorHandlerChanged" />

        <!-- Help Icon Button (Top-Right of Editor) -->
        <Border x:Name="HelpIcon"
                Grid.Row="1"
                WidthRequest="22"
                HeightRequest="22"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0, 8, 12, 0"
                BackgroundColor="{AppThemeBinding Light=#E0E0E5, Dark=#2a2a35}"
                Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#4a4a5c}"
                StrokeThickness="1"
                ZIndex="998">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="11" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHelpIconTapped" />
                <PointerGestureRecognizer PointerEntered="OnHelpIconPointerEntered"
                                          PointerExited="OnHelpIconPointerExited" />
            </Border.GestureRecognizers>
            <Label Text="?"
                   TextColor="{AppThemeBinding Light=#555565, Dark=#a0a0b0}"
                   FontSize="12"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Border>

        <!-- Light Dismiss Overlay for Help Popup -->
        <Grid x:Name="HelpDismissOverlay"
              Grid.Row="1"
              IsVisible="False"
              BackgroundColor="Transparent"
              ZIndex="997">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHelpDismissOverlayTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        <!-- Help Info Popup Card -->
        <Border x:Name="HelpPopupCard"
                Grid.Row="1"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1e1e24}"
                Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#3a3a4c}"
                StrokeThickness="1"
                Padding="12"
                ZIndex="999"
                WidthRequest="290"
                HeightRequest="240"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0, 36, 12, 0">
            <Border.Shadow>
                <Shadow Offset="0,4" Radius="8" Opacity="0.3" Brush="Black" />
            </Border.Shadow>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHelpPopupTapped" />
            </Border.GestureRecognizers>

            <VerticalStackLayout Spacing="5">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="✨ Editor Guide"
                           FontAttributes="Bold"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#111111, Dark=#f0f0f4}" />
                    <Label Grid.Column="1"
                           Text="❌"
                           TextColor="#7f8c8d"
                           FontSize="10"
                           HorizontalOptions="End"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseHelpTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
                
                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#2d2d38}" Margin="0,1" />
                
                <!-- Section 1: Dynamic Replacements -->
                <Label Text="Type { to insert dynamic game variables:"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#111111, Dark=#f0f0f4}" />
                <VerticalStackLayout Spacing="1.5" Margin="4,0,0,0">
                    <Label Text="• {player.Name} ➔ Protagonist Name"
                           FontSize="10"
                           TextColor="{AppThemeBinding Light=#555555, Dark=#a0a0b0}" />
                    <Label Text="• {variables.Gold} ➔ Global Variables"
                           FontSize="10"
                           TextColor="{AppThemeBinding Light=#555555, Dark=#a0a0b0}" />
                </VerticalStackLayout>
                
                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#2d2d38}" Margin="0,1" />
                
                <!-- Section 2: Hotlinks -->
                <Label Text="Type [ to insert environment hotlinks:"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#111111, Dark=#f0f0f4}" />
                <VerticalStackLayout Spacing="1.5" Margin="4,0,0,0">
                    <Label Text="• [A Ring] ➔ Character/object action menu"
                           FontSize="10"
                           TextColor="{AppThemeBinding Light=#555555, Dark=#a0a0b0}" />
                    <Label Text="• [North] ➔ Clickable travel navigation"
                           FontSize="10"
                           TextColor="{AppThemeBinding Light=#555555, Dark=#a0a0b0}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Floating Autocomplete Card Overlay -->
        <Border x:Name="PopupCard"
                Grid.Row="1"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1e1e24}"
                Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#3a3a4c}"
                StrokeThickness="1"
                Padding="6"
                ZIndex="999"
                WidthRequest="350"
                HeightRequest="220"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                Margin="12, 80, 0, 0">
            <Border.Shadow>
                <Shadow Offset="0,4" Radius="8" Opacity="0.3" Brush="Black" />
            </Border.Shadow>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>

            <Grid RowDefinitions="*,Auto">
                <CollectionView x:Name="SuggestionsList"
                                Grid.Row="0"
                                SelectionMode="None"
                                BackgroundColor="Transparent">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:SuggestionItem">
                            <Grid ColumnDefinitions="*,Auto"
                                  Padding="8,6"
                                  BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSuggestionItemTapped" />
                                    <PointerGestureRecognizer PointerEntered="OnSuggestionPointerEntered"
                                                              PointerExited="OnSuggestionPointerExited" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding DisplayText}"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light=#111111, Dark=#f0f0f4}" />
                                    <Label Text="{Binding Description}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light=#555555, Dark=#a0a0b0}"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding TypeName}"
                                       FontSize="10"
                                       FontAttributes="Italic"
                                       TextColor="{AppThemeBinding Light=#777777, Dark=#7f8c8d}"
                                       VerticalOptions="Center"
                                       Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Label Grid.Row="1"
                       Text="Tap a suggestion to autocomplete"
                       TextColor="{AppThemeBinding Light=#777777, Dark=#7f8c8d}"
                       FontSize="10"
                       HorizontalOptions="End"
                       Margin="0,4,4,0" />
            </Grid>
        </Border>

        <!-- Live HTML Preview Section -->
        <VerticalStackLayout Grid.Row="2"
                             Margin="0,8,0,0"
                             Spacing="4"
                             IsVisible="{Binding ShowToolbar, Source={x:Reference self}}">
            <Label Text="👁️ Live Preview" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Gray, Dark=DarkGray}" />
            <Border StrokeShape="RoundRectangle 6"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A4C}"
                    BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#1A1A22}"
                    Padding="10,8"
                    MinimumHeightRequest="36"
                    HorizontalOptions="FillAndExpand">
                <Label x:Name="PreviewLabel"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light=#111111, Dark=#F0F0F4}"
                       HorizontalOptions="FillAndExpand" />
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentView>
