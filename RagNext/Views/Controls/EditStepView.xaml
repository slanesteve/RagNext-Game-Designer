<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="RagNext.Views.Controls.EditStepView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Remove the inner ScrollView to avoid nested ScrollViews (parent page already scrolls) -->
    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Select Type" FontAttributes="Bold"/>
        <Picker x:Name="DefinitionPicker"
                ItemsSource="{Binding Definitions}"
                ItemDisplayBinding="{Binding Name}"
                SelectedItem="{Binding SelectedDefinition}" />

        <Label Text="Inputs" FontAttributes="Bold" />
        <CollectionView ItemsSource="{Binding EditableInputs}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Label}" />
                        <Entry IsVisible="{Binding ControlType, Converter={StaticResource ControlTypeEqualsConverter}, ConverterParameter=Text}">
                            <Entry.Triggers>
                                <DataTrigger TargetType="Entry" Binding="{Binding ControlType}" Value="Text">
                                    <Setter Property="Text" Value="{Binding Value, Mode=TwoWay}" />
                                </DataTrigger>
                            </Entry.Triggers>
                        </Entry>
                        <Editor IsVisible="{Binding ControlType, Converter={StaticResource ControlTypeEqualsConverter}, ConverterParameter=TextArea}">
                            <Editor.Triggers>
                                <DataTrigger TargetType="Editor" Binding="{Binding ControlType}" Value="TextArea">
                                    <Setter Property="Text" Value="{Binding Value, Mode=TwoWay}" />
                                </DataTrigger>
                            </Editor.Triggers>
                        </Editor>
                        <Picker ItemsSource="{Binding PickerSource}"
                                ItemDisplayBinding="{Binding Name}"
                                Loaded="OnInputPickerLoaded"
                                xmlns:behaviors="clr-namespace:RagNext.Behaviors"
                                IsVisible="{Binding ControlType, Converter={StaticResource ControlTypeEqualsConverter}, ConverterParameter=ComboBox}">
                            <Picker.Behaviors>
                                <behaviors:SyncPickerSelectionBehavior />
                            </Picker.Behaviors>
                        </Picker>
                        <CheckBox IsVisible="{Binding ControlType, Converter={StaticResource ControlTypeEqualsConverter}, ConverterParameter=Checkbox}">
                            <CheckBox.Triggers>
                                <DataTrigger TargetType="CheckBox" Binding="{Binding ControlType}" Value="Checkbox">
                                    <Setter Property="IsChecked" Value="{Binding Value, Mode=TwoWay}" />
                                </DataTrigger>
                            </CheckBox.Triggers>
                        </CheckBox>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Spacing="12">
            <Button Text="Save" Command="{Binding SaveCommand}" />
            <Button Text="Cancel" Command="{Binding CancelCommand}" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentView>