<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="RagNext.Views.Controls.EditStepView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RagNext.Views.Controls"
    xmlns:converters="clr-namespace:RagNext.Converters">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:ControlTypeEqualsConverter x:Key="ControlTypeEqualsConverter" />
            <converters:DataTypeEqualsConverter x:Key="DataTypeEqualsConverter" />
            <converters:StringEqualsConverter x:Key="StringEqualsConverter" />
            <converters:StringNotEqualsConverter x:Key="StringNotEqualsConverter" />
            <converters:CustomOptionsToListConverter x:Key="CustomOptionsToListConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Remove the inner ScrollView to avoid nested ScrollViews (parent page already scrolls) -->
    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Select Type" FontAttributes="Bold"/>
        <Picker x:Name="DefinitionPicker"
                ItemsSource="{Binding Definitions}"
                ItemDisplayBinding="{Binding Name}"
                SelectedItem="{Binding SelectedDefinition, Mode=OneWay}"
                SelectedIndexChanged="OnDefinitionPickerSelectedIndexChanged" />

        <Label Text="Inputs" FontAttributes="Bold" />
        <CollectionView ItemsSource="{Binding EditableInputs}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Label}" />

                        <!-- Default Inputs (Hidden when CustomOptions) -->
                        <VerticalStackLayout IsVisible="{Binding Label, Converter={StaticResource StringNotEqualsConverter}, ConverterParameter=CustomOptions}" Spacing="4">
                            <Grid IsVisible="{Binding ControlType, Converter={StaticResource ControlTypeEqualsConverter}, ConverterParameter=Text}"
                                  ColumnDefinitions="*, Auto"
                                  ColumnSpacing="8">
                                <controls:SuggestiveEditor x:Name="TextEditor"
                                                           Grid.Column="0"
                                                           Text="{Binding Value, Mode=OneWay}"
                                                           TextChanged="OnTextChanged"
                                                           UnfocusedEvent="OnEntryUnfocused"
                                                           ShowToolbar="True" />
                                <Button Grid.Column="1"
                                        Text="✨"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        Padding="0"
                                        VerticalOptions="Center"
                                        Clicked="OnAskAIClicked"
                                        CommandParameter="{x:Reference TextEditor}" />
                            </Grid>
                            <Grid IsVisible="{Binding ControlType, Converter={StaticResource ControlTypeEqualsConverter}, ConverterParameter=TextArea}"
                                  ColumnDefinitions="*, Auto"
                                  ColumnSpacing="8">
                                <controls:SuggestiveEditor x:Name="TextAreaEditor"
                                                           Grid.Column="0"
                                                           Text="{Binding Value, Mode=OneWay}"
                                                           TextChanged="OnTextChanged"
                                                           UnfocusedEvent="OnEditorUnfocused"
                                                           ShowToolbar="True" />
                                <Button Grid.Column="1"
                                        Text="✨"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        Padding="0"
                                        VerticalOptions="Center"
                                        Clicked="OnAskAIClicked"
                                        CommandParameter="{x:Reference TextAreaEditor}" />
                            </Grid>
                            <Grid IsVisible="{Binding ControlType, Converter={StaticResource ControlTypeEqualsConverter}, ConverterParameter=ComboBox}"
                                  ColumnDefinitions="*, Auto, Auto"
                                  ColumnSpacing="8">
                                <Grid Grid.Column="0">
                                    <Picker xmlns:behaviors="clr-namespace:RagNext.Behaviors"
                                            IsVisible="{Binding IsNormalMode}">
                                        <Picker.Behaviors>
                                            <behaviors:SyncPickerSelectionBehavior />
                                        </Picker.Behaviors>
                                    </Picker>
                                    <controls:SuggestiveEditor Text="{Binding Value, Mode=OneWay}"
                                           IsVisible="{Binding IsManualMode}"
                                           TextChanged="OnTextChanged"
                                           UnfocusedEvent="OnEntryUnfocused" />
                                </Grid>
                                <Button Grid.Column="1"
                                        Text="?"
                                        WidthRequest="24"
                                        HeightRequest="24"
                                        CornerRadius="12"
                                        Padding="0"
                                        FontSize="11"
                                        VerticalOptions="Center"
                                        BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#2A2A35}"
                                        TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}"
                                        FontAttributes="Bold"
                                        IsVisible="{Binding DataType, Converter={StaticResource DataTypeEqualsConverter}, ConverterParameter=Media}"
                                        Clicked="OnMediaHelpClicked" />
                                <Button Grid.Column="2"
                                        Text="{Binding ToggleButtonText}"
                                        Clicked="OnToggleManualMode"
                                        WidthRequest="70"
                                        HeightRequest="36"
                                        Padding="0"
                                        VerticalOptions="Center" />
                            </Grid>
                            <Entry Keyboard="Numeric"
                                   IsVisible="{Binding ControlType, Converter={StaticResource ControlTypeEqualsConverter}, ConverterParameter=Number}"
                                   Text="{Binding Value, Mode=OneWay}"
                                   TextChanged="OnTextChanged"
                                   Unfocused="OnEntryUnfocused" />
                            <CheckBox IsVisible="{Binding ControlType, Converter={StaticResource ControlTypeEqualsConverter}, ConverterParameter=Checkbox}" CheckedChanged="OnCheckChanged">
                                <CheckBox.Triggers>
                                    <DataTrigger TargetType="CheckBox" Binding="{Binding ControlType}" Value="Checkbox">
                                        <Setter Property="IsChecked" Value="{Binding Value, Mode=OneWay}" />
                                    </DataTrigger>
                                </CheckBox.Triggers>
                            </CheckBox>
                        </VerticalStackLayout>

                        <!-- Custom Option List Builder UI (Visible ONLY when CustomOptions) -->
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding Label, Converter={StaticResource StringEqualsConverter}, ConverterParameter=CustomOptions}">
                            <!-- Current options list -->
                            <!-- Current options list (non-virtualizing BindableLayout to prevent WinUI nested CollectionView crash) -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Value, Converter={StaticResource CustomOptionsToListConverter}}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*, Auto" Padding="6,4" Margin="0,2" BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#2A2A35}">
                                            <Label Text="{Binding .}" VerticalOptions="Center" FontSize="13" Margin="8,0,0,0"/>
                                            <Button Grid.Column="1" Text="🗑️" BackgroundColor="Transparent" TextColor="Red" Padding="0" WidthRequest="32" HeightRequest="32" Clicked="OnDeleteCustomOptionClicked" CommandParameter="{Binding .}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Add new option row -->
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8" Margin="0,4,0,10">
                                <Entry x:Name="NewOptionEntry" Placeholder="Type new option..." HeightRequest="36" FontSize="12" Grid.Column="0" />
                                <Button Text="Add" Clicked="OnAddCustomOptionClicked" BackgroundColor="#512BD4" TextColor="White" Padding="12,0" HeightRequest="36" Grid.Column="1" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!--<HorizontalStackLayout Spacing="12">
            <Button Text="Save" Command="{Binding SaveCommand}" />
            <Button Text="Cancel" Command="{Binding CancelCommand}" />
        </HorizontalStackLayout>-->
    </VerticalStackLayout>
</ContentView>