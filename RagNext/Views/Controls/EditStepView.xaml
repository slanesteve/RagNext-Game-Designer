<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="RagNext.Views.Controls.EditStepView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RagNext.Views.Controls">

    <!-- Remove the inner ScrollView to avoid nested ScrollViews (parent page already scrolls) -->
    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Select Type" FontAttributes="Bold"/>
        <Picker x:Name="DefinitionPicker"
                ItemsSource="{Binding Definitions}"
                ItemDisplayBinding="{Binding Name}"
                SelectedItem="{Binding SelectedDefinition}" />

        <Label Text="Inputs" FontAttributes="Bold" />
        <CollectionView ItemsSource="{Binding EditableInputs}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Label}" />
                        <controls:SuggestiveEditor Text="{Binding Value, Mode=TwoWay}"
                               IsVisible="{Binding ControlType, Converter={StaticResource ControlTypeEqualsConverter}, ConverterParameter=Text}"
                               TextChanged="OnTextChanged"
                               UnfocusedEvent="OnEntryUnfocused" />
                        <controls:SuggestiveEditor Text="{Binding Value, Mode=TwoWay}"
                                IsVisible="{Binding ControlType, Converter={StaticResource ControlTypeEqualsConverter}, ConverterParameter=TextArea}"
                                TextChanged="OnTextChanged"
                                UnfocusedEvent="OnEditorUnfocused" />
                        <Grid IsVisible="{Binding ControlType, Converter={StaticResource ControlTypeEqualsConverter}, ConverterParameter=ComboBox}"
                              ColumnDefinitions="*, Auto"
                              ColumnSpacing="8">
                            <Grid Grid.Column="0">
                                <Picker ItemsSource="{Binding PickerSource}"
                                        ItemDisplayBinding="{Binding Name}"
                                        Loaded="OnInputPickerLoaded"
                                        xmlns:behaviors="clr-namespace:RagNext.Behaviors"
                                        IsVisible="{Binding IsNormalMode}">
                                    <Picker.Behaviors>
                                        <behaviors:SyncPickerSelectionBehavior />
                                    </Picker.Behaviors>
                                </Picker>
                                <controls:SuggestiveEditor Text="{Binding Value, Mode=TwoWay}"
                                       IsVisible="{Binding IsManualMode}"
                                       TextChanged="OnTextChanged"
                                       UnfocusedEvent="OnEntryUnfocused" />
                            </Grid>
                            <Button Grid.Column="1"
                                    Text="{Binding ToggleButtonText}"
                                    Clicked="OnToggleManualMode"
                                    WidthRequest="70"
                                    HeightRequest="36"
                                    Padding="0"
                                    VerticalOptions="Center" />
                        </Grid>
                        <CheckBox IsVisible="{Binding ControlType, Converter={StaticResource ControlTypeEqualsConverter}, ConverterParameter=Checkbox}" CheckedChanged="OnCheckChanged">
                            <CheckBox.Triggers>
                                <DataTrigger TargetType="CheckBox" Binding="{Binding ControlType}" Value="Checkbox">
                                    <Setter Property="IsChecked" Value="{Binding Value, Mode=TwoWay}" />
                                </DataTrigger>
                            </CheckBox.Triggers>
                        </CheckBox>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!--<HorizontalStackLayout Spacing="12">
            <Button Text="Save" Command="{Binding SaveCommand}" />
            <Button Text="Cancel" Command="{Binding CancelCommand}" />
        </HorizontalStackLayout>-->
    </VerticalStackLayout>
</ContentView>