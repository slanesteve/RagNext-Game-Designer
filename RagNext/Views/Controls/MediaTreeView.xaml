<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Name="MediaTreeRoot"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:RagNext.Views.Controls"
             x:Class="RagNext.Views.Controls.MediaTreeView">
    <ContentView.Resources>
        <!-- Leaf (asset) template -->
        <DataTemplate x:Key="AssetTemplate">
            <Border Padding="4" Margin="{Binding Indent}" BackgroundColor="Transparent">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="#CCE5FF" />
                    </DataTrigger>
                </Border.Triggers>
                <HorizontalStackLayout Spacing="6">
                    <Label Text="{Binding Icon}" />
                    <Label Text="{Binding Name}" LineBreakMode="TailTruncation" />
                </HorizontalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={x:Reference MediaTreeRoot}, Path=BindingContext.SelectNodeCommand}"
                                          CommandParameter="{Binding}" />
                </Border.GestureRecognizers>
            </Border>
        </DataTemplate>

        <!-- Folder template (recursive via BindableLayout) -->
        <DataTemplate x:Key="FolderTemplate">
            <toolkit:Expander x:Name="FolderExpander" IsExpanded="False">
                <toolkit:Expander.Header>
                    <Border Padding="4" Margin="{Binding Indent}" BackgroundColor="Transparent">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#CCE5FF" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="6">
                            <!-- Expand/collapse indicator -->
                            <Label Text="▶"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding Source={x:Reference FolderExpander}, Path=IsExpanded}"
                                                 Value="True">
                                        <Setter Property="Text" Value="▼" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding Icon}" />
                            <Label Text="{Binding Name}" LineBreakMode="TailTruncation" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference MediaTreeRoot}, Path=BindingContext.SelectNodeCommand}"
                                                  CommandParameter="{Binding}" />
                        </Border.GestureRecognizers>
                    </Border>
                </toolkit:Expander.Header>

                <!-- Recurse to all depths without nested CollectionViews -->
                <VerticalStackLayout Spacing="0"
                                     BindableLayout.ItemsSource="{Binding Children}"
                                     BindableLayout.ItemTemplateSelector="{StaticResource NodeTemplateSelector}" />
            </toolkit:Expander>
        </DataTemplate>

        <!-- Chooses folder vs asset template -->
        <controls:NodeTemplateSelector x:Key="NodeTemplateSelector"
                                       FolderTemplate="{StaticResource FolderTemplate}"
                                       AssetTemplate="{StaticResource AssetTemplate}" />
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,*" Padding="8,6">
        <!-- Toolbar -->
        <HorizontalStackLayout Spacing="8">
            <Button Text="+ Folder" Padding="10,6" Command="{Binding AddFolderCommand}" />
            <Button Text="Import..." Padding="10,6" Command="{Binding ImportFilesCommand}" />
            <Button Text="Rename" Padding="10,6" Command="{Binding RenameCommand}" />
            <Button Text="Delete" Padding="10,6" Command="{Binding DeleteCommand}" />
        </HorizontalStackLayout>

        <!-- Root level using BindableLayout (no nested CollectionView) -->
        <VerticalStackLayout Grid.Row="1" Spacing="0"
                             BindableLayout.ItemsSource="{Binding Roots}"
                             BindableLayout.ItemTemplateSelector="{StaticResource NodeTemplateSelector}" />
    </Grid>
</ContentView>