<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RagNext.Views.Controls"
             x:Class="RagNext.Views.Controls.RightPaneLayout">
    <Grid ColumnDefinitions="*,340">
        <!-- Main content -->
        <ContentPresenter x:Name="MainPresenter" Grid.Column="0" />

        <!-- Media sidebar -->
        <Border Grid.Column="1" StrokeThickness="1" Stroke="#DDD" Background="#FAFAFA">
            <controls:MediaTreeView />
        </Border>
    </Grid>
</ContentView>