<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Name="ActionTreeRoot"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RagNext.Views.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converter="clr-namespace:RagNext.Converters"
             x:Class="RagNext.Views.Controls.ActionTreeView">
    <ContentView.Resources>
        <DataTemplate x:Key="InputTemplate">
            <Border Padding="4" Margin="{Binding Indent}" BackgroundColor="Transparent">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="#D6F5D6" />
                    </DataTrigger>
                </Border.Triggers>
                <HorizontalStackLayout Spacing="6">
                    <Label Text="{Binding Icon}" />
                    <Label Text="{Binding Name}" />
                </HorizontalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1"
                                          Command="{Binding Source={x:Reference ActionTreeRoot}, Path=BindingContext.SelectNodeCommand}"
                                          CommandParameter="{Binding}" />
                </Border.GestureRecognizers>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="StepTemplate">
            <toolkit:Expander x:Name="StepExpander"
                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                              ExpandedChanged="OnExpanderExpandedChanged">
                <toolkit:Expander.Header>
                    <Border Padding="4" Margin="{Binding Indent}" BackgroundColor="Transparent">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#D6F5D6" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="▶">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding Source={x:Reference StepExpander}, Path=IsExpanded}"
                                                 Value="True">
                                        <Setter Property="Text" Value="▼" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding Icon}" />
                            <Label Text="{Binding Name}" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer NumberOfTapsRequired="1"
                                                  Command="{Binding Source={x:Reference ActionTreeRoot}, Path=BindingContext.SelectNodeCommand}"
                                                  CommandParameter="{Binding}" />
                        </Border.GestureRecognizers>
                    </Border>
                </toolkit:Expander.Header>
                <!-- removed children list -->
            </toolkit:Expander>
        </DataTemplate>

        <DataTemplate x:Key="NodeTemplate">
            <toolkit:Expander x:Name="InnerNodeExpander"
                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                              ExpandedChanged="OnExpanderExpandedChanged">
                <toolkit:Expander.Header>
                    <Border Padding="4" Margin="{Binding Indent}" BackgroundColor="Transparent">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#D6F5D6" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="▶">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding Source={x:Reference InnerNodeExpander}, Path=IsExpanded}"
                                                 Value="True">
                                        <Setter Property="Text" Value="▼" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding Icon}" />
                            <Label Text="{Binding Name}" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer NumberOfTapsRequired="1"
                                                  Command="{Binding Source={x:Reference ActionTreeRoot}, Path=BindingContext.SelectNodeCommand}"
                                                  CommandParameter="{Binding}" />
                        </Border.GestureRecognizers>
                    </Border>
                </toolkit:Expander.Header>
                <VerticalStackLayout Spacing="0"
                                     BindableLayout.ItemsSource="{Binding Children}"
                                     BindableLayout.ItemTemplateSelector="{StaticResource ActionNodeTemplateSelector}" />
            </toolkit:Expander>
        </DataTemplate>

        <DataTemplate x:Key="ActionTemplate">
            <toolkit:Expander x:Name="ActionExpander"
                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                              ExpandedChanged="OnExpanderExpandedChanged">
                <toolkit:Expander.Header>
                    <Border Padding="4" Margin="{Binding Indent}" BackgroundColor="Transparent">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#D6F5D6" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="▼">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding Source={x:Reference ActionExpander}, Path=IsExpanded}"
                                                 Value="False">
                                        <Setter Property="Text" Value="▶" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding Icon}" />
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer NumberOfTapsRequired="1"
                                                  Command="{Binding Source={x:Reference ActionTreeRoot}, Path=BindingContext.SelectNodeCommand}"
                                                  CommandParameter="{Binding}" />
                        </Border.GestureRecognizers>
                    </Border>
                </toolkit:Expander.Header>
                <VerticalStackLayout Spacing="0"
                                     BindableLayout.ItemsSource="{Binding Children}"
                                     BindableLayout.ItemTemplateSelector="{StaticResource ActionNodeTemplateSelector}" />
            </toolkit:Expander>
        </DataTemplate>

        <controls:ActionNodeTemplateSelector x:Key="ActionNodeTemplateSelector"
                                             ActionTemplate="{StaticResource ActionTemplate}"
                                             NodeTemplate="{StaticResource NodeTemplate}"
                                             StepTemplate="{StaticResource StepTemplate}"
                                             InputTemplate="{StaticResource InputTemplate}" />
        <converter:NullToBoolConverter x:Key="NullToBoolConverter" />
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,*"
          ColumnDefinitions="280,16,*"
          x:Name="ParentGrid"
          Padding="8,6">
        <HorizontalStackLayout Spacing="8"
                               Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="3">
            <Button Text="+ Action" Command="{Binding AddActionCommand}" IsVisible="{Binding CanAddAction}" />
            <Button Text="+ Condition" Command="{Binding AddConditionCommand}" />
            <Button Text="+ Command" Command="{Binding AddCommandCommand}" />
            <Button Text="Delete" Command="{Binding DeleteCommand}" />
            <Button Text="Copy" Command="{Binding CopyCommand}" />
            <Button Text="Paste" Command="{Binding PasteCommand}" />
        </HorizontalStackLayout>

        <!-- Left: Tree -->
        <ScrollView Grid.Row="1"
                    Grid.Column="0"
                    VerticalScrollBarVisibility="Default">
            <VerticalStackLayout Spacing="0"
                                 BindableLayout.ItemsSource="{Binding Roots}"
                                 BindableLayout.ItemTemplateSelector="{StaticResource ActionNodeTemplateSelector}" />
        </ScrollView>

        <!-- Splitter Column with Grab & Hover Indicators -->
        <Grid Grid.Column="1" Grid.Row="1" BackgroundColor="Transparent" x:Name="SplitterBar" WidthRequest="16">
            <Grid.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
            </Grid.GestureRecognizers>
            
            <!-- Default divider line -->
            <BoxView x:Name="DefaultSplitterLine" Color="{AppThemeBinding Light={DynamicResource Gray200}, Dark={DynamicResource Gray800}}" WidthRequest="1" HorizontalOptions="Center" VerticalOptions="Fill" InputTransparent="True" />
            
            <!-- Glowing hover visual line -->
            <BoxView x:Name="HoverSplitterLine" Color="#8E2DE2" WidthRequest="3" HorizontalOptions="Center" VerticalOptions="Fill" InputTransparent="True" Opacity="0" />
            
            <!-- Ellipsis Gripper Badge -->
            <Border x:Name="GripperBadge" StrokeShape="RoundRectangle 6" WidthRequest="8" HeightRequest="26" BackgroundColor="{AppThemeBinding Light={DynamicResource Gray100}, Dark={DynamicResource Gray900}}" StrokeThickness="1" Stroke="{AppThemeBinding Light={DynamicResource Gray300}, Dark={DynamicResource Gray700}}" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True">
                <Label Text="⋮" FontSize="12" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-2,0,0" />
            </Border>
        </Grid>

        <!-- Right: Editor for selected step -->
        <ScrollView Grid.Row="1"
                    Grid.Column="2"
                    VerticalScrollBarVisibility="Default">
            <VerticalStackLayout Spacing="12"
                                 Padding="8,6">
                <!-- Step editor (commands / conditions) -->
                <!-- FIX: bind IsVisible to parent VM using x:Reference so it hides when an action is selected -->
                <controls:EditStepView BindingContext="{Binding Editor}"
                                       IsVisible="{Binding Source={x:Reference ActionTreeRoot}, Path=BindingContext.Editor, Converter={StaticResource NullToBoolConverter}}" />

                <!-- Action editor with Initially Active checkbox -->
                <Border Padding="8"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{AppThemeBinding Light=#F3F3F3, Dark=#2A2A35}"
                        IsVisible="{Binding Source={x:Reference ActionTreeRoot}, Path=BindingContext.ActionEditor, Converter={StaticResource NullToBoolConverter}}">
                    <VerticalStackLayout BindingContext="{Binding ActionEditor}" Spacing="8">
                        <Label Text="Edit Action" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111111, Dark=#F0F0F4}" />
                        <Entry Text="{Binding Name, Mode=TwoWay}" Placeholder="Action name" />
                        
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="Trigger Event" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light=#111111, Dark=#F0F0F4}" WidthRequest="100" />
                            <Picker ItemsSource="{Binding Source={x:Reference ActionTreeRoot}, Path=BindingContext.AvailableTriggers}"
                                    SelectedItem="{Binding Trigger, Mode=TwoWay}"
                                    TextColor="{AppThemeBinding Light=#111111, Dark=#F0F0F4}"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#353545}"
                                    WidthRequest="220" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding Source={x:Reference ActionTreeRoot}, Path=BindingContext.IsInitiallyActiveVisible}">
                            <Label Text="Initially Active" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light=#111111, Dark=#F0F0F4}" WidthRequest="100" />
                            <CheckBox IsChecked="{Binding InitiallyActive, Mode=TwoWay}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>