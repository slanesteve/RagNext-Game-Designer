<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RagNext.Views.RoomEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RagNext.Views.Controls"
    xmlns:behaviors="clr-namespace:RagNext.Behaviors"
    xmlns:local="clr-namespace:RagNext.Views"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Title="Edit Room">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Clicked="OnSaveClicked" />
    </ContentPage.ToolbarItems>

    <controls:RightPaneLayout>
        <controls:RightPaneLayout.Main>
            <Grid>
                <ScrollView x:Name="MainScroll"
                            VerticalScrollBarVisibility="Always">
                    <ScrollView.Behaviors>
                        <behaviors:ScrollAwareBehavior x:Name="ScrollAwareRoom"/>
                        <behaviors:SuppressJumpScrollBehavior />
                    </ScrollView.Behaviors>
                    <VerticalStackLayout Padding="12" Spacing="10">
                        <Label Text="Name" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry x:Name="NameEntry" Text="{Binding Name}" Placeholder="Room name" Grid.Column="0" />
                            <Button Text="✨" Grid.Column="1" WidthRequest="28" HeightRequest="28" Padding="0"
                                    Clicked="OnAskAIClicked" CommandParameter="{x:Reference NameEntry}" />
                        </Grid>

                        <Label Text="Description" />
                        <Grid ColumnDefinitions="*,Auto">
                            <controls:SuggestiveEditor x:Name="DescriptionEditor" Text="{Binding Description, Mode=TwoWay}" Grid.Column="0" />
                            <Button Text="✨" Grid.Column="1" WidthRequest="28" HeightRequest="28" Padding="0"
                                    Clicked="OnAskAIClicked" CommandParameter="{x:Reference DescriptionEditor}" />
                        </Grid>

                        <Label Text="Portrait" FontAttributes="Bold" Margin="0,10,0,0" />
                        <Grid ColumnDefinitions="150,*" ColumnSpacing="12" VerticalOptions="Center">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 12" StrokeDashArray="4,4" Stroke="Gray" BackgroundColor="#F5F5F5" HeightRequest="150" WidthRequest="150" Padding="0" Loaded="OnPortraitBorderLoaded">
                                <Border.GestureRecognizers>
                                    <DropGestureRecognizer AllowDrop="True" Drop="OnPortraitDrop" DragOver="OnPortraitDragOver" />
                                </Border.GestureRecognizers>
                                <Grid>
                                    <!-- Drop Image Here Placeholder -->
                                    <VerticalStackLayout x:Name="PlaceholderLayout" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6" InputTransparent="True">
                                        <Label Text="🖼️" FontSize="36" HorizontalOptions="Center" />
                                        <Label Text="Drop Image Here" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                    
                                    <!-- Actual Image -->
                                    <Image x:Name="PortraitImage" Aspect="AspectFill" HeightRequest="150" WidthRequest="150" IsVisible="False" InputTransparent="True" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Label x:Name="PortraitFileNameLabel" Text="No image selected" FontSize="13" TextColor="DimGray" FontAttributes="Italic" LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button x:Name="ClearPortraitButton" Text="Clear Image" Clicked="OnClearPortraitClicked" FontSize="12" BackgroundColor="#E05B5B" TextColor="White" Padding="10,4" HeightRequest="30" IsVisible="False" />
                                    <Button Text="Generate with AI..." Clicked="OnGeneratePortraitClicked" FontSize="12" BackgroundColor="#5B93E0" TextColor="White" Padding="10,4" HeightRequest="30" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray400}" />

                        <!-- Exits & Navigation -->
                        <toolkit:Expander IsExpanded="True" x:Name="ExitsExpander">
                            <toolkit:Expander.Header>
                                <Grid ColumnDefinitions="*,Auto" Padding="0,10,0,10" BackgroundColor="Transparent">
                                    <Label Text="Exits &amp; Navigation" FontAttributes="Bold" FontSize="15" Grid.Column="0" VerticalOptions="Center" />
                                    <Label Text="▼" Grid.Column="1" VerticalOptions="Center" FontSize="12">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference ExitsExpander}, Path=IsExpanded}" Value="False">
                                                <Setter Property="Text" Value="▶" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </toolkit:Expander.Header>
                            <toolkit:Expander.Content>
                                <Grid x:Name="ExitsGrid"
                                      ColumnDefinitions="*, *"
                                      ColumnSpacing="12"
                                      RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto"
                                      RowSpacing="8">

                                    <!-- North (row 0 col 0) -->
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="North →" FontSize="12" TextColor="{DynamicResource Gray500}" />
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                            <Picker x:Name="NorthPicker" Title="(none)" Grid.Column="0"
                                                    ItemDisplayBinding="{Binding Name}" />
                                            <CheckBox x:Name="NorthOneWay" Grid.Column="1" ToolTipProperties.Text="One Way" />
                                        </Grid>
                                        <Label Text="One Way" FontSize="10" TextColor="{DynamicResource Gray400}" HorizontalOptions="End" />
                                    </VerticalStackLayout>

                                    <!-- South (row 0 col 1) -->
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <Label Text="South ←" FontSize="12" TextColor="{DynamicResource Gray500}" />
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                            <Picker x:Name="SouthPicker" Title="(none)" Grid.Column="0"
                                                    ItemDisplayBinding="{Binding Name}" />
                                            <CheckBox x:Name="SouthOneWay" Grid.Column="1" />
                                        </Grid>
                                        <Label Text="One Way" FontSize="10" TextColor="{DynamicResource Gray400}" HorizontalOptions="End" />
                                    </VerticalStackLayout>

                                    <!-- East (row 1 col 0) -->
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <Label Text="East ↴" FontSize="12" TextColor="{DynamicResource Gray500}" />
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                            <Picker x:Name="EastPicker" Title="(none)" Grid.Column="0"
                                                    ItemDisplayBinding="{Binding Name}" />
                                            <CheckBox x:Name="EastOneWay" Grid.Column="1" />
                                        </Grid>
                                        <Label Text="One Way" FontSize="10" TextColor="{DynamicResource Gray400}" HorizontalOptions="End" />
                                    </VerticalStackLayout>

                                    <!-- West (row 1 col 1) -->
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <Label Text="West ↳" FontSize="12" TextColor="{DynamicResource Gray500}" />
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                            <Picker x:Name="WestPicker" Title="(none)" Grid.Column="0"
                                                    ItemDisplayBinding="{Binding Name}" />
                                            <CheckBox x:Name="WestOneWay" Grid.Column="1" />
                                        </Grid>
                                        <Label Text="One Way" FontSize="10" TextColor="{DynamicResource Gray400}" HorizontalOptions="End" />
                                    </VerticalStackLayout>

                                    <!-- Northwest (row 2 col 0) -->
                                    <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="2">
                                        <Label Text="Northwest ↖" FontSize="12" TextColor="{DynamicResource Gray500}" />
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                            <Picker x:Name="NorthWestPicker" Title="(none)" Grid.Column="0"
                                                    ItemDisplayBinding="{Binding Name}" />
                                            <CheckBox x:Name="NorthWestOneWay" Grid.Column="1" />
                                        </Grid>
                                        <Label Text="One Way" FontSize="10" TextColor="{DynamicResource Gray400}" HorizontalOptions="End" />
                                    </VerticalStackLayout>

                                    <!-- Northeast (row 2 col 1) -->
                                    <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="2">
                                        <Label Text="Northeast ↗" FontSize="12" TextColor="{DynamicResource Gray500}" />
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                            <Picker x:Name="NorthEastPicker" Title="(none)" Grid.Column="0"
                                                    ItemDisplayBinding="{Binding Name}" />
                                            <CheckBox x:Name="NorthEastOneWay" Grid.Column="1" />
                                        </Grid>
                                        <Label Text="One Way" FontSize="10" TextColor="{DynamicResource Gray400}" HorizontalOptions="End" />
                                    </VerticalStackLayout>

                                    <!-- Southwest (row 3 col 0) -->
                                    <VerticalStackLayout Grid.Row="3" Grid.Column="0" Spacing="2">
                                        <Label Text="Southwest ↙" FontSize="12" TextColor="{DynamicResource Gray500}" />
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                            <Picker x:Name="SouthWestPicker" Title="(none)" Grid.Column="0"
                                                    ItemDisplayBinding="{Binding Name}" />
                                            <CheckBox x:Name="SouthWestOneWay" Grid.Column="1" />
                                        </Grid>
                                        <Label Text="One Way" FontSize="10" TextColor="{DynamicResource Gray400}" HorizontalOptions="End" />
                                    </VerticalStackLayout>

                                    <!-- Southeast (row 3 col 1) -->
                                    <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="2">
                                        <Label Text="Southeast ↘" FontSize="12" TextColor="{DynamicResource Gray500}" />
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                            <Picker x:Name="SouthEastPicker" Title="(none)" Grid.Column="0"
                                                    ItemDisplayBinding="{Binding Name}" />
                                            <CheckBox x:Name="SouthEastOneWay" Grid.Column="1" />
                                        </Grid>
                                        <Label Text="One Way" FontSize="10" TextColor="{DynamicResource Gray400}" HorizontalOptions="End" />
                                    </VerticalStackLayout>

                                    <!-- Up (row 4 col 0) -->
                                    <VerticalStackLayout Grid.Row="4" Grid.Column="0" Spacing="2">
                                        <Label Text="Up ▲" FontSize="12" TextColor="{DynamicResource Gray500}" />
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                            <Picker x:Name="UpPicker" Title="(none)" Grid.Column="0"
                                                    ItemDisplayBinding="{Binding Name}" />
                                            <CheckBox x:Name="UpOneWay" Grid.Column="1" />
                                        </Grid>
                                        <Label Text="One Way" FontSize="10" TextColor="{DynamicResource Gray400}" HorizontalOptions="End" />
                                    </VerticalStackLayout>

                                    <!-- Down (row 4 col 1) -->
                                    <VerticalStackLayout Grid.Row="4" Grid.Column="1" Spacing="2">
                                        <Label Text="Down ▼" FontSize="12" TextColor="{DynamicResource Gray500}" />
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                            <Picker x:Name="DownPicker" Title="(none)" Grid.Column="0"
                                                    ItemDisplayBinding="{Binding Name}" />
                                            <CheckBox x:Name="DownOneWay" Grid.Column="1" />
                                        </Grid>
                                        <Label Text="One Way" FontSize="10" TextColor="{DynamicResource Gray400}" HorizontalOptions="End" />
                                    </VerticalStackLayout>

                                    <!-- In (row 5 col 0) -->
                                    <VerticalStackLayout Grid.Row="5" Grid.Column="0" Spacing="2">
                                        <Label Text="In ↩" FontSize="12" TextColor="{DynamicResource Gray500}" />
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                            <Picker x:Name="InPicker" Title="(none)" Grid.Column="0"
                                                    ItemDisplayBinding="{Binding Name}" />
                                            <CheckBox x:Name="InOneWay" Grid.Column="1" />
                                        </Grid>
                                        <Label Text="One Way" FontSize="10" TextColor="{DynamicResource Gray400}" HorizontalOptions="End" />
                                    </VerticalStackLayout>

                                    <!-- Out (row 5 col 1) -->
                                    <VerticalStackLayout Grid.Row="5" Grid.Column="1" Spacing="2">
                                        <Label Text="Out ↪" FontSize="12" TextColor="{DynamicResource Gray500}" />
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                            <Picker x:Name="OutPicker" Title="(none)" Grid.Column="0"
                                                    ItemDisplayBinding="{Binding Name}" />
                                            <CheckBox x:Name="OutOneWay" Grid.Column="1" />
                                        </Grid>
                                        <Label Text="One Way" FontSize="10" TextColor="{DynamicResource Gray400}" HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </toolkit:Expander.Content>
                        </toolkit:Expander>

                        <toolkit:Expander IsExpanded="True" x:Name="AttrsExpander">
                            <toolkit:Expander.Header>
                                <Grid ColumnDefinitions="*,Auto" Padding="0,10,0,10" BackgroundColor="Transparent">
                                    <Label Text="Attributes" FontAttributes="Bold" FontSize="15" Grid.Column="0" VerticalOptions="Center" />
                                    <Label Text="▼" Grid.Column="1" VerticalOptions="Center" FontSize="12">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference AttrsExpander}, Path=IsExpanded}" Value="False">
                                                <Setter Property="Text" Value="▶" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </toolkit:Expander.Header>
                            <toolkit:Expander.Content>
                                <VerticalStackLayout Spacing="8">
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Text="Add" Clicked="OnAddAttributeClicked" />
                                        <Button Text="Remove" Clicked="OnRemoveAttributeClicked" />
                                    </HorizontalStackLayout>
                                    <CollectionView x:Name="AttributesList"
                                                    ItemsSource="{Binding Attributes}"
                                                    SelectionMode="Single"
                                                    HeightRequest="220">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="6" ColumnSpacing="8" ColumnDefinitions="*,*">
                                                    <Grid ColumnDefinitions="*,Auto" Grid.Column="0">
                                                        <Entry x:Name="AttrNameEntry" Placeholder="Name" Text="{Binding Name}" Grid.Column="0" />
                                                        <Button Grid.Column="1"
                                                                Text="✨"
                                                                WidthRequest="28"
                                                                HeightRequest="28"
                                                                Padding="0"
                                                                Clicked="OnAskAIClicked"
                                                                CommandParameter="{x:Reference AttrNameEntry}" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,Auto" Grid.Column="1">
                                                        <Entry x:Name="AttrValueEntry" Placeholder="Value" Text="{Binding Value}" Grid.Column="0" />
                                                        <Button Grid.Column="1"
                                                                Text="✨"
                                                                WidthRequest="28"
                                                                HeightRequest="28"
                                                                Padding="0"
                                                                Clicked="OnAskAIClicked"
                                                                CommandParameter="{x:Reference AttrValueEntry}" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>
                            </toolkit:Expander.Content>
                        </toolkit:Expander>

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray400}" />

                        <toolkit:Expander IsExpanded="True" x:Name="ObjectsExpander">
                            <toolkit:Expander.Header>
                                <Grid ColumnDefinitions="*,Auto" Padding="0,10,0,10" BackgroundColor="Transparent">
                                    <Label Text="Room Objects" FontAttributes="Bold" FontSize="15" Grid.Column="0" VerticalOptions="Center" />
                                    <Label Text="▼" Grid.Column="1" VerticalOptions="Center" FontSize="12">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference ObjectsExpander}, Path=IsExpanded}" Value="False">
                                                <Setter Property="Text" Value="▶" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </toolkit:Expander.Header>
                            <toolkit:Expander.Content>
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Select Objects in this Room:" FontAttributes="Bold" Margin="0,5,0,0" />
                                    <CollectionView x:Name="ObjectsCheckList" HeightRequest="180">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="local:RoomEditPage+ObjectCheckItem">
                                                <Grid Padding="6" ColumnDefinitions="Auto,*">
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Grid.Column="0" CheckedChanged="OnRoomObjectCheckedChanged" />
                                                    <Label Text="{Binding Name}" VerticalOptions="Center" Grid.Column="1" Margin="8,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>
                            </toolkit:Expander.Content>
                        </toolkit:Expander>

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray400}" />

                        <!-- Actions -->
                        <toolkit:Expander IsExpanded="True" x:Name="ActionsExpander">
                            <toolkit:Expander.Header>
                                <Grid ColumnDefinitions="*,Auto" Padding="0,10,0,10" BackgroundColor="Transparent">
                                    <Label Text="Actions &amp; Events" FontAttributes="Bold" FontSize="15" Grid.Column="0" VerticalOptions="Center" />
                                    <Label Text="▼" Grid.Column="1" VerticalOptions="Center" FontSize="12">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference ActionsExpander}, Path=IsExpanded}" Value="False">
                                                <Setter Property="Text" Value="▶" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </toolkit:Expander.Header>
                            <toolkit:Expander.Content>
                                <controls:ActionTreeView Room="{Binding .}" />
                            </toolkit:Expander.Content>
                        </toolkit:Expander>
                    </VerticalStackLayout>
                </ScrollView>

                <Border InputTransparent="True"
                        IsVisible="{Binding Source={x:Reference ScrollAwareRoom}, Path=HasMoreAbove}"
                        Background="{AppThemeBinding Light={StaticResource TopFadeLight}, Dark={StaticResource TopFadeDark}}"
                        HeightRequest="32"
                        HorizontalOptions="Fill"
                        VerticalOptions="Start">
                    <Label Text="▲" HorizontalOptions="Center" VerticalOptions="Center" FontSize="12" Opacity="0.6"/>
                </Border>

                <Border InputTransparent="True"
                        IsVisible="{Binding Source={x:Reference ScrollAwareRoom}, Path=HasMoreBelow}"
                        Background="{AppThemeBinding Light={StaticResource BottomFadeLight}, Dark={StaticResource BottomFadeDark}}"
                        HeightRequest="40"
                        HorizontalOptions="Fill"
                        VerticalOptions="End">
                    <Label Text="Scroll for more ▼" HorizontalOptions="Center" VerticalOptions="Center" FontSize="12" Opacity="0.7"/>
                </Border>
            </Grid>
        </controls:RightPaneLayout.Main>
    </controls:RightPaneLayout>
</ContentPage>