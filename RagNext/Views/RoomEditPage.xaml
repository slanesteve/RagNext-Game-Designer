<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RagNext.Views.RoomEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RagNext.Views.Controls"
    Title="Edit Room">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Clicked="OnSaveClicked" />
        <ToolbarItem Text="Cancel" Clicked="OnCancelClicked" Priority="1" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="10">
            <Label Text="Name" />
            <Grid ColumnDefinitions="*,Auto">
                <Entry x:Name="NameEntry" Text="{Binding Name}" Placeholder="Room name" Grid.Column="0" />
                <Button Text="✨" Grid.Column="1" WidthRequest="28" HeightRequest="28" Padding="0"
                        Clicked="OnAskAIClicked" CommandParameter="{x:Reference NameEntry}" />
            </Grid>

            <Label Text="Description" />
            <Grid ColumnDefinitions="*,Auto">
                <Editor x:Name="DescriptionEditor" Text="{Binding Description}" HeightRequest="150" Grid.Column="0" />
                <Button Text="✨" Grid.Column="1" WidthRequest="28" HeightRequest="28" Padding="0"
                        Clicked="OnAskAIClicked" CommandParameter="{x:Reference DescriptionEditor}" />
            </Grid>

            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray400}" />

            <!-- Actions -->
            <controls:ActionTreeView Room="{Binding .}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>