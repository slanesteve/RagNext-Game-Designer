<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="RagNext.Views.Popups.LoadGamePopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="True">

    <Border Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2E2E3C}" 
            StrokeThickness="1" 
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E28}"
            StrokeShape="RoundRectangle 16" 
            WidthRequest="420" 
            HeightRequest="460" 
            Padding="20">
        <Border.Shadow>
            <Shadow Radius="15" Opacity="0.5" Brush="Black" Offset="0,8"/>
        </Border.Shadow>

        <Grid RowDefinitions="Auto, *, Auto" RowSpacing="16">

            <!-- Header -->
            <VerticalStackLayout Grid.Row="0" Spacing="4">
                <Label Text="📂 Select Saved Game"
                       FontSize="18" 
                       FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}"
                       HorizontalOptions="Center" />
                <Label Text="Click a game to load it, or tap the trashcan to clean up."
                       FontSize="11" 
                       TextColor="Gray" 
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Saves List -->
            <CollectionView Grid.Row="1" x:Name="SavesCollectionView" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Stroke="Transparent"
                                BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#252530}"
                                StrokeShape="RoundRectangle 8"
                                Margin="0,4"
                                Padding="12,8">
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                <Label Grid.Column="0" 
                                       Text="{Binding .}" 
                                       FontSize="14" 
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSaveTapped" CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                
                                <ImageButton Grid.Column="1"
                                             WidthRequest="32"
                                             HeightRequest="32"
                                             Padding="4"
                                             VerticalOptions="Center"
                                             BackgroundColor="Transparent"
                                             Clicked="OnDeleteClicked"
                                             CommandParameter="{Binding .}">
                                    <ImageButton.Source>
                                        <FontImageSource Glyph="🗑️" Color="#E05B5B" Size="16" />
                                    </ImageButton.Source>
                                </ImageButton>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                
                <CollectionView.EmptyView>
                    <Label Text="No saved games found." 
                           TextColor="Gray"
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" />
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- Bottom Actions -->
            <Button Grid.Row="2" 
                    Text="Cancel" 
                    Clicked="OnCancelClicked"
                    BackgroundColor="#444444" 
                    TextColor="White"
                    CornerRadius="8" 
                    HeightRequest="40" 
                    HorizontalOptions="Fill" />

        </Grid>
    </Border>
</toolkit:Popup>
