<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="RagNext.Views.Popups.AIImagePromptPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="False">
    <Border Stroke="{DynamicResource Gray300}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light={DynamicResource White}, Dark={DynamicResource OffBlack}}" StrokeShape="RoundRectangle 8">
        <VerticalStackLayout Padding="16" Spacing="12" WidthRequest="440" MaximumWidthRequest="600">
            <Label x:Name="TitleLabel" FontAttributes="Bold" FontSize="Medium" />
            
            <Label Text="Enter a prompt for the image:" FontSize="Small" TextColor="{DynamicResource Gray600}" />
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                <Editor x:Name="PromptEditor"
                        Grid.Column="0"
                        AutoSize="TextChanges"
                        Placeholder="Type your prompt..."
                        HeightRequest="100" />
                <Button Grid.Column="1"
                        Text="✨"
                        WidthRequest="32"
                        HeightRequest="32"
                        Padding="0"
                        VerticalOptions="Center"
                        Clicked="OnAskAIClicked" />
            </Grid>
            
            <Label Text="Select Image Size:" FontSize="Small" TextColor="{DynamicResource Gray600}" />
            <Picker x:Name="SizePicker">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>480 x 480</x:String>
                        <x:String>720 x 720</x:String>
                        <x:String>1024 x 1024</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <HorizontalStackLayout HorizontalOptions="End" Spacing="12" Margin="0,8,0,0">
                <Button Text="Cancel" Clicked="OnCancelClicked" />
                <Button Text="Generate" Clicked="OnOkClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
