<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="RagNext.Views.Popups.PublishGamePopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E"
            StrokeShape="RoundRectangle 16" WidthRequest="580" Padding="28">
        <Border.Shadow>
            <Shadow Radius="20" Opacity="0.7" Brush="Black" Offset="0,10"/>
        </Border.Shadow>

        <VerticalStackLayout Spacing="18">

            <!-- ── Header ──────────────────────────────────────────────── -->
            <VerticalStackLayout Spacing="4">
                <Label Text="🚀 Publish Game"
                       FontSize="22" FontAttributes="Bold" TextColor="#FFFFFF"
                       HorizontalOptions="Center" />
                <Label Text="Create a branded, standalone game your players can run with a double-click."
                       FontSize="12" TextColor="#A0A0A0" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- ── Metadata ─────────────────────────────────────────────── -->
            <VerticalStackLayout Spacing="6">
                <Label Text="GAME DETAILS" FontSize="11" FontAttributes="Bold"
                       TextColor="#00BFFF" CharacterSpacing="2" />
                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto"
                      ColumnSpacing="12" RowSpacing="8">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                        <Label Text="Title" FontSize="11" TextColor="#A0A0A0" />
                        <Entry x:Name="TitleEntry" BackgroundColor="#2D2D2D"
                               TextColor="#FFFFFF" HeightRequest="40" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                        <Label Text="Author" FontSize="11" TextColor="#A0A0A0" />
                        <Entry x:Name="AuthorEntry" BackgroundColor="#2D2D2D"
                               TextColor="#FFFFFF" HeightRequest="40" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                        <Label Text="Version" FontSize="11" TextColor="#A0A0A0" />
                        <Entry x:Name="VersionEntry" BackgroundColor="#2D2D2D"
                               TextColor="#FFFFFF" HeightRequest="40" />
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>

            <!-- ── Platform Picker ─────────────────────────────────────── -->
            <VerticalStackLayout Spacing="8">
                <Label Text="TARGET PLATFORM" FontSize="11" FontAttributes="Bold"
                       TextColor="#00BFFF" CharacterSpacing="2" />

                <!-- Platform cards grid -->
                <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="8"
                      x:Name="PlatformGrid">

                    <Border x:Name="WinCard" Grid.Column="0"
                            BackgroundColor="#252525" StrokeThickness="2"
                            Stroke="#00BFFF" StrokeShape="RoundRectangle 8"
                            Padding="8,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPlatformCardTapped" CommandParameter="0" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label Text="🪟" FontSize="24" HorizontalOptions="Center" />
                            <Label Text="Windows" FontSize="11" FontAttributes="Bold"
                                   TextColor="#FFFFFF" HorizontalOptions="Center" />
                            <Label x:Name="WinStatus" FontSize="9" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="MacCard" Grid.Column="1"
                            BackgroundColor="#1E1E1E" StrokeThickness="1"
                            Stroke="#444444" StrokeShape="RoundRectangle 8"
                            Padding="8,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPlatformCardTapped" CommandParameter="1" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label Text="🍎" FontSize="24" HorizontalOptions="Center" />
                            <Label Text="macOS" FontSize="11" FontAttributes="Bold"
                                   TextColor="#FFFFFF" HorizontalOptions="Center" />
                            <Label x:Name="MacStatus" FontSize="9" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="LinuxCard" Grid.Column="2"
                            BackgroundColor="#1E1E1E" StrokeThickness="1"
                            Stroke="#444444" StrokeShape="RoundRectangle 8"
                            Padding="8,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPlatformCardTapped" CommandParameter="2" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label Text="🐧" FontSize="24" HorizontalOptions="Center" />
                            <Label Text="Linux" FontSize="11" FontAttributes="Bold"
                                   TextColor="#FFFFFF" HorizontalOptions="Center" />
                            <Label x:Name="LinuxStatus" FontSize="9" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="WebGLCard" Grid.Column="3"
                            BackgroundColor="#1E1E1E" StrokeThickness="1"
                            Stroke="#444444" StrokeShape="RoundRectangle 8"
                            Padding="8,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPlatformCardTapped" CommandParameter="3" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label Text="🌐" FontSize="24" HorizontalOptions="Center" />
                            <Label Text="WebGL" FontSize="11" FontAttributes="Bold"
                                   TextColor="#FFFFFF" HorizontalOptions="Center" />
                            <Label x:Name="WebGLStatus" FontSize="9" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Template missing hint -->
                <Label x:Name="TemplateMissingLabel"
                       Text="⚠️ Template not found for this platform. Build the Unity shell player and copy it to Templates/{Platform}/ next to the Designer."
                       FontSize="11" TextColor="#FF8C00"
                       IsVisible="False" />
            </VerticalStackLayout>

            <!-- ── Output Path ──────────────────────────────────────────── -->
            <VerticalStackLayout Spacing="6">
                <Label Text="OUTPUT FOLDER" FontSize="11" FontAttributes="Bold"
                       TextColor="#00BFFF" CharacterSpacing="2" />
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                    <Entry x:Name="DestinationEntry" Grid.Column="0"
                           BackgroundColor="#2D2D2D" TextColor="#FFFFFF"
                           HeightRequest="40" Placeholder="Select output folder..."
                           PlaceholderColor="#666666" />
                    <Button Text="Browse…" Grid.Column="1"
                            Clicked="OnBrowseClicked"
                            BackgroundColor="#3A3A3A" TextColor="#FFFFFF"
                            HeightRequest="40" Padding="12,0" />
                </Grid>
                <CheckBox x:Name="CreateZipCheck" Color="#00BFFF" IsChecked="True" />
                <Label Text="Create ZIP for distribution (upload to itch.io, share with playtesters)"
                       FontSize="11" TextColor="#A0A0A0" Margin="-4,0,0,0" />
            </VerticalStackLayout>

            <!-- ── Game Summary ─────────────────────────────────────────── -->
            <Border BackgroundColor="#252525" Stroke="#333333" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" Padding="12,10">
                <Label x:Name="SummaryLabel" FontSize="12" TextColor="#888888" />
            </Border>

            <!-- ── Progress Log ─────────────────────────────────────────── -->
            <VerticalStackLayout x:Name="ProgressSection" IsVisible="False" Spacing="6">
                <BoxView HeightRequest="1" Color="#333333" />
                <ScrollView x:Name="ProgressScroll" HeightRequest="100">
                    <VerticalStackLayout x:Name="ProgressLog" Spacing="2" />
                </ScrollView>
                <ActivityIndicator x:Name="PublishSpinner" IsRunning="False"
                                   Color="#00FA9A" HeightRequest="24" />
            </VerticalStackLayout>

            <!-- ── Buttons ──────────────────────────────────────────────── -->
            <HorizontalStackLayout HorizontalOptions="End" Spacing="12" Margin="0,6,0,0">
                <Button Text="Cancel" Clicked="OnCancelClicked"
                        BackgroundColor="#444444" TextColor="#FFFFFF"
                        WidthRequest="100" CornerRadius="8" HeightRequest="42" />
                <Button x:Name="PublishBtn" Text="🚀  Publish" Clicked="OnPublishClicked"
                        BackgroundColor="#107C41" TextColor="#FFFFFF"
                        WidthRequest="130" CornerRadius="8" HeightRequest="42"
                        FontAttributes="Bold" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
