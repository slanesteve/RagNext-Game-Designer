<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="RagNext.Views.Popups.PublishGamePopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 16" WidthRequest="550" Padding="24">
        <Border.Shadow>
            <Shadow Radius="15" Opacity="0.6" Brush="Black" Offset="0,8"/>
        </Border.Shadow>

        <VerticalStackLayout Spacing="16">
            <!-- Header Section -->
            <Label Text="Publish Standalone Adventure" FontSize="22" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" />
            <Label Text="Compile and bundle your interactive story into an optimized distribution package." FontSize="13" TextColor="#A0A0A0" HorizontalTextAlignment="Center" Margin="0,0,0,10" />

            <!-- Target Platform -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Target Platform" FontSize="14" FontAttributes="Bold" TextColor="#00BFFF" />
                <Picker x:Name="PlatformPicker" BackgroundColor="#2D2D2D" TitleColor="#808080" TextColor="#FFFFFF" SelectedIndex="0">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Windows Desktop (Standalone Executable)</x:String>
                            <x:String>macOS Desktop (Standalone Executable)</x:String>
                            <x:String>Universal Mobile/Hub Package (.rag)</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </VerticalStackLayout>

            <!-- Metadata Info -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Game Metadata" FontSize="14" FontAttributes="Bold" TextColor="#00BFFF" />
                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="8">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                        <Label Text="Game Title" FontSize="11" TextColor="#A0A0A0" />
                        <Entry x:Name="TitleEntry" BackgroundColor="#2D2D2D" TextColor="#FFFFFF" HeightRequest="40" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                        <Label Text="Author" FontSize="11" TextColor="#A0A0A0" />
                        <Entry x:Name="AuthorEntry" BackgroundColor="#2D2D2D" TextColor="#FFFFFF" HeightRequest="40" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                        <Label Text="Version" FontSize="11" TextColor="#A0A0A0" />
                        <Entry x:Name="VersionEntry" BackgroundColor="#2D2D2D" TextColor="#FFFFFF" HeightRequest="40" />
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>

            <!-- Export Path -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Export Destination" FontSize="14" FontAttributes="Bold" TextColor="#00BFFF" />
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                    <Entry x:Name="DestinationEntry" Grid.Column="0" BackgroundColor="#2D2D2D" TextColor="#FFFFFF" HeightRequest="40" Placeholder="Select path..." PlaceholderColor="#666666" />
                    <Button Text="Browse..." Grid.Column="1" Clicked="OnBrowseClicked" BackgroundColor="#3A3A3A" TextColor="#FFFFFF" HeightRequest="40" Padding="12,0" />
                </Grid>
            </VerticalStackLayout>

            <!-- Progress Overlay / Feedback -->
            <VerticalStackLayout x:Name="ProgressSection" IsVisible="False" Spacing="8" Margin="0,10,0,0">
                <ActivityIndicator x:Name="PublishSpinner" IsRunning="False" Color="#00FA9A" HeightRequest="30" />
                <Label x:Name="ProgressStatusLabel" Text="Publishing..." FontSize="12" TextColor="#00FA9A" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Control Buttons -->
            <HorizontalStackLayout HorizontalOptions="End" Spacing="12" Margin="0,15,0,0">
                <Button Text="Cancel" Clicked="OnCancelClicked" BackgroundColor="#444444" TextColor="#FFFFFF" WidthRequest="100" CornerRadius="8" HeightRequest="40" />
                <Button x:Name="PublishBtn" Text="Publish" Clicked="OnPublishClicked" BackgroundColor="#107C41" TextColor="#FFFFFF" WidthRequest="120" CornerRadius="8" HeightRequest="40" FontAttributes="Bold" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
