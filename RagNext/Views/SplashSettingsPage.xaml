<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RagNext.Views.Controls"
             x:Class="RagNext.Views.SplashSettingsPage"
             Title="Game Splash Screen"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Clicked="OnSaveClicked" />
    </ContentPage.ToolbarItems>

    <controls:RightPaneLayout>
        <controls:RightPaneLayout.Main>
            <ScrollView>
                <Grid ColumnDefinitions="*, *" ColumnSpacing="24" Padding="24">
                    <!-- LEFT COLUMN: Configurations Editor Form -->
                    <VerticalStackLayout Grid.Column="0" Spacing="16">
                        <!-- Header Banner -->
                        <VerticalStackLayout Margin="0,0,0,8">
                            <Label Text="Game Splash Screen" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            <Label Text="Configure cinematic transitions for players launching your game." FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>

                        <!-- Card 1: Enable & Mode Toggles -->
                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Padding="16">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Active Setup" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}" />
                                
                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                    <VerticalStackLayout>
                                        <Label Text="Enable Custom Splash Screen" FontAttributes="Bold" FontSize="13" />
                                        <Label Text="Play custom cinematic sequence upon launching game in Unity." FontSize="11" TextColor="Gray" />
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="1" x:Name="EnabledSwitch" Toggled="OnEnabledToggled" />
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center" Margin="0,8,0,0">
                                    <VerticalStackLayout>
                                        <Label Text="Splash Mode" FontAttributes="Bold" FontSize="13" />
                                        <Label Text="Select static image layout or video playback." FontSize="11" TextColor="Gray" />
                                    </VerticalStackLayout>
                                    <Picker Grid.Column="1" x:Name="ModePicker" WidthRequest="150" SelectedIndexChanged="OnModeChanged">
                                        <Picker.Items>
                                            <x:String>ImageAndText</x:String>
                                            <x:String>Video</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Card 2: Image & Text Styling (conditional) -->
                        <Border x:Name="ImageTextStylingCard" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Padding="16">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Cinematic Customization" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}" />

                                <!-- Background Picker -->
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Background Image Asset" FontSize="12" FontAttributes="Bold" TextColor="Gray" />
                                    <Picker x:Name="BgImagePicker" Title="-- None / Black Background --" SelectedIndexChanged="OnBgImageChanged" />
                                </VerticalStackLayout>

                                <!-- Audio Picker -->
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Dramatic Sound Effect / Music" FontSize="12" FontAttributes="Bold" TextColor="Gray" />
                                    <Picker x:Name="AudioPicker" Title="-- None / Silence --" SelectedIndexChanged="OnAudioChanged" />
                                </VerticalStackLayout>

                                <!-- Transition Picker -->
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Transition Style Effect" FontSize="12" FontAttributes="Bold" TextColor="Gray" />
                                    <Picker x:Name="TransitionPicker" SelectedIndexChanged="OnTransitionChanged">
                                        <Picker.Items>
                                            <x:String>Fade</x:String>
                                            <x:String>Rise</x:String>
                                            <x:String>Cinematic</x:String>
                                            <x:String>Glitch</x:String>
                                            <x:String>Exposure</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </VerticalStackLayout>

                                <!-- Custom Overlay Title -->
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Display Title Text" FontSize="12" FontAttributes="Bold" TextColor="Gray" />
                                    <Entry x:Name="TitleEntry" Placeholder="Adventure Awaits..." TextChanged="OnTitleTextChanged" />
                                </VerticalStackLayout>

                                <!-- Font Customizer Grid -->
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="Font Size" FontSize="12" FontAttributes="Bold" TextColor="Gray" />
                                        <Entry x:Name="FontSizeEntry" Keyboard="Numeric" TextChanged="OnFontSizeChanged" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Font Color (Hex)" FontSize="12" FontAttributes="Bold" TextColor="Gray" />
                                        <Entry x:Name="FontColorEntry" Placeholder="#FFFFFF" TextChanged="OnFontColorChanged" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Card 3: Video Mode Configuration (conditional) -->
                        <Border x:Name="VideoStylingCard" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Padding="16" IsVisible="False">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Video Configuration" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}" />
                                
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Video Asset (MP4/WebM)" FontSize="12" FontAttributes="Bold" TextColor="Gray" />
                                    <Picker x:Name="VideoPicker" Title="-- Choose Video --" SelectedIndexChanged="OnVideoChanged" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Card 4: Animation Timings -->
                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Padding="16">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Animation Timeline (Seconds)" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}" />

                                <!-- Fade In -->
                                <Grid ColumnDefinitions="*, 80" RowDefinitions="Auto, Auto" RowSpacing="2">
                                    <Label Grid.Row="0" Text="Fade-in Duration" FontSize="12" FontAttributes="Bold" TextColor="Gray" />
                                    <Slider Grid.Row="1" x:Name="FadeInSlider" Minimum="0" Maximum="5" ValueChanged="OnTimingChanged" />
                                    <Label Grid.Row="1" Grid.Column="1" x:Name="FadeInValLabel" HorizontalOptions="Center" VerticalOptions="Center" FontSize="12" />
                                </Grid>

                                <!-- Display Duration -->
                                <Grid ColumnDefinitions="*, 80" RowDefinitions="Auto, Auto" RowSpacing="2">
                                    <Label Grid.Row="0" Text="Hold/Display Duration" FontSize="12" FontAttributes="Bold" TextColor="Gray" />
                                    <Slider Grid.Row="1" x:Name="DisplaySlider" Minimum="0" Maximum="8" ValueChanged="OnTimingChanged" />
                                    <Label Grid.Row="1" Grid.Column="1" x:Name="DisplayValLabel" HorizontalOptions="Center" VerticalOptions="Center" FontSize="12" />
                                </Grid>

                                <!-- Fade Out -->
                                <Grid ColumnDefinitions="*, 80" RowDefinitions="Auto, Auto" RowSpacing="2">
                                    <Label Grid.Row="0" Text="Fade-out Duration" FontSize="12" FontAttributes="Bold" TextColor="Gray" />
                                    <Slider Grid.Row="1" x:Name="FadeOutSlider" Minimum="0" Maximum="5" ValueChanged="OnTimingChanged" />
                                    <Label Grid.Row="1" Grid.Column="1" x:Name="FadeOutValLabel" HorizontalOptions="Center" VerticalOptions="Center" FontSize="12" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- RIGHT COLUMN: WYSIWYG Live Preview Panel -->
                    <VerticalStackLayout Grid.Column="1" Spacing="16" VerticalOptions="Center">
                        <VerticalStackLayout>
                            <Label Text="Live WYSIWYG Screen Coordinates" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            <Label Text="Drag the Title Text inside the 16:9 screen frame below to adjust alignment coordinates dynamically." FontSize="11" TextColor="Gray" />
                            <HorizontalStackLayout Spacing="16" Margin="0,4,0,0">
                                <Label x:Name="XCoordinateLabel" Text="X: 50%" FontAttributes="Bold" TextColor="#7752FE" FontSize="12" />
                                <Label x:Name="YCoordinateLabel" Text="Y: 50%" FontAttributes="Bold" TextColor="#7752FE" FontSize="12" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- 16:9 Premium Visual Preview Canvas -->
                        <Border StrokeShape="RoundRectangle 16" StrokeThickness="2" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2E2E3C}" BackgroundColor="Black" HeightRequest="315" WidthRequest="560" HorizontalOptions="Center" VerticalOptions="Center">
                            <Grid x:Name="PreviewCanvas" WidthRequest="560" HeightRequest="315">
                                <!-- Background image placeholder -->
                                <Image x:Name="PreviewBgImage" Aspect="AspectFill" InputTransparent="True" />
                                
                                <!-- Overlay darkness to fit game screen aesthetic -->
                                <BoxView Color="Black" Opacity="0.45" InputTransparent="True" />

                                <!-- Floating WYSIWYG Text Layer (Draggable with Word Wrapping!) -->
                                <Label x:Name="PreviewLabel"
                                       Text="My Adventure"
                                       TextColor="White"
                                       FontSize="28"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Start"
                                       VerticalOptions="Start"
                                       LineBreakMode="WordWrap"
                                       MaxLines="3"
                                       WidthRequest="350"
                                       HorizontalTextAlignment="Center"
                                       TranslationX="105"
                                       TranslationY="120">
                                    <Label.GestureRecognizers>
                                        <PanGestureRecognizer PanUpdated="OnTextPanUpdated" />
                                    </Label.GestureRecognizers>
                                </Label>

                                <!-- Dynamic Video mode overlay mask -->
                                <Border x:Name="PreviewVideoMask" StrokeShape="RoundRectangle 12" BackgroundColor="#D814141E" IsVisible="False" Margin="24">
                                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="🎬 Video Playback Active" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" />
                                        <Label Text="The player will launch full screen video natively." FontSize="11" TextColor="Gray" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </Border>
                        
                        <Button Text="Preview Transition Sequence" Clicked="OnPreviewTransitionClicked" BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" TextColor="{AppThemeBinding Light=#4A5568, Dark=#E2E8F0}" CornerRadius="8" HeightRequest="36" WidthRequest="220" HorizontalOptions="Center" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </controls:RightPaneLayout.Main>
    </controls:RightPaneLayout>
</ContentPage>
