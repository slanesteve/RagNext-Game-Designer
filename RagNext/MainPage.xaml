<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RagNext"
             xmlns:controls="clr-namespace:RagNext.Views.Controls"
             x:Class="RagNext.MainPage"
             Title="Game Editor">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Clicked="OnSaveClicked" />
    </ContentPage.ToolbarItems>



    <Grid>
        <controls:RightPaneLayout>
            <controls:RightPaneLayout.Main>
                <ScrollView>
                    <VerticalStackLayout Padding="30,20" Spacing="16">
                        <!-- Prestigious RagNext Branding -->
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,10,0,20">
                            <Border StrokeShape="RoundRectangle 24" StrokeThickness="0" WidthRequest="90" HeightRequest="90">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#8E2DE2" Offset="0.0" />
                                        <GradientStop Color="#4A00E0" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Shadow>
                                    <Shadow Radius="10" Opacity="0.4" Brush="#4A00E0" Offset="0,4" />
                                </Border.Shadow>
                                <Label Text="RN" FontSize="38" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="RAGNEXT" FontSize="28" FontAttributes="Bold" CharacterSpacing="3" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" HorizontalOptions="Center" Margin="0,8,0,0" />
                            <Label Text="PREMIUM STORY ENGINE &amp; RPG DESIGNER" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" TextColor="Gray" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <!-- Main Card Panel -->
                        <Border StrokeShape="RoundRectangle 16" 
                                StrokeThickness="1" 
                                Stroke="{AppThemeBinding Light=#E5E8F0, Dark=#2A2A35}" 
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A22}" 
                                Padding="24" 
                                Margin="0,10,0,10">
                            <Border.Shadow>
                                <Shadow Radius="16" Opacity="{AppThemeBinding Light=0.06, Dark=0.25}" Brush="Black" Offset="0,6" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="16">
                                <!-- Title Field -->
                                <VerticalStackLayout Spacing="6">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="📝" FontSize="14" VerticalTextAlignment="Center" />
                                        <Label Text="Game Title" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}" />
                                    </HorizontalStackLayout>
                                    <Entry Text="{Binding GameTitle, Mode=TwoWay}" 
                                           Placeholder="Enter game title"
                                           HeightRequest="42"
                                           FontSize="13"
                                           Margin="0,2,0,0" />
                                </VerticalStackLayout>

                                <!-- Author Field -->
                                <VerticalStackLayout Spacing="6">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="👤" FontSize="14" VerticalTextAlignment="Center" />
                                        <Label Text="Author Name" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}" />
                                    </HorizontalStackLayout>
                                    <Entry Text="{Binding GameAuthor, Mode=TwoWay}" 
                                           Placeholder="Enter author name"
                                           HeightRequest="42"
                                           FontSize="13"
                                           Margin="0,2,0,0" />
                                </VerticalStackLayout>

                                <!-- Version Field -->
                                <VerticalStackLayout Spacing="6">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="🏷️" FontSize="14" VerticalTextAlignment="Center" />
                                        <Label Text="Game Version" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}" />
                                    </HorizontalStackLayout>
                                    <Entry Text="{Binding GameVersion, Mode=TwoWay}" 
                                           Placeholder="e.g. 1.0.0"
                                           HeightRequest="42"
                                           FontSize="13"
                                           Margin="0,2,0,0" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <HorizontalStackLayout Spacing="12" HorizontalOptions="Fill">
                            <Button x:Name="CounterBtn" Text="Current Game: None" HorizontalOptions="StartAndExpand" />
                            <Button x:Name="Savebtn" Text="Save Game" Clicked="OnSaveClicked"
                                    SemanticProperties.Hint="Saves the game" HorizontalOptions="End" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </controls:RightPaneLayout.Main>
        </controls:RightPaneLayout>

        <Grid x:Name="StartupOverlayView" BackgroundColor="#A0000000" IsVisible="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackgroundTapped" />
            </Grid.GestureRecognizers>
            <Border VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="400" Padding="24" BackgroundColor="White" StrokeShape="RoundRectangle 12" InputTransparent="False">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDialogTapped" />
                </Border.GestureRecognizers>
                <Border.Shadow>
                    <Shadow Radius="15" Opacity="0.5" Brush="Black" Offset="0,6"/>
                </Border.Shadow>

                <Grid>
                    <VerticalStackLayout x:Name="WelcomeOptionsView" Spacing="16" HorizontalOptions="Center" IsVisible="True">
                        <Label Text="Welcome to RagNext Designer" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="0,0,0,10"/>
                        <Button Text="Create New Game" Clicked="OnOverlayCreateClicked" BackgroundColor="#512BD4" TextColor="White" HeightRequest="45" WidthRequest="250"/>
                        <Button Text="Load Saved Game" Clicked="OnOverlayLoadClicked" BackgroundColor="#512BD4" TextColor="White" HeightRequest="45" WidthRequest="250"/>
                        <Button Text="Load Last Workspace" Clicked="OnOverlayDefaultClicked" BackgroundColor="#E0E0E0" TextColor="Black" HeightRequest="45" WidthRequest="250"/>
                        <Button Text="Cancel" Clicked="OnCancelOverlayClicked" BackgroundColor="#7f8c8d" TextColor="White" HeightRequest="45" WidthRequest="250"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="InlineSavePickerView" Spacing="16" HorizontalOptions="Center" IsVisible="False">
                        <Label Text="Select a Saved Project" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="0,0,0,10"/>

                        <CollectionView x:Name="SavesCollectionView" SelectionMode="Single" HeightRequest="200" SelectionChanged="OnSaveSelectionChanged">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10">
                                        <Label Text="{Binding .}" FontSize="16" VerticalOptions="Center" TextColor="Black"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button Text="Cancel" Clicked="OnCloseSavePickerClicked" BackgroundColor="#E0E0E0" TextColor="Black" WidthRequest="200" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>