<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RagNext"
             x:Class="RagNext.MainPage"
             Title="Game Editor">
    <!-- Toolbar (single entry that opens a full menu) -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="File" Clicked="OnFileMenuClicked" />
        <ToolbarItem Text="Edit" Clicked="OnEditMenuClicked" />
        <ToolbarItem Text="Settings" Clicked="OnSettingsMenuClicked" />
        <ToolbarItem Text="Help" Clicked="OnHelpMenuClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="16">


            <Image
                Source="dotnet_bot.png"
                HeightRequest="140"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a hovercraft number nine" />

            <Label
                Text="Edit Game"
                FontSize="20"
                HorizontalOptions="Center" />

            <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" Background="#FFF" Padding="12" Shadow="True">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Title" />
                    <Entry Text="{Binding Title, Mode=TwoWay}" Placeholder="Enter game title" />

                    <Label Text="Author" />
                    <Entry Text="{Binding Author, Mode=TwoWay}" Placeholder="Enter author name" />

                    <Label Text="Version" />
                    <Entry Text="{Binding Version, Mode=TwoWay}" Placeholder="e.g. 1.0.0" />

                   

                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout Spacing="12" HorizontalOptions="Fill">
                <Button
                    x:Name="CounterBtn"
                    Text="Click me"
                    Clicked="OnCounterClicked"
                    HorizontalOptions="StartAndExpand" />

                <Button
                    x:Name="Savebtn"
                    Text="Save Game"
                    Clicked="OnSaveClicked"
                    SemanticProperties.Hint="Saves the game"
                    HorizontalOptions="End" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
