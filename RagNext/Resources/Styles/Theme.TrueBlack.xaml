<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="RagNext.Resources.Styles.Theme.TrueBlackTheme">
    <!-- AMOLED-friendly -->
    <Color x:Key="ColorPrimary">#3D82F6</Color>
    <Color x:Key="ColorPrimaryVariant">#2A5BB3</Color>
    <Color x:Key="ColorSecondary">#14B8A6</Color>
    <Color x:Key="ColorAccent">#F59E0B</Color>
    <Color x:Key="ColorBackground">#000000</Color>
    <Color x:Key="ColorSurface">#101010</Color>
    <Color x:Key="ColorOnBackground">#E5E5E5</Color>
    <Color x:Key="ColorOnSurface">#C7C7C7</Color>
    <Color x:Key="ColorError">#EF4444</Color>

    <!-- Buttons + common Styles.xaml keys -->
    <Color x:Key="Primary">#3D82F6</Color>
    <Color x:Key="PrimaryDark">#2A5BB3</Color>
    <Color x:Key="Secondary">#14B8A6</Color>
    <Color x:Key="Tertiary">#F59E0B</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="OffBlack">#000000</Color>

    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="SecondaryDarkText">#E5E5E5</Color>

    <Color x:Key="Gray100">#E5E5E5</Color>
    <Color x:Key="Gray200">#CFCFCF</Color>
    <Color x:Key="Gray300">#B3B3B3</Color>
    <Color x:Key="Gray400">#8C8C8C</Color>
    <Color x:Key="Gray500">#6B6B6B</Color>
    <Color x:Key="Gray600">#4D4D4D</Color>
    <Color x:Key="Gray900">#101010</Color>
    <Color x:Key="Gray950">#000000</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />

    <!-- Existing -->
    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
</ResourceDictionary>
