<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
					x:Class="RagNext.Resources.Styles.Theme.NordTheme">
    <!-- Existing Nord tokens -->
    <Color x:Key="ColorPrimary">#88C0D0</Color>
    <Color x:Key="ColorPrimaryVariant">#5E81AC</Color>
    <Color x:Key="ColorSecondary">#EBCB8B</Color>
    <Color x:Key="ColorAccent">#A3BE8C</Color>

    <Color x:Key="ColorBackground">#2E3440</Color>
    <Color x:Key="ColorSurface">#3B4252</Color>
    <Color x:Key="ColorOnBackground">#D8DEE9</Color>
    <Color x:Key="ColorOnSurface">#E5E9F0</Color>
    <Color x:Key="ColorError">#BF616A</Color>

    <!-- Buttons + common Styles.xaml keys -->
    <Color x:Key="Primary">#88C0D0</Color>
    <Color x:Key="PrimaryDark">#5E81AC</Color>
    <Color x:Key="Secondary">#EBCB8B</Color>
    <Color x:Key="Tertiary">#A3BE8C</Color>

    <Color x:Key="White">#ECEFF4</Color>
    <Color x:Key="Black">#2E3440</Color>
    <Color x:Key="OffBlack">#2B313C</Color>

    <Color x:Key="PrimaryDarkText">#ECEFF4</Color>
    <Color x:Key="SecondaryDarkText">#D8DEE9</Color>

    <Color x:Key="Gray100">#E5E9F0</Color>
    <Color x:Key="Gray200">#D8DEE9</Color>
    <Color x:Key="Gray300">#C8D0E0</Color>
    <Color x:Key="Gray400">#B0BCD0</Color>
    <Color x:Key="Gray500">#8A99B2</Color>
    <Color x:Key="Gray600">#6B7280</Color>
    <Color x:Key="Gray900">#3B4252</Color>
    <Color x:Key="Gray950">#2E3440</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />

    <!-- Existing brushes kept -->
    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushOnBackground" Color="{StaticResource ColorOnBackground}" />
</ResourceDictionary>