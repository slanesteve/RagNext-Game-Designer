<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RagNext.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RagNext"
    xmlns:views="clr-namespace:RagNext.Views"
    Title="RagNext"
    FlyoutBehavior="Locked"
    FlyoutWidth="175"
    FlyoutBackgroundColor="{AppThemeBinding Light=#F4F4F8, Dark={DynamicResource Black}}">

    <Shell.FlyoutContent>
        <Grid RowDefinitions="Auto,*" RowSpacing="12" Padding="12,12,6,12" BackgroundColor="{AppThemeBinding Light=#F4F4F8, Dark={DynamicResource Black}}">
            <!-- Mini Logo Header -->
            <HorizontalStackLayout Grid.Row="0" Spacing="8" HorizontalOptions="Center" Margin="0,4,0,4">
                <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" WidthRequest="32" HeightRequest="32">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#8E2DE2" Offset="0.0" />
                            <GradientStop Color="#4A00E0" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Label Text="RN" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="RAGNEXT" FontSize="16" FontAttributes="Bold" CharacterSpacing="2" TextColor="{DynamicResource PrimaryDarkText}" VerticalOptions="Center" />
            </HorizontalStackLayout>
 
            <Border Grid.Row="1"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E5E7EB, Dark={DynamicResource OffBlack}}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark={DynamicResource OffBlack}}"
                    Padding="4,8"
                    VerticalOptions="Fill">
                <Border.Shadow>
                    <Shadow Radius="4" Opacity="0.04" Brush="Black" Offset="0,1" />
                </Border.Shadow>
                
                <CollectionView ItemsSource="{Binding Items, Source={RelativeSource AncestorType={x:Type Shell}}}"
                                SelectedItem="{Binding CurrentItem, Source={RelativeSource AncestorType={x:Type Shell}}, Mode=TwoWay}"
                                SelectionMode="Single"
                                IsEnabled="{Binding IsFlyoutEnabled, Source={RelativeSource AncestorType={x:Type Shell}}}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="2" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    BackgroundColor="Transparent"
                                    Padding="12,10"
                                    Margin="4,2">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                                                    <Setter TargetName="TabTitleLabel" Property="Label.TextColor" Value="White" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                                <Label x:Name="TabTitleLabel"
                                       Text="{Binding Title}" 
                                       FontSize="13" 
                                       FontAttributes="Bold" 
                                       TextColor="{DynamicResource PrimaryDarkText}"
                                       VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </Grid>
    </Shell.FlyoutContent>

    <Shell.TitleView>
        <Border StrokeShape="RoundRectangle 8"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E5E7EB, Dark={DynamicResource Gray900}}"
                BackgroundColor="{AppThemeBinding Light=White, Dark={DynamicResource OffBlack}}"
                Margin="6,8,12,8"
                Padding="12,0"
                HeightRequest="36"
                VerticalOptions="Center">
            <Border.Shadow>
                <Shadow Radius="4" Opacity="0.04" Brush="Black" Offset="0,1" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <!-- Left part: title -->
                <Label Text="RagNext Designer" FontSize="14" FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                       VerticalOptions="Center" Grid.Column="0" />

                <!-- Right part: AI Status / Model Selection -->
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center" Grid.Column="1">
                    <Label Text="✨ AI:" 
                           TextColor="{AppThemeBinding Light={StaticResource Magenta}, Dark={StaticResource SecondaryDarkText}}" 
                           VerticalOptions="Center" FontSize="12" FontAttributes="Bold"/>
                    <Label x:Name="ProviderLabel" 
                           Text="None" 
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}" 
                           VerticalOptions="Center" FontSize="12" FontAttributes="Bold"/>
                    
                    <Border StrokeShape="RoundRectangle 6"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                            Padding="8,0"
                            HeightRequest="26"
                            VerticalOptions="Center"
                            Margin="0,0,4,0">
                        <Picker x:Name="ModelPicker" 
                                WidthRequest="200" 
                                HeightRequest="26" 
                                FontSize="11" 
                                TextColor="{DynamicResource PrimaryDarkText}"
                                BackgroundColor="Transparent"
                                TitleColor="Gray"
                                VerticalOptions="Center" 
                                SelectedIndexChanged="OnModelPickerSelectedIndexChanged" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Shell.TitleView>

    <FlyoutItem Title="Main" Route="main">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Splash Screen" Route="splashscreen">
        <ShellContent ContentTemplate="{DataTemplate views:SplashSettingsPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Player" Route="player">
        <ShellContent ContentTemplate="{DataTemplate views:PlayerEditPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Rooms" Route="rooms">
        <ShellContent ContentTemplate="{DataTemplate views:RoomsPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Objects" Route="gameobjects">
        <ShellContent ContentTemplate="{DataTemplate views:GameObjectsPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Characters" Route="characters">
        <ShellContent ContentTemplate="{DataTemplate views:CharactersPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Variables" Route="variables">
        <ShellContent ContentTemplate="{DataTemplate views:GameVariablesPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Functions" Route="functions">
        <ShellContent ContentTemplate="{DataTemplate views:GlobalFunctionsPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Timers" Route="timers">
        <ShellContent ContentTemplate="{DataTemplate views:GameTimersPage}" />
    </FlyoutItem>

</Shell>
