<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RagNext.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RagNext"
    xmlns:views="clr-namespace:RagNext.Views"
    Title="RagNext">

    <TabBar>
        <ShellContent Title="Main" Route="main" ContentTemplate="{DataTemplate local:MainPage}" />
        <ShellContent Title="Rooms" Route="rooms" ContentTemplate="{DataTemplate views:RoomsPage}" />
        <ShellContent Title="Objects" Route="gameobjects" ContentTemplate="{DataTemplate views:GameObjectsPage}" />
    </TabBar>

</Shell>
