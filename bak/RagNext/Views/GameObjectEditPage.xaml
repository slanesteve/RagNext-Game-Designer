<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="RagNext.Views.GameObjectEditPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:RagNext.Views.Controls" Title="Edit Object">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Clicked="OnSaveClicked" />
        <ToolbarItem Text="Cancel" Clicked="OnCancelClicked" Priority="1" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="10">
            <Label Text="Name" />
            <Entry Text="{Binding Name}" Placeholder="Object name" />

            <Label Text="Description" />
            <Editor Text="{Binding Description}" HeightRequest="150" />

            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray400}" />

            <!-- New nested actions --><!--
            <Label Text="Nested Actions" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Add Tree" Clicked="OnAddTreeClicked" />
                <Button Text="Remove Selected" Clicked="OnRemoveTreeClicked" />
            </HorizontalStackLayout>

            <CollectionView x:Name="ActionTreesList"
                        SelectionMode="Single"
                        ItemsSource="{Binding ActionTrees}"
                        SelectionChanged="OnTreeSelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="6" ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Name}" />
                            <Label Grid.Column="1" Text="{Binding Branches.Count, StringFormat='({0} branches)'}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No nested actions yet." />
                </CollectionView.EmptyView>
            </CollectionView>-->

            <!-- Tree view (left) + detailed editor (right) -->
            <Grid ColumnDefinitions="1*,2*" ColumnSpacing="8">
                <controls:ActionTreeView
                    x:Name="TreeControl"
                    Tree="{Binding SelectedItem, Source={x:Reference ActionTreesList}}" />
                <controls:ActionTreeEditorView
                    x:Name="TreeEditor"
                    Grid.Column="1"
                    Tree="{Binding SelectedItem, Source={x:Reference ActionTreesList}}"
                    SelectedBranch="{Binding SelectedBranch, Source={x:Reference TreeControl}}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>