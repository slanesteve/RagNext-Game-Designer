<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RagNext.Views.Controls" 
             x:Class="RagNext.Views.Controls.ActionBranchNodeView"
             x:Name="Root">
    <VerticalStackLayout Spacing="4">
        <!-- Node Header -->
        <Grid x:Name="HeaderGrid" Padding="6" BackgroundColor="{DynamicResource Gray400}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSelectTapped" />
            </Grid.GestureRecognizers>
            <FlyoutBase.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Add Command" Clicked="OnAddCommandClicked" />
                    <MenuFlyoutItem Text="Add Child Condition" Clicked="OnAddChildClicked" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Add Action" Clicked="OnAddTopLevelActionClicked" />
                    <MenuFlyoutItem Text="Remove" Clicked="OnRemoveClicked" />
                </MenuFlyout>
            </FlyoutBase.ContextFlyout>
            <HorizontalStackLayout Spacing="8">
                <Label Text="{Binding DisplayName}" FontAttributes="Bold" />
                <Label Text="{Binding Commands.Count, StringFormat='({0} cmds)'}" />
                <Label Text="{Binding Children.Count, StringFormat='({0} children)'}" />
            </HorizontalStackLayout>
        </Grid>
        <!-- Children -->
        <VerticalStackLayout Margin="16,0,0,0"
                         BindableLayout.ItemsSource="{Binding Children}"
                         Spacing="4">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <controls:ActionBranchNodeView />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>