<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:actions="clr-namespace:RagsCore.Actions;assembly=RagsCore"
             xmlns:converters="clr-namespace:RagNext.Converters"
             x:Class="RagNext.Views.Controls.ActionEditorView">
    <ContentView.Resources>
        <converters:TypeMatchConverter x:Key="TypeMatchConverter" />
        <converters:RoomSelectorConverter x:Key="RoomSelectorConverter" />
        <converters:ObjectSelectorConverter x:Key="ObjectSelectorConverter" />
    </ContentView.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="12">
            <Label Text="Action" FontAttributes="Bold"/>
            <Entry Placeholder="Action Name" Text="{Binding Action.Name}" />

            <Label Text="Conditions" FontAttributes="Bold"/>
            <HorizontalStackLayout Spacing="8">
                <Picker Title="Add condition"
                        ItemsSource="{Binding AvailableConditions}"
                        SelectedItem="{Binding SelectedConditionKey}" />
                <Button Text="Add" Command="{Binding AddConditionCommand}" />
            </HorizontalStackLayout>

            <CollectionView ItemsSource="{Binding Action.Conditions}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="8" Margin="0,6" BorderColor="{DynamicResource Gray600}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding TypeName}" FontAttributes="Bold"/>

                                <!-- VariableEqualsCondition -->
                                <VerticalStackLayout Spacing="4">
                                    <VerticalStackLayout.IsVisible>
                                        <MultiBinding Converter="{StaticResource TypeMatchConverter}">
                                            <Binding Path="." />
                                            <Binding Source="{x:Type actions:VariableEqualsCondition}" />
                                        </MultiBinding>
                                    </VerticalStackLayout.IsVisible>
                                    <Entry Placeholder="Variable Name" Text="{Binding Name}" />
                                    <Entry Placeholder="Value" Text="{Binding Value}" />
                                    <HorizontalStackLayout>
                                        <Label Text="Case Insensitive" VerticalOptions="Center" />
                                        <Switch IsToggled="{Binding CaseInsensitive}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- PlayerInRoomCondition -->
                                <VerticalStackLayout Spacing="4">
                                    <VerticalStackLayout.IsVisible>
                                        <MultiBinding Converter="{StaticResource TypeMatchConverter}">
                                            <Binding Path="." />
                                            <Binding Source="{x:Type actions:PlayerInRoomCondition}" />
                                        </MultiBinding>
                                    </VerticalStackLayout.IsVisible>

                                    <Picker Title="Room"
                                            ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.Game.Rooms}"
                                            ItemDisplayBinding="{Binding Name}">
                                        <Picker.SelectedItem>
                                            <MultiBinding Converter="{StaticResource RoomSelectorConverter}" Mode="TwoWay">
                                                <Binding Path="RoomId" Mode="TwoWay" />
                                                <Binding Source="{RelativeSource AncestorType={x:Type ContentView}}" Path="BindingContext.Game.Rooms" />
                                            </MultiBinding>
                                        </Picker.SelectedItem>
                                    </Picker>
                                </VerticalStackLayout>

                                <!-- RoomHasObjectCondition -->
                                <VerticalStackLayout Spacing="4">
                                    <VerticalStackLayout.IsVisible>
                                        <MultiBinding Converter="{StaticResource TypeMatchConverter}">
                                            <Binding Path="." />
                                            <Binding Source="{x:Type actions:RoomHasObjectCondition}" />
                                        </MultiBinding>
                                    </VerticalStackLayout.IsVisible>

                                    <Picker Title="Room"
                                            ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.Game.Rooms}"
                                            ItemDisplayBinding="{Binding Name}">
                                        <Picker.SelectedItem>
                                            <MultiBinding Converter="{StaticResource RoomSelectorConverter}" Mode="TwoWay">
                                                <Binding Path="RoomId" Mode="TwoWay" />
                                                <Binding Source="{RelativeSource AncestorType={x:Type ContentView}}" Path="BindingContext.Game.Rooms" />
                                            </MultiBinding>
                                        </Picker.SelectedItem>
                                    </Picker>

                                    <Picker Title="Object"
                                            ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.Game.Objects}"
                                            ItemDisplayBinding="{Binding Name}">
                                        <Picker.SelectedItem>
                                            <MultiBinding Converter="{StaticResource ObjectSelectorConverter}" Mode="TwoWay">
                                                <Binding Path="ObjectId" Mode="TwoWay" />
                                                <Binding Source="{RelativeSource AncestorType={x:Type ContentView}}" Path="BindingContext.Game.Objects" />
                                            </MultiBinding>
                                        </Picker.SelectedItem>
                                    </Picker>
                                </VerticalStackLayout>

                                <Button Text="Remove" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.RemoveConditionCommand}" CommandParameter="{Binding}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Commands" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="8">
                <Picker Title="Add command"
                        ItemsSource="{Binding AvailableCommands}"
                        SelectedItem="{Binding SelectedCommandKey}" />
                <Button Text="Add" Command="{Binding AddCommandCommand}" />
            </HorizontalStackLayout>

            <CollectionView ItemsSource="{Binding Action.Commands}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="8" Margin="0,6" BorderColor="{DynamicResource Gray600}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding TypeName}" FontAttributes="Bold"/>

                                <!-- SetVariableCommand -->
                                <VerticalStackLayout Spacing="4">
                                    <VerticalStackLayout.IsVisible>
                                        <MultiBinding Converter="{StaticResource TypeMatchConverter}">
                                            <Binding Path="." />
                                            <Binding Source="{x:Type actions:SetVariableCommand}" />
                                        </MultiBinding>
                                    </VerticalStackLayout.IsVisible>
                                    <Entry Placeholder="Variable Name" Text="{Binding Name}" />
                                    <Entry Placeholder="Value" Text="{Binding Value}" />
                                </VerticalStackLayout>

                                <!-- MovePlayerToRoomCommand -->
                                <VerticalStackLayout Spacing="4">
                                    <VerticalStackLayout.IsVisible>
                                        <MultiBinding Converter="{StaticResource TypeMatchConverter}">
                                            <Binding Path="." />
                                            <Binding Source="{x:Type actions:MovePlayerToRoomCommand}" />
                                        </MultiBinding>
                                    </VerticalStackLayout.IsVisible>

                                    <Picker Title="Room"
                                            ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.Game.Rooms}"
                                            ItemDisplayBinding="{Binding Name}">
                                        <Picker.SelectedItem>
                                            <MultiBinding Converter="{StaticResource RoomSelectorConverter}" Mode="TwoWay">
                                                <Binding Path="RoomId" Mode="TwoWay" />
                                                <Binding Source="{RelativeSource AncestorType={x:Type ContentView}}" Path="BindingContext.Game.Rooms" />
                                            </MultiBinding>
                                        </Picker.SelectedItem>
                                    </Picker>
                                </VerticalStackLayout>

                                <!-- AddObjectToRoomCommand -->
                                <VerticalStackLayout Spacing="4">
                                    <VerticalStackLayout.IsVisible>
                                        <MultiBinding Converter="{StaticResource TypeMatchConverter}">
                                            <Binding Path="." />
                                            <Binding Source="{x:Type actions:AddObjectToRoomCommand}" />
                                        </MultiBinding>
                                    </VerticalStackLayout.IsVisible>

                                    <Picker Title="Room"
                                            ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.Game.Rooms}"
                                            ItemDisplayBinding="{Binding Name}">
                                        <Picker.SelectedItem>
                                            <MultiBinding Converter="{StaticResource RoomSelectorConverter}" Mode="TwoWay">
                                                <Binding Path="RoomId" Mode="TwoWay" />
                                                <Binding Source="{RelativeSource AncestorType={x:Type ContentView}}" Path="BindingContext.Game.Rooms" />
                                            </MultiBinding>
                                        </Picker.SelectedItem>
                                    </Picker>

                                    <Picker Title="Object"
                                            ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.Game.Objects}"
                                            ItemDisplayBinding="{Binding Name}">
                                        <Picker.SelectedItem>
                                            <MultiBinding Converter="{StaticResource ObjectSelectorConverter}" Mode="TwoWay">
                                                <Binding Path="ObjectId" Mode="TwoWay" />
                                                <Binding Source="{RelativeSource AncestorType={x:Type ContentView}}" Path="BindingContext.Game.Objects" />
                                            </MultiBinding>
                                        </Picker.SelectedItem>
                                    </Picker>
                                </VerticalStackLayout>

                                <!-- RemoveObjectFromRoomCommand -->
                                <VerticalStackLayout Spacing="4">
                                    <VerticalStackLayout.IsVisible>
                                        <MultiBinding Converter="{StaticResource TypeMatchConverter}">
                                            <Binding Path="." />
                                            <Binding Source="{x:Type actions:RemoveObjectFromRoomCommand}" />
                                        </MultiBinding>
                                    </VerticalStackLayout.IsVisible>

                                    <Picker Title="Room"
                                            ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.Game.Rooms}"
                                            ItemDisplayBinding="{Binding Name}">
                                        <Picker.SelectedItem>
                                            <MultiBinding Converter="{StaticResource RoomSelectorConverter}" Mode="TwoWay">
                                                <Binding Path="RoomId" Mode="TwoWay" />
                                                <Binding Source="{RelativeSource AncestorType={x:Type ContentView}}" Path="BindingContext.Game.Rooms" />
                                            </MultiBinding>
                                        </Picker.SelectedItem>
                                    </Picker>

                                    <Picker Title="Object"
                                            ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.Game.Objects}"
                                            ItemDisplayBinding="{Binding Name}">
                                        <Picker.SelectedItem>
                                            <MultiBinding Converter="{StaticResource ObjectSelectorConverter}" Mode="TwoWay">
                                                <Binding Path="ObjectId" Mode="TwoWay" />
                                                <Binding Source="{RelativeSource AncestorType={x:Type ContentView}}" Path="BindingContext.Game.Objects" />
                                            </MultiBinding>
                                        </Picker.SelectedItem>
                                    </Picker>
                                </VerticalStackLayout>

                                <Button Text="Remove" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.RemoveCommandCommand}" CommandParameter="{Binding}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Test Run" Command="{Binding TestRunCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>