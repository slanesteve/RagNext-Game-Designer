<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:RagNext.Views.Controls"
             x:Class="RagNext.Views.Controls.ActionTreeEditorView"
             x:Name="Root">
    <VerticalStackLayout Spacing="10" Padding="6">
        <Label Text="Action Tree" FontAttributes="Bold" />
        <Entry Placeholder="Action name" Text="{Binding Tree.Name, Source={x:Reference Root}}" />

        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray400}" />

        <Label Text="Default (always runs)" FontAttributes="Bold" />
        <views:ActionCommandsEditorView
            Game="{Binding Game, Source={x:Reference Root}}"
            Commands="{Binding Tree.DefaultCommands, Source={x:Reference Root}, Mode=TwoWay}" />

        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray400}" />

        <!-- Selected branch editor -->
        <Label Text="Selected Branch" FontAttributes="Bold" />
        <views:ActionBranchEditorView
            BindingContext="{Binding SelectedBranch, Source={x:Reference Root}}" />

        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray400}" />
        <Label Text="Branches" FontAttributes="Bold" />

        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Tree.Branches, Source={x:Reference Root}}" Spacing="8">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <views:ActionBranchEditorView />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <HorizontalStackLayout Spacing="8">
            <Button Text="Add Branch" Clicked="OnAddBranchClicked" />
            <Button Text="Clear Branches" Clicked="OnClearBranchesClicked" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentView>