<Project>
  <!-- Override standard linker and registrar targets for Apple platforms to bypass workload SDK comparison bugs -->
  <Target Name="_LinkAssemblies" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" />
  <Target Name="ILLink" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" />
  <Target Name="_CompileInterfaceDefinitions" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" />
</Project>
